    { name: '錾花茶托', en: 'Chased Tea Saucer',
      meta: '民国 · 径 11cm',
      desc: '浅碟最难走银：槽浅则挂不住，槽深则透底。全凭腕力停在十分之一毫米的误差里。',
      craft: '浅槽走银 · 錾花', build: mkTray },
    { name: '祥龙献瑞酒壶', en: 'Auspicious Dragon Wine Ewer',
      meta: '当代 · 重 590.6g · 2013「金凤凰」创新产品设计大赛金奖',
      desc: '扁圆壶身，壶颈、壶嘴、壶底各刻二龙，壶把一龙，共成九龙缠绕之势。黑底白纹，银线随笔势在弧面上流转，留白与线条之间是中国传统艺术的意境；壶体极富流体感，端庄祥瑞。',
      craft: '九龙走银 · 扁圆壶身 · 捂黑', build: mkDragonEwer,
      /* 实体模型原始约 0.9×1.1×0.42m 且原点不在底面：等比缩到 0.20m 并归位；
