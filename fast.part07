      craft: '环形走银 · 一次成型', build: mkBangle },
    { name: '山水墨床', en: 'Ink Rest with Landscape',
      meta: '清末 · 长 9.2cm',
      desc: '床面弧凹承墨，两面皆需走银。翻面时铜片尚有余温，手一变形，原本对好的纹样就错位了。',
      craft: '双面走银 · 弧形器', build: mkInkbed }
