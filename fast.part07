";
window.__DRACO_WASM_B64 = "";
</script>
<script>
/* ============================================================
   乌铜走银 · 单厅 3D 展厅
   布局：正方形厅 → 中央屏风 → 11 座展柜沿正圆均布（柜面朝外，绕圆环参观）
   配色：黑铜 / 白银 / 暗金
   ============================================================ */
(function () {
  'use strict';

  var T = window.THREE;
  var $ = function (s) { return document.querySelector(s); };
  var $$ = function (s) { return Array.prototype.slice.call(document.querySelectorAll(s)); };

  if (!T) {
    var ld = $('#loader');
    if (ld) ld.innerHTML = '<div class="ld-txt" style="letter-spacing:.2em">3D 引擎未能加载</div>';
    return;
  }

  /* ---------- 基础工具 ---------- */
  function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
  function lerp(a, b, t) { return a + (b - a) * t; }
  function damp(a, b, l, dt) { return lerp(a, b, 1 - Math.exp(-l * dt)); }
  function easeInOut(t) { return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; }
  function pad2(n) { return (n < 10 ? '0' : '') + n; }
  // 朝向角按最短一側转，避免 focus / 返回时绕一大圈
  function angDiff(from, to) {
    var d = (to - from) % (Math.PI * 2);
    if (d > Math.PI) d -= Math.PI * 2;
    if (d < -Math.PI) d += Math.PI * 2;
    return d;
  }
  function rand(seed) { var s = seed; return function () { s = (s * 9301 + 49297) % 233280; return s / 233280; }; }

  /* ---------- 房间尺寸 ---------- */
  var ROOM = { w: 13.6, d: 13.6, h: 5.2 };   // 正方厅
  var HW = ROOM.w / 2, HD = ROOM.d / 2;
  var DOOR = { w: 2.9, h: 3.15 };
  var EYE = 1.46;          // 视高：压低一点，看铭牌不用低头

  /* ============================================================
     1. 渲染器 / 场景 / 相机
     ============================================================ */
  var canvas = $('#gl');
  var LITE = /[?&]lite=1/.test(location.search);
  var STILL = /[?&]still=1/.test(location.search);   // 有限帧模式（校验 / 截图用）
  var stillCount = 0, stillMax = 40;
  var renderer = new T.WebGLRenderer({
    canvas: canvas,
    antialias: !LITE,
    preserveDrawingBuffer: LITE || /[?&]still=1/.test(location.search),
    powerPreference: 'high-performance'
  });
  renderer.setPixelRatio(LITE ? 1 : Math.min(window.devicePixelRatio || 1, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.outputEncoding = T.sRGBEncoding;
  renderer.toneMapping = T.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.28;

  var scene = new T.Scene();
  scene.background = new T.Color(0x070606);
  scene.fog = new T.FogExp2(0x0a0908, 0.014);

  var camera = new T.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.10, 100);
  camera.position.set(0, EYE, HD + 6.2);

  /* ---------- 环境贴图（程序化 equirect → PMREM） ---------- */
  function buildEnv() {
    var W = 1024, H = 512;
    var c = document.createElement('canvas');
    c.width = W; c.height = H;
    var x = c.getContext('2d');

    var g = x.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0.00, '#33302a');
    g.addColorStop(0.24, '#181614');
    g.addColorStop(0.48, '#0e0d0c');
    g.addColorStop(0.74, '#080706');
    g.addColorStop(1.00, '#040303');
    x.fillStyle = g; x.fillRect(0, 0, W, H);

    // 顶部灯槽（软，多条）
    x.fillStyle = 'rgba(255,226,186,.50)';
    for (var i = 0; i < 8; i++) x.fillRect(24 + i * 124, 54, 68, 11);
    // 侧向冷光条（银）
    x.fillStyle = 'rgba(202,218,240,.20)';
    for (var j = 0; j < 10; j++) x.fillRect(j * 104, 236, 50, 6);
    // 地面反光
    var fg = x.createLinearGradient(0, H, 0, H * 0.70);
    fg.addColorStop(0, 'rgba(150,118,88,.24)');
    fg.addColorStop(1, 'rgba(150,118,88,0)');
    x.fillStyle = fg; x.fillRect(0, H * 0.70, W, H * 0.30);

    /* ★ 高光点：几个极亮的小光斑。
       PMREM 之后它们是锐利的镜面反射源——器物旋转时，
       银线扫过这些点就会「闪」一下。 */
    var spots = [
      [0.115, 0.205, 30, 'rgba(255,255,255,1)'],
      [0.315, 0.130, 18, 'rgba(255,247,230,.98)'],
      [0.480, 0.250, 34, 'rgba(255,255,255,.95)'],
      [0.665, 0.150, 16, 'rgba(233,243,255,.96)'],
      [0.845, 0.235, 26, 'rgba(255,250,238,.92)'],
      [0.945, 0.320, 15, 'rgba(216,234,255,.90)'],
      [0.400, 0.395, 13, 'rgba(255,242,220,.85)'],
      [0.720, 0.455, 14, 'rgba(255,255,255,.82)'],
      [0.205, 0.430, 12, 'rgba(226,240,255,.80)']
    ];
    spots.forEach(function (sp) {
      var px = sp[0] * W, py = sp[1] * H, r = sp[2];
      var rg = x.createRadialGradient(px, py, 0, px, py, r);
      rg.addColorStop(0.00, sp[3]);
      rg.addColorStop(0.24, 'rgba(255,252,244,.55)');
      rg.addColorStop(1.00, 'rgba(255,255,255,0)');
      x.fillStyle = rg;
      x.beginPath(); x.arc(px, py, r, 0, Math.PI * 2); x.fill();
    });

    var tex = new T.CanvasTexture(c);
    tex.mapping = T.EquirectangularReflectionMapping;
    var pm = new T.PMREMGenerator(renderer);
    pm.compileEquirectangularShader();
    var env = pm.fromEquirectangular(tex).texture;
    tex.dispose(); pm.dispose();
    return env;
  }
  scene.environment = buildEnv();

  /* ============================================================
     2. 程序化贴图
     ============================================================ */
  function newCanvas(w, h) {
    var c = document.createElement('canvas');
    c.width = w; c.height = h;
    return { c: c, x: c.getContext('2d') };
  }
  function texOf(c, wrap) {
    var t = new T.CanvasTexture(c);
    t.wrapS = t.wrapT = wrap ? T.RepeatWrapping : T.ClampToEdgeWrapping;
    t.anisotropy = Math.min(16, renderer.capabilities.getMaxAnisotropy() || 1);
    t.encoding = T.sRGBEncoding;
    return t;
  }

  /* ---------- 光晕贴图（地面光池、灯下柔光都用它） ---------- */
  function poolTex() {
    var o = newCanvas(256, 256), x = o.x;
    var g = x.createRadialGradient(128, 128, 4, 128, 128, 126);
    g.addColorStop(0, 'rgba(255,222,178,.55)');
    g.addColorStop(0.45, 'rgba(255,206,150,.16)');
    g.addColorStop(1, 'rgba(255,190,130,0)');
    x.fillStyle = g; x.fillRect(0, 0, 256, 256);
    return o.c;
  }
  var poolTexture = texOf(poolTex());

  /* ---------- 地面：屏前磨光石板 / 屏后胡桃木 ----------
     实景里屏风这一侧是大料磨光暖灰石，反光强、缝细亮；
     屏风背面是深胡桃长条地板。分割线正好压在屏风基座下，
     两侧各露一段铜条收口，走过去才察觉换了个空间。 */
  function makeStoneFloorTex() {
    var W = 2048, H = Math.round(W * (ROOM.d / 2) / ROOM.w);   // 1024
    var o = newCanvas(W, H), x = o.x;
    var pxm = W / ROOM.w;
    var r = rand(17);

    var g = x.createLinearGradient(0, 0, W * 0.75, H);
    g.addColorStop(0.00, '#4a3d2e');
    g.addColorStop(0.38, '#574836');
    g.addColorStop(0.68, '#504233');
    g.addColorStop(1.00, '#413628');
    x.fillStyle = g; x.fillRect(0, 0, W, H);

    // 云斑：大团深浅，石材的絮状纹
    for (var i = 0; i < 420; i++) {
      var px = r() * W, py = r() * H, rad = 40 + r() * 250;
      var warm = r() > 0.45;
      var a = 0.018 + r() * 0.045;
      var gg = x.createRadialGradient(px, py, 0, px, py, rad);
      gg.addColorStop(0, warm ? 'rgba(154,136,112,' + a.toFixed(3) + ')'
                              : 'rgba(16,12,9,' + (a * 1.3).toFixed(3) + ')');
      gg.addColorStop(1, warm ? 'rgba(172,152,124,0)' : 'rgba(22,17,13,0)');
      x.fillStyle = gg;
      x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();
    }

    // 石板 1.15m，逐块微差
    var cell = 1.15 * pxm;
    var r2 = rand(53);
    for (var gy = 0; gy < H + cell; gy += cell) {
      for (var gx = 0; gx < W + cell; gx += cell) {
        var v = r2() - 0.5;
        x.fillStyle = v > 0 ? 'rgba(182,166,144,' + (v * 0.07).toFixed(3) + ')'
                            : 'rgba(14,11,8,' + (-v * 0.10).toFixed(3) + ')';
        x.fillRect(gx, gy, cell, cell);
      }
    }

    // 石粒
    for (var j = 0; j < 7000; j++) {
      var a2 = 0.008 + r() * 0.028;
      x.fillStyle = r() > 0.52 ? 'rgba(228,222,210,' + a2.toFixed(3) + ')'
                               : 'rgba(0,0,0,' + (a2 * 2.1).toFixed(3) + ')';
      x.fillRect(r() * W, r() * H, 1 + r() * 2.2, 1 + r() * 2.2);
    }

    // 缝：细亮缝 + 一侧暗影
    for (var sx = cell; sx < W; sx += cell) {
      x.fillStyle = 'rgba(10,7,5,.30)'; x.fillRect(sx + 2, 0, 3, H);
      x.fillStyle = 'rgba(206,192,172,.10)'; x.fillRect(sx - 1, 0, 2, H);
    }
    for (var sy = cell; sy < H; sy += cell) {
      x.fillStyle = 'rgba(10,7,5,.30)'; x.fillRect(0, sy + 2, W, 3);
      x.fillStyle = 'rgba(206,192,172,.10)'; x.fillRect(0, sy - 1, W, 2);
    }

    // 磨光面的大片反光
    var sh = x.createLinearGradient(0, H * 0.08, W * 0.92, H * 0.96);
    sh.addColorStop(0.00, 'rgba(255,246,228,.085)');
    sh.addColorStop(0.34, 'rgba(255,246,228,.015)');
    sh.addColorStop(0.66, 'rgba(96,74,50,.045)');
    sh.addColorStop(1.00, 'rgba(255,240,214,.045)');
    x.fillStyle = sh; x.fillRect(0, 0, W, H);

    return o.c;
  }

  function makeWoodFloorTex() {
    var W = 2048, H = Math.round(W * (ROOM.d / 2) / ROOM.w);   // 1024
    var o = newCanvas(W, H), x = o.x;
    var pxm = W / ROOM.w;
    var pw = 0.185 * pxm;                  // 板宽 185mm
    var r = rand(97);

    x.fillStyle = '#2a1d14'; x.fillRect(0, 0, W, H);

    var tones = [[48, 33, 21], [39, 27, 17], [54, 38, 25], [43, 29, 19], [34, 24, 15]];

    for (var c = 0; c * pw < W; c++) {
      var x0 = c * pw;
      var base = tones[(r() * tones.length) | 0];
      x.fillStyle = 'rgb(' + base[0] + ',' + base[1] + ',' + base[2] + ')';
      x.fillRect(x0, 0, pw, H);

      // 木纹：一束顺着板长的细线
      for (var k = 0; k < 24; k++) {
        var gx = x0 + 1.5 + r() * (pw - 3);
        x.strokeStyle = r() > 0.46 ? 'rgba(0,0,0,.17)' : 'rgba(158,120,80,.085)';
        x.lineWidth = 0.7 + r() * 1.5;
        x.beginPath();
        x.moveTo(gx, 0);
        var yy = 0;
        while (yy < H) {
          var seg = 70 + r() * 170;
          x.bezierCurveTo(gx + (r() - 0.5) * 5, yy + seg * 0.34,
                          gx + (r() - 0.5) * 5, yy + seg * 0.68,
                          gx + (r() - 0.5) * 4, yy + seg);
          yy += seg;
        }
        x.stroke();
      }

      // 板缝
      x.fillStyle = 'rgba(0,0,0,.58)'; x.fillRect(x0, 0, 1.7, H);
      x.fillStyle = 'rgba(190,152,110,.09)'; x.fillRect(x0 + 1.7, 0, 1.1, H);

      // 错缝端头
      var off = r() * 1.9 * pxm;
      for (var ey = off; ey < H; ey += 1.9 * pxm) {
        x.fillStyle = 'rgba(0,0,0,.45)'; x.fillRect(x0, ey, pw, 1.8);
        x.fillStyle = 'rgba(200,160,116,.06)'; x.fillRect(x0, ey + 1.8, pw, 1);
      }
    }

    // 漆面反光
    var sh = x.createLinearGradient(W * 0.1, 0, W * 0.9, H);
    sh.addColorStop(0.00, 'rgba(255,232,196,.055)');
    sh.addColorStop(0.42, 'rgba(255,232,196,.010)');
    sh.addColorStop(1.00, 'rgba(255,232,196,.035)');
    x.fillStyle = sh; x.fillRect(0, 0, W, H);

    return o.c;
  }
  /* ---------- 墙：黑铜 + 银线 + 暗金腰线 ---------- */
  function makeWallTex() {
    var W = 512, H = 1024;                 // 2.4m × 5.2m
    var o = newCanvas(W, H), x = o.x;

    var g = x.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#5a544b');
    g.addColorStop(0.45, '#625c52');
    g.addColorStop(0.80, '#645e55');
    g.addColorStop(1, '#544e46');
    x.fillStyle = g; x.fillRect(0, 0, W, H);

    // 细密横纹（锤揲感）
    var r = rand(31);
    x.strokeStyle = 'rgba(223,230,239,.022)';
    x.lineWidth = 1;
    for (var y = 0; y < H; y += 7) {
      x.beginPath();
      x.moveTo(0, y + r() * 3);
      x.lineTo(W, y + r() * 3);
      x.stroke();
    }

    // 竖向银线（板缝）
    x.strokeStyle = 'rgba(216,228,242,.20)';
    x.lineWidth = 1.6;
    x.beginPath(); x.moveTo(1, 0); x.lineTo(1, H); x.stroke();
    x.beginPath(); x.moveTo(W - 1, 0); x.lineTo(W - 1, H); x.stroke();
    x.strokeStyle = 'rgba(216,228,242,.07)';
    x.beginPath(); x.moveTo(W / 2, 0); x.lineTo(W / 2, H); x.stroke();

    // 暗金腰线
    var by = H * 0.815;
    x.fillStyle = 'rgba(176,138,79,.62)';
    x.fillRect(0, by, W, 2.4);
    x.fillStyle = 'rgba(176,138,79,.20)';
    x.fillRect(0, by + 4, W, 1);

    // 腰线以上：极简回纹带
    x.strokeStyle = 'rgba(176,138,79,.16)';
    x.lineWidth = 1.6;
    var cell = W / 8;
    for (var i = 0; i < 8; i++) {
      var x0 = i * cell + cell * 0.3, w0 = cell * 0.4;
      var yy = by - cell * 0.42;
      x.beginPath();
      x.moveTo(x0, yy + w0);
      x.lineTo(x0, yy);
      x.lineTo(x0 + w0, yy);
      x.lineTo(x0 + w0, yy + w0 * 0.62);
      x.stroke();
    }

    // 腰线以下：深色墙裙（提亮后不再压到近黑）
    x.fillStyle = 'rgba(0,0,0,.10)';
    x.fillRect(0, by + 6, W, H - by - 6);

    // 顶部灯槽洗墙：自上而下的暖光衰减（让墙不至于全黑）
    var tg = x.createLinearGradient(0, 0, 0, H * 0.72);
    tg.addColorStop(0.00, 'rgba(255,224,190,.36)');
    tg.addColorStop(0.20, 'rgba(255,216,176,.17)');
    tg.addColorStop(0.52, 'rgba(255,208,164,.06)');
    tg.addColorStop(1.00, 'rgba(255,196,140,0)');
    x.fillStyle = tg; x.fillRect(0, 0, W, H * 0.72);

    // 墙脚阴影（地面反光与墙的交界）
    var bg2 = x.createLinearGradient(0, H, 0, H * 0.90);
    bg2.addColorStop(0.00, 'rgba(0,0,0,.62)');
    bg2.addColorStop(1.00, 'rgba(0,0,0,0)');
    x.fillStyle = bg2; x.fillRect(0, H * 0.90, W, H * 0.10);

    return o.c;
  }

  /* ---------- 纹样遮罩（白 = 银） ---------- */
  function motifLandscape(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);
    x.strokeStyle = '#fff'; x.lineCap = 'round'; x.lineJoin = 'round';

    x.lineWidth = w * 0.007;
    x.strokeRect(w * 0.05, h * 0.06, w * 0.90, h * 0.88);
    x.lineWidth = w * 0.003;
    x.strokeRect(w * 0.068, h * 0.085, w * 0.864, h * 0.83);

    function ridge(x0, x1, base, amp, seed) {
      x.beginPath(); x.moveTo(x0, base);
      var n = 26, s = seed;
      for (var i = 1; i <= n; i++) {
        s = (s * 9301 + 49297) % 233280;
        var rnd = s / 233280;
        var px = lerp(x0, x1, i / n);
        var py = base - Math.sin((i / n) * Math.PI) * amp * (0.3 + rnd * 0.9);
        x.lineTo(px, py);
      }
      x.stroke();
    }
    x.lineWidth = w * 0.0042;
    ridge(w * 0.08, w * 0.94, h * 0.60, h * 0.30, 7);
    x.lineWidth = w * 0.0026;
    ridge(w * 0.10, w * 0.90, h * 0.70, h * 0.14, 23);

    // 皴
    x.lineWidth = w * 0.002;
    for (var i = 0; i < 14; i++) {
      var bx = w * (0.16 + (i / 14) * 0.66);
      var byy = h * (0.50 + (i % 3) * 0.04);
      x.beginPath(); x.moveTo(bx, byy); x.lineTo(bx + w * 0.010, byy + h * 0.055); x.stroke();
    }

    // 水波
    x.lineWidth = w * 0.0024;
    for (var j = 0; j < 5; j++) {
      var y = h * (0.76 + j * 0.042);
      x.beginPath();
      for (var k = 0; k <= 44; k++) {
        var pxx = w * 0.08 + (w * 0.84) * (k / 44);
        var pyy = y + Math.sin(k * 0.85 + j * 1.6) * h * 0.007;
        k ? x.lineTo(pxx, pyy) : x.moveTo(pxx, pyy);
      }
      x.stroke();
    }

    // 月（以流云半遮，避免孤立成圈）
    x.lineWidth = w * 0.0032;
    x.beginPath(); x.arc(w * 0.78, h * 0.20, w * 0.046, 0, Math.PI * 2); x.stroke();
    x.lineWidth = w * 0.0030;
    for (var cm = 0; cm < 2; cm++) {
      var cy0 = h * (0.196 + cm * 0.030);
      x.beginPath();
      x.moveTo(w * 0.685, cy0);
      x.bezierCurveTo(w * 0.735, cy0 - h * 0.026, w * 0.812, cy0 + h * 0.020, w * 0.872, cy0 - h * 0.004);
      x.stroke();
    }

    // 孤松
    x.lineWidth = w * 0.0028;
    x.beginPath();
    x.moveTo(w * 0.16, h * 0.66);
    x.bezierCurveTo(w * 0.175, h * 0.55, w * 0.165, h * 0.46, w * 0.205, h * 0.39);
    x.stroke();
    for (var m = 0; m < 5; m++) {
      var yy2 = h * (0.43 + m * 0.045);
      x.beginPath(); x.moveTo(w * 0.19, yy2); x.lineTo(w * 0.265, yy2 - h * 0.018); x.stroke();
    }

    return o.c;
  }

  function motifLattice(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);
    x.strokeStyle = '#fff';
    var cell = w * 0.1;
    x.lineWidth = Math.max(1.4, w * 0.005);
    var nc = Math.ceil(w / cell), nr = Math.ceil(h / cell);
    for (var j = 0; j < nr; j++) {
      for (var i = 0; i < nc; i++) {
        var x0 = i * cell, y0 = j * cell;
        x.strokeRect(x0 + cell * 0.26, y0 + cell * 0.26, cell * 0.48, cell * 0.48);
      }
    }
    x.lineWidth = Math.max(1, w * 0.0022);
    for (var a = 0; a <= nc; a++) { x.beginPath(); x.moveTo(a * cell, 0); x.lineTo(a * cell, nr * cell); x.stroke(); }
    for (var b = 0; b <= nr; b++) { x.beginPath(); x.moveTo(0, b * cell); x.lineTo(nc * cell, b * cell); x.stroke(); }
    return o.c;
  }

  function motifFlora(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);
    x.strokeStyle = '#fff'; x.lineCap = 'round'; x.lineJoin = 'round';

    x.lineWidth = w * 0.006;
    x.beginPath();
    x.moveTo(w * 0.12, h * 0.88);
    x.bezierCurveTo(w * 0.30, h * 0.70, w * 0.44, h * 0.56, w * 0.72, h * 0.26);
    x.stroke();

    // 梅花（五瓣）
    function plum(px, py, r) {
      for (var i = 0; i < 5; i++) {
        var a = (i / 5) * Math.PI * 2 - Math.PI / 2;
        var bx = px + Math.cos(a) * r * 0.62;
        var byy = py + Math.sin(a) * r * 0.62;
        x.lineWidth = w * 0.0042;
        x.beginPath();
        x.ellipse(bx, byy, r * 0.46, r * 0.34, a, 0, Math.PI * 2);
        x.stroke();
      }
      x.lineWidth = w * 0.003;
      x.beginPath(); x.arc(px, py, r * 0.16, 0, Math.PI * 2); x.stroke();
    }
    plum(w * 0.70, h * 0.26, w * 0.11);
    plum(w * 0.48, h * 0.48, w * 0.085);
    plum(w * 0.80, h * 0.52, w * 0.075);

    // 叶
    x.lineWidth = w * 0.0034;
    for (var i = 0; i < 6; i++) {
      var t = 0.22 + i * 0.11;
      var px2 = lerp(w * 0.15, w * 0.66, t);
      var py2 = lerp(h * 0.86, h * 0.32, t);
      x.beginPath();
      x.ellipse(px2, py2 - h * 0.05, w * 0.05, h * 0.017, -0.7, 0, Math.PI * 2);
      x.stroke();
    }
    return o.c;
  }

  /* ---------- 香炉专用纹样 ---------- */

  // 万字锦地（密集回纹，用于炉身）
  function motifMeander(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);
    var cell = w / 8;
    x.strokeStyle = '#fff';
    x.lineWidth = Math.max(1.5, cell * 0.040);
    x.lineJoin = 'miter'; x.lineCap = 'butt';

    var cols = Math.ceil(w / cell), rows = Math.ceil(h / cell);
    for (var j = 0; j < rows; j++) {
      for (var i = 0; i < cols; i++) {
        var x0 = i * cell + cell * 0.14;
        var y0 = j * cell + cell * 0.14;
        var s0 = cell * 0.70;
        x.beginPath();
        x.moveTo(x0, y0 + s0);
        x.lineTo(x0, y0);
        x.lineTo(x0 + s0, y0);
        x.lineTo(x0 + s0, y0 + s0 * 0.64);
        x.lineTo(x0 + s0 * 0.40, y0 + s0 * 0.64);
        x.lineTo(x0 + s0 * 0.40, y0 + s0 * 0.32);
        x.lineTo(x0 + s0 * 0.70, y0 + s0 * 0.32);
        x.stroke();
      }
    }
    return o.c;
  }

  // 回纹带：单行，低覆盖（用于口沿与盖沿）
  function motifBand(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);
    x.strokeStyle = '#fff';
    x.lineWidth = Math.max(2, h * 0.075);
    x.lineJoin = 'miter'; x.lineCap = 'butt';
    var n = 8, cw = w / n;
    for (var i = 0; i < n; i++) {
      var x0 = i * cw + cw * 0.18, y0 = h * 0.26, s0 = cw * 0.62, hh = h * 0.48;
      x.beginPath();
      x.moveTo(x0, y0 + hh);
      x.lineTo(x0, y0);
      x.lineTo(x0 + s0, y0);
      x.lineTo(x0 + s0, y0 + hh * 0.62);
      x.lineTo(x0 + s0 * 0.42, y0 + hh * 0.62);
      x.stroke();
    }
    return o.c;
  }

  // 斜方格（备用）
  function motifHatch(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);
    var gap = h / 7;
    x.strokeStyle = '#fff';
    x.lineWidth = Math.max(1.4, h * 0.030);
    for (var i = -w; i < w * 2; i += gap) {
      x.beginPath(); x.moveTo(i, 0); x.lineTo(i + h, h); x.stroke();
      x.beginPath(); x.moveTo(i, h); x.lineTo(i + h, 0); x.stroke();
    }
    return o.c;
  }

  // 开光内的走金松枝（绿通道 = 金）
  function motifPineRoundel(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);

    // 银边双圈（白）
    x.strokeStyle = '#fff';
    x.lineWidth = w * 0.014;
    x.beginPath(); x.arc(w / 2, h / 2, w * 0.455, 0, Math.PI * 2); x.stroke();
    x.lineWidth = w * 0.006;
    x.beginPath(); x.arc(w / 2, h / 2, w * 0.418, 0, Math.PI * 2); x.stroke();

    // 金松：主干 + 枝 + 针簇
    var GOLD = 'rgb(0,224,0)';
    x.strokeStyle = GOLD; x.lineCap = 'round';

    // 主干（S 形）
    x.lineWidth = w * 0.030;
    x.beginPath();
    x.moveTo(w * 0.30, h * 0.80);
    x.bezierCurveTo(w * 0.33, h * 0.62, w * 0.26, h * 0.52, w * 0.36, h * 0.40);
    x.stroke();

    // 枝
    x.lineWidth = w * 0.016;
    [[0.36, 0.40, 0.66, 0.30], [0.36, 0.40, 0.52, 0.62], [0.31, 0.62, 0.20, 0.52],
     [0.31, 0.62, 0.24, 0.72], [0.66, 0.30, 0.76, 0.24]].forEach(function (b) {
      x.beginPath();
      x.moveTo(w * b[0], h * b[1]);
      x.lineTo(w * b[2], h * b[3]);
      x.stroke();
    });

    // 针簇：以扇形短针代替叶
    function needle(cx, cy, rad, dir) {
      x.lineWidth = w * 0.008;
      for (var i = 0; i < 13; i++) {
        var a = dir - 1.15 + (i / 12) * 2.3;
        x.beginPath();
        x.moveTo(cx, cy);
        x.lineTo(cx + Math.cos(a) * rad, cy + Math.sin(a) * rad);
        x.stroke();
      }
    }
    needle(w * 0.68, h * 0.29, w * 0.075, -0.35);
    needle(w * 0.60, h * 0.36, w * 0.070, -0.9);
    needle(w * 0.50, h * 0.50, w * 0.068, -0.4);
    needle(w * 0.26, h * 0.56, w * 0.062, 2.5);
    needle(w * 0.24, h * 0.72, w * 0.058, 1.5);
    needle(w * 0.78, h * 0.24, w * 0.055, -0.1);

    // 松果点
    x.fillStyle = GOLD;
    x.beginPath(); x.arc(w * 0.40, h * 0.45, w * 0.020, 0, Math.PI * 2); x.fill();

    return o.c;
  }

  // 盖面云纹 + 银边镂空
  function motifCloud(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);

    // 云卷：连续 S 形带 + 卷头
    x.strokeStyle = '#fff'; x.lineCap = 'round';
    for (var k = 0; k < 4; k++) {
      var cy = h * (0.14 + k * 0.21);
      x.lineWidth = Math.max(2, h * 0.020);
      x.beginPath();
      x.moveTo(-w * 0.05, cy);
      x.bezierCurveTo(w * 0.20, cy - h * 0.075, w * 0.34, cy + h * 0.070, w * 0.56, cy - h * 0.010);
      x.bezierCurveTo(w * 0.74, cy - h * 0.070, w * 0.86, cy + h * 0.062, w * 1.05, cy + h * 0.008);
      x.stroke();

      x.lineWidth = Math.max(1.6, h * 0.014);
      for (var c = 0; c < 2; c++) {
        var cxp = w * (0.26 + c * 0.44), cyp = cy - h * 0.020;
        x.beginPath();
        x.arc(cxp, cyp, h * 0.040, 0.6, 5.2);
        x.stroke();
      }
    }

    // 镂空：黑心 + 银边（读起来像被錾开的气孔）
    [[0.50, 0.30, 0.085, 0.070], [0.18, 0.56, 0.070, 0.058],
     [0.78, 0.58, 0.075, 0.062], [0.42, 0.84, 0.062, 0.050]].forEach(function (b) {
      var cx = w * b[0], cy = h * b[1], rx = w * b[2], ry = h * b[3];
      x.save();
      x.beginPath(); x.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
      x.fillStyle = '#000'; x.fill();
      x.lineWidth = Math.max(2, h * 0.016);
      x.strokeStyle = '#fff'; x.stroke();
      x.restore();
    });

    return o.c;
  }

  /* 九龙缠绕：几条粗细不一的 S 形银线绕腹盘绕，线侧缀鳞点，
     首端收一个小回勾作龙首。留白多于纹样——乌铜走银讲究的就是这个。 */
  function motifCoiledDragon(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);
    x.strokeStyle = '#fff'; x.lineCap = 'round'; x.lineJoin = 'round';

    var bands = [
      { y: 0.150, amp: 0.072, ph: 0.0, lw: 0.0150, fq: 1.15 },
      { y: 0.285, amp: 0.058, ph: 1.7, lw: 0.0118, fq: 1.55 },
      { y: 0.425, amp: 0.082, ph: 3.4, lw: 0.0172, fq: 0.95 },
      { y: 0.565, amp: 0.056, ph: 5.1, lw: 0.0106, fq: 1.75 },
      { y: 0.705, amp: 0.070, ph: 2.3, lw: 0.0140, fq: 1.30 },
      { y: 0.845, amp: 0.050, ph: 4.2, lw: 0.0098, fq: 1.60 }
    ];

    bands.forEach(function (b) {
      var pts = [];
      for (var i = 0; i <= 140; i++) {
        var u = i / 140;
        var py = h * (b.y
          + Math.sin(u * Math.PI * 2 * b.fq + b.ph) * b.amp
          + Math.sin(u * Math.PI * 5.0 + b.ph * 1.7) * b.amp * 0.20);
        pts.push([w * u, py]);
      }

      x.lineWidth = w * b.lw;
      x.beginPath();
      pts.forEach(function (q, i) { i ? x.lineTo(q[0], q[1]) : x.moveTo(q[0], q[1]); });
      x.stroke();

      /* 鳞点：沿线每隔几段点一对小弧 */
      x.lineWidth = w * b.lw * 0.42;
      for (var k = 10; k < pts.length - 10; k += 14) {
        var a = pts[k - 2], c = pts[k + 2];
        var dx = c[0] - a[0], dy = c[1] - a[1];
        var len = Math.hypot(dx, dy) || 1;
        var nx = -dy / len, ny = dx / len;
        var r0 = w * b.lw * 1.05;
        [-1, 1].forEach(function (sgn) {
          var cx0 = pts[k][0] + nx * r0 * sgn, cy0 = pts[k][1] + ny * r0 * sgn;
          x.beginPath();
          x.arc(cx0, cy0, w * b.lw * 0.60, 0, Math.PI * 1.25);
          x.stroke();
        });
      }

      /* 龙首：尾端一个回勾 + 一点眼 */
      var e0 = pts[pts.length - 1], e1 = pts[pts.length - 14];
      var ang = Math.atan2(e0[1] - e1[1], e0[0] - e1[0]);
      x.lineWidth = w * b.lw * 0.95;
      x.beginPath();
      x.arc(e0[0] - Math.cos(ang) * w * 0.012, e0[1] - Math.sin(ang) * w * 0.012,
            w * b.lw * 2.6, ang - 1.9, ang + 2.3);
      x.stroke();
      x.lineWidth = w * b.lw * 0.55;
      x.beginPath();
      x.arc(e1[0], e1[1] + w * b.lw * 1.1, w * b.lw * 0.75, 0, Math.PI * 2);
      x.stroke();
    });

    return o.c;
  }

  function motifBamboo(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);
    x.strokeStyle = '#fff'; x.lineCap = 'round';

    var nodes = [[0.30, 0.06], [0.62, 0.10], [0.82, 0.16]];
    nodes.forEach(function (n, idx) {
      var cx0 = w * n[0];
      x.lineWidth = w * (0.010 - idx * 0.002);
      x.beginPath(); x.moveTo(cx0, h * 0.98); x.lineTo(cx0, h * n[1]); x.stroke();
      // 竹节
      x.lineWidth = w * 0.004;
      for (var y = h * 0.98; y > h * n[1]; y -= h * 0.13) {
        x.beginPath(); x.moveTo(cx0 - w * 0.016, y); x.lineTo(cx0 + w * 0.016, y); x.stroke();
      }
      // 叶
      x.lineWidth = w * 0.0042;
      for (var l = 0; l < 4; l++) {
        var ly = h * (0.34 + l * 0.13);
        var dir = l % 2 === 0 ? 1 : -1;
        x.beginPath();
        x.moveTo(cx0, ly);
        x.quadraticCurveTo(cx0 + dir * w * 0.10, ly - h * 0.045, cx0 + dir * w * 0.19, ly - h * 0.02);
        x.stroke();
      }
    });
    return o.c;
  }

  function motifRadial(w, h) {
    var o = newCanvas(w, h), x = o.x;
    x.fillStyle = '#000'; x.fillRect(0, 0, w, h);
    x.strokeStyle = '#fff';
    var c = w / 2;
    x.lineWidth = w * 0.012;
    x.beginPath(); x.arc(c, h / 2, w * 0.46, 0, Math.PI * 2); x.stroke();
    x.lineWidth = w * 0.005;
    x.beginPath(); x.arc(c, h / 2, w * 0.40, 0, Math.PI * 2); x.stroke();
    x.beginPath(); x.arc(c, h / 2, w * 0.16, 0, Math.PI * 2); x.stroke();

    for (var i = 0; i < 8; i++) {
      var a = (i / 8) * Math.PI * 2;
      x.lineWidth = w * 0.006;
      x.beginPath();
      x.ellipse(c + Math.cos(a) * w * 0.28, h / 2 + Math.sin(a) * w * 0.28,
        w * 0.075, w * 0.038, a, 0, Math.PI * 2);
      x.stroke();
    }
    return o.c;
  }

  var MOTIF = {
    landscape: motifLandscape,
    lattice: motifLattice,
    flora: motifFlora,
    bamboo: motifBamboo,
    radial: motifRadial
  };

  /* ============================================================
     3. 材质
     ============================================================ */
  var C_SILVER = new T.Color(0xf2f7ff);
  var C_COPPER_FRESH = new T.Color(0xc07a4d);
  var C_COPPER_PATINA = new T.Color(0x080606);

  function craftMaterial(maskCanvas, opt) {
    opt = opt || {};
    var map = texOf(maskCanvas, opt.repeat || false);
    if (opt.repeat) { map.wrapS = map.wrapT = T.RepeatWrapping; map.repeat.set(opt.repeat[0], opt.repeat[1]); }

    var m = new T.MeshStandardMaterial({
      map: map,
      bumpMap: map,
      bumpScale: opt.bumpScale !== undefined ? opt.bumpScale : 0.003,
      metalness: 0.90,
      roughness: 0.32,
      envMapIntensity: 1.82,
      side: opt.side || T.FrontSide
    });

    m.onBeforeCompile = function (sh) {
      sh.uniforms.uSilver = { value: new T.Color().copy(C_SILVER) };
      sh.uniforms.uCopperF = { value: new T.Color().copy(C_COPPER_FRESH) };
      sh.uniforms.uCopperP = { value: new T.Color().copy(C_COPPER_PATINA) };
      sh.uniforms.uPatina = { value: opt.patina !== undefined ? opt.patina : 1 };
      sh.uniforms.uGold = { value: new T.Color(0xc99a52) };
      sh.uniforms.uGoldAmt = { value: opt.gold ? 1 : 0 };
      sh.uniforms.uSilverR = { value: opt.silverRough !== undefined ? opt.silverRough : 0.075 };

      sh.fragmentShader = sh.fragmentShader
        .replace('void main() {', [
          'uniform vec3 uSilver;',
          'uniform vec3 uCopperF;',
          'uniform vec3 uCopperP;',
          'uniform float uPatina;',
          'uniform vec3 uGold;',
          'uniform float uGoldAmt;',
          'uniform float uSilverR;',
          'void main() {'
        ].join('\n'))
        .replace('#include <map_fragment>', [
          '#include <map_fragment>',
          'float mSilver = clamp( diffuseColor.r, 0.0, 1.0 );',
          'float mGold = clamp( diffuseColor.g * ( 1.0 - diffuseColor.r ) * uGoldAmt, 0.0, 1.0 );',
          'vec3 copperCol = mix( uCopperF, uCopperP, uPatina );'
        ].join('\n'))
        .replace('#include <roughnessmap_fragment>',
          'float roughnessFactor = mix( mix( 0.30, 0.46, uPatina ), uSilverR, max( mSilver, mGold * 0.7 ) );')
        .replace('#include <emissivemap_fragment>',
          '#include <emissivemap_fragment>\n  totalEmissiveRadiance += uSilver * mSilver * 0.055 + uGold * mGold * 0.030;')
        .replace('#include <metalnessmap_fragment>', [
          'float metalnessFactor = mix( 0.82, 1.0, max( mSilver, mGold ) );',
          'diffuseColor.rgb = mix( copperCol, uSilver * 1.06, mSilver );',
          'diffuseColor.rgb = mix( diffuseColor.rgb, uGold, mGold );'
        ].join('\n'));
    };
    return m;
  }

  var plainCopper = new T.MeshStandardMaterial({ color: 0x120e0c, metalness: 0.88, roughness: 0.46, envMapIntensity: 1.0 });
  var goldMat = new T.MeshStandardMaterial({ color: 0xb08a4f, metalness: 1.0, roughness: 0.30, envMapIntensity: 1.3 });
  var stoneMat = new T.MeshStandardMaterial({ color: 0x14100d, metalness: 0.1, roughness: 0.95, envMapIntensity: 0.2 });

  /* 台座：不受光材质 + 手绘明暗，避免被聚光打成死白，也让灯光只落在器物上 */
  var plinthSideTex = (function () {
    var o = newCanvas(8, 256), x = o.x;
    var g = x.createLinearGradient(0, 0, 0, 256);
    g.addColorStop(0.00, '#453a30');
    g.addColorStop(0.14, '#2a211a');
    g.addColorStop(0.62, '#14100d');
    g.addColorStop(1.00, '#0a0807');
    x.fillStyle = g; x.fillRect(0, 0, 8, 256);
    return texOf(o.c);
  })();
  var plinthSideMat = new T.MeshBasicMaterial({ map: plinthSideTex });
  var plinthTopMat = new T.MeshBasicMaterial({ color: 0x171310 });
  var plinthEdgeMat = new T.MeshBasicMaterial({ color: 0x0b0908 });
  var PLINTH_MATS = [plinthSideMat, plinthSideMat, plinthTopMat, plinthEdgeMat, plinthSideMat, plinthSideMat];
  var silverMat = new T.MeshStandardMaterial({ color: 0xdde5ef, metalness: 1.0, roughness: 0.20, envMapIntensity: 1.4 });

  /* ============================================================
     4. 房间
     ============================================================ */
  var room = new T.Group();
  scene.add(room);

  var floorStone = new T.Mesh(
    new T.PlaneGeometry(ROOM.w, ROOM.d / 2),
    new T.MeshStandardMaterial({
      map: texOf(makeStoneFloorTex()), metalness: 0.50, roughness: 0.100, envMapIntensity: 1.15
    })
  );
  floorStone.rotation.x = -Math.PI / 2;
  floorStone.position.set(0, 0, ROOM.d / 4);
  room.add(floorStone);

  var floorWood = new T.Mesh(
    new T.PlaneGeometry(ROOM.w, ROOM.d / 2),
    new T.MeshStandardMaterial({
      map: texOf(makeStoneFloorTex()), metalness: 0.50, roughness: 0.100, envMapIntensity: 1.15
    })
  );
  floorWood.rotation.x = -Math.PI / 2;
  floorWood.position.set(0, 0, -ROOM.d / 4);
  room.add(floorWood);

  // 铜条收口：压在屏风基座底下，只在两侧露出一段
  var floorSeam = new T.Mesh(
    new T.BoxGeometry(ROOM.w, 0.012, 0.048),
    new T.MeshStandardMaterial({ color: 0x8a6a3e, metalness: 1.0, roughness: 0.44, envMapIntensity: 0.9 })
  );
  floorSeam.position.set(0, 0.006, 0);
  room.add(floorSeam);

  /* 顶棚：暖白石膏 + 两处圆形藻井
     —— 屏前一口大圆井（双扇吊灯），屏后一口小圆井（星芒吊灯）。
     井是真开洞：洞壁 0.30m 深，井顶压一块旧铜圆盘，洞口压一圈亮口线，
     光从口线里漫出来。抬头才像照片里那口穹顶。 */
  var HALL_CEIL = 4.45;
  var CEIL_HIDE = [];          // 俯视平面时把这一层收起来
  var CEIL_PITS = [
    { x: 0, z: 2.70, r: 2.55 },
    { x: 0, z: -3.20, r: 2.06 }
  ];

  function makePlasterTex() {
    var W = 512, H = 512, o = newCanvas(W, H), x = o.x;
    x.fillStyle = '#cfc7b8'; x.fillRect(0, 0, W, H);
    var r = rand(61);
    for (var i = 0; i < 260; i++) {
      var px = r() * W, py = r() * H, rad = 14 + r() * 90;
      var g = x.createRadialGradient(px, py, 0, px, py, rad);
      var warm = r() > 0.5;
      g.addColorStop(0, warm ? 'rgba(255,250,238,.10)' : 'rgba(118,108,94,.07)');
      g.addColorStop(1, warm ? 'rgba(255,250,238,0)' : 'rgba(118,108,94,0)');
      x.fillStyle = g; x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();
    }
    for (var j = 0; j < 3600; j++) {
      x.fillStyle = r() > 0.5 ? 'rgba(255,255,250,.05)' : 'rgba(96,88,76,.05)';
      x.fillRect(r() * W, r() * H, 1.2, 1.2);
    }
    return o.c;
  }

  var ceilShape = new T.Shape();
  ceilShape.moveTo(-HW, -HD);
  ceilShape.lineTo(HW, -HD);
  ceilShape.lineTo(HW, HD);
  ceilShape.lineTo(-HW, HD);
  ceilShape.closePath();
  CEIL_PITS.forEach(function (p) {
    var hole = new T.Path();
    hole.absarc(p.x, p.z, p.r, 0, Math.PI * 2, true);
    ceilShape.holes.push(hole);
  });
  var ceilGeo = new T.ShapeGeometry(ceilShape, 40);
  (function () {
    var pos = ceilGeo.attributes.position, uv = ceilGeo.attributes.uv;
    for (var i = 0; i < pos.count; i++) {
      uv.setXY(i, (pos.getX(i) + HW) / ROOM.w, (pos.getY(i) + HD) / ROOM.d);
    }
    uv.needsUpdate = true;
  })();

  var ceilTex = texOf(makePlasterTex(), true);
  ceilTex.repeat.set(3, 3);

  var ceil = new T.Mesh(ceilGeo, new T.MeshStandardMaterial({
    map: ceilTex, color: 0xb4ab9c, metalness: 0.02, roughness: 0.95, envMapIntensity: 0.26
  }));
  ceil.rotation.x = Math.PI / 2;
  ceil.position.y = HALL_CEIL;
  room.add(ceil);
  CEIL_HIDE.push(ceil);

  /* 井壁 / 井顶铜盘 / 洞口亮线 */
  var M_PIT_WALL = new T.MeshStandardMaterial({
    color: 0x6d4d2e, metalness: 0.45, roughness: 0.68, envMapIntensity: 0.45, side: T.BackSide
  });
  var M_PIT_RIM = new T.MeshBasicMaterial({ color: 0xf7ead3 });

  function makePitDiscTex() {
    var W = 512, o = newCanvas(W, W), x = o.x;
    var g = x.createRadialGradient(W * 0.5, W * 0.5, 8, W * 0.5, W * 0.5, W * 0.5);
    g.addColorStop(0.00, '#a87b46');
    g.addColorStop(0.35, '#986c3b');
    g.addColorStop(0.72, '#7d5730');
    g.addColorStop(0.92, '#5e4023');
    g.addColorStop(1.00, '#49311b');
    x.fillStyle = g; x.fillRect(0, 0, W, W);

    var r = rand(41);
    for (var i = 0; i < 130; i++) {
      var px = r() * W, py = r() * W, rad = 10 + r() * 100;
      var gg = x.createRadialGradient(px, py, 0, px, py, rad);
      gg.addColorStop(0, r() > 0.5 ? 'rgba(210,168,108,.10)' : 'rgba(66,46,26,.11)');
      gg.addColorStop(1, 'rgba(0,0,0,0)');
      x.fillStyle = gg; x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();
    }
    // 打磨的同心圆
    for (var k = 8; k < W / 2; k += 11) {
      x.strokeStyle = k % 33 === 0 ? 'rgba(232,192,136,.020)' : 'rgba(38,25,13,.020)';
      x.lineWidth = 3;
      x.beginPath(); x.arc(W / 2, W / 2, k, 0, Math.PI * 2); x.stroke();
    }
    return o.c;
  }
  var pitDiscMat = new T.MeshStandardMaterial({
    map: texOf(makePitDiscTex()), metalness: 0.60, roughness: 0.48,
    envMapIntensity: 0.55, emissive: 0x2c1c0d, emissiveIntensity: 0.75
  });

  var M_COVE_WARM = new T.MeshBasicMaterial({
    color: 0xffcf96, transparent: true, opacity: 0.52,
    blending: T.AdditiveBlending, depthWrite: false
  });

  CEIL_PITS.forEach(function (p) {
    var drumH = 0.30;
    var drum = new T.Mesh(new T.CylinderGeometry(p.r, p.r, drumH, 56, 1, true), M_PIT_WALL);
    drum.position.set(p.x, HALL_CEIL + drumH / 2, p.z);
    room.add(drum); CEIL_HIDE.push(drum);

    var disc = new T.Mesh(new T.CircleGeometry(p.r - 0.008, 56), pitDiscMat);
    disc.rotation.x = Math.PI / 2;
    disc.position.set(p.x, HALL_CEIL + drumH, p.z);
    room.add(disc); CEIL_HIDE.push(disc);

    var rim = new T.Mesh(new T.RingGeometry(p.r - 0.150, p.r - 0.004, 64), M_PIT_RIM);
    rim.rotation.x = Math.PI / 2;
    rim.position.set(p.x, HALL_CEIL - 0.006, p.z);
    room.add(rim); CEIL_HIDE.push(rim);

    var warm = new T.Mesh(new T.RingGeometry(p.r - 0.20, p.r - 0.02, 64), M_COVE_WARM);
    warm.rotation.x = Math.PI / 2;
    warm.position.set(p.x, HALL_CEIL + 0.016, p.z);
    room.add(warm); CEIL_HIDE.push(warm);
  });

  /* 筒灯：沿两口井各围一圈，四角再补几盏 */
  var M_DL_RING = new T.MeshStandardMaterial({
    color: 0x9a938a, metalness: 0.65, roughness: 0.42, envMapIntensity: 0.55
  });
  var M_DL_LENS = new T.MeshBasicMaterial({ color: 0xfff4de });
  function addDownlight(px, pz) {
    var ring = new T.Mesh(new T.CylinderGeometry(0.080, 0.080, 0.026, 18, 1, true), M_DL_RING);
    ring.position.set(px, HALL_CEIL - 0.013, pz);
    room.add(ring); CEIL_HIDE.push(ring);
    var lens = new T.Mesh(new T.CircleGeometry(0.057, 18), M_DL_LENS);
    lens.rotation.x = Math.PI / 2;
    lens.position.set(px, HALL_CEIL - 0.027, pz);
    room.add(lens); CEIL_HIDE.push(lens);
  }
  (function () {
    var i, a;
    for (i = 0; i < 10; i++) {
      a = (i / 10) * Math.PI * 2 + 0.26;
      addDownlight(Math.cos(a) * 3.56, 2.70 + Math.sin(a) * 3.56);
    }
    for (i = 0; i < 8; i++) {
      a = (i / 8) * Math.PI * 2 + 0.14;
      addDownlight(Math.cos(a) * 2.92, -3.20 + Math.sin(a) * 2.92);
    }
    [[-4.55, 4.55], [4.55, 4.55], [-4.55, -4.55], [4.55, -4.55],
     [-4.70, 0.30], [4.70, 0.30], [0, 5.92], [0, -5.92]].forEach(function (q) {
      addDownlight(q[0], q[1]);
    });
  })();

  /* 吊灯 A：屏前一对折扇灯（米黄绢面 + 黄铜骨架） */
  function makePleatTex() {
    var W = 512, H = 64, o = newCanvas(W, H), x = o.x;
    for (var i = 0; i < W; i++) {
      var t = Math.abs(Math.sin(i / W * Math.PI * 30));
      var v = 0.58 + t * 0.42;
      x.fillStyle = 'rgb(' + Math.round(248 * v) + ',' + Math.round(228 * v) + ',' + Math.round(188 * v) + ')';
      x.fillRect(i, 0, 1, H);
    }
    var g = x.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0.00, 'rgba(126,94,52,.34)');
    g.addColorStop(0.38, 'rgba(126,94,52,0)');
    g.addColorStop(1.00, 'rgba(255,248,224,.20)');
    x.fillStyle = g; x.fillRect(0, 0, W, H);
    return o.c;
  }
  var fanMat = new T.MeshStandardMaterial({
    map: texOf(makePleatTex()), color: 0xe9d2a6,
    metalness: 0.05, roughness: 0.72,
    emissive: 0xffb469, emissiveIntensity: 0.34,
    side: T.DoubleSide, transparent: true, opacity: 0.93
  });
  var M_BRASS = new T.MeshStandardMaterial({ color: 0xb08a4f, metalness: 0.95, roughness: 0.34, envMapIntensity: 1.05 });
  var M_BULB = new T.MeshBasicMaterial({ color: 0xffe9c2 });

  function mkFanLamp(px, pz, rod, tilt, spin, scale) {
    var g = new T.Group();
    g.position.set(px, HALL_CEIL, pz);
    g.scale.setScalar(scale || 1);

    var canopy = new T.Mesh(new T.CylinderGeometry(0.055, 0.058, 0.032, 18), M_BRASS);
    canopy.position.y = -0.018;
    g.add(canopy);

    var stem = new T.Mesh(new T.CylinderGeometry(0.0075, 0.0075, rod, 8), M_BRASS);
    stem.position.y = -rod / 2 - 0.03;
    g.add(stem);

    var shade = new T.Mesh(
      new T.CylinderGeometry(0.055, 0.60, 0.25, 32, 1, true, 0, Math.PI * 1.34), fanMat
    );
    shade.position.y = -rod - 0.16;
    shade.rotation.set(0, spin, tilt);
    g.add(shade);

    var hub = new T.Mesh(new T.CylinderGeometry(0.048, 0.052, 0.028, 16), M_BRASS);
    hub.position.y = -rod - 0.075;
    g.add(hub);

    var bulb = new T.Mesh(new T.SphereGeometry(0.042, 12, 10), M_BULB);
    bulb.position.y = -rod - 0.155;
    g.add(bulb);

    scene.add(g);
    CEIL_HIDE.push(g);
    return g;
  }
  mkFanLamp(-0.70, 2.92, 0.94, 0.24, -0.55, 1.00);
  mkFanLamp(0.72, 2.64, 0.76, -0.22, 0.62, 0.90);

  var fanLight = new T.SpotLight(0xffcb96, 2.4, 9.0, 1.05, 1.0, 1.5);
  fanLight.position.set(0.02, HALL_CEIL - 0.90, 2.72);
  fanLight.target.position.set(0.02, 0, 2.10);
  scene.add(fanLight, fanLight.target);

  /* 吊灯 B：屏后星芒灯（黄铜细杆 + 末端小灯） */
  var M_TIP = new T.MeshBasicMaterial({ color: 0xffeeca });
  function mkStarLamp(px, pz) {
    var topY = HALL_CEIL + 0.30, hubY = topY - 0.34;
    var g = new T.Group();

    var stem = new T.Mesh(new T.CylinderGeometry(0.007, 0.007, 0.34, 8), M_BRASS);
    stem.position.set(px, topY - 0.17, pz);
    g.add(stem);

    var hub = new T.Mesh(new T.CylinderGeometry(0.080, 0.098, 0.036, 22), M_BRASS);
    hub.position.set(px, hubY, pz);
    g.add(hub);

    var frost = new T.Mesh(new T.CircleGeometry(0.14, 24), M_BULB);
    frost.rotation.x = Math.PI / 2;
    frost.position.set(px, hubY - 0.022, pz);
    g.add(frost);

    var arms = 16;
    for (var i = 0; i < arms; i++) {
      var a = (i / arms) * Math.PI * 2;
      var len = 0.46 + (i % 2) * 0.09;
      var arm = new T.Mesh(new T.CylinderGeometry(0.0045, 0.0045, len, 6), M_BRASS);
      arm.position.set(px + Math.cos(a) * len * 0.5, hubY - 0.035 - (i % 2) * 0.03, pz + Math.sin(a) * len * 0.5);
      arm.rotation.set(0, -a, Math.PI / 2);
      g.add(arm);

      var tip = new T.Mesh(new T.SphereGeometry(0.015, 8, 6), M_TIP);
      tip.position.set(px + Math.cos(a) * len, hubY - 0.035 - (i % 2) * 0.03, pz + Math.sin(a) * len);
      g.add(tip);
    }
    scene.add(g);
    CEIL_HIDE.push(g);

    var pl = new T.PointLight(0xffd7a2, 1.1, 6.0, 2.2);
    pl.position.set(px, hubY - 0.34, pz);
    scene.add(pl);
  }
  mkStarLamp(0, -3.20);
  /* 柔边光条：中间实、两端和上下渐隐。
     发光面如果是一块硬边纯白，转视角时边缘会在"白"和"黑"之间逐帧跳；
     渐隐之后跨像素也是连续过渡，看着就是一片稳定的光。 */
  function softStripTexture(w, h, power) {
    var o = newCanvas(256, 64), x = o.x;
    x.clearRect(0, 0, 256, 64);
    x.save();
    x.translate(128, 32);
    x.scale(1, 0.25);
    var g = x.createRadialGradient(0, 0, 0, 0, 0, 128);
    g.addColorStop(0.00, 'rgba(255,255,255,1)');
    g.addColorStop(power || 0.55, 'rgba(255,255,255,.86)');
    g.addColorStop(0.86, 'rgba(255,255,255,.24)');
    g.addColorStop(1.00, 'rgba(255,255,255,0)');
    x.fillStyle = g;
    x.beginPath(); x.arc(0, 0, 128, 0, Math.PI * 2); x.fill();
    x.restore();
    return o.c;
  }

  /* 顶棚灯带：不再只靠贴图上的假灯槽，做一圈真的发光条，把厅内基础照度抬起来 */
  var coveSoftDim = texOf(softStripTexture(256, 64, 0.36));
  var M_COVE_DIM = new T.MeshBasicMaterial({
    map: coveSoftDim, color: 0xf2d7b2, transparent: true, depthWrite: false
  });
  // 四边灯槽：沿墙顶一圈暖光条，洗墙的光源在视觉上有了出处
  function coveRibbon(w, d, px, pz) {
    var c = new T.Mesh(new T.PlaneGeometry(w, d), M_COVE_DIM);
    c.rotation.x = Math.PI / 2;
    c.position.set(px, HALL_CEIL - 0.03, pz);
    room.add(c);
  }
  coveRibbon(ROOM.w - 0.18, 0.17, 0, -HD + 0.10);
  coveRibbon(ROOM.w - 0.18, 0.17, 0, HD - 0.10);
  coveRibbon(0.17, ROOM.d - 0.18, -HW + 0.10, 0);
  coveRibbon(0.17, ROOM.d - 0.18, HW - 0.10, 0);

  var wallTexBase = makeWallTex();
  function wallMat(len) {
    var t = texOf(wallTexBase, true);
    t.wrapS = t.wrapT = T.RepeatWrapping;
    t.repeat.set(len / 2.4, 1);
    return new T.MeshStandardMaterial({ map: t, metalness: 0.38, roughness: 0.58, envMapIntensity: 1.10 });
  }

  /* 局部墙片（门楣 / 梁上墙）：同一张墙贴图按真实高度与横向位置取切片，
     使色阶、微纹与两侧整墙完全对齐，不再出现一块「颜色不一样的板」 */
  function wallMatSlice(len, y0, y1, xLeft) {
    var t = texOf(wallTexBase, true);
    t.wrapS = t.wrapT = T.RepeatWrapping;
    t.repeat.set(len / 2.4, (y1 - y0) / ROOM.h);
    t.offset.set((((xLeft + HW) / 2.4) % 1 + 1) % 1, y0 / ROOM.h);
    return new T.MeshStandardMaterial({ map: t, metalness: 0.38, roughness: 0.58, envMapIntensity: 1.10 });
  }

  function addWall(w, h, pos, rotY) {
    var m = new T.Mesh(new T.PlaneGeometry(w, h), wallMat(w));
    m.position.set(pos[0], h / 2, pos[1]);
    m.rotation.y = rotY;
    room.add(m);
    return m;
  }
  /* 北墙：西侧开一道门，通向下一进的「长廊」（走过门洞即切换场景） */
  var NX = -4.95, NW = 2.40, NH = 2.95;
  addWall(NX - NW / 2 + HW, ROOM.h, [(-HW + NX - NW / 2) / 2, -HD], 0);
  addWall(HW - (NX + NW / 2), ROOM.h, [(NX + NW / 2 + HW) / 2, -HD], 0);
  var nLintel = new T.Mesh(new T.PlaneGeometry(NW, ROOM.h - NH),
    wallMatSlice(NW, NH, ROOM.h, NX - NW / 2));
  nLintel.position.set(NX, NH + (ROOM.h - NH) / 2, -HD);
  room.add(nLintel);
  addWall(ROOM.d, ROOM.h, [-HW, 0], Math.PI / 2);          // 西
  addWall(ROOM.d, ROOM.h, [HW, 0], -Math.PI / 2);          // 东

  // 南墙（带门洞）
  var sideW = HW - DOOR.w / 2;
  addWall(sideW, ROOM.h, [-(DOOR.w / 2 + sideW / 2), HD], Math.PI);
  addWall(sideW, ROOM.h, [(DOOR.w / 2 + sideW / 2), HD], Math.PI);
  var lintel = new T.Mesh(
    new T.PlaneGeometry(DOOR.w, ROOM.h - DOOR.h),
    wallMatSlice(DOOR.w, DOOR.h, ROOM.h, -DOOR.w / 2)
  );
  lintel.position.set(0, DOOR.h + (ROOM.h - DOOR.h) / 2, HD);
  lintel.rotation.y = Math.PI;
  room.add(lintel);

  /* ============================================================
     4a. 北侧门洞 —— 通向长廊
     ------------------------------------------------------------
     厅内是黑铜的暗，长廊是石材的亮。这里只做一件事：
     把门洞做成「里面亮着」的浅龛（深 0.7m），暖光从洞里漫到脚边，
     走进去就切换到长廊。
     ============================================================ */
  var PD = 0.70;                            // 门洞进深
  var PZ1 = -HD - PD;                       // 龛底

  function pbox(w, h, d, px, py, pz, mat) {
    var m = new T.Mesh(new T.BoxGeometry(w, h, d), mat);
    m.position.set(px, py, pz);
    scene.add(m);
    return m;
  }

  /* 门洞内壁：深色石材，不抢光 */
  var M_JAMB = new T.MeshStandardMaterial({ color: 0x0d0b09, roughness: 0.92, metalness: 0.0, envMapIntensity: 0.10 });
  var M_PFLOOR = new T.MeshStandardMaterial({ color: 0x0a0807, roughness: 0.55, metalness: 0.0, envMapIntensity: 0.10 });

  pbox(0.06, NH, PD, NX - NW / 2 + 0.03, NH / 2, -HD - PD / 2, M_JAMB);
  pbox(0.06, NH, PD, NX + NW / 2 - 0.03, NH / 2, -HD - PD / 2, M_JAMB);
  pbox(NW, 0.06, PD, NX, NH - 0.03, -HD - PD / 2, M_JAMB);
  pbox(NW, 0.05, PD, NX, 0.025, -HD - PD / 2, M_PFLOOR);

  /* 厅内一侧的门套，薄薄一圈 */
  pbox(0.10, NH + 0.10, 0.16, NX - NW / 2 - 0.05, (NH + 0.10) / 2, -HD + 0.06, M_JAMB);
  pbox(0.10, NH + 0.10, 0.16, NX + NW / 2 + 0.05, (NH + 0.10) / 2, -HD + 0.06, M_JAMB);
  pbox(NW + 0.20, 0.10, 0.16, NX, NH + 0.05, -HD + 0.06, M_JAMB);

  /* 龛底的光：暖白渐变，暗示「里面还有空间」 */
  var lgC = newCanvas(96, 160), lgx = lgC.x;
  var lgg = lgx.createLinearGradient(0, 0, 0, 160);
  lgg.addColorStop(0.00, '#f6e8ce');
  lgg.addColorStop(0.40, '#eed8b4');
  lgg.addColorStop(0.66, '#dfc7a2');
  lgg.addColorStop(0.70, '#cdb289');
  lgg.addColorStop(1.00, '#b0936c');
  lgx.fillStyle = lgg; lgx.fillRect(0, 0, 96, 160);
  // 地面：比墙略深，暗示洞外还有进深
  var flg = lgx.createLinearGradient(0, 112, 0, 160);
  flg.addColorStop(0, 'rgba(146,118,82,.10)');
  flg.addColorStop(0.30, 'rgba(150,122,86,.22)');
  flg.addColorStop(1, 'rgba(178,150,112,.42)');
  lgx.fillStyle = flg; lgx.fillRect(0, 112, 96, 48);
  lgx.fillStyle = 'rgba(120,96,64,.13)';
  lgx.fillRect(0, 111, 96, 1.5);
  // 两侧的暗边
  var vg = lgx.createLinearGradient(0, 0, 96, 0);
  vg.addColorStop(0, 'rgba(72,54,34,.50)');
  vg.addColorStop(0.13, 'rgba(72,54,34,0)');
  vg.addColorStop(0.87, 'rgba(72,54,34,0)');
  vg.addColorStop(1, 'rgba(72,54,34,.50)');
  lgx.fillStyle = vg; lgx.fillRect(0, 0, 96, 160);

  /* 连通版：龛底整面敞开，穿过门洞直接望见长廊门厅，不再放发光假墙 */
  var IW = 1.55, IH = 2.45;

  /* 门口一小盏：让光漫到厅内地面，成为「这边可以走」的提示 */
  var pDoor = new T.PointLight(0xffdcb2, 1.6, 4.5, 2);
  pDoor.position.set(NX, 1.85, -HD - 0.28);
  scene.add(pDoor);

  /* 门额：只做金字，不做底板，贴在暗墙上最清 */
  function doorPlaqueTex() {
    var W = 900, H = 280, o = newCanvas(W, H), x = o.x;
    x.clearRect(0, 0, W, H);
    x.textAlign = 'center';
    x.textBaseline = 'middle';
    var g = x.createLinearGradient(0, 40, 0, 190);
    g.addColorStop(0.00, '#f4e0b2');
    g.addColorStop(0.46, '#c9a566');
    g.addColorStop(1.00, '#8a6c3a');
    x.fillStyle = g;
    x.font = '600 130px "Songti SC","STSong","SimSun",serif';
    x.fillText('長　廊', W / 2, 118);
    x.strokeStyle = 'rgba(201,165,102,.42)';
    x.lineWidth = 2;
    x.beginPath(); x.moveTo(W / 2 - 176, 186); x.lineTo(W / 2 + 176, 186); x.stroke();
    x.fillStyle = 'rgba(201,165,102,.72)';
    x.font = '400 32px "PingFang SC","Microsoft YaHei",sans-serif';
    x.fillText('五 道 工 序 · 石 框 展 窗', W / 2, 226);
    return o.c;
  }
  var dPlaque = new T.Mesh(
    new T.PlaneGeometry(1.52, 0.473),
    new T.MeshBasicMaterial({ map: texOf(doorPlaqueTex()), transparent: true, depthWrite: false })
  );
  dPlaque.position.set(NX, NH + 0.40, -HD + 0.17);
  scene.add(dPlaque);

  /* ============================================================
     4b. 入口门楼 —— 依实景照片复原
     ------------------------------------------------------------
     自下而上：门槛石 / 朱红门套立柱 / 朱红横梁 / 黑地金字匾额
     「烏銅走銀傳習館」/ 万字回纹挂落 / 彩画额枋 / 压檐
     另配：红纱灯笼一对、左柱黑地金联、门内米白吊顶与圆形藻井、
           深色木地板、红绒隔离绳、门口原木墩
     ============================================================ */
  var GZ = HD + 0.04;                       // 门楼平面（相对世界 z）

  /* ---------- 门楼专用贴图 ---------- */
  // 匾额：黑漆地 + 阴刻金字
  function makePlaqueTex() {
    var W = 1664, H = 352, o = newCanvas(W, H), x = o.x;
    var g = x.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0.00, '#1a1511');
    g.addColorStop(0.38, '#0d0b09');
    g.addColorStop(0.72, '#100c09');
    g.addColorStop(1.00, '#191309');
    x.fillStyle = g; x.fillRect(0, 0, W, H);

    // 漆面横向擦痕
    var r = rand(91);
    for (var i = 0; i < 1100; i++) {
      x.fillStyle = r() > 0.55
        ? 'rgba(255,238,206,' + (0.006 + r() * 0.016) + ')'
        : 'rgba(0,0,0,' + (0.02 + r() * 0.05) + ')';
      x.fillRect(r() * W, r() * H, 1 + r() * 34, 1);
    }
    // 上下两道细金线
    x.fillStyle = 'rgba(178,140,82,.62)';
    x.fillRect(0, 9, W, 2.2);
    x.fillRect(0, H - 12, W, 2.2);

    var chars = '烏銅走銀傳習館';
    var n = chars.length;
    var fs = Math.round(H * 0.525);
    var cw = (W - 230) / n;
    x.textAlign = 'center'; x.textBaseline = 'middle';
    x.font = '700 ' + fs + 'px "STKaiti","KaiTi","Kaiti SC","Songti SC","SimSun",serif';

    for (var k = 0; k < n; k++) {
      var cx = 115 + cw * (k + 0.5), cy = H / 2 + 2;
      // 阴刻投影
      x.fillStyle = 'rgba(0,0,0,.92)';
      x.fillText(chars[k], cx + 3, cy + 6);
      // 金漆分层
      var lg = x.createLinearGradient(0, cy - fs * 0.42, 0, cy + fs * 0.42);
      lg.addColorStop(0.00, '#ffeec2');
      lg.addColorStop(0.26, '#e2c083');
      lg.addColorStop(0.50, '#c49c58');
      lg.addColorStop(0.74, '#a37c3d');
      lg.addColorStop(1.00, '#775524');
      x.fillStyle = lg;
      x.fillText(chars[k], cx, cy);
      // 刃口高光
      x.strokeStyle = 'rgba(255,246,214,.20)';
      x.lineWidth = 1.1;
      x.strokeText(chars[k], cx, cy);
    }
    return o.c;
  }

  // 挂落：万字回纹（同时输出色彩图与凹凸图）
  function makeFriezeTex() {
    var W = 2048, H = 232, o = newCanvas(W, H), x = o.x;
    var ob = newCanvas(W, H), bx = ob.x;

    x.fillStyle = '#2a1614'; x.fillRect(0, 0, W, H);
    bx.fillStyle = '#000'; bx.fillRect(0, 0, W, H);

    function stroke(pathFn) {
      x.lineWidth = 3.2; x.strokeStyle = '#b8945a';
      x.beginPath(); pathFn(x); x.stroke();
      bx.lineWidth = 3.2; bx.strokeStyle = '#fff';
      bx.beginPath(); pathFn(bx); bx.stroke();
    }

    // 上下压边
    [12, H - 12].forEach(function (y) {
      stroke(function (c) { c.moveTo(0, y); c.lineTo(W, y); });
    });

    // 连续回纹格
    var cell = 96, ncell = Math.round(W / cell);
    for (var i = 0; i < ncell; i++) {
      var x0 = i * cell + cell / 2, ah = H * 0.28;
      stroke(function (c) {
        var pts = [[-ah, ah], [ah, ah], [ah, -ah], [-ah, -ah], [-ah, ah * 0.34],
                   [ah * 0.36, ah * 0.34], [ah * 0.36, -ah * 0.36]];
        c.moveTo(x0 + pts[0][0], H / 2 + pts[0][1]);
        for (var p = 1; p < pts.length; p++) c.lineTo(x0 + pts[p][0], H / 2 + pts[p][1]);
      });
      // 格间竖棂
      if (i < ncell - 1) {
        stroke(function (c) { c.moveTo(x0 + cell / 2, 24); c.lineTo(x0 + cell / 2, H - 24); });
      }
    }

    // 金色受光渐变
    var gg = x.createLinearGradient(0, 0, 0, H);
    gg.addColorStop(0, 'rgba(255,240,206,.30)');
    gg.addColorStop(0.34, 'rgba(255,240,206,.02)');
    gg.addColorStop(1, 'rgba(0,0,0,.34)');
    x.globalCompositeOperation = 'source-atop';
    x.fillStyle = gg; x.fillRect(0, 0, W, H);
    x.globalCompositeOperation = 'source-over';

    return { map: o.c, bump: ob.c };
  }

  // 额枋彩画：青绿地 + 暗红分段 + 描金卷草花鸟
  function makeCaihuaTex() {
    var W = 2048, H = 208, o = newCanvas(W, H), x = o.x;
    x.fillStyle = '#243029'; x.fillRect(0, 0, W, H);

    // 上下暗红带
    x.fillStyle = '#4c1d19';
    x.fillRect(0, 0, W, 30); x.fillRect(0, H - 30, W, 30);
    x.fillStyle = 'rgba(178,140,82,.55)';
    x.fillRect(0, 30, W, 2); x.fillRect(0, H - 32, W, 2);

    // 卷草：双正弦藤蔓
    x.strokeStyle = '#a8823f'; x.lineCap = 'round';
    for (var lane = 0; lane < 2; lane++) {
      var baseY = H * (0.36 + lane * 0.30);
      x.lineWidth = lane ? 2.2 : 3.4;
      x.beginPath();
      for (var t = 0; t <= 220; t++) {
        var px = (t / 220) * W;
        var py = baseY + Math.sin(t * 0.085 + lane * 1.9) * H * 0.10;
        t ? x.lineTo(px, py) : x.moveTo(px, py);
      }
      x.stroke();
      // 涡卷
      x.lineWidth = 2.0;
      for (var s = 0; s < 26; s++) {
        var cx = (s + 0.5) * (W / 26);
        var cy = baseY + Math.sin((s + 0.5) * (W / 26) / W * 220 * 0.085 + lane * 1.9) * H * 0.10;
        x.beginPath();
        x.arc(cx, cy, H * 0.075, 0, Math.PI * (s % 2 ? 1.6 : 1.4));
        x.stroke();
      }
    }

    // 粉白花簇
    for (var f = 0; f < 13; f++) {
      var fx = (f + 0.5) * (W / 13) + (f % 2 ? 22 : -22);
      var fy = H * (f % 2 ? 0.40 : 0.62);
      x.fillStyle = 'rgba(232,206,206,.85)';
      x.beginPath(); x.arc(fx, fy, H * 0.052, 0, Math.PI * 2); x.fill();
      x.fillStyle = 'rgba(196,150,160,.9)';
      for (var p = 0; p < 5; p++) {
        var a = (p / 5) * Math.PI * 2;
        x.beginPath();
        x.ellipse(fx + Math.cos(a) * H * 0.05, fy + Math.sin(a) * H * 0.05, H * 0.035, H * 0.026, a, 0, Math.PI * 2);
        x.fill();
      }
      x.fillStyle = '#c9a45c';
      x.beginPath(); x.arc(fx, fy, H * 0.018, 0, Math.PI * 2); x.fill();
    }

    // 金鸟（简笔：身 + 双翼 + 长尾）
    function bird(bx0, by0, s, flip) {
      x.save();
      x.translate(bx0, by0); x.scale(flip ? -s : s, s);
      x.fillStyle = '#c8a264';
      x.beginPath(); x.ellipse(0, 0, 26, 11, -0.18, 0, Math.PI * 2); x.fill();
      x.beginPath(); x.arc(24, -5, 7, 0, Math.PI * 2); x.fill();
      x.beginPath(); x.moveTo(28, -5); x.lineTo(38, -2); x.lineTo(28, 0); x.closePath(); x.fill();
      x.beginPath(); x.moveTo(-4, -6); x.quadraticCurveTo(6, -34, 26, -26); x.quadraticCurveTo(8, -18, 6, -2); x.closePath(); x.fill();
      x.beginPath(); x.moveTo(-22, 2); x.quadraticCurveTo(-56, -6, -70, -20); x.quadraticCurveTo(-46, 6, -20, 10); x.closePath(); x.fill();
      x.restore();
    }
    bird(W * 0.20, H * 0.46, 0.95, false);
    bird(W * 0.68, H * 0.54, 0.85, true);

    // 顶部压光
    var gg = x.createLinearGradient(0, 0, 0, H);
    gg.addColorStop(0, 'rgba(255,240,208,.16)');
    gg.addColorStop(0.5, 'rgba(255,240,208,0)');
    gg.addColorStop(1, 'rgba(0,0,0,.26)');
    x.fillStyle = gg; x.fillRect(0, 0, W, H);
    return o.c;
  }

  // 外墙：可平铺的方块石（左右压暗交给灯光与雾）
  function makeFacadeTile() {
    var S = 512, o = newCanvas(S, S), x = o.x;
    var g = x.createLinearGradient(0, 0, 0, S);
    g.addColorStop(0, '#615d55');
    g.addColorStop(0.55, '#4e4b45');
    g.addColorStop(1, '#3c3a35');
    x.fillStyle = g; x.fillRect(0, 0, S, S);

    var r = rand(53);
    for (var i = 0; i < 3200; i++) {
      var a = 0.02 + r() * 0.045;
      x.fillStyle = r() > 0.5 ? 'rgba(240,238,230,' + a + ')' : 'rgba(0,0,0,' + a * 1.7 + ')';
      x.fillRect(r() * S, r() * S, 1 + r() * 3, 1 + r() * 3);
    }
    // 方石分缝（2×2）
    x.strokeStyle = 'rgba(24,23,21,.55)'; x.lineWidth = 3;
    [0, S / 2].forEach(function (p) {
      x.beginPath(); x.moveTo(p + 1, 0); x.lineTo(p + 1, S); x.stroke();
      x.beginPath(); x.moveTo(0, p + 1); x.lineTo(S, p + 1); x.stroke();
    });
    x.strokeStyle = 'rgba(232,230,220,.14)'; x.lineWidth = 1;
    [0, S / 2].forEach(function (p) {
      x.beginPath(); x.moveTo(p + 4, 0); x.lineTo(p + 4, S); x.stroke();
      x.beginPath(); x.moveTo(0, p + 4); x.lineTo(S, p + 4); x.stroke();
    });
    return o.c;
  }
  var facadeTile = makeFacadeTile();
  function facadeMat(w, h, k) {
    var unit = k || 1.9;
    var t = texOf(facadeTile, true);
    t.wrapS = t.wrapT = T.RepeatWrapping;
    t.repeat.set(Math.max(1, Math.round(w / unit)), Math.max(1, Math.round(h / unit)));
    return new T.MeshStandardMaterial({ map: t, metalness: 0.05, roughness: 0.93, envMapIntensity: 0.16 });
  }

  // 门内木地板
  function makeDeckTex() {
    var W = 1024, H = 1024, o = newCanvas(W, H), x = o.x;
    var g = x.createLinearGradient(0, 0, W, H);
    g.addColorStop(0, '#4a3220');
    g.addColorStop(0.5, '#392617');
    g.addColorStop(1, '#2c1e12');
    x.fillStyle = g; x.fillRect(0, 0, W, H);

    var r = rand(77);
    // 板条（横向）
    for (var row = 0; row < 16; row++) {
      var y0 = row * (H / 16);
      var v = 0.82 + r() * 0.30;
      x.fillStyle = 'rgba(255,236,208,' + ((v - 1) * 0.09 + 0.01) + ')';
      x.fillRect(0, y0, W, H / 16);
      // 板缝
      x.fillStyle = 'rgba(0,0,0,.55)';
      x.fillRect(0, y0, W, 2.4);
      // 木纹
      x.strokeStyle = 'rgba(0,0,0,.10)'; x.lineWidth = 1;
      for (var m = 0; m < 6; m++) {
        var yy = y0 + 8 + m * (H / 16 - 10) / 6;
        x.beginPath(); x.moveTo(0, yy + r() * 3);
        for (var t = 1; t <= 24; t++) x.lineTo((t / 24) * W, yy + Math.sin(t * 0.7 + row) * 1.6 + r() * 1.4);
        x.stroke();
      }
      // 错缝
      var cut = ((row * 337) % 100) / 100 * W;
      x.fillStyle = 'rgba(0,0,0,.42)';
      x.fillRect(cut, y0, 2, H / 16);
    }
    return o.c;
  }

  // 红纱灯：竖骨架 + 金色上下箍
  function makeLampTex() {
    var W = 512, H = 256, o = newCanvas(W, H), x = o.x;
    var g = x.createRadialGradient(W / 2, H / 2, 10, W / 2, H / 2, W * 0.62);
    g.addColorStop(0, '#e05a3e');
    g.addColorStop(0.55, '#c33b28');
    g.addColorStop(1, '#8e2418');
    x.fillStyle = g; x.fillRect(0, 0, W, H);
    // 竹骨
    x.strokeStyle = 'rgba(72,20,12,.55)'; x.lineWidth = 2.4;
    for (var i = 0; i <= 16; i++) {
      var px = (i / 16) * W;
      x.beginPath(); x.moveTo(px, 0); x.lineTo(px, H); x.stroke();
    }
    // 上下金箍
    x.fillStyle = '#c9a45c';
    x.fillRect(0, 0, W, 14); x.fillRect(0, H - 14, W, 14);
    x.fillStyle = 'rgba(255,244,214,.35)';
    x.fillRect(0, 0, W, 4); x.fillRect(0, H - 14, W, 3);
    return o.c;
  }

  // 楹联：黑漆地 + 阴刻鎏金 + 落款朱印
  function makeCoupletTex(text, sub) {
    var W = 336, H = 2176, o = newCanvas(W, H), x = o.x;

    // 黑漆底（横向有极轻的漆色差）
    var g = x.createLinearGradient(0, 0, W, 0);
    g.addColorStop(0.00, '#080706');
    g.addColorStop(0.30, '#100c09');
    g.addColorStop(0.68, '#0d0a08');
    g.addColorStop(1.00, '#060505');
    x.fillStyle = g; x.fillRect(0, 0, W, H);

    // 漆面擦痕 + 洒金
    var r = rand(137);
    for (var i = 0; i < 5200; i++) {
      var a = 0.008 + r() * 0.026;
      x.fillStyle = r() > 0.74
        ? 'rgba(216,178,114,' + (a * 1.7) + ')'
        : 'rgba(0,0,0,' + (a * 2.2) + ')';
      x.fillRect(r() * W, r() * H, 1 + r() * 3.6, 1 + r() * 1.8);
    }

    // 双道金边
    x.strokeStyle = 'rgba(196,154,92,.86)'; x.lineWidth = 5;
    x.strokeRect(10, 10, W - 20, H - 20);
    x.strokeStyle = 'rgba(120,92,54,.48)'; x.lineWidth = 1.6;
    x.strokeRect(21, 21, W - 42, H - 42);

    // 四角回纹角花
    x.strokeStyle = 'rgba(198,158,92,.78)'; x.lineWidth = 3.2;
    [[10, 10, 1, 1], [W - 10, 10, -1, 1], [10, H - 10, 1, -1], [W - 10, H - 10, -1, -1]]
      .forEach(function (c) {
        x.save();
        x.translate(c[0], c[1]); x.scale(c[2], c[3]);
        x.beginPath();
        x.moveTo(3, 58); x.lineTo(3, 3); x.lineTo(58, 3);
        x.moveTo(15, 58); x.lineTo(15, 15); x.lineTo(58, 15);
        x.moveTo(27, 58); x.lineTo(27, 27); x.lineTo(58, 27);
        x.stroke();
        x.restore();
      });

    // 主字：七个大字，阴刻鎏金
    var n = text.length;
    var top = 152, bot = H - 300;
    var fs = Math.min(Math.round((bot - top) / n * 0.90), 232);
    var step = (bot - top) / n;
    var CX = 128;
    x.textAlign = 'center'; x.textBaseline = 'middle';
    x.font = '700 ' + fs + 'px "STKaiti","KaiTi","Kaiti SC","Kaiti TC",serif';

    for (var k = 0; k < n; k++) {
      var cy = top + step * (k + 0.5);
      // 阴刻凹槽
      x.fillStyle = 'rgba(0,0,0,.95)';
      x.fillText(text[k], CX + 2, cy + 7);
      // 鎏金分层
      var lg = x.createLinearGradient(0, cy - fs * 0.46, 0, cy + fs * 0.46);
      lg.addColorStop(0.00, '#fff0c8');
      lg.addColorStop(0.20, '#e8c98d');
      lg.addColorStop(0.44, '#cfa661');
      lg.addColorStop(0.70, '#a98244');
      lg.addColorStop(1.00, '#765324');
      x.fillStyle = lg;
      x.fillText(text[k], CX, cy);
      // 刀口高光
      x.strokeStyle = 'rgba(255,246,214,.16)'; x.lineWidth = 1.2;
      x.strokeText(text[k], CX, cy);
    }

    // 落款：外侧小字竖排
    x.font = '400 23px "STKaiti","KaiTi","Kaiti SC",serif';
    x.fillStyle = 'rgba(198,162,102,.84)';
    var SX = 282, sy = H - 820;
    for (var j = 0; j < sub.length; j++) {
      if (sub[j] === ' ') { sy += 22; continue; }
      x.fillText(sub[j], SX, sy);
      sy += 33;
    }

    // 朱印
    x.save();
    x.translate(SX, H - 250);
    x.fillStyle = 'rgba(150,34,28,.90)';
    x.fillRect(-25, -25, 50, 50);
    x.strokeStyle = 'rgba(255,222,196,.50)'; x.lineWidth = 1.8;
    x.strokeRect(-25, -25, 50, 50);
    x.fillStyle = 'rgba(255,234,216,.90)';
    x.font = '700 19px "STKaiti","KaiTi",serif';
    x.fillText('烏', 0, -11); x.fillText('銅', 0, 12);
    x.restore();

    return o.c;
  }

  // 朱红大漆木
  function makeRedWoodTex() {
    var W = 256, H = 1024, o = newCanvas(W, H), x = o.x;
    // 均匀底色（明暗交给灯光，避免每个面都出现一条亮带）
    x.fillStyle = '#6b1e24'; x.fillRect(0, 0, W, H);
    var vg = x.createLinearGradient(0, 0, 0, H);
    vg.addColorStop(0.00, 'rgba(0,0,0,.22)');
    vg.addColorStop(0.18, 'rgba(0,0,0,0)');
    vg.addColorStop(0.82, 'rgba(0,0,0,0)');
    vg.addColorStop(1.00, 'rgba(0,0,0,.20)');
    x.fillStyle = vg; x.fillRect(0, 0, W, H);

    var r = rand(41);
    for (var i = 0; i < 74; i++) {
      x.strokeStyle = 'rgba(0,0,0,' + (0.03 + r() * 0.055) + ')';
      x.lineWidth = 0.6 + r() * 1.7;
      var px = r() * W;
      x.beginPath(); x.moveTo(px, 0);
      for (var t = 1; t <= 12; t++) x.lineTo(px + Math.sin(t * 0.9 + i) * 2.4, (t / 12) * H);
      x.stroke();
    }
    for (var j = 0; j < 26; j++) {
      x.strokeStyle = 'rgba(255,196,170,' + (0.016 + r() * 0.026) + ')';
      x.lineWidth = 0.8;
      var qx = r() * W;
      x.beginPath(); x.moveTo(qx, 0); x.lineTo(qx + r() * 4, H); x.stroke();
    }
    for (var k = 0; k < 44; k++) {
      x.fillStyle = r() > 0.5
        ? 'rgba(255,215,190,' + (0.006 + r() * 0.012) + ')'
        : 'rgba(0,0,0,' + (0.02 + r() * 0.03) + ')';
      x.beginPath();
      x.ellipse(r() * W, r() * H, 18 + r() * 58, 6 + r() * 22, 0, 0, Math.PI * 2);
      x.fill();
    }
    return o.c;
  }
  var redWoodTex = texOf(makeRedWoodTex(), true);
  redWoodTex.repeat.set(1, 1.5);

  /* ---------- 门楼材质 ---------- */
  var M_RED = new T.MeshStandardMaterial({ map: redWoodTex, metalness: 0.12, roughness: 0.60, envMapIntensity: 0.38 });
  var M_RED_DK = new T.MeshStandardMaterial({ color: 0x43151a, metalness: 0.08, roughness: 0.74, envMapIntensity: 0.30 });
  var M_GOLD = new T.MeshStandardMaterial({ color: 0xb08a4f, metalness: 0.95, roughness: 0.34, emissive: 0x2c2010, emissiveIntensity: 1.0, envMapIntensity: 1.2 });
  var M_GOLD_DK = new T.MeshStandardMaterial({ color: 0x7a5c32, metalness: 0.9, roughness: 0.48, emissive: 0x160f06, envMapIntensity: 0.9 });
  var M_STONE_L = new T.MeshStandardMaterial({ color: 0x4b4842, metalness: 0.04, roughness: 0.94, envMapIntensity: 0.3 });

  var gatePlaqueTex = texOf(makePlaqueTex());
  var M_PLAQUE_F = new T.MeshStandardMaterial({ map: gatePlaqueTex, metalness: 0.30, roughness: 0.44, envMapIntensity: 0.8, bumpMap: gatePlaqueTex, bumpScale: 0.006 });
  var M_PLAQUE_B = new T.MeshStandardMaterial({ color: 0x14100c, metalness: 0.20, roughness: 0.70 });

  var frieze = makeFriezeTex();
  var friezeMap = texOf(frieze.map), friezeBump = texOf(frieze.bump);
  var M_FRIEZE = new T.MeshStandardMaterial({ map: friezeMap, bumpMap: friezeBump, bumpScale: 0.012, metalness: 0.62, roughness: 0.46, emissive: 0x120d05, envMapIntensity: 0.9 });

  var caihuaTex = texOf(makeCaihuaTex());
  var M_CAIHUA = new T.MeshStandardMaterial({ map: caihuaTex, metalness: 0.25, roughness: 0.70, envMapIntensity: 0.5 });

  var deckTex = texOf(makeDeckTex(), true);
  deckTex.repeat.set(2, 2.2);
  var M_DECK = new T.MeshStandardMaterial({ map: deckTex, metalness: 0.30, roughness: 0.26, envMapIntensity: 1.0 });

  var lampTex = texOf(makeLampTex());
  var M_LAMP = new T.MeshStandardMaterial({
    map: lampTex, emissiveMap: lampTex, emissive: 0xffffff, emissiveIntensity: 0.52,
    metalness: 0.0, roughness: 0.82, transparent: true, opacity: 0.96
  });

  var M_PLASTER = new T.MeshStandardMaterial({ color: 0xd6cfc0, metalness: 0.02, roughness: 0.95, envMapIntensity: 0.25 });

  var gate = new T.Group();
  gate.position.set(0, 0, GZ);
  scene.add(gate);

  // 带正面贴图的板（+Z 为正面）
  function plaqueBox(w, h, d, front, back, side) {
    var e = side || M_RED_DK;
    return new T.Mesh(new T.BoxGeometry(w, h, d), [e, e, e, e, front, back || e]);
  }

  /* ---------- A. 外墙（门洞四周） ---------- */
  var FACE_Z = 0.30;               // 外墙前表面
  var FT = 0.34, FZ = FACE_Z - FT / 2;
  [-1, 1].forEach(function (s) {
    var wSide = HW - DOOR.w / 2;
    var m = new T.Mesh(new T.BoxGeometry(wSide, ROOM.h, FT), facadeMat(wSide, ROOM.h));
    m.position.set(s * (DOOR.w / 2 + wSide / 2), ROOM.h / 2, FZ);
    gate.add(m);
  });
  var facadeTop = new T.Mesh(new T.BoxGeometry(DOOR.w, ROOM.h - DOOR.h, FT), facadeMat(DOOR.w, ROOM.h - DOOR.h));
  facadeTop.position.set(0, DOOR.h + (ROOM.h - DOOR.h) / 2, FZ);
  gate.add(facadeTop);

  // 外墙上沿口（压顶）
  var cornice = new T.Mesh(new T.BoxGeometry(HW * 2, 0.16, 0.62), M_GOLD_DK);
  cornice.position.set(0, ROOM.h - 0.05, FACE_Z + 0.02);
  gate.add(cornice);

  /* ---------- B. 门套立柱（朱红，凸出墙面） ---------- */
  var COL_W = 0.42, COL_D = 0.36;
  var COL_Z = FACE_Z + COL_D / 2;
  [-1, 1].forEach(function (s) {
    var col = new T.Mesh(new T.BoxGeometry(COL_W, DOOR.h, COL_D), M_RED);
    col.position.set(s * (DOOR.w / 2 + COL_W / 2), DOOR.h / 2, COL_Z);
    gate.add(col);

    // 柱础
    var base = new T.Mesh(new T.BoxGeometry(COL_W + 0.10, 0.22, COL_D + 0.10), M_STONE_L);
    base.position.set(s * (DOOR.w / 2 + COL_W / 2), 0.11, COL_Z);
    gate.add(base);

    // 柱头金箍
    var cap = new T.Mesh(new T.BoxGeometry(COL_W + 0.05, 0.075, COL_D + 0.05), M_GOLD);
    cap.position.set(s * (DOOR.w / 2 + COL_W / 2), DOOR.h - 0.045, COL_Z);
    gate.add(cap);
    var cap2 = new T.Mesh(new T.BoxGeometry(COL_W + 0.03, 0.030, COL_D + 0.03), M_GOLD_DK);
    cap2.position.set(s * (DOOR.w / 2 + COL_W / 2), DOOR.h - 0.14, COL_Z);
    gate.add(cap2);

    // 柱中金线
    var line = new T.Mesh(new T.BoxGeometry(0.010, DOOR.h - 0.30, 0.005), M_GOLD_DK);
    line.position.set(s * (DOOR.w / 2 + COL_W / 2) + s * (COL_W / 2 - 0.05), (DOOR.h - 0.30) / 2, COL_Z + COL_D / 2);
    gate.add(line);

    // 柱头花板（绦环板）
    var flor = new T.Mesh(new T.BoxGeometry(COL_W - 0.04, 0.26, 0.016), M_FRIEZE);
    flor.position.set(s * (DOOR.w / 2 + COL_W / 2), 2.83, COL_Z + COL_D / 2 + 0.006);
    gate.add(flor);
    var florFrame = new T.Mesh(new T.BoxGeometry(COL_W - 0.02, 0.014, 0.022), M_GOLD);
    florFrame.position.set(s * (DOOR.w / 2 + COL_W / 2), 2.97, COL_Z + COL_D / 2 + 0.008);
    gate.add(florFrame);

    // 柱脚线脚
    var footTrim = new T.Mesh(new T.BoxGeometry(COL_W + 0.03, 0.028, COL_D + 0.03), M_GOLD_DK);
    footTrim.position.set(s * (DOOR.w / 2 + COL_W / 2), 0.235, COL_Z);
    gate.add(footTrim);
  });

  // 门洞内顶棚（米白，从门外可窥见门厅天花）
  var soffit = new T.Mesh(
    new T.PlaneGeometry(DOOR.w - 0.04, 0.62),
    new T.MeshStandardMaterial({ color: 0xcac2b1, metalness: 0.02, roughness: 0.96, side: T.DoubleSide, envMapIntensity: 0.2 })
  );
  soffit.rotation.x = Math.PI / 2;
  soffit.position.set(0, DOOR.h - 0.015, FACE_Z - 0.32);
  gate.add(soffit);

  // 门洞内沿：朱红门套
  [-1, 1].forEach(function (s) {
    var rev = new T.Mesh(new T.BoxGeometry(0.11, DOOR.h, 0.68), M_RED);
    rev.position.set(s * (DOOR.w / 2 - 0.055), DOOR.h / 2, FACE_Z - 0.34);
    gate.add(rev);
    // 门套金线
    var revLine = new T.Mesh(new T.BoxGeometry(0.016, DOOR.h - 0.06, 0.012), M_GOLD);
    revLine.position.set(s * (DOOR.w / 2 - 0.055), DOOR.h / 2, FACE_Z - 0.02);
    gate.add(revLine);
    // 门套上端收头
    var revCap = new T.Mesh(new T.BoxGeometry(0.13, 0.05, 0.70), M_GOLD_DK);
    revCap.position.set(s * (DOOR.w / 2 - 0.055), DOOR.h - 0.025, FACE_Z - 0.34);
    gate.add(revCap);
  });
  // 门洞上方内沿
  var revTop = new T.Mesh(new T.BoxGeometry(DOOR.w, 0.11, 0.68), M_RED);
  revTop.position.set(0, DOOR.h - 0.055, FACE_Z - 0.34);
  gate.add(revTop);

  /* ---------- C. 横梁 / 匾额 / 挂落 / 彩画枋 ---------- */
  var Y_BEAM0 = DOOR.h;            // 3.15
  var H_BEAM = 0.28;
  var Y_PLAQUE0 = Y_BEAM0 + H_BEAM, H_PLAQUE = 0.82;
  var Y_FRIEZE0 = Y_PLAQUE0 + H_PLAQUE, H_FRIEZE = 0.48;
  var Y_CAI0 = Y_FRIEZE0 + H_FRIEZE, H_CAI = ROOM.h - Y_CAI0 - 0.02;

  // 朱红横梁（匾下）
  var beam = new T.Mesh(new T.BoxGeometry(3.94, H_BEAM, 0.30), M_RED);
  beam.position.set(0, Y_BEAM0 + H_BEAM / 2, FACE_Z + 0.15);
  gate.add(beam);
  // 梁下金线脚
  var beamTrim = new T.Mesh(new T.BoxGeometry(3.96, 0.034, 0.32), M_GOLD);
  beamTrim.position.set(0, Y_BEAM0 + 0.017, FACE_Z + 0.15);
  gate.add(beamTrim);

  // 匾额
  var plaque = plaqueBox(3.92, H_PLAQUE, 0.16, M_PLAQUE_F, M_PLAQUE_B);
  plaque.position.set(0, Y_PLAQUE0 + H_PLAQUE / 2, FACE_Z + 0.08);
  gate.add(plaque);
  // 匾框（四边金条）
  [[0, H_PLAQUE / 2, 3.98, 0.040], [0, -H_PLAQUE / 2, 3.98, 0.040],
   [-1.96, 0, 0.040, H_PLAQUE], [1.96, 0, 0.040, H_PLAQUE]].forEach(function (b) {
    var bar = new T.Mesh(new T.BoxGeometry(b[2], b[3], 0.195), M_GOLD);
    bar.position.set(b[0], Y_PLAQUE0 + H_PLAQUE / 2 + b[1], FACE_Z + 0.08);
    gate.add(bar);
  });
  // 匾下小托（雀替）
  [-1, 1].forEach(function (s) {
    var br = new T.Mesh(new T.BoxGeometry(0.30, 0.16, 0.22), M_GOLD_DK);
    br.position.set(s * 1.72, Y_PLAQUE0 + 0.02, FACE_Z + 0.14);
    gate.add(br);
  });

  // 挂落
  var friezeMesh = plaqueBox(4.66, H_FRIEZE, 0.13, M_FRIEZE, M_RED_DK, M_RED_DK);
  friezeMesh.position.set(0, Y_FRIEZE0 + H_FRIEZE / 2, FACE_Z + 0.065);
  gate.add(friezeMesh);
  // 挂落上下金边
  [0, H_FRIEZE].forEach(function (dy) {
    var e = new T.Mesh(new T.BoxGeometry(4.72, 0.028, 0.16), M_GOLD);
    e.position.set(0, Y_FRIEZE0 + dy, FACE_Z + 0.07);
    gate.add(e);
  });

  // 彩画额枋
  var caihua = plaqueBox(5.72, H_CAI, 0.24, M_CAIHUA, M_RED_DK, M_RED_DK);
  caihua.position.set(0, Y_CAI0 + H_CAI / 2, FACE_Z + 0.12);
  gate.add(caihua);
  // 额枋左右"雀替"收头
  [-1, 1].forEach(function (s) {
    var q = new T.Mesh(new T.BoxGeometry(0.34, H_CAI + 0.10, 0.28), M_RED_DK);
    q.position.set(s * 2.90, Y_CAI0 + H_CAI / 2 - 0.02, FACE_Z + 0.12);
    gate.add(q);
  });

  /* ---------- D. 红纱灯笼一对 ---------- */
  function buildLantern(sx) {
    var L = new T.Group();
    L.position.set(sx * 2.32, 3.46, 1.12);

    // 吊索
    var cord = new T.Mesh(new T.CylinderGeometry(0.019, 0.019, 1.52, 8), M_GOLD_DK);
    cord.position.y = 1.02;
    L.add(cord);

    // 灯身（南瓜形轮廓）
    var pts = [];
    for (var i = 0; i <= 16; i++) {
      var t = i / 16;
      var r = 0.285 * Math.sin(Math.PI * (0.10 + t * 0.84));
      pts.push(new T.Vector2(Math.max(0.060, r), lerp(-0.31, 0.31, t)));
    }
    var body = new T.Mesh(new T.LatheGeometry(pts, 24), M_LAMP);
    L.add(body);

    // 上盖 / 下盖
    var capT = new T.Mesh(new T.CylinderGeometry(0.105, 0.155, 0.080, 16), M_GOLD);
    capT.position.y = 0.325; L.add(capT);
    var capB = new T.Mesh(new T.CylinderGeometry(0.155, 0.105, 0.080, 16), M_GOLD);
    capB.position.y = -0.325; L.add(capB);

    // 灯笼内胆光
    var glow = new T.PointLight(0xff8f4a, 0.95, 2.6, 2.0);
    glow.position.y = 0;
    L.add(glow);

    // 流苏
    var tas = new T.Group();
    tas.position.y = -0.385;
    var knot = new T.Mesh(new T.SphereGeometry(0.045, 10, 8), M_GOLD);
    tas.add(knot);
    for (var k = 0; k < 7; k++) {
      var a = (k / 7) * Math.PI * 2;
      var strand = new T.Mesh(new T.CylinderGeometry(0.008, 0.005, 0.30, 4), M_GOLD_DK);
      strand.position.set(Math.cos(a) * 0.035, -0.16, Math.sin(a) * 0.035);
      strand.rotation.z = Math.cos(a) * 0.10;
      strand.rotation.x = Math.sin(a) * 0.10;
      tas.add(strand);
    }
    L.add(tas);
    return L;
  }
  gate.add(buildLantern(-1));
  gate.add(buildLantern(1));

  /* ---------- E. 左右楹联（一副七言） ---------- */
  function coupletBoard(side, text, sub) {
    var grp = new T.Group();

    var mat = new T.MeshStandardMaterial({
      map: texOf(makeCoupletTex(text, sub)),
      metalness: 0.26, roughness: 0.46, envMapIntensity: 0.85
    });
    var board = plaqueBox(0.42, 2.72, 0.05, mat, M_RED_DK, M_RED_DK);
    grp.add(board);

    // 四面实木金漆包边（比贴图更立得住）
    [[0, 1.375, 0.47, 0.036], [0, -1.375, 0.47, 0.036],
     [-0.217, 0, 0.036, 2.75], [0.217, 0, 0.036, 2.75]].forEach(function (b) {
      var bar = new T.Mesh(new T.BoxGeometry(b[2], b[3], 0.066), M_GOLD_DK);
      bar.position.set(b[0], b[1], 0.002);
      grp.add(bar);
      var edge = new T.Mesh(new T.BoxGeometry(b[2] * 0.97, Math.max(0.008, b[3] * 0.16), 0.070), M_GOLD);
      edge.position.set(b[0], b[1] + (b[3] > b[2] ? 0 : (b[1] > 0 ? -b[3] * 0.34 : b[3] * 0.34)), 0.003);
      grp.add(edge);
    });

    // 顶部云头
    var yun = new T.Mesh(new T.BoxGeometry(0.30, 0.055, 0.062), M_GOLD_DK);
    yun.position.set(0, 1.392, 0.002);
    grp.add(yun);

    // 吊挂金钩
    [-0.13, 0.13].forEach(function (xx) {
      var hook = new T.Mesh(new T.BoxGeometry(0.020, 0.085, 0.062), M_GOLD_DK);
      hook.position.set(xx, 1.442, -0.028);
      grp.add(hook);
    });

    grp.position.set(side * 2.24, 1.94, FACE_Z + 0.055);
    gate.add(grp);
  }

  coupletBoard(1, '改革開放春風動', '歲次甲申仲秋　滇南匠人題');
  coupletBoard(-1, '烏銅技藝得新生', '烏銅走銀傳習館主人書');

  /* ---------- F. 门槛石 ---------- */
  var sillStone = new T.Mesh(new T.BoxGeometry(DOOR.w, 0.13, 0.42), M_STONE_L);
  sillStone.position.set(0, 0.065, 0.06);
  gate.add(sillStone);

  /* ---------- G. 门内：木地板 / 吊顶 / 藻井 ---------- */
  var DECK = { w: 3.6, d: 1.25, y: 0.014 };
  var deck = new T.Mesh(new T.PlaneGeometry(DECK.w, DECK.d), M_DECK);
  deck.rotation.x = -Math.PI / 2;
  deck.position.set(0, DECK.y, 0.10 - DECK.d / 2);
  gate.add(deck);
  // 铜条收边
  var deckEdge = new T.Mesh(new T.BoxGeometry(DECK.w + 0.06, 0.016, 0.05), M_GOLD_DK);
  deckEdge.position.set(0, DECK.y, 0.10 - DECK.d);
  gate.add(deckEdge);

  // 米白吊顶
  var CEIL_Y = 4.06;
  var ceiling = new T.Mesh(
    new T.PlaneGeometry(DECK.w + 0.5, DECK.d + 0.4),
    new T.MeshStandardMaterial({ color: 0xd4cbb8, metalness: 0.02, roughness: 0.94, side: T.FrontSide, envMapIntensity: 0.2, emissive: 0x2b2620, emissiveIntensity: 1.0 })
  );
  ceiling.rotation.x = Math.PI / 2;
  ceiling.position.set(0, CEIL_Y, 0.10 - (DECK.d + 0.4) / 2);
  gate.add(ceiling);

  // 吊顶井格（细缝，让这块顶面有构造）
  var ceilJointMat = new T.MeshBasicMaterial({ color: 0x8d8474, transparent: true, opacity: 0.35 });
  for (var cj = 1; cj <= 3; cj++) {
    var jl = new T.Mesh(new T.BoxGeometry(DECK.w + 0.4, 0.006, 0.014), ceilJointMat);
    jl.position.set(0, CEIL_Y - 0.004, 0.10 - (DECK.d + 0.4) * (cj / 4));
    gate.add(jl);
  }
  for (var ck = 1; ck <= 2; ck++) {
    var jv = new T.Mesh(new T.BoxGeometry(0.014, 0.006, DECK.d + 0.4), ceilJointMat);
    jv.position.set(-(DECK.w + 0.4) / 2 + (DECK.w + 0.4) * (ck / 3), CEIL_Y - 0.004, 0.10 - (DECK.d + 0.4) / 2);
    gate.add(jv);
  }

  // 吊顶筒灯（发光小圆片）
  var downMat = new T.MeshBasicMaterial({ color: 0xfff0d4 });
  for (var dr = 0; dr < 2; dr++) {
    for (var dc = 0; dc < 3; dc++) {
      var dl = new T.Mesh(new T.CircleGeometry(0.055, 18), downMat);
      dl.rotation.x = Math.PI / 2;
      dl.position.set(-1.1 + dc * 1.1, CEIL_Y - 0.006, 0.10 - 0.55 - dr * 0.85);
      gate.add(dl);
      var dh = new T.Mesh(
        new T.CircleGeometry(0.34, 20),
        new T.MeshBasicMaterial({
          map: poolTexture, color: 0xffd9a8, transparent: true, opacity: 0.22,
          blending: T.AdditiveBlending, depthWrite: false
        })
      );
      dh.rotation.x = Math.PI / 2;
      dh.position.set(-1.1 + dc * 1.1, CEIL_Y - 0.008, 0.10 - 0.55 - dr * 0.85);
      gate.add(dh);
    }
  }

  // 吊顶暗金收边
  [[0, 0.10 + 0.02, DECK.w + 0.5, 0], [0, 0.10 - DECK.d - 0.38, DECK.w + 0.5, 0]].forEach(function (b) {
    var r2 = new T.Mesh(new T.BoxGeometry(b[2], 0.10, 0.09), M_GOLD_DK);
    r2.position.set(b[0], CEIL_Y - 0.05, b[1]);
    gate.add(r2);
  });

  // 藻井
  var domeC = { y: CEIL_Y, z: -0.58, r: 0.56 };
  var cofferWall = new T.Mesh(
    new T.CylinderGeometry(domeC.r, domeC.r * 0.88, 0.30, 48, 1, true),
    new T.MeshStandardMaterial({ color: 0xa79d8a, metalness: 0.02, roughness: 0.96, side: T.BackSide, envMapIntensity: 0.18 })
  );
  cofferWall.position.set(0, domeC.y - 0.15, domeC.z);
  gate.add(cofferWall);

  var cofferTop = new T.Mesh(
    new T.CircleGeometry(domeC.r * 0.88, 48),
    new T.MeshStandardMaterial({ color: 0x9d9382, metalness: 0.03, roughness: 0.96, side: T.FrontSide, envMapIntensity: 0.16 })
  );
  cofferTop.rotation.x = Math.PI / 2;
  cofferTop.position.set(0, domeC.y - 0.30, domeC.z);
  gate.add(cofferTop);

  // 藻井金环
  var cofferRing = new T.Mesh(new T.TorusGeometry(domeC.r * 0.90, 0.022, 8, 56), M_GOLD);
  cofferRing.rotation.x = -Math.PI / 2;
  cofferRing.position.set(0, domeC.y - 0.30, domeC.z);
  gate.add(cofferRing);

  // 金莲花：中心 + 双层花瓣
  var lotus = new T.Group();
  lotus.position.set(0, domeC.y - 0.30, domeC.z);
  var petalMat = new T.MeshStandardMaterial({ color: 0xc9a45c, metalness: 0.86, roughness: 0.38, emissive: 0x1e1508, envMapIntensity: 1.1, side: T.DoubleSide });
  for (var ring = 0; ring < 2; ring++) {
    var cnt = ring ? 12 : 8;
    for (var p = 0; p < cnt; p++) {
      var a = (p / cnt) * Math.PI * 2 + (ring ? Math.PI / cnt : 0);
      var rad = ring ? 0.20 : 0.34;
      var petal = new T.Mesh(new T.SphereGeometry(1, 10, 8), petalMat);
      petal.scale.set(0.055, 0.016, ring ? 0.135 : 0.20);
      petal.position.set(Math.cos(a) * rad, -0.008 - ring * 0.012, Math.sin(a) * rad);
      petal.rotation.y = -a;
      petal.rotation.z = ring ? 0.10 : 0.16;
      lotus.add(petal);
    }
  }
  var lotusCore = new T.Mesh(new T.SphereGeometry(0.13, 14, 10), petalMat);
  lotusCore.scale.y = 0.34;
  lotusCore.position.y = -0.02;
  lotus.add(lotusCore);
  gate.add(lotus);

  // 筒灯一圈
  var lampDiscMat = new T.MeshBasicMaterial({ color: 0xfff0d6 });
  for (var ld = 0; ld < 14; ld++) {
    var la = (ld / 14) * Math.PI * 2;
    var disc = new T.Mesh(new T.CircleGeometry(0.052, 12), lampDiscMat);
    disc.rotation.x = Math.PI / 2;
    disc.position.set(Math.cos(la) * (domeC.r + 0.52), CEIL_Y - 0.004, domeC.z + Math.sin(la) * (domeC.r + 0.52));
    gate.add(disc);
  }
  // 吊顶整体洗光
  var ceilLight = new T.PointLight(0xfff2dd, 1.9, 7.0, 2.0);
  ceilLight.position.set(0, CEIL_Y - 0.42, -0.58);
  gate.add(ceilLight);

  /* ---------- H. 红绒隔离绳（中间留口） ---------- */
  function ropeSegment(x0, x1, z) {
    var gR = new T.Group();
    [x0, x1].forEach(function (px) {
      var post = new T.Mesh(new T.CylinderGeometry(0.030, 0.044, 0.92, 12), M_GOLD);
      post.position.set(px, 0.46, z);
      gR.add(post);
      var ball = new T.Mesh(new T.SphereGeometry(0.055, 14, 10), M_GOLD);
      ball.position.set(px, 0.95, z);
      gR.add(ball);
      var foot = new T.Mesh(new T.CylinderGeometry(0.085, 0.10, 0.035, 16), M_GOLD_DK);
      foot.position.set(px, 0.018, z);
      gR.add(foot);
    });
    var curve = new T.CatmullRomCurve3([
      new T.Vector3(x0, 0.90, z),
      new T.Vector3((x0 + x1) / 2, 0.62, z + 0.02),
      new T.Vector3(x1, 0.90, z)
    ]);
    var rope = new T.Mesh(
      new T.TubeGeometry(curve, 26, 0.026, 8, false),
      new T.MeshStandardMaterial({ color: 0xa8262c, metalness: 0.02, roughness: 0.92, envMapIntensity: 0.3 })
    );
    gR.add(rope);
    return gR;
  }
  gate.add(ropeSegment(-1.42, -0.62, -0.92));
  gate.add(ropeSegment(0.62, 1.42, -0.92));

  /* ---------- I. 门口原木墩 ---------- */
  function buildLog(sx) {
    var geo = new T.CylinderGeometry(0.19, 0.25, 0.56, 11, 2);
    var pos = geo.attributes.position;
    var rr = rand(sx > 0 ? 71 : 33);
    for (var i = 0; i < pos.count; i++) {
      var vx = pos.getX(i), vy = pos.getY(i), vz = pos.getZ(i);
      var f = 1 + (rr() - 0.5) * 0.16;
      pos.setXYZ(i, vx * f, vy * (0.94 + rr() * 0.14), vz * f);
    }
    geo.computeVertexNormals();
    var m = new T.Mesh(geo, new T.MeshStandardMaterial({
      color: 0x4b3623, metalness: 0.06, roughness: 0.95, envMapIntensity: 0.25, flatShading: true
    }));
    m.position.set(sx * 1.16, 0.28, -0.24);
    m.rotation.y = sx * 0.6;
    return m;
  }
  /* 门口原木墩：已按需求删除（用户 2026-11-14 指定） */

  /* ---------- J. 门外：石地 / 台阶 / 檐口 ---------- */
  var outFloor = new T.Mesh(
    new T.PlaneGeometry(13.0, 9.0),
    facadeMat(13.0, 9.0)
  );
  outFloor.rotation.x = -Math.PI / 2;
  outFloor.position.set(0, -0.012, 4.6);
  gate.add(outFloor);

  // 台阶（两级）
  var stepMain = new T.Mesh(new T.BoxGeometry(3.62, 0.10, 0.52), new T.MeshStandardMaterial({ color: 0x55504a, metalness: 0.05, roughness: 0.93, envMapIntensity: 0.30 }));
  stepMain.position.set(0, 0.05, 0.50);
  gate.add(stepMain);
  var stepEdge = new T.Mesh(new T.BoxGeometry(3.66, 0.012, 0.06), new T.MeshStandardMaterial({ color: 0x4a3a22, metalness: 0.8, roughness: 0.6 }));
  stepEdge.position.set(0, 0.104, 0.74);
  gate.add(stepEdge);

  // 檐口（深出门外，形成门廊顶，遮挡上方）
  var M_EAVE = new T.MeshStandardMaterial({ color: 0x120807, metalness: 0.10, roughness: 0.90, envMapIntensity: 0.12 });
  var M_RAFTER = new T.MeshStandardMaterial({ color: 0x1d1710, metalness: 0.3, roughness: 0.78, envMapIntensity: 0.25 });
  var eave = new T.Mesh(new T.BoxGeometry(6.6, 0.16, 5.6), M_EAVE);
  eave.position.set(0, ROOM.h - 0.02, 2.85);
  gate.add(eave);
  var eaveGold = new T.Mesh(new T.BoxGeometry(6.62, 0.038, 0.10), M_GOLD);
  eaveGold.position.set(0, ROOM.h - 0.10, 5.62);
  gate.add(eaveGold);
  // 檐下椽子
  for (var rafter = 0; rafter < 9; rafter++) {
    var rf = new T.Mesh(new T.BoxGeometry(0.055, 0.085, 5.3), M_RAFTER);
    rf.position.set(-3.0 + rafter * 0.75, ROOM.h - 0.172, 2.80);
    gate.add(rf);
  }
  // 檐下两盏小射灯（打亮门脸）
  [-1, 1].forEach(function (s) {
    var spot = new T.SpotLight(0xffe2bc, 1.5, 9.0, 0.62, 0.5, 1.6);
    spot.position.set(s * 2.5, ROOM.h - 0.30, 3.0);
    spot.target.position.set(s * 1.0, 3.9, 0.0);
    gate.add(spot);
    gate.add(spot.target);
  });

  // 门外两侧墙（延伸，形成门廊）
  [-1, 1].forEach(function (s) {
    var side = new T.Mesh(new T.BoxGeometry(0.30, 3.6, 9.2), facadeMat(9.2, 3.6));
    side.position.set(s * 6.3, 1.8, 4.8);
    gate.add(side);
  });

  // 街对面院墙（给门外一个边界，避免望出去是纯黑）
  var courtWall = new T.Mesh(new T.BoxGeometry(12.9, 3.6, 0.34), facadeMat(12.9, 3.6, 1.15));
  courtWall.position.set(0, 1.8, 9.42);
  gate.add(courtWall);
  // 院墙上的两盏壁灯
  [-1, 1].forEach(function (s) {
    var cage = new T.Mesh(new T.BoxGeometry(0.26, 0.42, 0.18), M_GOLD_DK);
    cage.position.set(s * 1.4, 2.35, 9.20);
    gate.add(cage);
    var bulb = new T.Mesh(
      new T.PlaneGeometry(0.18, 0.32),
      new T.MeshBasicMaterial({ color: 0xffd9a0 })
    );
    bulb.position.set(s * 1.4, 2.35, 9.10);
    bulb.rotation.y = Math.PI;
    gate.add(bulb);
  });
  // 院墙前的地脚线
  var courtSkirt = new T.Mesh(new T.BoxGeometry(12.9, 0.30, 0.06), M_RED_DK);
  courtSkirt.position.set(0, 0.15, 9.23);
  gate.add(courtSkirt);

  /* ---------- K. 门楼照明 ---------- */
  var gateKey = new T.PointLight(0xffd9ac, 2.30, 7.0, 2.0);
  gateKey.position.set(0, 3.95, GZ + 1.55);
  scene.add(gateKey);

  var gateFill = new T.PointLight(0xffeedd, 1.10, 6.0, 2.0);
  gateFill.position.set(0, 2.90, HD + 0.30);
  scene.add(gateFill);

  var gateSpill = new T.PointLight(0xffcf9a, 0.70, 4.2, 2.0);
  gateSpill.position.set(0, 2.20, HD - 1.10);
  scene.add(gateSpill);

  /* ---------- 顶部灯槽（发光条） ---------- */
  var coveMat = new T.MeshBasicMaterial({ color: 0xffd7a6, transparent: true, opacity: 0.5 });
  [[0, -HD + 0.5, ROOM.w - 3, 0], [0, HD - 0.5, ROOM.w - 3, 0],
   [-HW + 0.5, 0, ROOM.d - 3, 1], [HW - 0.5, 0, ROOM.d - 3, 1]].forEach(function (c) {
    var g = c[3] === 0
      ? new T.BoxGeometry(c[2], 0.02, 0.10)
      : new T.BoxGeometry(0.10, 0.02, c[2]);
    var m = new T.Mesh(g, coveMat);
    m.position.set(c[0], HALL_CEIL - 0.05, c[1]);
    room.add(m);
  });

  /* ============================================================
     5. 中央影壁：整面乌铜板屏风 + 圈椅陈设
     ------------------------------------------------------------
     实景里那不是折屏，是一整面「铜板影壁」：五列三板拼成，
     四周深色木框，正中一枚旧铜徽记，徽记下方鎏金四字；
     影壁前一对圈椅、一张两屉小几、两只梅瓶 —— 一壁两椅一几，
     进门第一眼就落在它身上。
     ============================================================ */
  var screenGroup = new T.Group();
  scene.add(screenGroup);

  var SW = 5.02, SH = 4.34, ST = 0.30, SB = 0.11;   // SB+SH = 4.45 = HALL_CEIL

  /* --- 做旧黄铜板：斑驳金箔 / 氧化 / 水渍 / 细划痕 ---
     这块墙不是一块光滑镀金板，是锤过的黄铜贴过金箔、几十年没擦：
     暗金 #B8860B 与古铜 #8B4513 交杂，铜绿、紫灰、铁锈一层压一层，
     水渍是带边的椭圆印，划痕细而短、方向大体一致。
     颜色图之外再烘两张线性图：粗糙度（哪块亮哪块哑）与凹凸（拼缝、划痕、水渍）。 */
  var WALL_TEX_W = 2048, WALL_TEX_H = 1756;      // 与 FIELD_W / FIELD_H 同比
  var WALL_COLS = 5, WALL_ROWS = 4;
  var WALL_HALO_Y = 0.412;                       // 徽章在贴图上的纵向位置

  function linTex(c) {
    var t = new T.CanvasTexture(c);
    t.wrapS = t.wrapT = T.ClampToEdgeWrapping;
    t.anisotropy = Math.min(16, renderer.capabilities.getMaxAnisotropy() || 1);
    return t;
  }

  function makeBronzePlateTex() {
    var W = WALL_TEX_W, H = WALL_TEX_H;
    var o = newCanvas(W, H), x = o.x;
    var r = rand(8301);

    x.fillStyle = '#6a4f2c'; x.fillRect(0, 0, W, H);
    var g = x.createLinearGradient(0, 0, W * 0.55, H);
    g.addColorStop(0.00, 'rgba(170,126,56,.56)');
    g.addColorStop(0.34, 'rgba(134,96,46,.42)');
    g.addColorStop(0.68, 'rgba(96,62,32,.34)');
    g.addColorStop(1.00, 'rgba(54,36,19,.56)');
    x.fillStyle = g; x.fillRect(0, 0, W, H);

    /* 三层尺度的斑驳：大团定调、中团破坏、小点做脏 */
    var tones = ['rgba(204,158,80,', 'rgba(152,106,52,', 'rgba(104,68,36,',
                 'rgba(82,64,52,', 'rgba(84,100,82,', 'rgba(44,30,18,'];
    [[62, 220, 520, 0.240], [200, 70, 210, 0.155], [520, 18, 70, 0.100]]
      .forEach(function (cf) {
        for (var i = 0; i < cf[0]; i++) {
          var px = r() * W, py = r() * H, rad = cf[1] + r() * (cf[2] - cf[1]);
          var c = tones[(r() * tones.length) | 0];
          var a = cf[3] * (0.45 + r() * 0.9);
          var gg = x.createRadialGradient(px, py, rad * 0.06, px, py, rad);
          gg.addColorStop(0.00, c + a.toFixed(3) + ')');
          gg.addColorStop(0.60, c + (a * 0.38).toFixed(3) + ')');
          gg.addColorStop(1.00, c + '0)');
          x.fillStyle = gg;
          x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();
        }
      });

    /* 氧化块：边界比大团清楚一点，否则整面墙糊成一片渐变 */
    for (var oi = 0; oi < 64; oi++) {
      var ox = r() * W, oy = r() * H, orad = 40 + r() * 150;
      var oc = ['rgba(58,74,56,', 'rgba(72,58,66,', 'rgba(120,66,34,', 'rgba(38,26,15,'][(r() * 4) | 0];
      var oa = 0.07 + r() * 0.13;
      var og = x.createRadialGradient(ox, oy, 0, ox, oy, orad);
      og.addColorStop(0.00, oc + oa.toFixed(3) + ')');
      og.addColorStop(0.55, oc + (oa * 0.72).toFixed(3) + ')');
      og.addColorStop(0.86, oc + (oa * 0.22).toFixed(3) + ')');
      og.addColorStop(1.00, oc + '0)');
      x.fillStyle = og;
      x.beginPath(); x.arc(ox, oy, orad, 0, Math.PI * 2); x.fill();
    }

    /* 金箔：一层压一层贴上去的，边缘不齐，光下深浅不一 */
    for (var li = 0; li < 26; li++) {
      var lx = r() * W, ly = r() * H;
      var lw = 90 + r() * 320, lh = 60 + r() * 240;
      x.save();
      x.translate(lx, ly);
      x.rotate((r() - 0.5) * 0.6);
      var lg2 = x.createLinearGradient(-lw / 2, -lh / 2, lw / 2, lh / 2);
      var ga = 0.05 + r() * 0.09;
      lg2.addColorStop(0.00, 'rgba(226,180,102,0)');
      lg2.addColorStop(0.35, 'rgba(230,186,108,' + ga.toFixed(3) + ')');
      lg2.addColorStop(0.70, 'rgba(214,166,92,' + (ga * 0.7).toFixed(3) + ')');
      lg2.addColorStop(1.00, 'rgba(200,150,80,0)');
      x.fillStyle = lg2;
      x.beginPath();
      x.moveTo(-lw / 2, -lh / 2 + r() * 20);
      x.lineTo(lw / 2 - r() * 16, -lh / 2);
      x.lineTo(lw / 2, lh / 2 - r() * 18);
      x.lineTo(-lw / 2 + r() * 14, lh / 2);
      x.closePath(); x.fill();
      x.restore();
    }

    /* 水渍：不是一个个正圆，是洇开的不规则印子，只比底色暗一层 */
    for (var wi = 0; wi < 20; wi++) {
      var wx = r() * W, wy = r() * H;
      var wrx = 60 + r() * 170, wry = wrx * (0.30 + r() * 0.50);
      x.save();
      x.translate(wx, wy);
      x.rotate((r() - 0.5) * 1.3);
      var wg = x.createRadialGradient(0, 0, wrx * 0.30, 0, 0, wrx);
      wg.addColorStop(0.00, 'rgba(30,20,11,0)');
      wg.addColorStop(0.72, 'rgba(30,20,11,.065)');
      wg.addColorStop(0.94, 'rgba(24,16,9,.045)');
      wg.addColorStop(1.00, 'rgba(24,16,9,0)');
      x.fillStyle = wg;
      x.beginPath(); x.ellipse(0, 0, wrx, wry, 0, 0, Math.PI * 2); x.fill();
      x.restore();
    }

    /* 竖向水线：从上往下淌过的一道道痕 */
    for (var d = 0; d < 22; d++) {
      var dx = r() * W, dy = r() * H * 0.55, dl = H * (0.18 + r() * 0.45);
      var dg = x.createLinearGradient(0, dy, 0, dy + dl);
      dg.addColorStop(0.00, 'rgba(38,28,16,.26)');
      dg.addColorStop(0.30, 'rgba(38,28,16,.10)');
      dg.addColorStop(1.00, 'rgba(38,28,16,0)');
      x.fillStyle = dg;
      x.fillRect(dx, dy, 2 + r() * 14, dl);
    }

    /* 划痕：短、细、方向散，浅一道深一道 */
    for (var s = 0; s < 1900; s++) {
      var sx = r() * W, sy = r() * H, len = 8 + r() * 54;
      var ang = (r() - 0.5) * 0.55 + (r() > 0.75 ? 1.1 : 0);
      x.strokeStyle = r() > 0.52 ? 'rgba(255,236,198,.030)' : 'rgba(0,0,0,.038)';
      x.lineWidth = 0.8 + r() * 0.7;
      x.beginPath();
      x.moveTo(sx, sy);
      x.lineTo(sx + Math.cos(ang) * len, sy + Math.sin(ang) * len);
      x.stroke();
    }

    /* 拼缝：五列四板，暗缝压一道，右边留一线亮口 */
    var cw = W / WALL_COLS, rh = H / WALL_ROWS;
    for (var ci = 1; ci < WALL_COLS; ci++) {
      var cxp = Math.round(ci * cw);
      x.fillStyle = 'rgba(16,10,5,.70)'; x.fillRect(cxp - 2.5, 0, 5, H);
      x.fillStyle = 'rgba(250,224,176,.22)'; x.fillRect(cxp + 2.5, 0, 1.6, H);
    }
    for (var ri = 1; ri < WALL_ROWS; ri++) {
      var ryp = Math.round(ri * rh);
      x.fillStyle = 'rgba(16,10,5,.70)'; x.fillRect(0, ryp - 2.5, W, 5);
      x.fillStyle = 'rgba(250,224,176,.22)'; x.fillRect(0, ryp + 2.5, W, 1.6);
    }

    /* 洗墙光晕：徽章那一团暖，往四周散开 */
    var hx = W * 0.5, hy = H * WALL_HALO_Y;
    var hg = x.createRadialGradient(hx, hy, H * 0.03, hx, hy, W * 0.56);
    hg.addColorStop(0.00, 'rgba(255,222,164,.20)');
    hg.addColorStop(0.34, 'rgba(246,206,146,.10)');
    hg.addColorStop(0.72, 'rgba(210,160,96,.03)');
    hg.addColorStop(1.00, 'rgba(150,100,50,0)');
    x.fillStyle = hg; x.fillRect(0, 0, W, H);

    /* 上下压深 + 两侧压深：墙边自然暗下去 */
    var tg = x.createLinearGradient(0, 0, 0, H);
    tg.addColorStop(0.00, 'rgba(12,8,4,.15)');
    tg.addColorStop(0.14, 'rgba(12,8,4,.02)');
    tg.addColorStop(0.62, 'rgba(12,8,4,.02)');
    tg.addColorStop(0.88, 'rgba(10,7,4,.14)');
    tg.addColorStop(1.00, 'rgba(8,5,3,.34)');
    x.fillStyle = tg; x.fillRect(0, 0, W, H);

    var vg = x.createLinearGradient(0, 0, W, 0);
    vg.addColorStop(0.00, 'rgba(14,9,5,.62)');
    vg.addColorStop(0.16, 'rgba(14,9,5,.10)');
    vg.addColorStop(0.50, 'rgba(14,9,5,0)');
    vg.addColorStop(0.84, 'rgba(14,9,5,.10)');
    vg.addColorStop(1.00, 'rgba(14,9,5,.62)');
    x.fillStyle = vg; x.fillRect(0, 0, W, H);

    return o.c;
  }

  /* --- 粗糙度图（线性）：打磨过的块面反光强，氧化的块面反光弱 --- */
  function makeBronzeRoughTex() {
    var W = 1024, H = Math.round(W * WALL_TEX_H / WALL_TEX_W);
    var o = newCanvas(W, H), x = o.x;
    var r = rand(5507);
    x.fillStyle = '#8e8e8e'; x.fillRect(0, 0, W, H);       // 0.56 基准

    for (var i = 0; i < 300; i++) {
      var px = r() * W, py = r() * H, rad = 24 + r() * 190;
      var light = r() > 0.52;
      var v = (light ? 72 + r() * 48 : 158 + r() * 70) | 0;
      var gg = x.createRadialGradient(px, py, 0, px, py, rad);
      gg.addColorStop(0, 'rgba(' + v + ',' + v + ',' + v + ',' + (0.18 + r() * 0.30).toFixed(2) + ')');
      gg.addColorStop(1, 'rgba(' + v + ',' + v + ',' + v + ',0)');
      x.fillStyle = gg;
      x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();
    }

    /* 划痕处被磨得更亮 */
    for (var s = 0; s < 900; s++) {
      var sx = r() * W, sy = r() * H, len = 8 + r() * 60;
      x.strokeStyle = 'rgba(118,118,118,.30)';
      x.lineWidth = 1;
      x.beginPath(); x.moveTo(sx, sy); x.lineTo(sx + len, sy + (r() - 0.5) * 2); x.stroke();
    }

    /* 拼缝积灰，最哑 */
    var cw = W / WALL_COLS, rh = H / WALL_ROWS;
    x.fillStyle = '#d8d8d8';
    for (var ci = 1; ci < WALL_COLS; ci++) x.fillRect(Math.round(ci * cw) - 3, 0, 6, H);
    for (var ri = 1; ri < WALL_ROWS; ri++) x.fillRect(0, Math.round(ri * rh) - 3, W, 6);

    return o.c;
  }

  /* --- 凹凸图（线性）：拼缝是沟、划痕是细槽、水渍边微鼓 --- */
  function makeBronzeBumpTex() {
    var W = 1024, H = Math.round(W * WALL_TEX_H / WALL_TEX_W);
    var o = newCanvas(W, H), x = o.x;
    var r = rand(9021);
    x.fillStyle = '#808080'; x.fillRect(0, 0, W, H);

    /* 板上微微起伏（锤打留下的不平） */
    for (var i = 0; i < 220; i++) {
      var px = r() * W, py = r() * H, rad = 40 + r() * 220;
      var v = (r() > 0.5 ? 140 : 118) | 0;
      var gg = x.createRadialGradient(px, py, 0, px, py, rad);
      gg.addColorStop(0, 'rgba(' + v + ',' + v + ',' + v + ',.22)');
      gg.addColorStop(1, 'rgba(' + v + ',' + v + ',' + v + ',0)');
      x.fillStyle = gg;
      x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();
    }

    /* 水渍压出的一圈浅边 */
    for (var wi = 0; wi < 30; wi++) {
      var wx = r() * W, wy = r() * H, wr = 30 + r() * 110;
      x.strokeStyle = 'rgba(150,150,150,.35)'; x.lineWidth = 3;
      x.beginPath(); x.arc(wx, wy, wr, 0, Math.PI * 2); x.stroke();
      x.strokeStyle = 'rgba(105,105,105,.30)'; x.lineWidth = 3;
      x.beginPath(); x.arc(wx, wy, wr - 6, 0, Math.PI * 2); x.stroke();
    }

    /* 划痕 */
    for (var s = 0; s < 1300; s++) {
      var sx = r() * W, sy = r() * H, len = 8 + r() * 70;
      x.strokeStyle = r() > 0.5 ? 'rgba(172,172,172,.24)' : 'rgba(98,98,98,.28)';
      x.lineWidth = 1;
      x.beginPath(); x.moveTo(sx, sy); x.lineTo(sx + len, sy + (r() - 0.5) * 2.4); x.stroke();
    }

    /* 拼缝：深沟 + 一侧倒角 */
    var cw = W / WALL_COLS, rh = H / WALL_ROWS;
    for (var ci = 1; ci < WALL_COLS; ci++) {
      var cxp = Math.round(ci * cw);
      x.fillStyle = '#3a3a3a'; x.fillRect(cxp - 3, 0, 6, H);
      x.fillStyle = '#b0b0b0'; x.fillRect(cxp + 3, 0, 2, H);
    }
    for (var ri = 1; ri < WALL_ROWS; ri++) {
      var ryp = Math.round(ri * rh);
      x.fillStyle = '#3a3a3a'; x.fillRect(0, ryp - 3, W, 6);
      x.fillStyle = '#b0b0b0'; x.fillRect(0, ryp + 3, W, 2);
    }

    return o.c;
  }

  /* --- 正中徽章：与墙面同材质的暗纹浮雕（老匠人像） ---
     不是一枚亮铜牌，是「同一块墙锻出来的一块」：底色与墙一致，
     人像只低低凸起一点，靠倒角吃洗墙光的那一线高光读出来。
     所以颜色图里人像只比底面深一点，真正的立体全靠 bumpMap。
     比例照参考图来：帽檐占圆盘宽 78%，头占 30%，肩几乎撑满 —— 是幅肖像，不是个小图标。 */
  function masterBody() {
    var p = new Path2D();

    /* 帽檐：中段压在额前（会被头挡住，不用管），两端外挑到耳侧、右高左低 */
    p.moveTo(-114, -84);
    p.quadraticCurveTo(-72, -112, -20, -108);
    p.quadraticCurveTo(36, -104, 112, -76);
    p.quadraticCurveTo(50, -92, 2, -94);
    p.quadraticCurveTo(-60, -94, -114, -84);

    /* 帽冠：矮而宽，顶上一道浅凹 */
    p.moveTo(-46, -100);
    p.bezierCurveTo(-48, -120, -30, -132, -6, -133);
    p.quadraticCurveTo(0, -127, 6, -133);
    p.bezierCurveTo(30, -132, 48, -120, 46, -100);
    p.closePath();

    /* 头：蛋形，下巴收窄 */
    p.moveTo(-42, -66);
    p.bezierCurveTo(-42, -98, -22, -110, 0, -110);
    p.bezierCurveTo(22, -110, 42, -98, 42, -66);
    p.bezierCurveTo(42, -36, 24, -18, 0, -18);
    p.bezierCurveTo(-24, -18, -42, -36, -42, -66);

    /* 两耳 */
    p.moveTo(47.5, -62);
    p.ellipse(42, -62, 5.5, 8, 0, 0, Math.PI * 2);
    p.moveTo(-36.5, -62);
    p.ellipse(-42, -62, 5.5, 8, 0, 0, Math.PI * 2);

    /* 脖子 */
    p.rect(-15, -26, 30, 20);

    /* 肩与身：宽肩，下面被圆盘裁掉 */
    p.moveTo(-40, -8);
    p.bezierCurveTo(-82, -6, -110, 12, -118, 48);
    p.lineTo(-136, 170);
    p.lineTo(136, 170);
    p.lineTo(118, 48);
    p.bezierCurveTo(110, 12, 82, -6, 40, -8);
    p.quadraticCurveTo(0, 12, -40, -8);

    /* 左臂：从肩上一路收到胸前 */
    p.moveTo(-108, 50);
    p.quadraticCurveTo(-76, 82, -24, 88);
    p.quadraticCurveTo(6, 90, 12, 70);
    p.quadraticCurveTo(-16, 52, -44, 34);
    p.quadraticCurveTo(-80, 24, -108, 50);

    /* 握住烟杆的手 */
    p.moveTo(-14, 52);
    p.bezierCurveTo(-18, 42, -8, 36, 4, 37);
    p.bezierCurveTo(16, 38, 22, 44, 21, 55);
    p.bezierCurveTo(20, 66, 10, 71, 0, 69);
    p.bezierCurveTo(-9, 67, -14, 62, -14, 52);

    return p;
  }

  function masterPipe() {
    var p = new Path2D();
    p.moveTo(12, 58);
    p.lineTo(-16, 136);
    return p;
  }

  function masterBowl() {
    var p = new Path2D();
    p.moveTo(-15, 138);
    p.ellipse(-19, 142, 12, 13, 0, 0, Math.PI * 2);
    return p;
  }

  /* 五官：全部走线刻。填色块叠在一起必然读成一张笑脸，线刻才像錾出来的。 */
  function masterFace() {
    var p = new Path2D();
    /* 帽檐压在额头上的那道影：把帽子与脑门分开，不然一顶帽子读成秃头 */
    p.moveTo(-43, -92); p.quadraticCurveTo(0, -87, 43, -92);
    p.moveTo(-34, -101); p.quadraticCurveTo(0, -97, 34, -101);
    /* 眉：两道短横，压得低 */
    p.moveTo(-30, -86); p.lineTo(-11, -83);
    p.moveTo(11, -83); p.lineTo(30, -86);
    /* 眼：短横，不做成圆点 */
    p.moveTo(-24, -74); p.lineTo(-13, -75);
    p.moveTo(13, -75); p.lineTo(24, -74);
    /* 鼻 */
    p.moveTo(0, -76); p.quadraticCurveTo(-1, -64, 5, -60);
    /* 髭：两撇往下垂 */
    p.moveTo(-3, -55); p.quadraticCurveTo(-14, -56, -22, -50);
    p.moveTo(3, -55); p.quadraticCurveTo(14, -56, 22, -50);
    /* 下颌的短须：几道竖线 */
    p.moveTo(-13, -42); p.lineTo(-16, -26);
    p.moveTo(-4, -44); p.lineTo(-5, -22);
    p.moveTo(5, -44); p.lineTo(6, -22);
    p.moveTo(14, -42); p.lineTo(17, -26);
    /* 眼角与额头的纹：老匠人的年纪全在这几笔上 */
    p.moveTo(26, -66); p.lineTo(34, -68);
    p.moveTo(-26, -66); p.lineTo(-34, -68);
    p.moveTo(-14, -96); p.lineTo(-4, -98);
    p.moveTo(4, -98); p.lineTo(14, -96);
    return p;
  }

  function drawMaster(x, cx, cy, s, style) {
    x.save();
    x.translate(cx, cy);
    x.scale(s, s);
    x.fillStyle = style;
    x.fill(masterBody());
    x.fill(masterBowl());
    x.strokeStyle = style;
    x.lineCap = 'round';
    x.lineWidth = 13;
    x.stroke(masterPipe());
    x.restore();
  }

  /* 倒角：左上受光、右下压深，一线高光就是「凸起」的证据 */
  function bevelMaster(x, cx, cy, s) {
    x.save();
    x.translate(cx, cy);
    x.scale(s, s);
    x.lineWidth = 5;
    var up = x.createLinearGradient(-130, -145, 130, 145);
    up.addColorStop(0.00, 'rgba(240,202,146,.40)');
    up.addColorStop(0.40, 'rgba(240,202,146,.05)');
    up.addColorStop(0.58, 'rgba(240,202,146,0)');
    x.strokeStyle = up;
    x.stroke(masterBody());
    x.stroke(masterBowl());
    var dn = x.createLinearGradient(130, 145, -130, -145);
    dn.addColorStop(0.00, 'rgba(14,8,3,.48)');
    dn.addColorStop(0.38, 'rgba(14,8,3,.08)');
    dn.addColorStop(0.56, 'rgba(14,8,3,0)');
    x.strokeStyle = dn;
    x.stroke(masterBody());
    x.stroke(masterBowl());
    x.restore();
  }

  function makeMedallionTex() {
    var W = 512, o = newCanvas(W, W), x = o.x, c = W / 2;
    x.clearRect(0, 0, W, W);

    x.save();
    x.beginPath(); x.arc(c, c, c - 1, 0, Math.PI * 2); x.clip();

    /* 底：与墙面同一路的做旧黄铜，只是更收 */
    var g = x.createRadialGradient(c, c * 0.82, 6, c, c, c);
    g.addColorStop(0.00, '#8d6a39');
    g.addColorStop(0.40, '#7b5a30');
    g.addColorStop(0.74, '#664c28');
    g.addColorStop(0.94, '#412e19');
    g.addColorStop(1.00, '#31220f');
    x.fillStyle = g; x.fillRect(0, 0, W, W);

    var r = rand(19);
    for (var i = 0; i < 140; i++) {
      var px = r() * W, py = r() * W, rad = 8 + r() * 66;
      var gg = x.createRadialGradient(px, py, 0, px, py, rad);
      var t = r();
      gg.addColorStop(0, t > 0.62 ? 'rgba(196,152,84,.12)'
                    : t > 0.30 ? 'rgba(96,110,86,.10)'
                               : 'rgba(24,16,8,.16)');
      gg.addColorStop(1, 'rgba(0,0,0,0)');
      x.fillStyle = gg; x.fillRect(0, 0, W, W);
    }
    /* 细划痕 */
    for (var s2 = 0; s2 < 700; s2++) {
      var sx = r() * W, sy = r() * W, len = 6 + r() * 34;
      x.strokeStyle = r() > 0.5 ? 'rgba(255,236,198,.05)' : 'rgba(0,0,0,.06)';
      x.lineWidth = 0.9;
      x.beginPath(); x.moveTo(sx, sy); x.lineTo(sx + len, sy + (r() - 0.5) * 2); x.stroke();
    }

    /* 人像：压深一层，边上带倒角 */
    drawMaster(x, c, c + 24, 1.58, 'rgba(30,19,9,.44)');
    bevelMaster(x, c, c + 24, 1.58);

    /* 五官：只在颜色图里压深一点，凹凸靠 bump */
    x.save();
    x.translate(c, c + 24); x.scale(1.58, 1.58);
    x.strokeStyle = 'rgba(20,12,5,.30)';
    x.lineCap = 'round'; x.lineJoin = 'round'; x.lineWidth = 3.6;
    x.stroke(masterFace());
    x.restore();

    /* 中心一团淡淡的受光 */
    var hg = x.createRadialGradient(c, c * 0.86, 4, c, c, c);
    hg.addColorStop(0.00, 'rgba(255,226,172,.16)');
    hg.addColorStop(0.55, 'rgba(255,214,156,.04)');
    hg.addColorStop(1.00, 'rgba(120,80,40,0)');
    x.fillStyle = hg; x.fillRect(0, 0, W, W);

    /* 边缘压深，把圆牌收住 */
    var vg = x.createRadialGradient(c, c, c * 0.74, c, c, c);
    vg.addColorStop(0, 'rgba(18,11,5,0)');
    vg.addColorStop(1, 'rgba(18,11,5,.38)');
    x.fillStyle = vg; x.fillRect(0, 0, W, W);
    x.restore();

    /* 外圈两道细刻线 */
    x.strokeStyle = 'rgba(52,36,19,.80)'; x.lineWidth = 4;
    x.beginPath(); x.arc(c, c, c - 7, 0, Math.PI * 2); x.stroke();
    x.strokeStyle = 'rgba(216,178,118,.14)'; x.lineWidth = 1.4;
    x.beginPath(); x.arc(c, c, c - 11, 0, Math.PI * 2); x.stroke();

    /* 圆外透明，交给 CircleGeometry 裁 */
    x.globalCompositeOperation = 'destination-in';
    var mg = x.createRadialGradient(c, c, c - 3, c, c, c - 0.5);
    mg.addColorStop(0, 'rgba(0,0,0,1)');
    mg.addColorStop(1, 'rgba(0,0,0,0)');
    x.fillStyle = mg;
    x.beginPath(); x.arc(c, c, c, 0, Math.PI * 2); x.fill();
    x.globalCompositeOperation = 'source-over';

    return o.c;
  }

  /* 凹凸图：人像凸起（白），面部细节略低（灰），边缘模糊求「柔和」 */
  function makeMedallionBump() {
    var W = 512, o = newCanvas(W, W), x = o.x;
    x.fillStyle = '#787878'; x.fillRect(0, 0, W, W);
    if (x.filter !== undefined) x.filter = 'blur(2.5px)';
    drawMaster(x, 256, 280, 1.58, '#ffffff');
    x.save();
    x.translate(256, 280); x.scale(1.58, 1.58);
    x.strokeStyle = '#a8a8a8';
    x.lineCap = 'round'; x.lineJoin = 'round'; x.lineWidth = 3.6;
    x.stroke(masterFace());
    x.restore();
    if (x.filter !== undefined) x.filter = 'none';
    /* 圆外压平，免得 bump 在圆边起台阶 */
    x.globalCompositeOperation = 'destination-in';
    x.fillStyle = '#ffffff';
    x.beginPath(); x.arc(256, 256, 254, 0, Math.PI * 2); x.fill();
    x.globalCompositeOperation = 'source-over';
    return o.c;
  }

  /* --- 徽记下的鎏金四字 --- */
  function makeScreenText() {
    var W = 1024, H = 256, o = newCanvas(W, H), x = o.x;
    x.clearRect(0, 0, W, H);
    x.textAlign = 'center'; x.textBaseline = 'middle';

    var txt = '乌 铜 走 银';
    x.font = '600 92px "STKaiti","KaiTi","Kaiti SC",serif';

    /* 先落一道暗描边：墙面被洗墙灯打亮以后，光靠亮金面会糊掉 */
    x.lineJoin = 'round';
    x.strokeStyle = 'rgba(24,15,7,.62)';
    x.lineWidth = 7;
    x.strokeText(txt, W / 2, 106);

    var lg = x.createLinearGradient(0, 48, 0, 164);
    lg.addColorStop(0.00, '#fff6dc');
    lg.addColorStop(0.32, '#f0d29a');
    lg.addColorStop(0.64, '#d3ab6a');
    lg.addColorStop(1.00, '#a27a3f');
    x.fillStyle = lg;
    x.fillText(txt, W / 2, 106);

    x.font = '400 27px "Helvetica Neue",Arial,sans-serif';
    x.strokeStyle = 'rgba(24,15,7,.50)';
    x.lineWidth = 4;
    x.strokeText('W U T O N G   Z O U Y I N', W / 2, 188);
    x.fillStyle = 'rgba(240,218,176,.80)';
    x.fillText('W U T O N G   Z O U Y I N', W / 2, 188);
    return o.c;
  }

  var M_FRAME = new T.MeshStandardMaterial({
    color: 0x1a120d, metalness: 0.34, roughness: 0.46, envMapIntensity: 0.55
  });
  var M_MIRROR = new T.MeshStandardMaterial({
    color: 0x08080a, metalness: 1.0, roughness: 0.075, envMapIntensity: 1.25
  });
  var M_ROSEWOOD = new T.MeshStandardMaterial({
    color: 0x050403, metalness: 0.0, roughness: 0.95, envMapIntensity: 0.04
  });
  var M_SEAT = new T.MeshStandardMaterial({
    color: 0x050403, metalness: 0.0, roughness: 0.95, envMapIntensity: 0.06
  });
  var M_TRIM = new T.MeshStandardMaterial({
    color: 0x7d5c33, metalness: 0.80, roughness: 0.54, envMapIntensity: 0.60
  });

  /* --- 基座 --- */
  var screenBase = new T.Mesh(new T.BoxGeometry(SW + 0.56, SB, 0.84), stoneMat);
  screenBase.position.y = SB / 2;
  screenGroup.add(screenBase);

  var baseEdge = new T.Mesh(new T.BoxGeometry(SW + 0.58, 0.020, 0.030), M_TRIM);
  baseEdge.position.set(0, SB - 0.014, 0.415);
  screenGroup.add(baseEdge);
  var baseEdgeB = new T.Mesh(new T.BoxGeometry(SW + 0.58, 0.020, 0.030), M_TRIM);
  baseEdgeB.position.set(0, SB - 0.014, -0.415);
  screenGroup.add(baseEdgeB);

  /* --- 木框 --- */
  function sb(w, h, d, px, py, pz, mat) {
    var m = new T.Mesh(new T.BoxGeometry(w, h, d), mat || M_FRAME);
    m.position.set(px, py, pz);
    screenGroup.add(m);
    return m;
  }
  sb(0.19, SH, ST, -(SW / 2 - 0.095), SB + SH / 2, 0);
  sb(0.19, SH, ST, (SW / 2 - 0.095), SB + SH / 2, 0);
  sb(SW, 0.19, ST, 0, SB + SH - 0.095, 0);
  sb(SW, 0.17, ST, 0, SB + 0.085, 0);

  /* --- 铜板面 --- */
  var FIELD_W = SW - 0.38, FIELD_H = SH - 0.36;
  var fieldY = SB + 0.17 + FIELD_H / 2;
  var plateTex = texOf(makeBronzePlateTex());
  var plateRough = linTex(makeBronzeRoughTex());
  var plateBump = linTex(makeBronzeBumpTex());

  /* 做旧黄铜：金属度压到 0.82（全金属在 r147 里没有漫反射，灯稍弱就发死），
     粗糙度交给贴图 —— 打磨过的块面 0.35，氧化的块面 0.75，平均值 0.55。 */
  var plateMat = new T.MeshStandardMaterial({
    map: plateTex, roughnessMap: plateRough, bumpMap: plateBump, bumpScale: 0.0040,
    color: 0xf2e6d2, metalness: 0.82, roughness: 1.0, envMapIntensity: 0.70
  });
  var plateMatBack = new T.MeshStandardMaterial({
    map: plateTex, roughnessMap: plateRough, bumpMap: plateBump, bumpScale: 0.0040,
    color: 0x4a4034, metalness: 0.78, roughness: 1.0, envMapIntensity: 0.40
  });

  var faceF = new T.Mesh(new T.PlaneGeometry(FIELD_W, FIELD_H), plateMat);
  faceF.position.set(0, fieldY, ST / 2 + 0.002);
  screenGroup.add(faceF);

  var faceB = new T.Mesh(new T.PlaneGeometry(FIELD_W, FIELD_H), plateMatBack);
  faceB.position.set(0, fieldY, -ST / 2 - 0.002);
  faceB.rotation.y = Math.PI;
  screenGroup.add(faceB);

  /* 铜板与木框之间那一道窄铜边 */
  sb(FIELD_W + 0.13, 0.030, ST + 0.018, 0, SB + 0.155, 0, M_TRIM);
  sb(FIELD_W + 0.13, 0.030, ST + 0.018, 0, SB + SH - 0.175, 0, M_TRIM);
  sb(0.030, FIELD_H + 0.05, ST + 0.018, -(FIELD_W / 2 + 0.048), fieldY, 0, M_TRIM);
  sb(0.030, FIELD_H + 0.05, ST + 0.018, (FIELD_W / 2 + 0.048), fieldY, 0, M_TRIM);

  /* --- 徽章 + 铭文：与墙同材质，只低低凸起一点，靠倒角吃洗墙光 --- */
  var M_AGED = new T.MeshStandardMaterial({
    color: 0x4e3818, metalness: 0.66, roughness: 0.74, envMapIntensity: 0.22
  });
  var M_MEDB = new T.MeshStandardMaterial({
    color: 0x2a1d10, metalness: 0.55, roughness: 0.86, envMapIntensity: 0.18
  });
  var MED_Y = 2.70;

  var medBack = new T.Mesh(new T.CircleGeometry(0.386, 56), M_MEDB);
  medBack.position.set(0, MED_Y, ST / 2 + 0.004);
  screenGroup.add(medBack);

  var medRing = new T.Mesh(new T.TorusGeometry(0.360, 0.008, 8, 64), M_AGED);
  medRing.position.set(0, MED_Y, ST / 2 + 0.011);
  screenGroup.add(medRing);

  var med = new T.Mesh(new T.CircleGeometry(0.350, 64), new T.MeshStandardMaterial({
    map: texOf(makeMedallionTex()),
    bumpMap: linTex(makeMedallionBump()), bumpScale: 0.0042,
    color: 0xf4ead8, metalness: 0.84, roughness: 0.60, envMapIntensity: 0.55
  }));
  med.position.set(0, MED_Y, ST / 2 + 0.009);
  screenGroup.add(med);

  var textMat = new T.MeshStandardMaterial({
    map: texOf(makeScreenText()), transparent: true, depthWrite: false,
    metalness: 0.50, roughness: 0.44, envMapIntensity: 0.65,
    emissive: 0x543a15, emissiveIntensity: 0.30
  });
  var ins = new T.Mesh(new T.PlaneGeometry(1.50, 0.375), textMat);
  ins.position.set(0, 2.02, ST / 2 + 0.010);
  screenGroup.add(ins);

  /* --- 背面同样收口：一枚压得很低的圆牌 --- */
  var backMed = new T.Mesh(new T.CircleGeometry(0.44, 48), new T.MeshStandardMaterial({
    map: texOf(makeMedallionTex()), color: 0x6e6355,
    metalness: 0.30, roughness: 0.74, envMapIntensity: 0.20
  }));
  backMed.position.set(0, 2.45, -ST / 2 - 0.006);
  backMed.rotation.y = Math.PI;
  screenGroup.add(backMed);
  var backRing = new T.Mesh(new T.TorusGeometry(0.45, 0.010, 8, 56), M_TRIM);
  backRing.position.set(0, 2.45, -ST / 2 - 0.004);
  screenGroup.add(backRing);

  /* --- 两侧镜面黑柱：把影壁嵌进墙里 --- */
  [-1, 1].forEach(function (s) {
    var col = new T.Mesh(new T.BoxGeometry(0.32, 4.45, 0.50), M_MIRROR);
    col.position.set(s * (SW / 2 + 0.20), 2.225, 0);
    screenGroup.add(col);
    var cap = new T.Mesh(new T.BoxGeometry(0.34, 0.050, 0.52), M_FRAME);
    cap.position.set(s * (SW / 2 + 0.20), 4.42, 0);
    screenGroup.add(cap);
  });

  /* --- 屏前：圈椅一对 --- */
  var chairSplatMat = craftMaterial(motifFlora(512, 512), {
    patina: 1, bumpScale: 0.0010, silverRough: 0.16
  });
  function mkArmchair() {
    var g = new T.Group();
    var CW = 0.58, CD = 0.52, seatY = 0.47;

    [[-1, -1], [1, -1], [-1, 1], [1, 1]].forEach(function (q) {
      var leg = new T.Mesh(new T.BoxGeometry(0.044, seatY, 0.044), M_ROSEWOOD);
      leg.position.set(q[0] * (CW / 2 - 0.035), seatY / 2, q[1] * (CD / 2 - 0.035));
      g.add(leg);
    });

    var seatFrame = new T.Mesh(new T.BoxGeometry(CW, 0.055, CD), M_ROSEWOOD);
    seatFrame.position.y = seatY - 0.020;
    g.add(seatFrame);
    var seatPanel = new T.Mesh(new T.BoxGeometry(CW - 0.07, 0.020, CD - 0.07), M_SEAT);
    seatPanel.position.y = seatY + 0.012;
    g.add(seatPanel);

    [-1, 1].forEach(function (s) {
      var post = new T.Mesh(new T.CylinderGeometry(0.019, 0.021, 0.56, 10), M_ROSEWOOD);
      post.position.set(s * (CW / 2 - 0.045), seatY + 0.28, -(CD / 2 - 0.045));
      post.rotation.x = -0.06;
      g.add(post);
    });

    // 马蹄形搭脑：一木连做成扶手
    var railCurve = new T.CatmullRomCurve3([
      new T.Vector3(-0.255, 0.880, 0.185),
      new T.Vector3(-0.285, 0.955, 0.020),
      new T.Vector3(-0.255, 1.005, -0.160),
      new T.Vector3(0, 1.022, -0.245),
      new T.Vector3(0.255, 1.005, -0.160),
      new T.Vector3(0.285, 0.955, 0.020),
      new T.Vector3(0.255, 0.880, 0.185)
    ]);
    g.add(new T.Mesh(new T.TubeGeometry(railCurve, 48, 0.019, 8, false), M_ROSEWOOD));

    // 联帮棍
    [-1, 1].forEach(function (s) {
      var ap = new T.Mesh(new T.CylinderGeometry(0.014, 0.016, 0.40, 8), M_ROSEWOOD);
      ap.position.set(s * 0.262, 0.680, 0.150);
      g.add(ap);
      var ap2 = new T.Mesh(new T.CylinderGeometry(0.012, 0.014, 0.32, 8), M_ROSEWOOD);
      ap2.position.set(s * 0.274, 0.760, 0.005);
      g.add(ap2);
    });

    // 椅背板：走银
    var splat = new T.Mesh(new T.BoxGeometry(0.152, 0.46, 0.018), chairSplatMat);
    splat.position.set(0, 0.745, -0.232);
    splat.rotation.x = -0.05;
    g.add(splat);

    [-1, 1].forEach(function (s) {
      var sp = new T.Mesh(new T.CylinderGeometry(0.009, 0.009, 0.50, 6), M_ROSEWOOD);
      sp.position.set(s * 0.098, 0.750, -0.228);
      g.add(sp);
    });

    // 管脚枨
    [[0, 1], [0, -1], [1, 0], [-1, 0]].forEach(function (q) {
      var st = new T.Mesh(new T.BoxGeometry(q[0] ? 0.030 : CW - 0.09, 0.030, q[0] ? CD - 0.09 : 0.030), M_ROSEWOOD);
      st.position.set(q[0] * (CW / 2 - 0.035), 0.150, q[1] * (CD / 2 - 0.035));
      g.add(st);
    });
    return g;
  }
  [-1, 1].forEach(function (s) {
    var ch = mkArmchair();
    ch.position.set(s * 1.12, 0, 1.28);
    ch.rotation.y = s * 0.05;
    scene.add(ch);
  });

  /* --- 屏前：两屉小几 --- */
  function mkSideTable() {
    var g = new T.Group();
    var W = 0.50, D = 0.40, topY = 0.74;
    var top = new T.Mesh(new T.BoxGeometry(W, 0.034, D), M_ROSEWOOD);
    top.position.y = topY;
    g.add(top);
    var body = new T.Mesh(new T.BoxGeometry(W - 0.06, 0.44, D - 0.05), M_ROSEWOOD);
    body.position.y = topY - 0.255;
    g.add(body);

    [0.615, 0.435].forEach(function (dy) {
      var dr = new T.Mesh(new T.BoxGeometry(W - 0.10, 0.145, 0.014), M_ROSEWOOD);
      dr.position.set(0, dy, D / 2 - 0.015);
      g.add(dr);
      var pull = new T.Mesh(new T.TorusGeometry(0.020, 0.0045, 8, 18), goldMat);
      pull.position.set(0, dy - 0.030, D / 2 + 0.001);
      g.add(pull);
    });

    [[-1, -1], [1, -1], [-1, 1], [1, 1]].forEach(function (q) {
      var leg = new T.Mesh(new T.BoxGeometry(0.030, 0.30, 0.030), M_ROSEWOOD);
      leg.position.set(q[0] * (W / 2 - 0.035), 0.150, q[1] * (D / 2 - 0.035));
      g.add(leg);
    });

    var card = new T.Mesh(new T.BoxGeometry(0.110, 0.006, 0.072), new T.MeshBasicMaterial({ color: 0xf2ead9 }));
    card.position.set(0, topY + 0.020, 0.02);
    card.rotation.y = 0.18;
    g.add(card);
    return g;
  }
  var sideTable = mkSideTable();
  sideTable.position.set(0, 0, 1.30);
  scene.add(sideTable);

  /* --- 屏前：一对梅瓶（龙纹走银） --- */
  var vaseMat = craftMaterial(motifLandscape(1024, 1024), {
    patina: 1, bumpScale: 0.0012, side: T.DoubleSide, silverRough: 0.20
  });
  function mkFloorVase() {
    var g = new T.Group();
    var H = 1.34;
    var prof = [
      [0.000, 0.000], [0.062, 0.000], [0.069, 0.010], [0.058, 0.026],
      [0.088, 0.070], [0.116, 0.180], [0.128, 0.315], [0.122, 0.430],
      [0.101, 0.545], [0.078, 0.645], [0.061, 0.730], [0.056, 0.795],
      [0.063, 0.842], [0.073, 0.862], [0.066, 0.880], [0.058, 0.868]
    ];
    var pts = prof.map(function (p) { return new T.Vector2(p[0] * 0.92, p[1] * H); });
    g.add(new T.Mesh(new T.LatheGeometry(pts, 56), vaseMat));

    var ring = new T.Mesh(new T.TorusGeometry(0.073, 0.0038, 8, 34), silverMat);
    ring.position.y = 0.862 * H;
    ring.rotation.x = Math.PI / 2;
    g.add(ring);
    return g;
  }
  [-1, 1].forEach(function (s) {
    var v = mkFloorVase();
    v.position.set(s * 2.16, 0, 1.24);
    v.rotation.y = s * 0.7;
    scene.add(v);
  });

  /* 影壁洗墙：贴顶、近墙、向下打，中心一团暖光晕，两侧自然收暗。
     灯位离墙只有 0.58m，光轴几乎垂直墙面，锥角一开就是一片「洗」出来的渐变。 */
  var wallWash = new T.SpotLight(0xffe0b4, 2.2, 14, 0.95, 1.0, 1.20);
  wallWash.position.set(0, HALL_CEIL - 0.06, 0.52);
  wallWash.target.position.set(0, 3.05, 0.05);
  scene.add(wallWash, wallWash.target);

  /* 正面一团光晕：平着打向徽章那一带，中心亮、四周自然收 —— 洗墙灯打不出的那种聚光感 */
  var wallHalo = new T.SpotLight(0xffd9a2, 3.9, 12, 0.82, 1.0, 1.12);
  wallHalo.position.set(0, 2.72, 1.55);
  wallHalo.target.position.set(0, 2.98, 0.05);
  scene.add(wallHalo, wallHalo.target);

  /* 屏前一抹落地补光：圈椅与梅瓶不至于沉进黑里 */
  var chairFill = new T.PointLight(0xffd7ab, 0.62, 4.6, 2.0);
  chairFill.position.set(0, 1.50, 2.42);
  scene.add(chairFill);
  /* ============================================================
     6. 展品数据与模型
     ============================================================ */
  function lathe(profile, seg) {
    var pts = profile.map(function (p) { return new T.Vector2(p[0], p[1]); });
    return new T.LatheGeometry(pts, seg || 64);
  }

  /* --- 器物构建器（局部坐标，底面 y=0） --- */
  function mkInkbox() {
    var g = new T.Group();
    var body = new T.Mesh(new T.BoxGeometry(0.34, 0.052, 0.25), plainCopper);
    body.position.y = 0.026;
    g.add(body);
    var lid = new T.Mesh(new T.BoxGeometry(0.352, 0.030, 0.262),
      craftMaterial(motifLandscape(1024, 760), { patina: 1, bumpScale: 0.0018 }));
    lid.position.y = 0.067;
    g.add(lid);
    return g;
  }

  function mkEwer() {
    var g = new T.Group();
    var m = craftMaterial(motifFlora(1024, 1024), { patina: 1, bumpScale: 0.0022 });
    var body = new T.Mesh(lathe([
      [0.00, 0.00], [0.075, 0.00], [0.082, 0.014], [0.088, 0.045],
      [0.082, 0.088], [0.062, 0.122], [0.040, 0.150], [0.036, 0.170],
      [0.044, 0.180], [0.020, 0.187], [0.00, 0.188]
    ], 56), m);
    g.add(body);

    var spout = new T.Mesh(new T.CylinderGeometry(0.009, 0.017, 0.10, 16, 1, true), plainCopper);
    spout.position.set(0.062, 0.135, 0);
    spout.rotation.z = -0.78;
    g.add(spout);

    var handle = new T.Mesh(new T.TorusGeometry(0.040, 0.0065, 10, 24, Math.PI * 1.15), plainCopper);
    handle.position.set(-0.052, 0.108, 0);
    handle.rotation.set(Math.PI / 2, 0, -0.55);
    g.add(handle);

    var knob = new T.Mesh(new T.SphereGeometry(0.014, 16, 12), goldMat);
    knob.position.y = 0.196;
    g.add(knob);
    return g;
  }

  /* 祥龙献瑞酒壶：扁圆腹、短颈、上翘壶嘴、环形壶把，九龙缠身 */
  function mkDragonEwer() {
    var g = new T.Group();
    var m = craftMaterial(motifCoiledDragon(1024, 1024), {
      patina: 1, bumpScale: 0.0024, side: T.DoubleSide
    });

    var body = new T.Mesh(lathe([
      [0.000, 0.000], [0.054, 0.000], [0.060, 0.009],
      [0.049, 0.024],                       // 圈足内收
      [0.076, 0.044],
      [0.100, 0.070],
      [0.114, 0.098],                       // 腹径最大：0.228m
      [0.109, 0.124],
      [0.089, 0.148],
      [0.061, 0.164],                       // 肩
      [0.045, 0.174],
      [0.041, 0.184],                       // 短颈
      [0.047, 0.191],                       // 口沿外撇
      [0.039, 0.194],
      [0.033, 0.186],
      [0.000, 0.183]
    ], 64), m);
    g.add(body);

    /* 足沿与颈沿：两道银线，把扁圆的轮廓收住 */
    var footRing = new T.Mesh(new T.TorusGeometry(0.052, 0.0034, 8, 40), silverMat);
    footRing.position.y = 0.012;
    footRing.rotation.x = Math.PI / 2;
    g.add(footRing);

    var neckRing = new T.Mesh(new T.TorusGeometry(0.045, 0.0032, 8, 36), silverMat);
    neckRing.position.y = 0.191;
    neckRing.rotation.x = Math.PI / 2;
    g.add(neckRing);

    /* 盖：压住壶口，钮坐在盖上 */
    var lid = new T.Mesh(new T.CylinderGeometry(0.0445, 0.0470, 0.009, 36), plainCopper);
    lid.position.y = 0.1885;
    g.add(lid);
    var lidRing = new T.Mesh(new T.TorusGeometry(0.0442, 0.0020, 8, 32), silverMat);
    lidRing.position.y = 0.1925;
    lidRing.rotation.x = Math.PI / 2;
    g.add(lidRing);

    /* 壶嘴：弯曲上翘的「流」，用曲线管做，比圆柱更像执壶 */
    var spoutCurve = new T.CatmullRomCurve3([
      new T.Vector3(0.056, 0.116, 0),
      new T.Vector3(0.106, 0.145, 0),
      new T.Vector3(0.143, 0.177, 0),
      new T.Vector3(0.163, 0.205, 0)
    ]);
    var spout = new T.Mesh(new T.TubeGeometry(spoutCurve, 24, 0.0118, 12, false), plainCopper);
    g.add(spout);
    var spoutTip = new T.Mesh(new T.TorusGeometry(0.0114, 0.0024, 8, 22), silverMat);
    spoutTip.position.set(0.163, 0.205, 0);
    spoutTip.rotation.set(Math.PI / 2 - 0.62, 0, 0);
    g.add(spoutTip);

    /* 壶把：从腹侧起、翻过肩落到颈上的 C 形把 */
    var handleCurve = new T.CatmullRomCurve3([
      new T.Vector3(-0.084, 0.124, 0),
      new T.Vector3(-0.148, 0.140, 0),
      new T.Vector3(-0.154, 0.183, 0),
      new T.Vector3(-0.106, 0.197, 0),
      new T.Vector3(-0.047, 0.186, 0)
    ]);
    var handle = new T.Mesh(new T.TubeGeometry(handleCurve, 30, 0.0070, 10, false), plainCopper);
    g.add(handle);

    /* 盖钮 */
    var knob = new T.Mesh(new T.SphereGeometry(0.0115, 16, 12), goldMat);
    knob.position.y = 0.200;
    knob.scale.y = 0.82;
    g.add(knob);
    return g;
  }

  function mkCenser() {
    var g = new T.Group();

    /* ===== 器物尺寸（米）：高约 0.162，腹径 0.098 ===== */
    var R = 0.049;                    // 球腹最大半径
    var Y_TRAY = 0.012;               // 托盘高
    var Y_FOOT = 0.040;               // 圈足顶
    var Y_BELLY = 0.070;              // 球腹最宽处
    var Y_SHOULDER = 0.098;           // 球腹收口
    var Y_RIM = 0.116;                // 口沿顶
    var Y_LID = 0.152;                // 盖顶

    var silverLion = new T.MeshStandardMaterial({
      color: 0xa9b1bc, metalness: 1.0, roughness: 0.34, envMapIntensity: 1.25
    });

    /* ---- 1. 托盘（素胎，只留一道银口） ---- */
    var tray = new T.Mesh(lathe([
      [0.000, 0.000], [0.034, 0.000], [0.048, 0.002],
      [0.054, 0.007], [0.053, 0.010], [0.044, 0.009],
      [0.028, 0.006], [0.000, 0.005]
    ], 64), plainCopper);
    g.add(tray);
    var trayRim = new T.Mesh(new T.TorusGeometry(0.0535, 0.0016, 8, 56), silverLion);
    trayRim.position.y = 0.0095;
    trayRim.rotation.x = Math.PI / 2;
    g.add(trayRim);

    /* ---- 2. 圈足（喇叭形） ---- */
    var foot = new T.Mesh(lathe([
      [0.000, Y_TRAY], [0.030, Y_TRAY], [0.032, Y_TRAY + 0.004],
      [0.028, Y_TRAY + 0.012], [0.030, Y_FOOT - 0.006], [0.034, Y_FOOT]
    ], 64), plainCopper);
    g.add(foot);
    // 足上一道银圈
    var footBand = new T.Mesh(new T.TorusGeometry(0.0335, 0.0022, 8, 44), silverLion);
    footBand.position.y = Y_FOOT - 0.004;
    footBand.rotation.x = Math.PI / 2;
    g.add(footBand);

    /* ---- 3. 球腹（万字锦地） ---- */
    var bodyH = Y_SHOULDER - Y_FOOT;               // 0.058
    var circ = 2 * Math.PI * R;                    // 0.308
    var cell = 0.0118;                             // 锦地单元 11.8mm
    var bodyMat = craftMaterial(motifMeander(768, 768), {
      patina: 1, bumpScale: 0.0032, silverRough: 0.155,
      repeat: [Math.max(1, Math.round(circ / cell / 8)), Math.max(2, Math.round(bodyH / cell / 8))]
    });
    bodyMat.envMapIntensity = 1.0;
    var body = new T.Mesh(lathe([
      [0.032, Y_FOOT],
      [0.042, Y_FOOT + 0.010],
      [R, Y_BELLY - 0.006],
      [R * 0.985, Y_BELLY + 0.008],
      [0.041, Y_SHOULDER - 0.008],
      [0.037, Y_SHOULDER]
    ], 72), bodyMat);
    g.add(body);

    /* ---- 4. 两处圆形开光：内以走金松枝 ---- */
    var roundelMat = craftMaterial(motifPineRoundel(512, 512), {
      patina: 1, gold: true, bumpScale: 0.0026, silverRough: 0.11
    });
    roundelMat.envMapIntensity = 1.35;

    var capAng = 0.60;                                        // 开光球冠半角
    [0, Math.PI].forEach(function (phi) {
      var patch = new T.Mesh(
        new T.SphereGeometry(R * 1.004, 28, 20,
          phi + Math.PI / 2 - capAng, capAng * 2,
          Math.PI / 2 - capAng, capAng * 2),
        roundelMat
      );
      patch.position.y = Y_BELLY - 0.004;
      g.add(patch);
    });
    // 开光外的一圈银线
    [0, Math.PI].forEach(function (phi) {
      var ring = new T.Mesh(
        new T.TorusGeometry(R * Math.sin(capAng) * 1.005, 0.0016, 8, 40),
        silverLion
      );
      ring.position.y = Y_BELLY - 0.004;
      ring.rotation.y = phi;
      ring.rotation.x = 0;
      g.add(ring);
    });

    /* ---- 5. 狮首衔环双耳 ---- */
    function lionMask() {
      var L = new T.Group();

      // 背板
      var plate = new T.Mesh(new T.CylinderGeometry(0.0175, 0.0175, 0.005, 24), silverLion);
      plate.rotation.x = Math.PI / 2;
      plate.position.z = 0.002;
      L.add(plate);

      // 联珠边
      var beaded = new T.Mesh(new T.TorusGeometry(0.0175, 0.0022, 8, 32), silverLion);
      beaded.position.z = 0.004;
      L.add(beaded);

      // 面部
      var face = new T.Mesh(new T.SphereGeometry(0.0125, 20, 14), silverLion);
      face.scale.set(1.0, 1.05, 0.72);
      face.position.z = 0.008;
      L.add(face);

      // 眉弓
      [-1, 1].forEach(function (s2) {
        var brow = new T.Mesh(new T.TorusGeometry(0.0058, 0.0016, 6, 14, Math.PI * 1.1), silverLion);
        brow.position.set(s2 * 0.0062, 0.0042, 0.0155);
        brow.rotation.z = s2 > 0 ? 0.5 : Math.PI - 0.5;
        L.add(brow);
        // 眼
        var eye = new T.Mesh(new T.SphereGeometry(0.0032, 12, 10), silverLion);
        eye.position.set(s2 * 0.0062, 0.0012, 0.0168);
        L.add(eye);
      });

      // 鼻
      var nose = new T.Mesh(new T.SphereGeometry(0.0032, 12, 10), silverLion);
      nose.position.set(0, -0.0026, 0.0192);
      L.add(nose);

      // 口 / 獠牙
      var mouth = new T.Mesh(new T.BoxGeometry(0.010, 0.0034, 0.003), silverLion);
      mouth.position.set(0, -0.0075, 0.0172);
      L.add(mouth);

      // 鬃毛卷
      for (var i = 0; i < 7; i++) {
        var a = -1.5 + (i / 6) * 3.0;
        var curl = new T.Mesh(new T.TorusGeometry(0.0034, 0.0011, 6, 12, Math.PI * 1.4), silverLion);
        curl.position.set(Math.cos(a) * 0.0128, Math.sin(a) * 0.0128 + 0.002, 0.0052);
        curl.rotation.z = a;
        L.add(curl);
      }

      // 衔环
      var ring = new T.Mesh(new T.TorusGeometry(0.0118, 0.0022, 8, 28), silverLion);
      ring.position.set(0, -0.0255, 0.004);
      L.add(ring);

      return L;
    }

    [-1, 1].forEach(function (sx) {
      var m = lionMask();
      m.position.set(sx * (R * 0.94), Y_BELLY - 0.004, 0);
      m.scale.setScalar(0.80);
      m.rotation.y = sx * Math.PI / 2;
      g.add(m);
    });

    /* ---- 6. 口沿宽箍（斜方格） ---- */
    var rimMat = craftMaterial(motifBand(512, 160), {
      patina: 1, bumpScale: 0.0024, silverRough: 0.12,
      repeat: [4, 1]
    });
    var rim = new T.Mesh(lathe([
      [0.036, Y_SHOULDER], [0.040, Y_SHOULDER + 0.004],
      [0.040, Y_RIM - 0.004], [0.037, Y_RIM]
    ], 72), rimMat);
    g.add(rim);
    var rimLine = new T.Mesh(new T.TorusGeometry(0.0405, 0.0018, 8, 48), silverLion);
    rimLine.position.y = Y_RIM - 0.004;
    rimLine.rotation.x = Math.PI / 2;
    g.add(rimLine);

    /* ---- 7. 镂空云纹穹盖：十片，留缝 ---- */
    var lidMat = craftMaterial(motifCloud(384, 384), {
      patina: 1, bumpScale: 0.0018, silverRough: 0.13,
      side: T.DoubleSide, repeat: [3, 1]
    });
    var lidProfile = [
      [0.037, Y_RIM],
      [0.037, Y_RIM + 0.006],
      [0.034, Y_RIM + 0.014],
      [0.027, Y_RIM + 0.024],
      [0.016, Y_RIM + 0.032],
      [0.000, Y_LID]
    ];
    var lidDome = new T.Mesh(lathe(lidProfile, 64), lidMat);
    g.add(lidDome);

    // 盖子底圈
    var lidBand = new T.Mesh(new T.TorusGeometry(0.0375, 0.0024, 8, 48), silverLion);
    lidBand.position.y = Y_RIM + 0.003;
    lidBand.rotation.x = Math.PI / 2;
    g.add(lidBand);

    /* ---- 8. 顶珠（红玛瑙） ---- */
    var socket = new T.Mesh(new T.CylinderGeometry(0.0075, 0.0105, 0.008, 16), silverLion);
    socket.position.y = Y_LID + 0.002;
    g.add(socket);

    var agate = new T.Mesh(
      new T.SphereGeometry(0.0118, 24, 18),
      new T.MeshPhysicalMaterial({
        color: 0x7d0e14, metalness: 0.0, roughness: 0.12,
        clearcoat: 1.0, clearcoatRoughness: 0.06,
        envMapIntensity: 2.2, emissive: 0x2a0406, emissiveIntensity: 0.9
      })
    );
    agate.position.y = Y_LID + 0.014;
    g.add(agate);

    return g;
  }

  // 局部旋转（带 phiStart / phiLength 的 lathe）
  function lathePartial(profile, seg, phiStart, phiLength) {
    var pts = profile.map(function (p) { return new T.Vector2(p[0], p[1]); });
    return new T.LatheGeometry(pts, seg, phiStart, phiLength);
  }

  function mkBrushpot() {
    var g = new T.Group();
    var m = craftMaterial(motifBamboo(768, 1024), { patina: 1, bumpScale: 0.0016 });
    var body = new T.Mesh(new T.CylinderGeometry(0.056, 0.058, 0.185, 40, 1, true), m);
    body.position.y = 0.0925;
    body.material.side = T.DoubleSide;
    g.add(body);

    var base = new T.Mesh(new T.CylinderGeometry(0.058, 0.060, 0.012, 40), plainCopper);
    base.position.y = 0.006;
    g.add(base);

    var rim = new T.Mesh(new T.TorusGeometry(0.056, 0.0038, 8, 40), silverMat);
    rim.position.y = 0.185;
    rim.rotation.x = Math.PI / 2;
    g.add(rim);
    return g;
  }

  function mkVase() {
    var g = new T.Group();
    var m = craftMaterial(motifFlora(1024, 1024), { patina: 1, bumpScale: 0.002 });
    var body = new T.Mesh(lathe([
      [0.00, 0.00], [0.052, 0.00], [0.058, 0.012], [0.050, 0.040],
      [0.074, 0.105], [0.078, 0.150], [0.062, 0.200], [0.040, 0.240],
      [0.034, 0.262], [0.046, 0.272], [0.040, 0.276], [0.030, 0.268],
      [0.028, 0.250], [0.000, 0.248]
    ], 64), m);
    g.add(body);

    var band = new T.Mesh(new T.TorusGeometry(0.058, 0.0035, 8, 48), silverMat);
    band.position.y = 0.042;
    band.rotation.x = Math.PI / 2;
    g.add(band);
    return g;
  }

  function mkTray() {
    var g = new T.Group();
    var m = craftMaterial(motifRadial(1024, 1024), { patina: 1, bumpScale: 0.0016 });
    var body = new T.Mesh(lathe([
      [0.00, 0.000], [0.070, 0.000], [0.086, 0.006], [0.090, 0.020],
      [0.082, 0.026], [0.074, 0.016], [0.000, 0.012]
    ], 56), m);
    g.add(body);
    return g;
  }

  function mkSeal() {
    var g = new T.Group();
    var body = new T.Mesh(new T.BoxGeometry(0.058, 0.075, 0.058), plainCopper);
    body.position.y = 0.0375;
    g.add(body);
    var knob = new T.Mesh(new T.TorusGeometry(0.020, 0.0065, 10, 24, Math.PI * 1.4), goldMat);
    knob.position.y = 0.090;
    knob.rotation.set(0, 0, Math.PI * 0.2);
    g.add(knob);
    return g;
  }

  function mkRoundBox() {
    var g = new T.Group();
    var m = craftMaterial(motifLattice(768, 768), { patina: 1, bumpScale: 0.0016 });
    var body = new T.Mesh(new T.CylinderGeometry(0.070, 0.072, 0.038, 44), m);
    body.position.y = 0.019;
    g.add(body);
    var lid = new T.Mesh(new T.CylinderGeometry(0.074, 0.074, 0.012, 44),
      craftMaterial(motifRadial(768, 768), { patina: 1, bumpScale: 0.0014 }));
    lid.position.y = 0.044;
    g.add(lid);
    var knob = new T.Mesh(new T.SphereGeometry(0.010, 14, 10), silverMat);
    knob.position.y = 0.056;
    g.add(knob);
    return g;
  }

  function mkPlaque() {
    var g = new T.Group();
    // 立式挂牌（微微后倾）
    var board = new T.Mesh(new T.BoxGeometry(0.11, 0.16, 0.008),
      craftMaterial(motifLattice(384, 512), { patina: 1, bumpScale: 0.0012 }));
    board.position.set(0, 0.088, 0);
    board.rotation.x = -0.10;
    g.add(board);

    var hole = new T.Mesh(new T.TorusGeometry(0.010, 0.0022, 8, 18), silverMat);
    hole.position.set(0, 0.168, 0);
    hole.rotation.x = Math.PI / 2;
    g.add(hole);

    var stand = new T.Mesh(new T.BoxGeometry(0.10, 0.010, 0.045), stoneMat);
    stand.position.y = 0.005;
    g.add(stand);
    return g;
  }

  function mkBangle() {
    var g = new T.Group();
    var m = craftMaterial(motifLattice(384, 384), { patina: 1, bumpScale: 0.0009 });
    var ring = new T.Mesh(new T.TorusGeometry(0.055, 0.0085, 16, 56), m);
    ring.rotation.x = Math.PI / 2;
    ring.position.y = 0.010;
    g.add(ring);
    // 小托
    var stand = new T.Mesh(new T.CylinderGeometry(0.030, 0.036, 0.010, 24), stoneMat);
    stand.position.y = 0.005;
    g.add(stand);
    return g;
  }

  function mkInkbed() {
    var g = new T.Group();
    var m = craftMaterial(motifLandscape(768, 384), { patina: 1, bumpScale: 0.0014 });
    var bed = new T.Mesh(new T.BoxGeometry(0.20, 0.018, 0.070), m);
    bed.position.y = 0.030;
    g.add(bed);
    [-1, 1].forEach(function (s) {
      var foot = new T.Mesh(new T.CylinderGeometry(0.018, 0.022, 0.030, 8, 1, false, 0, Math.PI), plainCopper);
      foot.rotation.z = Math.PI / 2;
      foot.rotation.y = Math.PI / 2;
      foot.position.set(s * 0.078, 0.016, 0);
      g.add(foot);
    });
    return g;
  }

  /* ⑦ 号柜酒壶：默认沿用原来的程序化酒壶，主展厅一打开就是原版画面。
     只有显式 ?ewer=lite|full 才换成外部实体模型；?ewer=off 或未识别取值等同默认。 */
  var EWER_VARIANT = new URLSearchParams(location.search).get('ewer') || 'lite';
  var EWER_URL = EWER_VARIANT === 'full' ? (window.__GLB_EWER || 'assets/ewer-dragon.glb')
    : (EWER_VARIANT === 'lite' ? (window.__GLB_EWER || 'assets/ewer-dragon-lite.glb') : null);

  /* ---------- 11 件展品：位置 / 朝向 / 文案 ---------- */
  /* n = 朝向（指向展厅内部）的单位向量 */
  var EXHIBITS = [
    { name: '山水纹墨盒', en: 'Ink Box with Landscape in Silver',
      meta: '清末民初 · 长 8.6cm · 乌铜走银',
      desc: '文人随身之器。盖面山水以银线勾勒，山石用「披麻皴」走线，最细处银线不足半毫米——錾刀一滑，整块铜胎作废。',
      craft: '錾刻 · 走银 · 捂黑', build: mkInkbox },
    { name: '乌铜印章', en: 'Wutong Seal',
