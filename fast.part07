  /* ---------- 沿墙布局：11 座展柜贴墙环绕 ----------
     正方形厅里，正圆只能在四面墙各贴一点，中间必然空出三四米，
     柜子就变成"摆在房间中央"；改成贴墙的一圈：
     柜背离墙 0.21m，柜面统一朝向厅心，参观动线＝贴着柜子内侧走一整圈。
     南入口与西北长廊门前各留空档，进门、去长廊都不挡路。 */
  var WALL_GAP = 0.72;                    // 柜心到墙内面的距离
  var WI = HD - WALL_GAP;                 // 柜心所在的四条线（±WI）
  var LAYOUT = [
    { p: [ 3.60,  WI], n: [ 0, -1] },     // ① 南墙东 · 入口右手
    { p: [  WI,  3.05], n: [-1,  0] },     // ② 东墙南
    { p: [  WI, -0.30], n: [-1,  0] },     // ③ 东墙中
    { p: [  WI, -3.55], n: [-1,  0] },     // ④ 东墙北
    { p: [ 4.70, -WI], n: [ 0,  1] },     // ⑤ 北墙东
    { p: [ 1.30, -WI], n: [ 0,  1] },     // ⑥ 北墙中
    { p: [-2.30, -WI], n: [ 0,  1] },     // ⑦ 北墙西 · 让开长廊门口
    { p: [-WI, -4.30], n: [ 1,  0] },     // ⑧ 西墙北
    { p: [-WI, -0.90], n: [ 1,  0] },     // ⑨ 西墙中
    { p: [-WI,  2.50], n: [ 1,  0] },     // ⑩ 西墙南
    { p: [-3.60,  WI], n: [ 0, -1] }      // ⑪ 南墙西 · 入口左手
  ];
  EXHIBITS.forEach(function (E, i) {
    var L = LAYOUT[i];
    E.p = L.p;
    E.n = L.n;
    E.a = Math.atan2(L.n[0], L.n[1]);
  });

  /* ---------- 说明牌贴图 ---------- */
  function wrapText(x, text, maxW, lh, startY, fill) {
    var line = '', y = startY;
    x.fillStyle = fill;
    for (var i = 0; i < text.length; i++) {
      var test = line + text[i];
      if (x.measureText(test).width > maxW && line) {
        x.fillText(line, 48, y);
        line = text[i];
        y += lh;
      } else {
        line = test;
      }
    }
    if (line) x.fillText(line, 48, y);
    return y;
  }

  function plaqueTex(i) {
    var E = EXHIBITS[i];
    var W = 1024, H = 616;
    var o = newCanvas(W, H), x = o.x;

    // 米白纸质底
    var g = x.createLinearGradient(0, 0, W, H);
    g.addColorStop(0, '#efe9dc');
    g.addColorStop(0.55, '#e7dfd0');
    g.addColorStop(1, '#ded5c4');
    x.fillStyle = g; x.fillRect(0, 0, W, H);

    // 纸纹
    var r = rand(91 + i);
    for (var k = 0; k < 5200; k++) {
      var a = 0.012 + r() * 0.030;
      x.fillStyle = r() > 0.5 ? 'rgba(255,255,255,' + a + ')' : 'rgba(90,74,52,' + (a * 0.9) + ')';
      x.fillRect(r() * W, r() * H, 1 + r() * 3, 1 + r() * 1.6);
    }

    // 双线框
    x.strokeStyle = 'rgba(70,56,36,.55)'; x.lineWidth = 3;
    x.strokeRect(22, 22, W - 44, H - 44);
    x.strokeStyle = 'rgba(120,96,58,.42)'; x.lineWidth = 1.4;
    x.strokeRect(34, 34, W - 68, H - 68);

    // 编号
    x.fillStyle = '#8a6a3a';
    x.font = '600 30px "SF Mono", Consolas, monospace';
    x.fillText(pad2(i + 1) + ' / 11', 58, 100);

    // 工艺标签（右上）
    x.textAlign = 'right';
    x.fillStyle = 'rgba(96,76,48,.9)';
    x.font = '500 26px "PingFang SC","Microsoft YaHei",sans-serif';
    x.fillText(E.craft, W - 58, 100);
    x.textAlign = 'left';

    // 中文名
    x.fillStyle = '#141110';
    x.font = '500 68px "Songti SC","SimSun",serif';
    x.fillText(E.name, 56, 200);

    // 英文名
    x.fillStyle = '#5f5748';
    x.font = 'italic 400 28px "Songti SC","Times New Roman",serif';
    x.fillText(E.en, 58, 246);

    // 分隔
    x.fillStyle = 'rgba(122,96,58,.55)';
    x.fillRect(58, 272, 140, 3);

    // 年代 / 尺寸
    x.fillStyle = '#3d352a';
    x.font = '400 27px "PingFang SC","Microsoft YaHei",sans-serif';
    x.fillText(E.meta, 58, 316);

    // 正文
    x.fillStyle = '#2e281f';
    x.font = '400 28px "PingFang SC","Microsoft YaHei",sans-serif';
    var line = '', yy = 372, maxW = W - 116;
    for (var c = 0; c < E.desc.length; c++) {
      var test = line + E.desc[c];
      if (x.measureText(test).width > maxW && line) {
        x.fillText(line, 58, yy);
        line = E.desc[c];
        yy += 44;
      } else line = test;
    }
    if (line) x.fillText(line, 58, yy);

    // 页脚
    x.fillStyle = 'rgba(88,72,48,.7)';
    x.font = '400 20px "SF Mono", Consolas, monospace';
    x.fillText('WUTONG ZOUYIN · 乌铜走银传习馆', 58, H - 46);

    return o.c;
  }

  /* ---------- 光池贴图 ---------- */
  /* ---------- 顶灯光锥贴图 ---------- */
  function beamTex() {
    var o = newCanvas(32, 256), x = o.x;
    var g = x.createLinearGradient(0, 0, 0, 256);
    g.addColorStop(0.00, 'rgba(255,240,214,0.00)');
    g.addColorStop(0.06, 'rgba(255,236,204,0.62)');
    g.addColorStop(0.34, 'rgba(255,226,186,0.26)');
    g.addColorStop(0.72, 'rgba(255,216,172,0.08)');
    g.addColorStop(1.00, 'rgba(255,208,160,0.00)');
    x.fillStyle = g; x.fillRect(0, 0, 32, 256);
    return o.c;
  }

  /* ============================================================
     7. 展柜 + 展品 + 说明牌
     ============================================================ */
  var pickables = [];
  var exhibitNodes = [];

  var CASE = { w: 0.98, baseH: 0.92, glassH: 1.12 };
  CASE.topY = CASE.baseH + CASE.glassH;         // 2.04
  var OBJ_Y = 1.042;                            // 常态：器物底面
  var OBJ_S = 1.46;                             // 常态缩放
  var FOCUS_Y = 1.060;                          // 聚焦：悬浮高度
  var FOCUS_S = 3.20;                           // 聚焦：放大倍数
  var _fs = parseFloat(new URLSearchParams(location.search).get('fs'));
  if (!isNaN(_fs)) FOCUS_S = _fs;               // 调试：?fs=5 放大观察

  /* ---------- 柜体材质 ---------- */
  var caseBodyMat = new T.MeshStandardMaterial({ color: 0x121317, metalness: 0.42, roughness: 0.52, envMapIntensity: 0.90 });
  /* 细金属条（腰线 1cm、顶盖边 7mm）在画面里只有一两像素宽，
     镜面度太高就会逐帧亮暗跳；压一点反射、加一点粗糙度，亮度就稳了。 */
  var caseTrimMat = new T.MeshStandardMaterial({ color: 0x0a0b0e, metalness: 0.66, roughness: 0.40, envMapIntensity: 1.05 });
  var steelMat = new T.MeshStandardMaterial({ color: 0x9198a3, metalness: 0.92, roughness: 0.34, envMapIntensity: 1.20 });
  var ivoryMat = new T.MeshStandardMaterial({
    color: 0xdcd4c6, metalness: 0.03, roughness: 0.84,
    envMapIntensity: 0.7, emissive: 0x1d1813, emissiveIntensity: 1.0
  });
  var ledMat = new T.MeshBasicMaterial({ color: 0xfff0d8 });

  function makeGlassMat() {
    return new T.MeshPhysicalMaterial({
      color: 0xc2d6e8, metalness: 0.0, roughness: 0.115,
      transparent: true, opacity: 0.080, side: T.DoubleSide,
      depthWrite: false, envMapIntensity: 1.30,
      clearcoat: 1.0, clearcoatRoughness: 0.12
    });
  }

  /* ---------- GLB 展品：加载成功后替换程序化替身 ----------
     默认按展厅观感抬一档反射；?raw=1 时改为「保真导入」：
     不碰材质的任何外观参数，只让它避开全局 ACES / 雾，并换一张中性 IBL。
     ?glb=路径 可把任意 .glb 换进这一柜（file:// 下仍受 CORS 限制）。 */
  var _gltfLoader = null;
  var glbState = { total: 0, loaded: 0 };
  var GLB_RAW = /[?&]raw=1/.test(location.search);
  var GLB_OVERRIDE = new URLSearchParams(location.search).get('glb');
  var _rawEnv = null;

  /* 展厅那张 env 是暗金色、还预烘了 9 个高光点，金属进去必然发暖。
     保真模式另给一张中性灰阶环境，只提供照明，不写进材质参数。 */
  function makeRawEnv() {
    var c = document.createElement('canvas'); c.width = 256; c.height = 128;
    var x = c.getContext('2d');
    var g = x.createLinearGradient(0, 0, 0, 128);
    g.addColorStop(0.00, '#59616c');
    g.addColorStop(0.46, '#333941');
    g.addColorStop(0.52, '#24282f');
    g.addColorStop(1.00, '#0e1116');
    x.fillStyle = g; x.fillRect(0, 0, 256, 128);
    var s = x.createRadialGradient(64, 32, 2, 64, 32, 48);
    s.addColorStop(0, 'rgba(214,226,244,.42)');
    s.addColorStop(1, 'rgba(214,226,244,0)');
    x.fillStyle = s; x.fillRect(0, 0, 256, 128);
    var tex = new T.CanvasTexture(c);
    tex.mapping = T.EquirectangularReflectionMapping;
    tex.encoding = T.sRGBEncoding;
    var pm = new T.PMREMGenerator(renderer);
    pm.compileEquirectangularShader();
    var rt = pm.fromEquirectangular(tex);
    tex.dispose(); pm.dispose();
    return rt.texture;
  }

  function applyRawGlb(root) {
    if (!_rawEnv) _rawEnv = makeRawEnv();
    root.traverse(function (o) {
      if (!o.isMesh || !o.material) return;
      var ms = Array.isArray(o.material) ? o.material : [o.material];
      ms.forEach(function (m) {
        m.toneMapped = false;     // 跳过 ACES，基色不被压暗 / 降饱和
        m.fog = false;            // 不吃展厅的暖棕雾
        m.envMap = _rawEnv;       // 只换照明环境
        m.needsUpdate = true;
        // color / metalness / roughness / map / envMapIntensity 一律保持文件原值
      });
    });
  }

  /* 外部模型的尺度千差万别：等比缩到指定高度、x/z 居中、底面贴 y=0。
     只改 transform，不动顶点、UV、法线或材质，形状与质感完全保留。 */
  function fitGlbToCase(gscene, targetH) {
    var b = new T.Box3().setFromObject(gscene);
    var sz = new T.Vector3(); b.getSize(sz);
    var ctr = new T.Vector3(); b.getCenter(ctr);
    gscene.position.x -= ctr.x;
    gscene.position.y -= b.min.y;
    gscene.position.z -= ctr.z;
    var wrap = new T.Group();
    wrap.scale.setScalar(targetH / (sz.y || 1));
    wrap.add(gscene);
    return wrap;
  }

  function loadGlb(url, host, opts) {
    opts = opts || {};
    var raw = GLB_RAW || !!opts.raw;
    if (!T.GLTFLoader) { console.warn('[glb] GLTFLoader 缺失，保留程序化模型'); return; }
    _gltfLoader = _gltfLoader || new T.GLTFLoader();
    glbState.total++;

    function onOk(g) {
      while (host.children.length) host.remove(host.children[0]);
      g.scene.traverse(function (o) {
        if (o.isMesh && o.material) {
          if (!raw) o.material.envMapIntensity = 2.2;   // 展厅观感：抬反射
          o.frustumCulled = true;
        }
      });
      var node = opts.fit ? fitGlbToCase(g.scene, opts.fit) : g.scene;
      if (raw) applyRawGlb(node);
      host.add(node);
      if (opts.fit) {
        var __tone = new URLSearchParams(location.search).get('tone');
        if (__tone !== '0') {
          var __dark = (__tone !== '1');
          node.traverse(function (o) {
            if (!o.isMesh || !o.material) return;
            var ms = Array.isArray(o.material) ? o.material : [o.material];
            ms.forEach(function (m) {
              if (m.color) m.color.setRGB(__dark ? 0.24 : 0.42,
                                          __dark ? 0.26 : 0.45,
                                          __dark ? 0.30 : 0.50);
              if (m.specularColor) m.specularColor.setRGB(0.90, 0.94, 1.0);
              if ('specularIntensity' in m) m.specularIntensity = __dark ? 0.35 : 0.45;
              if ('envMapIntensity' in m) m.envMapIntensity = __dark ? 0.85 : 1.0;
              m.needsUpdate = true;
            });
          });
        }
      }
      glbState.loaded++;
      console.log('[glb] 模型已载入 (' + glbState.loaded + '/' + glbState.total + ')' + (raw ? ' [raw]' : ''));
    }
    function onFail(err) { console.warn('[glb] 模型加载失败，保留程序化模型', (err && err.message) || err); }

    /* 大贴图在软件渲染环境里走 createImageBitmap 可能挂起；先 fetch 再 parse，
       就能在构造 GLTFParser 之前临时屏蔽它，让贴图改用 <img> 解码，像素一致。 */
    fetch(url).then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.arrayBuffer();
    }).then(function (buf) {
      var saved = window.createImageBitmap;
      try { window.createImageBitmap = undefined; } catch (e) {}
      try {
        _gltfLoader.parse(buf, '', onOk, onFail);
      } finally {
        try { window.createImageBitmap = saved; } catch (e) {}
      }
    }).catch(onFail);
  }

  var LED_TEX = texOf(softStripTexture(256, 64, 0.62));

  function buildPedestal(i) {
    var E = EXHIBITS[i];
    var grp = new T.Group();

    /* ---- 黑色基座 ---- */
    var baseBody = new T.Mesh(new T.BoxGeometry(CASE.w, CASE.baseH, CASE.w), caseBodyMat);
    baseBody.position.y = CASE.baseH / 2;
    grp.add(baseBody);

    // 踢脚收进
    var foot = new T.Mesh(new T.BoxGeometry(CASE.w - 0.07, 0.055, CASE.w - 0.07), caseTrimMat);
    foot.position.y = 0.0275;
    grp.add(foot);

    // 基座腰线（细不锈钢带）
    var waist = new T.Mesh(new T.BoxGeometry(CASE.w + 0.006, 0.010, CASE.w + 0.006), steelMat);
    waist.position.y = 0.315;
    grp.add(waist);

    // 基座顶面钢板
    var deck = new T.Mesh(new T.BoxGeometry(CASE.w + 0.014, 0.022, CASE.w + 0.014), caseTrimMat);
    deck.position.y = CASE.baseH - 0.011;
    grp.add(deck);

    /* ---- 玻璃罩 ---- */
    var glassMat = makeGlassMat();
    var glass = new T.Mesh(new T.BoxGeometry(CASE.w - 0.024, CASE.glassH, CASE.w - 0.024), glassMat);
    glass.position.y = CASE.baseH + CASE.glassH / 2;
    grp.add(glass);

    // 四角立柱
    [-1, 1].forEach(function (sx) {
      [-1, 1].forEach(function (sz) {
        var post = new T.Mesh(new T.BoxGeometry(0.024, CASE.glassH + 0.02, 0.024), caseTrimMat);
        post.position.set(sx * (CASE.w / 2 - 0.012), CASE.baseH + CASE.glassH / 2, sz * (CASE.w / 2 - 0.012));
        grp.add(post);
      });
    });

    // 顶盖 + 顶盖不锈钢边
    var cap = new T.Mesh(new T.BoxGeometry(CASE.w + 0.034, 0.058, CASE.w + 0.034), caseTrimMat);
    cap.position.y = CASE.topY + 0.029;
    grp.add(cap);
    var capEdge = new T.Mesh(new T.BoxGeometry(CASE.w + 0.038, 0.007, CASE.w + 0.038), steelMat);
    capEdge.position.y = CASE.topY + 0.0035;
    grp.add(capEdge);

    // 柜内顶部灯板（暖白发光面）
    var led = new T.Mesh(new T.PlaneGeometry(CASE.w - 0.42, CASE.w - 0.42),
      new T.MeshBasicMaterial({
        map: LED_TEX, color: 0xe8cda8,
        transparent: true, depthWrite: false
      }));
    led.rotation.x = Math.PI / 2;
    led.position.y = CASE.topY - 0.016;
    grp.add(led);

    // 灯板下的柔光晕
    var ledGlow = new T.Mesh(
      new T.PlaneGeometry(0.86, 0.86),
      new T.MeshBasicMaterial({
        map: poolTexture, color: 0xffd7a2, transparent: true, opacity: 0.18,
        blending: T.AdditiveBlending, depthWrite: false, side: T.DoubleSide
      })
    );
    ledGlow.rotation.x = Math.PI / 2;
    ledGlow.position.y = CASE.topY - 0.030;
    grp.add(ledGlow);

    /* ---- 柜内米白台芯 ---- */
    var deckIn = new T.Mesh(new T.BoxGeometry(0.56, 0.104, 0.56), ivoryMat);
    deckIn.position.y = OBJ_Y - 0.052;
    grp.add(deckIn);
    // 台芯顶面的柔光
    var deckGlow = new T.Mesh(
      new T.CircleGeometry(0.315, 30),
      new T.MeshBasicMaterial({
        map: poolTexture, color: 0xfff0d8, transparent: true, opacity: 0.22,
        blending: T.AdditiveBlending, depthWrite: false
      })
    );
    deckGlow.rotation.x = -Math.PI / 2;
    deckGlow.position.y = OBJ_Y + 0.0015;
    grp.add(deckGlow);

    // 器物接触阴影
    var shadow = new T.Mesh(
      new T.CircleGeometry(0.30, 24),
      new T.MeshBasicMaterial({ map: poolTexture, color: 0x000000, transparent: true, opacity: 0.55, depthWrite: false })
    );
    shadow.rotation.x = -Math.PI / 2;
    shadow.position.y = OBJ_Y + 0.0022;
    grp.add(shadow);

    /* ---- 说明牌：柜身正面，上沿贴面、下沿外挑成斜台，站着就能读 ---- */
    var labelW = 0.66, labelH = labelW * 0.6;
    var LTILT = -0.34;                       // 上仰 19°，正对站姿视线
    var labelGrp = new T.Group();
    labelGrp.position.set(0, 0.918, CASE.w / 2 + 0.003);
    labelGrp.rotation.x = LTILT;
    grp.add(labelGrp);

    var labelBack = new T.Mesh(
      new T.BoxGeometry(labelW + 0.018, labelH + 0.018, 0.009),
      caseTrimMat
    );
    labelBack.position.set(0, -labelH / 2, -0.005);
    labelGrp.add(labelBack);

    var label = new T.Mesh(
      new T.PlaneGeometry(labelW, labelH),
      new T.MeshBasicMaterial({ map: texOf(plaqueTex(i)), color: 0xece6d8 })
    );
    label.position.set(0, -labelH / 2, 0.0006);
    labelGrp.add(label);

    // 斜台下的承托小台沿
    var ledge = new T.Mesh(
      new T.BoxGeometry(labelW + 0.040, 0.048, 0.145),
      caseTrimMat
    );
    ledge.position.set(0, 0.518, CASE.w / 2 + 0.075);
    grp.add(ledge);

    /* ---- 展品 ---- */
    var obj = E.build();
    obj.position.y = OBJ_Y;
    obj.scale.setScalar(OBJ_S);
    grp.add(obj);
    /* ?glb= 只覆盖 ⑤ 号柜的花瓶；⑦ 号柜由 ?ewer= 选版本 */
    var glbUrl = (i === 4 && GLB_OVERRIDE) ? GLB_OVERRIDE : E.glb;
    if (glbUrl) {
      obj.userData.glb = true;
      obj.userData.glbRaw = !!E.glbRaw;
      loadGlb(glbUrl, obj, { fit: E.glbFit, raw: E.glbRaw });
    }

    /* ---- 拾取体 ---- */
    var pick = new T.Mesh(
      new T.BoxGeometry(CASE.w + 0.10, CASE.topY + 0.10, CASE.w + 0.10),
      new T.MeshBasicMaterial({ visible: false })
    );
    pick.position.y = (CASE.topY + 0.10) / 2;
    pick.userData.exhibit = i;
    grp.add(pick);
    pickables.push(pick);

    /* ---- 地面光池：沿参观方向拉长，像展柜在抛光地面上的反射 ---- */
    var pool = new T.Mesh(
      new T.PlaneGeometry(1.55, 2.6),
      new T.MeshBasicMaterial({
        map: poolTexture, color: 0xffd6a6, transparent: true, opacity: 0.20,
        blending: T.AdditiveBlending, depthWrite: false
      })
    );
    pool.rotation.x = -Math.PI / 2;
    pool.position.set(0, 0.012, 0.55);
    grp.add(pool);

    /* ---- 聚焦时的光晕（默认透明） ---- */
    var halo = new T.Mesh(
      new T.PlaneGeometry(1.5, 1.5),
      new T.MeshBasicMaterial({
        map: poolTexture, color: 0xffe2b8, transparent: true, opacity: 0,
        blending: T.AdditiveBlending, depthWrite: false
      })
    );
    halo.position.set(0, 1.55, -0.02);
    grp.add(halo);

    /* ---- 摆位与朝向 ---- */
    var ang = Math.atan2(E.n[0], E.n[1]);
    grp.position.set(E.p[0], 0, E.p[1]);
    grp.rotation.y = ang;
    scene.add(grp);

    exhibitNodes.push({
      group: grp, pick: pick, obj: obj,
      glass: glassMat, pool: pool, halo: halo,
      spin: Math.random() * Math.PI * 2, glow: 0
    });
  }

  for (var ei = 0; ei < EXHIBITS.length; ei++) buildPedestal(ei);

  /* ============================================================
     8. 灯光
     ============================================================ */
  scene.add(new T.HemisphereLight(0x8b8378, 0x2f2a25, 1.35));
  // 极轻的环境光只托暗部；再多就把黑铜压成灰塑料
  scene.add(new T.AmbientLight(0xd8c7ad, 0.10));

  var keyLight = new T.DirectionalLight(0xffe6c8, 0.85);
  keyLight.position.set(-5, 7.5, 4);
  scene.add(keyLight);

  /* ---------- 天花轨道 + 轨道射灯 ---------- */
  var M_FIXTURE = new T.MeshStandardMaterial({ color: 0x0e1013, metalness: 0.78, roughness: 0.32, envMapIntensity: 1.2 });
  var M_LENS = new T.MeshBasicMaterial({ color: 0xfff1d8 });
  var RAIL_Y = HALL_CEIL - 0.40;

  /* 灯轨：沿墙一圈的矩形轨，位置正好落在每盏灯的吊点上（柜心 + 0.78m） */
  var RAIL_IN = WALL_GAP + 0.78;
  var railX = HW - RAIL_IN, railZ = HD - RAIL_IN;
  function railBar(w, d, bx, bz) {
    var m = new T.Mesh(new T.BoxGeometry(w, 0.042, d), M_FIXTURE);
    m.position.set(bx, RAIL_Y, bz);
    scene.add(m);
  }
  railBar(railX * 2 + 0.05, 0.044, 0, railZ);
  railBar(railX * 2 + 0.05, 0.044, 0, -railZ);
  railBar(0.044, railZ * 2, railX, 0);
  railBar(0.044, railZ * 2, -railX, 0);

  exhibitNodes.forEach(function (n, i) {
    var E = EXHIBITS[i];
    var nx = E.n[0], nz = E.n[1], nl = Math.hypot(nx, nz) || 1;
    nx /= nl; nz /= nl;

    /* ---- 天花射灯：灯体挂在轨道上，斜向下打向展柜 ---- */
    var from = new T.Vector3(E.p[0] + nx * 0.78, RAIL_Y - 0.10, E.p[1] + nz * 0.78);
    var to = new T.Vector3(E.p[0], CASE.topY + 0.10, E.p[1]);
    var dir = to.clone().sub(from).normalize();

    var stem = new T.Mesh(new T.CylinderGeometry(0.010, 0.010, 0.14, 6), M_FIXTURE);
    stem.position.set(from.x, RAIL_Y, from.z);
    stem.rotation.z = 0;
    scene.add(stem);

    var body = new T.Mesh(new T.CylinderGeometry(0.052, 0.070, 0.16, 16), M_FIXTURE);
    body.position.copy(from);
    body.quaternion.setFromUnitVectors(new T.Vector3(0, -1, 0), dir);
    scene.add(body);

    var lens = new T.Mesh(new T.CircleGeometry(0.058, 18), M_LENS);
    lens.position.copy(from).addScaledVector(dir, 0.072);
    lens.quaternion.setFromUnitVectors(new T.Vector3(0, 0, 1), dir);
    scene.add(lens);

    /* ---- 柜内顶灯：真正的照明，紧贴柜顶灯板 ---- */
    var inFrom = new T.Vector3(E.p[0] + nx * 0.06, CASE.topY - 0.075, E.p[1] + nz * 0.06);
    var sp = new T.SpotLight(0xffeccf, 11.0, 3.2, 0.70, 0.55, 1.20);
    sp.position.copy(inFrom);
    sp.target.position.set(E.p[0], OBJ_Y + 0.16, E.p[1]);
    scene.add(sp, sp.target);
  });

  /* ---------- 聚焦时的高光掠过（让银线闪） ---------- */
  var sparkA = new T.PointLight(0xdcebff, 0, 3.2, 2.0);
  var sparkB = new T.PointLight(0xffd9a4, 0, 3.2, 2.0);
  scene.add(sparkA, sparkB);

  /* 展品材质：环境反射再抬一档（材质保真的外部模型跳过） */
  exhibitNodes.forEach(function (n) {
    if ((GLB_RAW && n.obj.userData.glb) || n.obj.userData.glbRaw) return;
    n.obj.traverse(function (o) {
      if (o.isMesh && o.material && o.material.isMeshStandardMaterial) {
        o.material.envMapIntensity = 1.5;
      }
    });
  });

  /* ============================================================
     9. 相机控制
     ============================================================ */
  var state = {
    yaw: Math.PI, pitch: -0.105,
    pos: new T.Vector3(0, EYE, HD + 6.2),
    focus: -1
  };
  var target = { yaw: Math.PI, pitch: -0.105, pos: state.pos.clone() };
  var keys = {};
  var camAnim = null;
  var AERIAL = false;

  function applyCamera() {
    if (AERIAL) return;
    camera.position.copy(state.pos);
    camera.position.y = EYE;
    var cp = Math.cos(state.pitch);
    camera.lookAt(
      state.pos.x + Math.sin(state.yaw) * cp,
      EYE + Math.sin(state.pitch),
      state.pos.z + Math.cos(state.yaw) * cp
    );
  }
  applyCamera();

  // 拖拽环视
  var dragging = false, lastX = 0, lastY = 0, downX = 0, downY = 0, downT = 0;

  canvas.addEventListener('pointerdown', function (e) {
    dragging = true;
    lastX = downX = e.clientX;
    lastY = downY = e.clientY;
    downT = performance.now();
    canvas.setPointerCapture && canvas.setPointerCapture(e.pointerId);
  });

  canvas.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    var dx = e.clientX - lastX, dy = e.clientY - lastY;
    lastX = e.clientX; lastY = e.clientY;
    target.yaw -= dx * 0.0032;
    target.pitch = clamp(target.pitch - dy * 0.0026, -0.85, 0.62);
  });

  function endDrag(e) {
    if (!dragging) return;
    dragging = false;
    var moved = Math.abs(e.clientX - downX) + Math.abs(e.clientY - downY);
    var quick = performance.now() - downT < 450;
    if (moved < 8 && quick) tryPick(e.clientX, e.clientY);
  }
  canvas.addEventListener('pointerup', endDrag);
  canvas.addEventListener('pointercancel', function () { dragging = false; });

  // 键盘
  window.addEventListener('keydown', function (e) {
    keys[e.code] = true;
    if (e.code === 'Escape') unfocus();
    if (e.code.indexOf('Arrow') === 0 || e.code === 'Space') e.preventDefault();
  });
  window.addEventListener('keyup', function (e) { keys[e.code] = false; });
  // 切走窗口时清空按键：否则"按着 W 切出去再回来"会一直往前走
  window.addEventListener('blur', function () { keys = {}; });
  document.addEventListener('visibilitychange', function () { if (document.hidden) keys = {}; });
  // 页面被嵌在 iframe 里时先把焦点抢回来，键盘事件才发得到这里
  if (window.self !== window.top) {
    try { window.focus(); } catch (err) {}
    document.addEventListener('pointerdown', function () { try { window.focus(); } catch (err) {} }, true);
  }

  // 拾取
  var raycaster = new T.Raycaster();
  var ndc = new T.Vector2();

  function tryPick(px, py) {
    if (window.__CORR_PICK && window.__CORR_PICK(px, py)) return;
    ndc.x = (px / window.innerWidth) * 2 - 1;
    ndc.y = -(py / window.innerHeight) * 2 + 1;
    raycaster.setFromCamera(ndc, camera);
    var hits = raycaster.intersectObjects(pickables, false);
    if (hits.length) focus(hits[0].object.userData.exhibit);
  }

  /* ---------- 聚焦 / 返回 ---------- */
  var card = $('#card');

  function focusPose(i) {
    var E = EXHIBITS[i];
    var nx = E.n[0], nz = E.n[1];
    var len = Math.hypot(nx, nz) || 1;
    nx /= len; nz /= len;
    return {
      pos: new T.Vector3(E.p[0] + nx * 1.80, EYE, E.p[1] + nz * 1.80),
      yaw: Math.atan2(-nx, -nz),
      pitch: -0.165
    };
  }

  function focus(i) {
    if (i < 0 || i >= EXHIBITS.length) return;
    if (state.focus !== i) {
      if (state.focus < 0) state._back = { pos: state.pos.clone(), yaw: target.yaw, pitch: target.pitch };
      state.focus = i;
    }
    var p = focusPose(i);
    target.pos.copy(p.pos);
    target.yaw = state.yaw + angDiff(state.yaw, p.yaw);
    target.pitch = p.pitch;

    var E = EXHIBITS[i];
    $('#cardIdx').textContent = pad2(i + 1) + ' / 11';
    $('#cardName').textContent = E.name;
    $('#cardEn').textContent = E.en;
    $('#cardMeta').textContent = E.meta;
    $('#cardCraft').textContent = E.craft;
    $('#cardDesc').textContent = E.desc;
    card.classList.add('on');
    $('#focusHint').classList.remove('on');
  }

  function unfocus() {
    if (state.focus < 0) return;
    state.focus = -1;
    card.classList.remove('on');
    if (state._back) {
      target.pos.copy(state._back.pos);
      target.yaw = state.yaw + angDiff(state.yaw, state._back.yaw);
      target.pitch = state._back.pitch;
    }
  }
  $('#cardBack').addEventListener('click', unfocus);

  /* ---------- 移动与碰撞 ---------- */
  var BLOCK = [];
  EXHIBITS.forEach(function (E) { BLOCK.push({ x: E.p[0], z: E.p[1], r: 0.92 }); });

  /* 门楼两侧的实墙体（AABB，用于阻止穿墙） */
  var GATE_WALLS = [
    { x0: -HW - 2, x1: -DOOR.w / 2 + 0.02, z0: HD - 0.42, z1: HD + 0.52 },
    { x0: DOOR.w / 2 - 0.02, x1: HW + 2, z0: HD - 0.42, z1: HD + 0.52 }
  ];

  function pushBox(p, b, r) {
    var cx = clamp(p.x, b.x0, b.x1), cz = clamp(p.z, b.z0, b.z1);
    var dx = p.x - cx, dz = p.z - cz;
    var d = Math.hypot(dx, dz);
    if (d >= r) return;
    if (d > 0.0001) {
      p.x = cx + (dx / d) * r;
      p.z = cz + (dz / d) * r;
    } else {
      // 已进入内部：沿最短方向推出
      var dl = p.x - b.x0, dr = b.x1 - p.x, dn = p.z - b.z0, df = b.z1 - p.z;
      var m = Math.min(dl, dr, dn, df);
      if (m === dl) p.x = b.x0 - r;
      else if (m === dr) p.x = b.x1 + r;
      else if (m === dn) p.z = b.z0 - r;
      else p.z = b.z1 + r;
    }
  }

  function collide(p) {
    if (window.__IN_CONNECTED && window.__IN_CONNECTED(p)) {
      if (window.__CORR_COLLIDE) window.__CORR_COLLIDE(p);
      return;
    }
    var inDoor = Math.abs(p.x) < DOOR.w / 2 - 0.22;
    var inNDoor = Math.abs(p.x - NX) < NW / 2 - 0.26;

    // 纵向活动范围：厅内 → 门洞 → 门外广场；走进北侧门洞则进入过厅
    p.z = clamp(p.z, inNDoor ? PZ1 + 0.50 : -HD + 0.55, HD + 7.2);

    // 左右收边
    if (p.z > HD + 0.55) p.x = clamp(p.x, -2.55, 2.55);
    else if (p.z < -HD + 0.30) p.x = clamp(p.x, NX - NW / 2 + 0.26, NX + NW / 2 - 0.26);
    else p.x = clamp(p.x, -HW + 0.55, HW - 0.55);

    // 门楼墙体阻挡
    for (var gw = 0; gw < GATE_WALLS.length; gw++) pushBox(p, GATE_WALLS[gw], 0.34);

    // 若在门洞通道内，收窄到洞口
    if (p.z > HD - 0.50 && p.z < HD + 0.55 && inDoor) {
      p.x = clamp(p.x, -DOOR.w / 2 + 0.30, DOOR.w / 2 - 0.30);
    }

    // 门内红绒隔离绳（中间留通行口）
    var ropeZ = GZ - 0.92;
    if (p.z < ropeZ + 0.20 && p.z > ropeZ - 0.22 && Math.abs(p.x) > 0.50) {
      p.z = p.z > ropeZ ? ropeZ + 0.20 : ropeZ - 0.22;
    }

    // 影壁 + 屏前陈设（圈椅、小几、梅瓶）
    var SX0 = -2.90, SX1 = 2.90, SZ0 = -0.45, SZ1 = 1.94;
    if (p.x > SX0 && p.x < SX1 && p.z > SZ0 && p.z < SZ1) {
      var dL = p.x - SX0, dR = SX1 - p.x, dB = p.z - SZ0, dF = SZ1 - p.z;
      var mn = Math.min(dL, dR, dB, dF);
      if (mn === dF) p.z = SZ1;
      else if (mn === dB) p.z = SZ0;
      else if (mn === dL) p.x = SX0;
      else p.x = SX1;
    }
    // 基座
    for (var i = 0; i < BLOCK.length; i++) {
      var b = BLOCK[i];
      var dx = p.x - b.x, dz = p.z - b.z;
      var d = Math.hypot(dx, dz);
      if (d < b.r && d > 0.0001) {
        p.x = b.x + (dx / d) * b.r;
        p.z = b.z + (dz / d) * b.r;
      }
    }
  }

  /* ---------- 走过北侧门洞 → 进入长廊 ---------- */
  var leaving = false;
  var doorLock = performance.now() + 900;   // 刚开局/刚从长廊回来时先不触发
  function leaveToCorridor() { /* 连通版：走过北门就是长廊，不换页 */ }

  /* ============================================================
     10. 平面导览
     ============================================================ */
  var MM = { w: 168, h: 168, pad: 8 };
  var mmScale = (MM.w - MM.pad * 2) / ROOM.w;
  function mmX(x) { return MM.w / 2 + x * mmScale; }
  function mmY(z) { return MM.h / 2 + z * mmScale; }

  (function buildDots() {
    var g = $('#mmDots');
    EXHIBITS.forEach(function (E, i) {
      var c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('cx', mmX(E.p[0]));
      c.setAttribute('cy', mmY(E.p[1]));
      c.setAttribute('r', 2.1);
      c.setAttribute('class', 'mm-dot');
      g.appendChild(c);
    });
  })();

  var mmMe = $('#mmMe'), mmDir = $('#mmDir'), mmDotEls = $$('#mmDots circle');

  function updateMinimap() {
    mmMe.setAttribute('transform',
      'translate(' + mmX(clamp(state.pos.x, -HW, HW)) + ',' + clamp(mmY(state.pos.z), 9.0, MM.h - 9.0) + ')');
    var deg = -state.yaw * 180 / Math.PI + 180;
    mmDir.setAttribute('transform', 'rotate(' + deg + ')');
    mmDotEls.forEach(function (el, i) {
      el.classList.toggle('on', i === state.focus);
    });
  }

  /* ============================================================
     11. 主循环
     ============================================================ */
  var lastT = 0, firstFrame = true;

  // 开场：从院中缓缓走近门楼（按任意方向键或深链定位则跳过）
  var intro = {
    on: !STILL && !/[?&](pos|aerial)=/.test(location.search),
    t: 0, dur: 4.6,
    z0: HD + 6.2, z1: HD + 3.3, p0: 0.02, p1: -0.06
  };

  function frame(t) {
    var dt = Math.min(0.05, (t - lastT) / 1000 || 0.016);
    lastT = t;

    if (intro.on) {
      if (keys.KeyW || keys.KeyS || keys.KeyA || keys.KeyD || state.focus >= 0) {
        intro.on = false;
      } else {
        intro.t = Math.min(1, intro.t + dt / intro.dur);
        var ie = easeInOut(intro.t);
        state.pos.z = target.pos.z = lerp(intro.z0, intro.z1, ie);
        state.pitch = target.pitch = lerp(intro.p0, intro.p1, ie);
        if (intro.t >= 1) intro.on = false;
      }
    }

    // 移动（聚焦时禁用）
    if (!AERIAL && state.focus < 0 && !leaving) {
      var fwd = 0, side = 0;
      if (keys.KeyW || keys.ArrowUp) fwd += 1;
      if (keys.KeyS || keys.ArrowDown) fwd -= 1;
      if (keys.KeyA || keys.ArrowLeft) side -= 1;
      if (keys.KeyD || keys.ArrowRight) side += 1;
      if (fwd || side) {
        var spd = 3.3 * dt;
        var sy = Math.sin(target.yaw), cy = Math.cos(target.yaw);
        var np = target.pos.clone();
        // 右向量 = (-cos yaw, sin yaw)：D 向画面右、A 向画面左
        np.x += (sy * fwd - cy * side) * spd;
        np.z += (cy * fwd + sy * side) * spd;
        collide(np);
        target.pos.copy(np);
      }
    }

    /* ---- 展品：常态缓缓自转，聚焦时升起放大、快速旋转 ---- */
    for (var ni = 0; ni < exhibitNodes.length; ni++) {
      var nd = exhibitNodes[ni];
      var on = (ni === state.focus);

      nd.obj.position.y = damp(nd.obj.position.y, on ? FOCUS_Y : OBJ_Y, 6.0, dt);
      nd.obj.scale.setScalar(damp(nd.obj.scale.x, on ? FOCUS_S : OBJ_S, 5.2, dt));

      nd.spin += dt * (on ? 0.38 : 0.050);
      nd.obj.rotation.y = nd.spin;

      nd.glass.opacity = damp(nd.glass.opacity, on ? 0.020 : 0.085, 7, dt);
      nd.glow = damp(nd.glow, on ? 1 : 0, 6, dt);
      nd.halo.material.opacity = nd.glow * 0.26;
      nd.pool.material.opacity = 0.20 + nd.glow * 0.30;
    }

    /* ---- 聚焦时的两盏「掠过光」：绕着器物转，银线扫到就闪 ---- */
    if (state.focus >= 0) {
      var FE = EXHIBITS[state.focus];
      var fx = FE.p[0], fz = FE.p[1];
      var aa = t * 0.00085;
      sparkA.position.set(fx + Math.cos(aa) * 1.05, FOCUS_Y + 0.62, fz + Math.sin(aa) * 1.05);
      sparkB.position.set(fx - Math.cos(aa * 1.35 + 1.1) * 0.95, FOCUS_Y + 0.30, fz - Math.sin(aa * 1.35 + 1.1) * 0.95);
      sparkA.intensity = damp(sparkA.intensity, 10.5, 5, dt);
      sparkB.intensity = damp(sparkB.intensity, 5.5, 5, dt);
    } else {
      sparkA.intensity = damp(sparkA.intensity, 0, 6, dt);
      sparkB.intensity = damp(sparkB.intensity, 0, 6, dt);
    }

    state.pos.x = damp(state.pos.x, target.pos.x, 8, dt);
    state.pos.z = damp(state.pos.z, target.pos.z, 8, dt);
    state.yaw = damp(state.yaw, target.yaw, 9, dt);
    state.pitch = damp(state.pitch, target.pitch, 9, dt);

    // 走进门洞：切到长廊
    /* 连通版：删掉换页触发，玩家直接走过门洞 */

    applyCamera();
    updateMinimap();

    if (window.__CORR_TICK) window.__CORR_TICK(dt, t * 0.001);
    renderer.autoClear = true;
    renderer.toneMappingExposure = 1.28;
    renderer.render(scene, camera);
    if (window.__CORR) {
      renderer.autoClear = false;
      renderer.toneMappingExposure = window.__CORR_EXPOSURE || 0.95;
      renderer.render(window.__CORR.scene, camera);
      renderer.autoClear = true;
      renderer.toneMappingExposure = 1.28;
    }

    if (firstFrame) {
      firstFrame = false;
      setTimeout(function () {
        var ld = $('#loader');
        if (ld) { ld.classList.add('off'); setTimeout(function () { ld.style.display = 'none'; }, 1000); }
        var eh = $('#enterHint');
        if (eh) { eh.classList.add('on'); setTimeout(function () { eh.classList.remove('on'); }, 2600); }
      }, 260);
    }

    if (!STILL || ++stillCount < stillMax) requestAnimationFrame(frame);
  }

  /* ============================================================
     12. 尺寸 / 深链
     ============================================================ */
  function resize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }
  window.addEventListener('resize', resize);

  var q = new URLSearchParams(location.search);
  var qf = parseInt(q.get('frames'), 10);
  if (!isNaN(qf) && qf > 0) stillMax = qf;


  // ?spot=N 直达第 N 件（0 起）
  var qi = parseInt(q.get('spot'), 10);
  if (!isNaN(qi) && qi >= 0 && qi < EXHIBITS.length) {
    var fp = focusPose(qi);
    state.pos.copy(fp.pos);
    target.pos.copy(fp.pos);
    state.yaw = target.yaw = fp.yaw;
    state.pitch = target.pitch = fp.pitch;
    focus(qi);
    applyCamera();
  }

  // ?aerial=1 俯视平面
  if (q.get('aerial')) {
    AERIAL = true;
    var av = q.get('aerial');
    if (av === 'hall') {
      camera.position.set(0, 24, 4.6); camera.lookAt(0, 0, 0.3); camera.fov = 54;
    } else if (av === 'corridor') {
      camera.position.set(-22, 26, -9); camera.lookAt(-22, 0, -11); camera.fov = 52;
    } else {
      camera.position.set(-14, 32, 2); camera.lookAt(-14, 0, -2); camera.fov = 58;
    }
    camera.updateProjectionMatrix();
    CEIL_HIDE.forEach(function (o) { o.visible = false; });
    scene.fog = null;
    var mmEl = $('#minimap'); if (mmEl) mmEl.style.display = 'none';
    var tp = $('#tips'); if (tp) tp.style.display = 'none';
    var htEl = $('#hudTitle'); if (htEl) htEl.style.display = 'none';
  }

  // ?pos=x,z&yaw=deg
  var qpos = q.get('pos');
  if (qpos) {
    var parts = qpos.split(',').map(parseFloat);
    if (parts.length >= 2) {
      state.pos.set(parts[0], EYE, parts[1]);
      target.pos.copy(state.pos);
    }
  }
  var qyaw = parseFloat(q.get('yaw'));
  if (!isNaN(qyaw)) {
    state.yaw = target.yaw = qyaw * Math.PI / 180;
  }
  var qpitch = parseFloat(q.get('pitch'));
  if (!isNaN(qpitch)) {
    state.pitch = target.pitch = qpitch * Math.PI / 180;
  }

  // ?from=corridor：从长廊退回本厅，暗场淡入
  if (/[?&]from=corridor/.test(location.search)) {
    var v0 = $('#veil');
    if (v0) {
      v0.style.transition = 'none';
      v0.style.opacity = '1';
      setTimeout(function () {
        v0.style.transition = '';
        v0.style.opacity = '';
        v0.classList.remove('on');
      }, 220);
    }
    var eh0 = $('#enterHint');
    if (eh0) eh0.style.display = 'none';
  }

  window.__HALL = {
    T: T, renderer: renderer, scene: scene, camera: camera,
    state: state, target: target, keys: keys,
    EYE: EYE, ROOM: ROOM, HW: HW, HD: HD, NX: NX, NW: NW, PZ1: PZ1,
    BLOCK: BLOCK,
    CEIL_HIDE: CEIL_HIDE
  };
  applyCamera();
  resize();
  requestAnimationFrame(frame);

  // 无头 / 极简环境兜底
  window.addEventListener('load', function () {
    setTimeout(function () {
      var ld = $('#loader');
      if (ld && !ld.classList.contains('off')) {
        ld.classList.add('off');
        setTimeout(function () { ld.style.display = 'none'; }, 800);
      }
    }, 3000);
  });


})();

</script>
<script>
/* ---------- 0. 引擎：复用展厅的 Three.js r147（不再加载 r160 ESM） ---------- */
const THREE = window.__HALL.T;
const PARAMS = new URLSearchParams(location.search);
const FROM_HALL = true;
const errBox = document.getElementById('err');
/* ---------- 1. 工具 ---------- */
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const lerp = (a, b, t) => a + (b - a) * t;
const rnd = (a, b) => a + Math.random() * (b - a);

function makeCanvas(w, h, fn) {
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  fn(c.getContext('2d'), w, h);
  return c;
}
function canvasTex(c, repeat) {
  const t = new THREE.CanvasTexture(c);
  t.colorSpace = THREE.SRGBColorSpace;
  t.anisotropy = Math.min(8, renderer.capabilities.getMaxAnisotropy());
  if (repeat) { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(repeat[0], repeat[1]); }
  return t;
}
const dotTex = (() => {
  const c = makeCanvas(64, 64, (g) => {
    const gr = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    gr.addColorStop(0, 'rgba(255,255,255,1)');
    gr.addColorStop(0.35, 'rgba(255,240,220,.65)');
    gr.addColorStop(1, 'rgba(255,220,180,0)');
    g.fillStyle = gr; g.fillRect(0, 0, 64, 64);
  });
  const t = new THREE.CanvasTexture(c);
  t.colorSpace = THREE.SRGBColorSpace;
  return t;
})();

/* ---------- 2. 渲染器 / 场景 / 相机 ----------
   与展厅共用 renderer 和 camera；长廊保留独立 Scene，
   于是雾、环境贴图、灯光、色调曝光都还是原来的米色石材观感。 */
const canvas = document.getElementById('gl');
const renderer = window.__HALL.renderer;
const scene = new THREE.Scene();
scene.background = null;          /* 不清屏：第二次渲染叠在展厅画面上 */
scene.fog = new THREE.Fog(0xd9d0c1, 23, 58);
const camera = window.__HALL.camera;

const ROOM = { w: 7.2, L: 32, h: 4.35 };
const HW = ROOM.w / 2;          // 3.6
const HL = ROOM.L / 2;          // 16
const player = { x: -1.0, z: HL + 1.0, yaw: -Math.PI / 2 + 0.32, pitch: -0.015, bob: 0, speed: 0 };
/* ---------- 3. 程序化贴图 ---------- */
function stoneWallTexture() {
  const c = makeCanvas(1024, 1024, (g, W, H) => {
    const gr = g.createLinearGradient(0, 0, 0, H);
    gr.addColorStop(0, '#8d7f6a');
    gr.addColorStop(0.45, '#968872');
    gr.addColorStop(0.80, '#9a8c76');
    gr.addColorStop(1, '#877a66');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);

    /* 石材颗粒 */
    for (let i = 0; i < 9000; i++) {
      const v = Math.random() > 0.5 ? 255 : 90;
      g.fillStyle = `rgba(${v},${v - 6},${v - 18},${0.014 + Math.random() * 0.03})`;
      g.fillRect(Math.random() * W, Math.random() * H, 1.5, 1.5);
    }
    /* 云斑 */
    for (let i = 0; i < 90; i++) {
      const x = Math.random() * W, y = Math.random() * H, r = 20 + Math.random() * 90;
      const gr2 = g.createRadialGradient(x, y, 0, x, y, r);
      gr2.addColorStop(0, `rgba(255,253,246,${0.02 + Math.random() * 0.03})`);
      gr2.addColorStop(1, 'rgba(255,253,246,0)');
      g.fillStyle = gr2; g.beginPath(); g.arc(x, y, r, 0, 6.283); g.fill();
    }

    /* 锤揲细横纹：与展厅墙同款金属微纹 */
    for (let y = 0; y < H; y += 7) {
      g.fillStyle = 'rgba(223,230,239,.024)';
      g.fillRect(0, y + Math.random() * 3, W, 1);
    }
    /* 竖向银线板缝：2.4m 一块，与展厅墙同一模数 */
    [0, W - 2].forEach((x) => {
      g.fillStyle = 'rgba(216,228,242,.16)';
      g.fillRect(x, 0, 2, H);
      g.fillStyle = 'rgba(216,228,242,.05)';
      g.fillRect(x + 4, 0, 1.4, H);
    });
  });
  return canvasTex(c, [3.2, 1]);
}

function marbleTexture() {
  const c = makeCanvas(1024, 1024, (g, W, H) => {
    /* 展厅地面同款暖灰磨光石板（2×2 石板 = 1.2m 一块） */
    const gr = g.createLinearGradient(0, 0, W * 0.75, H);
    gr.addColorStop(0.00, '#4a3d2e');
    gr.addColorStop(0.38, '#574836');
    gr.addColorStop(0.68, '#504233');
    gr.addColorStop(1.00, '#413628');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);

    /* 细颗粒 */
    for (let i = 0; i < 12000; i++) {
      const v = Math.random() > 0.5 ? 250 : 90;
      g.fillStyle = `rgba(${v},${v - 2},${v - 8},${0.008 + Math.random() * 0.02})`;
      g.fillRect(Math.random() * W, Math.random() * H, 1.2, 1.2);
    }

    /* 石纹：细而长 */
    for (let i = 0; i < 42; i++) {
      let x = Math.random() * W, y = Math.random() * H;
      g.beginPath(); g.moveTo(x, y);
      const steps = 6 + Math.floor(Math.random() * 9);
      for (let s2 = 0; s2 < steps; s2++) {
        x += (Math.random() - 0.4) * 160;
        y += (Math.random() - 0.5) * 120;
        g.lineTo(x, y);
      }
      g.strokeStyle = `rgba(88,86,80,${0.1 + Math.random() * 0.16})`;
      g.lineWidth = 0.4 + Math.random() * 1.1;
      g.stroke();
    }
    /* 少量浅色石脉 */
    for (let i = 0; i < 16; i++) {
      let x = Math.random() * W, y = Math.random() * H;
      g.beginPath(); g.moveTo(x, y);
      for (let s2 = 0; s2 < 5; s2++) {
        x += (Math.random() - 0.5) * 130;
        y += (Math.random() - 0.5) * 90;
        g.lineTo(x, y);
      }
      g.strokeStyle = `rgba(252,251,247,${0.05 + Math.random() * 0.08})`;
      g.lineWidth = 0.6 + Math.random() * 1.6;
      g.stroke();
    }

    /* 石板缝：暗缝 + 一侧亮线（与展厅地面同一收口做法） */
    for (let i = 0; i <= 2; i++) {
      const q = Math.min(i * 512, W - 3);
      g.fillStyle = 'rgba(10,7,5,.34)';
      g.fillRect(q, 0, 3, H);
      g.fillRect(0, q, W, 3);
      g.fillStyle = 'rgba(206,192,172,.12)';
      g.fillRect(Math.min(q + 3, W - 2), 0, 2, H);
      g.fillRect(0, Math.min(q + 3, H - 2), W, 2);
    }
  });
  return canvasTex(c, [3.0, 13.4]);
}

function ceilingTexture() {
  const c = makeCanvas(512, 512, (g, W, H) => {
    g.fillStyle = '#74716c'; g.fillRect(0, 0, W, H);

    /* 细颗粒 */
    for (let i = 0; i < 9000; i++) {
      const v = Math.random() > 0.5 ? 255 : 0;
      g.fillStyle = `rgba(${v},${v},${v},${0.01 + Math.random() * 0.022})`;
      g.fillRect(Math.random() * W, Math.random() * H, 1.4, 1.4);
    }
    /* 极弱的云斑 */
    for (let i = 0; i < 30; i++) {
      const x = Math.random() * W, y = Math.random() * H, r = 60 + Math.random() * 150;
      const gr = g.createRadialGradient(x, y, 0, x, y, r);
      gr.addColorStop(0, `rgba(255,255,255,${0.015 + Math.random() * 0.02})`);
      gr.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = gr; g.beginPath(); g.arc(x, y, r, 0, 6.283); g.fill();
    }
    /* 模板拼缝 */
    g.fillStyle = 'rgba(38,36,33,.34)';
    for (let x = 0; x < W; x += 256) g.fillRect(x, 0, 2, H);
    for (let y = 0; y < H; y += 170) g.fillRect(0, y, W, 1.6);
  });
  return canvasTex(c, [2.2, 8]);
}

/* 展窗内壁：暖光洗过的墙 */
function warmBackTexture() {
  const c = makeCanvas(512, 512, (g, W, H) => {
    const gr = g.createLinearGradient(0, 0, 0, H);
    gr.addColorStop(0, '#fff7e8');
    gr.addColorStop(0.3, '#f6e9d1');
    gr.addColorStop(0.62, '#e8d8b9');
    gr.addColorStop(0.86, '#dccaa9');
    gr.addColorStop(1, '#cbb794');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);

    /* 顶部灯槽的洗光 */
    const rg = g.createRadialGradient(W * 0.5, -H * 0.16, 8, W * 0.5, -H * 0.16, H * 0.92);
    rg.addColorStop(0, 'rgba(255,252,240,.95)');
    rg.addColorStop(1, 'rgba(255,252,240,0)');
    g.fillStyle = rg; g.fillRect(0, 0, W, H);

    /* 四角压暗，做出箱体纵深 */
    const vg = g.createRadialGradient(W * 0.5, H * 0.55, H * 0.3, W * 0.5, H * 0.55, H * 0.92);
    vg.addColorStop(0, 'rgba(120,98,70,0)');
    vg.addColorStop(1, 'rgba(96,76,52,.3)');
    g.fillStyle = vg; g.fillRect(0, 0, W, H);

    /* 纸面质感 */
    for (let i = 0; i < 900; i++) {
      g.fillStyle = `rgba(140,120,92,${0.005 + Math.random() * 0.012})`;
      g.fillRect(Math.random() * W, Math.random() * H, 2, 2);
    }
  });
  return canvasTex(c);
}

/* 端景：纸本立轴 */
function endScrollTexture() {
  const c = makeCanvas(1024, 1024, (g, W, H) => {
    const gr = g.createLinearGradient(0, 0, W, H);
    gr.addColorStop(0, '#e9dcc4');
    gr.addColorStop(0.5, '#e3d4b8');
    gr.addColorStop(1, '#d8c8a8');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);

    for (let i = 0; i < 1600; i++) {
      const x = Math.random() * W, y = Math.random() * H;
      g.fillStyle = `rgba(140,118,86,${0.005 + Math.random() * 0.016})`;
      g.beginPath(); g.arc(x, y, 1 + Math.random() * 12, 0, 6.283); g.fill();
    }

    g.textAlign = 'center'; g.textBaseline = 'middle';

    /* 右侧大字：乌铜走银 */
    g.fillStyle = '#241e17';
    g.font = '600 162px "Songti SC","STSong","SimSun",serif';
    [...'乌铜走银'].forEach((ch, i) => g.fillText(ch, W * 0.655, 176 + i * 172));

    /* 左侧小引 */
    g.fillStyle = 'rgba(60,50,38,.5)';
    g.font = '400 40px "Songti SC","STSong",serif';
    [...'以铜为骨'].forEach((ch, i) => g.fillText(ch, W * 0.34, 322 + i * 52));
    [...'以银为纹'].forEach((ch, i) => g.fillText(ch, W * 0.245, 322 + i * 52));

    /* 印章 */
    g.fillStyle = 'rgba(150,58,40,.82)';
    g.fillRect(W * 0.6, 872, 66, 66);
    g.fillStyle = 'rgba(243,233,214,.95)';
    g.font = '400 26px "Songti SC",serif';
    g.fillText('乌', W * 0.6 + 33, 893);
    g.fillText('银', W * 0.6 + 33, 921);

    /* 边线 */
    g.strokeStyle = 'rgba(120,96,64,.24)';
    g.lineWidth = 2;
    g.strokeRect(46, 46, W - 92, H - 92);
  });
  return canvasTex(c);
}

/* 展窗外墙上的小铭牌 */
function labelTexture(no, name) {
  const c = makeCanvas(768, 128, (g, W, H) => {
    g.fillStyle = '#2c2620'; g.fillRect(0, 0, W, H);
    g.fillStyle = 'rgba(220,196,155,.07)'; g.fillRect(0, 0, W, H);
    g.textBaseline = 'middle';
    g.fillStyle = '#d9c49b';
    g.font = '400 54px "Songti SC","STSong","SimSun",serif';
    g.fillText(no, 34, H / 2 + 2);
    g.fillStyle = 'rgba(217,196,155,.45)';
    g.fillRect(96, 34, 1, 60);
    g.fillStyle = '#efe6d4';
    g.font = '400 44px "Songti SC","STSong","SimSun",serif';
    g.fillText(name, 120, H / 2 + 2);
  });
  return canvasTex(c);
}

/* 展窗内的工序说明卡 */
function windowCardTexture(no, name) {
  const c = makeCanvas(460, 620, (g, W, H) => {
    g.fillStyle = '#f0e5cd'; g.fillRect(0, 0, W, H);

    /* 纸纹 */
    for (let i = 0; i < 900; i++) {
      g.fillStyle = `rgba(140,120,90,${0.006 + Math.random() * 0.018})`;
      g.fillRect(Math.random() * W, Math.random() * H, 2, 2);
    }
    g.strokeStyle = 'rgba(78,62,42,.5)';
    g.lineWidth = 2.2;
    g.strokeRect(22, 22, W - 44, H - 44);

    g.textAlign = 'center'; g.textBaseline = 'middle';

    /* 序号 */
    g.fillStyle = 'rgba(88,66,38,.95)';
    g.font = '500 62px "Songti SC","STSong",serif';
    g.fillText(no, W * 0.5, 86);

    /* 竖排工序名 */
    g.fillStyle = '#2e2720';
    g.font = '600 52px "Songti SC","STSong",serif';
    const chars = [...name];
    const step = Math.min(66, 420 / Math.max(1, chars.length));
    const startY = 152;
    chars.forEach((ch, i) => g.fillText(ch, W * 0.63, startY + i * step));

    /* 简易工艺图：圆与线 */
    g.strokeStyle = 'rgba(96,74,44,.28)';
    g.lineWidth = 1.4;
    g.beginPath(); g.arc(W * 0.36, H - 150, 52, 0, 6.283); g.stroke();
    g.beginPath(); g.arc(W * 0.36, H - 150, 30, 0, 6.283); g.stroke();
    g.beginPath(); g.moveTo(W * 0.36, H - 240); g.lineTo(W * 0.36, H - 60); g.stroke();
    g.beginPath(); g.moveTo(58, H - 46); g.lineTo(W - 58, H - 46); g.stroke();
  });
  return canvasTex(c);
}

/* 门外日光 */
function daylightTexture() {
  const c = makeCanvas(256, 256, (g, W, H) => {
    const gr = g.createLinearGradient(0, 0, 0, H);
    gr.addColorStop(0, '#f6f1e6');
    gr.addColorStop(0.42, '#f2ead9');
    gr.addColorStop(0.66, '#e6d9c0');
    gr.addColorStop(1, '#cfc0a6');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);

    /* 远处另一道墙的暗影 */
    g.fillStyle = 'rgba(170,152,126,.6)';
    g.fillRect(0, H * 0.6, W, 3);
    g.fillStyle = 'rgba(158,140,116,.34)';
    g.fillRect(0, H * 0.6, W, H * 0.4);
    g.fillStyle = 'rgba(120,104,84,.16)';
    g.fillRect(0, 0, W, H * 0.1);

    /* 光晕 */
    const rg = g.createRadialGradient(W * 0.5, H * 0.26, 8, W * 0.5, H * 0.26, W * 0.72);
    rg.addColorStop(0, 'rgba(255,255,250,.92)');
    rg.addColorStop(1, 'rgba(255,255,250,0)');
    g.fillStyle = rg; g.fillRect(0, 0, W, H);
  });
  return canvasTex(c);
}

/* 入口门额 */
function doorSignTexture() {
  const c = makeCanvas(1024, 160, (g, W, H) => {
    g.clearRect(0, 0, W, H);
    g.textAlign = 'center'; g.textBaseline = 'middle';
    g.fillStyle = 'rgba(48,40,30,.86)';
    g.font = '400 62px "Songti SC","STSong","SimSun",serif';
    g.fillText('乌 铜 走 银 · 非 遗 工 艺 展 廊', W / 2, H / 2);
  });
  return canvasTex(c);
}

/* 地面光晕（模拟展窗在石材上的反射） */
function floorGlowTexture() {
  const c = makeCanvas(256, 256, (g, W, H) => {
    const gr = g.createRadialGradient(W * 0.5, H * 0.5, 0, W * 0.5, H * 0.5, W * 0.5);
    gr.addColorStop(0, 'rgba(255,230,190,.9)');
    gr.addColorStop(0.32, 'rgba(255,218,172,.36)');
    gr.addColorStop(0.68, 'rgba(255,210,160,.1)');
    gr.addColorStop(1, 'rgba(255,205,155,0)');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);
  });
  return canvasTex(c);
}

/* 展窗在地面上的镜像光带 */
function reflTexture(flip) {
  return canvasTex(makeCanvas(256, 128, (g, W, H) => {
    const gv = g.createLinearGradient(flip ? W : 0, 0, flip ? 0 : W, 0);
    gv.addColorStop(0, 'rgba(255,242,216,.96)');
    gv.addColorStop(0.3, 'rgba(255,234,204,.46)');
    gv.addColorStop(0.65, 'rgba(255,228,196,.14)');
    gv.addColorStop(1, 'rgba(255,225,190,0)');
    g.fillStyle = gv; g.fillRect(0, 0, W, H);

    g.globalCompositeOperation = 'destination-in';
    const gh = g.createLinearGradient(0, 0, 0, H);
    gh.addColorStop(0, 'rgba(0,0,0,0)');
    gh.addColorStop(0.14, 'rgba(0,0,0,1)');
    gh.addColorStop(0.86, 'rgba(0,0,0,1)');
    gh.addColorStop(1, 'rgba(0,0,0,0)');
    g.fillStyle = gh; g.fillRect(0, 0, W, H);
  }));
}

/* 器物：乌铜底 + 走银纹样（贴图） */
function vesselPatternTexture() {
  const c = makeCanvas(1024, 512, (g, W, H) => {
    g.fillStyle = '#3c332c'; g.fillRect(0, 0, W, H);

    /* 铜面颗粒 */
    for (let i = 0; i < 6000; i++) {
      const v = Math.random() > 0.5 ? 255 : 0;
      g.fillStyle = `rgba(${v},${v},${v},${0.008 + Math.random() * 0.016})`;
      g.fillRect(Math.random() * W, Math.random() * H, 1.6, 1.6);
    }

    /* 横向银环 */
    [0.3, 0.46, 0.64, 0.78].forEach(t => {
      const y = H * t;
      g.fillStyle = 'rgba(198,208,214,.9)';
      g.fillRect(0, y, W, 3.4);
      g.fillStyle = 'rgba(240,247,252,.55)';
      g.fillRect(0, y, W, 1.2);
    });

    /* 竖向银丝 */
    const vTop = H * 0.34, vBot = H * 0.76;
    g.fillStyle = 'rgba(196,205,212,.72)';
    for (let i = 0; i < 16; i++) {
      const x = (i + 0.5) * (W / 16);
      g.fillRect(x, vTop, 2.4, vBot - vTop);
    }

    /* 竖向之间的折枝纹（简化的连续回纹） */
    g.strokeStyle = 'rgba(210,219,226,.5)';
    g.lineWidth = 2.4;
    for (let i = 0; i < 16; i++) {
      const x = (i + 0.5) * (W / 16);
      const y = H * 0.55;
      g.beginPath();
      g.moveTo(x - 12, y - 18);
      g.lineTo(x, y);
      g.lineTo(x - 12, y + 18);
      g.stroke();
    }

    /* 接近底部收暗 */
    const gr = g.createLinearGradient(0, 0, 0, H);
    gr.addColorStop(0, 'rgba(255,240,220,.1)');
    gr.addColorStop(0.72, 'rgba(0,0,0,0)');
    gr.addColorStop(1, 'rgba(0,0,0,.32)');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);
  });
  return canvasTex(c);
}

/* 接触阴影贴图 */
function shadowTexture() {
  const c = makeCanvas(128, 128, (g, W, H) => {
    const gr = g.createRadialGradient(64, 64, 0, 64, 64, 64);
    gr.addColorStop(0, 'rgba(0,0,0,.62)');
    gr.addColorStop(0.5, 'rgba(0,0,0,.28)');
    gr.addColorStop(1, 'rgba(0,0,0,0)');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);
  });
  return canvasTex(c);
}

/* ---------- 4. 材质 ---------- */
const TEX = {
  wall: stoneWallTexture(),
  floor: marbleTexture(),
  ceiling: ceilingTexture(),
  warm: warmBackTexture(),
  scroll: endScrollTexture(),
  glow: floorGlowTexture(),
  shadow: shadowTexture()
};

const M = {
  wall: new THREE.MeshStandardMaterial({ map: TEX.wall, bumpMap: TEX.wall, bumpScale: 0.010, color: 0xffffff, roughness: 0.62, metalness: 0.20, envMapIntensity: 1.05 }),
  trim: new THREE.MeshStandardMaterial({ color: 0xe4d7c1, roughness: 0.6, metalness: 0.02, envMapIntensity: 0.7 }),
  trimShadow: new THREE.MeshStandardMaterial({ color: 0x8f8474, roughness: 0.9 }),
  floor: new THREE.MeshStandardMaterial({ map: TEX.floor, bumpMap: TEX.floor, bumpScale: 0.003, color: 0xffffff, roughness: 0.28, metalness: 0.18, envMapIntensity: 0.88 }),
  border: new THREE.MeshStandardMaterial({ color: 0x7d7364, roughness: 0.46, metalness: 0.10, envMapIntensity: 0.7 }),
  caseFloor: new THREE.MeshStandardMaterial({ color: 0xa89a84, roughness: 0.94, metalness: 0.0 }),
  caseWall: new THREE.MeshStandardMaterial({ map: TEX.wall, bumpMap: TEX.wall, bumpScale: 0.010, color: 0xffffff, roughness: 0.62, metalness: 0.20, envMapIntensity: 1.05 }),
  ceiling: new THREE.MeshStandardMaterial({ map: TEX.ceiling, bumpMap: TEX.ceiling, bumpScale: 0.02, color: 0xc2c0ba, roughness: 0.97, emissive: 0x4e4c46, emissiveIntensity: 1 }),
  track: new THREE.MeshStandardMaterial({ color: 0x25241f, roughness: 0.48, metalness: 0.62 }),
  trackHead: new THREE.MeshStandardMaterial({ color: 0x1d1c19, roughness: 0.42, metalness: 0.7 }),
  plaster: new THREE.MeshStandardMaterial({ color: 0xc2b8a9, roughness: 0.95, envMapIntensity: 0.35 }),
  warm: new THREE.MeshBasicMaterial({ map: TEX.warm, color: 0xcebc9c }),
  scroll: new THREE.MeshBasicMaterial({ map: TEX.scroll }),
  walnut: new THREE.MeshStandardMaterial({ color: 0x6e5540, roughness: 0.66, metalness: 0.04 }),
  walnutDark: new THREE.MeshStandardMaterial({ color: 0x473428, roughness: 0.72 }),
  brass: new THREE.MeshStandardMaterial({ color: 0xa8865a, roughness: 0.36, metalness: 0.9 }),
  brassDim: new THREE.MeshStandardMaterial({ color: 0x8a7047, roughness: 0.42, metalness: 0.85 }),
  black: new THREE.MeshStandardMaterial({ color: 0x1b1815, roughness: 0.9 })
};

M.reflL = reflTexture(false);
M.reflR = reflTexture(true);

/* 道具材质（微缩场景用） */
const MAT = {
  wood: new THREE.MeshStandardMaterial({ color: 0xb1936c, roughness: 0.74, metalness: 0.03 }),
  woodDark: new THREE.MeshStandardMaterial({ color: 0x8d6a45, roughness: 0.82 }),
  woodDeep: new THREE.MeshStandardMaterial({ color: 0x5b452e, roughness: 0.88 }),
  copper: new THREE.MeshStandardMaterial({ color: 0x8d5f3d, roughness: 0.36, metalness: 0.88 }),
  blackCopper: new THREE.MeshStandardMaterial({ color: 0x463c33, roughness: 0.44, metalness: 0.8, emissive: 0x120f0c, emissiveIntensity: 1 }),
  silver: new THREE.MeshStandardMaterial({ color: 0xcdd3d7, roughness: 0.28, metalness: 0.92 }),
  silverDim: new THREE.MeshStandardMaterial({ color: 0xa8adb1, roughness: 0.44, metalness: 0.86 }),
  stone: new THREE.MeshStandardMaterial({ color: 0x8d8578, roughness: 0.96 }),
  felt: new THREE.MeshStandardMaterial({ color: 0x3b352d, roughness: 1 }),
  cloth: new THREE.MeshStandardMaterial({ color: 0x6d6355, roughness: 0.96 }),
  clothDark: new THREE.MeshStandardMaterial({ color: 0x4e463b, roughness: 0.96 }),
  skin: new THREE.MeshStandardMaterial({ color: 0xc09a78, roughness: 0.74 }),
  hair: new THREE.MeshStandardMaterial({ color: 0x1c1815, roughness: 1 }),
  iron: new THREE.MeshStandardMaterial({ color: 0x55524e, roughness: 0.46, metalness: 0.7 }),
  vessel: new THREE.MeshStandardMaterial({ map: vesselPatternTexture(), roughness: 0.46, metalness: 0.72, envMapIntensity: 0.32, side: THREE.DoubleSide })
};

/* 道具材质：降低 IBL 强度，保留展窗内的明暗层次 */
Object.values(MAT).forEach(m => {
  if (m && m.isMeshStandardMaterial) {
    m.envMapIntensity = 0.28;
  }
});

/* ---------- 5. 环境光照（IBL） ---------- */
function buildEnv() {
  const c = makeCanvas(256, 128, (g, W, H) => {
    const gr = g.createLinearGradient(0, 0, 0, H);
    gr.addColorStop(0, '#83807a');
    gr.addColorStop(0.3, '#bdb4a5');
    gr.addColorStop(0.46, '#e6dcc9');
    gr.addColorStop(0.56, '#f2e8d5');
    gr.addColorStop(0.72, '#c4b9a6');
    gr.addColorStop(1, '#5a544b');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);

    /* 顶部灯带 */
    for (let i = 0; i < 5; i++) {
      const x = (i + 0.5) * (W / 5);
      const rg = g.createRadialGradient(x, H * 0.1, 2, x, H * 0.1, W * 0.16);
      rg.addColorStop(0, 'rgba(255,250,235,.95)');
      rg.addColorStop(1, 'rgba(255,250,235,0)');
      g.fillStyle = rg; g.fillRect(x - W * 0.16, 0, W * 0.32, H * 0.4);
    }
    /* 暖色墙面反光 */
    const wg = g.createLinearGradient(0, H * 0.4, W, H * 0.62);
    wg.addColorStop(0, 'rgba(255,224,180,.16)');
    wg.addColorStop(0.5, 'rgba(255,236,206,.05)');
    wg.addColorStop(1, 'rgba(255,224,180,.16)');
    g.fillStyle = wg; g.fillRect(0, 0, W, H);
  });
  const tex = new THREE.CanvasTexture(c);
  tex.mapping = THREE.EquirectangularReflectionMapping;
  tex.colorSpace = THREE.SRGBColorSpace;
  const pmrem = new THREE.PMREMGenerator(renderer);
  const env = pmrem.fromEquirectangular(tex).texture;
  tex.dispose();
  pmrem.dispose();
  return env;
}
scene.environment = buildEnv();

scene.add(new THREE.HemisphereLight(0xeef2f0, 0x8d8375, 0.3));
scene.add(new THREE.AmbientLight(0xfff4e6, 0.07));

/* ---------- 5.5 长廊横置：整个展厅绕 Y 轴转 90°，原 -z 廊道变成世界 -x（向西） ---------- */
/* 相机也挂进 world：player 的 x/z、碰撞盒、展窗视点、深链参数全部保持原逻辑坐标。 */
const TURN = Math.PI / 2;
/* 逻辑 (x,z) -> 世界 (z + PX, -x + PZ)：门厅正对展厅北门 (-4.95,-6.8)，长廊向西 */
const WORLD_PX = -21.4, WORLD_PZ = -11.2;
const world = new THREE.Group();
world.rotation.y = TURN;
world.position.set(WORLD_PX, 0, WORLD_PZ);
scene.add(world);
/* 相机由展厅统一控制，不挂进 world */

/* ---------- 6. 展厅建筑 ---------- */
const arch = new THREE.Group();
world.add(arch);

/* 展窗墙南端（进门一侧）不再立端墩：墙到最后一扇展窗为止，进门视野敞开 */
const WALL_END_Z = 14.15;                 /* = WIN_Z[4] + WIN.W / 2 */
const WALL_END_L = WALL_END_Z + HL;       /* 30.3 */
const WALL_END_C = (WALL_END_Z - HL) / 2; /* -0.925 */

function box(w, h, d, mat, x, y, z, parent) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
  m.position.set(x, y, z);
  m.receiveShadow = true;
  (parent || arch).add(m);
  return m;
}

/* 接触阴影 */
function contactShadow(parent, x, y, z, w, d, op) {
  const m = new THREE.Mesh(
    new THREE.PlaneGeometry(w, d),
    new THREE.MeshBasicMaterial({ map: TEX.shadow, transparent: true, opacity: op === undefined ? 0.45 : op, depthWrite: false })
  );
  m.rotation.x = -Math.PI / 2;
  m.position.set(x, y, z);
  parent.add(m);
  return m;
}

/* 地面光晕（近似反射） */
function floorGlow(x, z, w, d, op, rotY) {
  const m = new THREE.Mesh(
    new THREE.PlaneGeometry(w, d),
    new THREE.MeshBasicMaterial({
      map: TEX.glow, transparent: true, opacity: op, depthWrite: false,
      blending: THREE.AdditiveBlending
    })
  );
  m.rotation.x = -Math.PI / 2;
  if (rotY) m.rotation.z = rotY;
  m.position.set(x, 0.012, z);
  m.renderOrder = 2;
  arch.add(m);
  return m;
}

/* —— 地面 —— */
const floorMesh = new THREE.Mesh(new THREE.PlaneGeometry(ROOM.w, ROOM.L), M.floor);
floorMesh.rotation.x = -Math.PI / 2;
floorMesh.receiveShadow = true;
arch.add(floorMesh);

/* 靠墙深色石带 */
[-1, 1].forEach(s => {
  const band = new THREE.Mesh(new THREE.PlaneGeometry(0.34, s < 0 ? WALL_END_L : ROOM.L), M.border);
  band.rotation.x = -Math.PI / 2;
  band.position.set(s * (HW - 0.17), 0.006, s < 0 ? WALL_END_C : 0);
  arch.add(band);
});

/* 墙脚环境遮蔽：让墙与地交接处沉下去 */
(function wallEdgeShadow() {
  const make = (dark) => makeCanvas(64, 8, (g, W, H) => {
    const gr = g.createLinearGradient(dark ? W : 0, 0, dark ? 0 : W, 0);
    gr.addColorStop(0, 'rgba(48,38,26,.8)');
    gr.addColorStop(0.55, 'rgba(52,42,30,.22)');
    gr.addColorStop(1, 'rgba(52,42,30,0)');
    g.fillStyle = gr; g.fillRect(0, 0, W, H);
  });
  const texL = canvasTex(make(false), null);
  const texR = canvasTex(make(true), null);
  [-1, 1].forEach(sd => {
    const m = new THREE.Mesh(
      new THREE.PlaneGeometry(0.8, sd < 0 ? WALL_END_L : ROOM.L),
      new THREE.MeshBasicMaterial({ map: sd < 0 ? texL : texR, transparent: true, opacity: 0.85, depthWrite: false })
    );
    m.rotation.x = -Math.PI / 2;
    m.position.set(sd * (HW - 0.4), 0.009, sd < 0 ? WALL_END_C : 0);
    m.renderOrder = 1;
    arch.add(m);
  });
})();

/* 地面铜线导引 */
const guideMat = new THREE.MeshStandardMaterial({ color: 0x9c8d70, roughness: 0.55, metalness: 0.45 });
const guide = new THREE.Mesh(new THREE.BoxGeometry(0.014, 0.006, 26.4), guideMat);
guide.position.set(0, 0.007, 0);
arch.add(guide);

/* —— 天花（?aerial=1 俯视总览时整体隐藏） —— */
const AERIAL_HIDE = [
  box(ROOM.w - 1.4, 0.1, ROOM.L, M.ceiling, 0, ROOM.h + 0.05, 0),
  box(0.72, 0.1, WALL_END_L, M.ceiling, -(HW - 0.36), ROOM.h + 0.05, WALL_END_C),
  box(0.72, 0.1, ROOM.L, M.ceiling, HW - 0.36, ROOM.h + 0.05, 0),

  /* 中央灯槽 */
  box(0.06, 0.3, ROOM.L, M.track, -0.72, ROOM.h + 0.15, 0),
  box(0.06, 0.3, ROOM.L, M.track, 0.72, ROOM.h + 0.15, 0),
  box(1.5, 0.06, ROOM.L, M.ceiling, 0, ROOM.h + 0.33, 0),
  box(0.12, 0.1, ROOM.L - 1.6, M.track, 0, ROOM.h + 0.02, 0)
];

/* 墙顶灯槽 */
[-1, 1].forEach(s => {
  const CL = s < 0 ? WALL_END_L - 0.4 : ROOM.L - 0.4;
  const cove = new THREE.Mesh(
    new THREE.BoxGeometry(0.045, 0.05, CL),
    new THREE.MeshBasicMaterial({ color: 0xfff4e0 })
  );
  cove.position.set(s * (HW - 0.05), ROOM.h - 0.14, s < 0 ? WALL_END_C : 0);
  arch.add(cove);

  const recess = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.2, CL), M.trimShadow);
  recess.position.set(s * (HW - 0.03), ROOM.h - 0.24, s < 0 ? WALL_END_C : 0);
  arch.add(recess);
});

/* —— 左墙（带五个展窗开口） —— */
const WT = 0.4;
const WIN = { W: 4.3, H: 2.85, SILL: 0.55, D: 1.7 };
const WIN_Z = [-12, -6, 0, 6, 12];
const TOP = WIN.SILL + WIN.H;

/* 展窗墙到最后一扇展窗为止；南端（进门一侧）不再立端墩，进门视野敞开 */
box(WT, WIN.SILL, WALL_END_L, M.wall, -HW - WT / 2, WIN.SILL / 2, WALL_END_C);
box(WT, ROOM.h - TOP, WALL_END_L, M.wall, -HW - WT / 2, (TOP + ROOM.h) / 2, WALL_END_C);

const PIERS = [
  [-HL, WIN_Z[0] - WIN.W / 2],
  [WIN_Z[0] + WIN.W / 2, WIN_Z[1] - WIN.W / 2],
  [WIN_Z[1] + WIN.W / 2, WIN_Z[2] - WIN.W / 2],
  [WIN_Z[2] + WIN.W / 2, WIN_Z[3] - WIN.W / 2],
  [WIN_Z[3] + WIN.W / 2, WIN_Z[4] - WIN.W / 2]
];
PIERS.forEach(([a, b]) => {
  box(WT, WIN.H, b - a, M.wall, -HW - WT / 2, WIN.SILL + WIN.H / 2, (a + b) / 2);
});

/* —— 右墙 —— */
box(WT, ROOM.h, ROOM.L, M.wall, HW + WT / 2, ROOM.h / 2, 0);

/* —— 北端墙 + 端景壁龛 —— */
const NICHE = { w: 3.5, h: 3.5, d: 0.72, z: -HL };
box((ROOM.w - NICHE.w) / 2, ROOM.h, WT, M.wall, -(NICHE.w / 2 + (ROOM.w - NICHE.w) / 4), ROOM.h / 2, -HL - WT / 2);
box((ROOM.w - NICHE.w) / 2, ROOM.h, WT, M.wall, (NICHE.w / 2 + (ROOM.w - NICHE.w) / 4), ROOM.h / 2, -HL - WT / 2);
box(NICHE.w, ROOM.h - NICHE.h, WT, M.wall, 0, (NICHE.h + ROOM.h) / 2, -HL - WT / 2);

/* 壁龛内壁 */
box(NICHE.w, NICHE.h, 0.06, M.plaster, 0, NICHE.h / 2, -HL - NICHE.d);
box(0.06, NICHE.h, NICHE.d, M.plaster, -NICHE.w / 2, NICHE.h / 2, -HL - NICHE.d / 2);
box(0.06, NICHE.h, NICHE.d, M.plaster, NICHE.w / 2, NICHE.h / 2, -HL - NICHE.d / 2);
box(NICHE.w, 0.06, NICHE.d, M.plaster, 0, NICHE.h, -HL - NICHE.d / 2);

const scrollPanel = new THREE.Mesh(new THREE.PlaneGeometry(NICHE.w - 0.06, NICHE.h - 0.06), M.scroll);
scrollPanel.position.set(0, NICHE.h / 2, -HL - NICHE.d + 0.035);
arch.add(scrollPanel);

/* 壁龛石框 */
box(0.14, NICHE.h + 0.14, 0.18, M.trim, -NICHE.w / 2 - 0.07, NICHE.h / 2, -HL - 0.03);
box(0.14, NICHE.h + 0.14, 0.18, M.trim, NICHE.w / 2 + 0.07, NICHE.h / 2, -HL - 0.03);
box(NICHE.w + 0.28, 0.14, 0.18, M.trim, 0, NICHE.h + 0.07, -HL - 0.03);

/* —— 南端：整面敞开，进门即见左手横向长廊 —— */
/* 原「门洞两侧实墙 + 门楣 + 门框立柱」会正对进厅视线、把长廊挡死，已全部拆除。
   只保留一道贴顶过梁作为两厅分界；DOOR 常量仍供门槛 / 门额 / 灯位等尺寸基准使用。 */
const DOOR = { w: 3.2, h: 2.95 };
const LINTEL_H = 0.42;
box(ROOM.w, LINTEL_H, WT, M.wall, 0, ROOM.h - LINTEL_H / 2, HL + WT / 2);

/* 门外玄关：一块被日光洗亮的墙 */
const vest = new THREE.Group();
arch.add(vest);
const vestFloor = new THREE.Mesh(new THREE.PlaneGeometry(5.2, 2.0), floorMatFor(5.2, 2.0));
vestFloor.rotation.x = -Math.PI / 2;
vestFloor.position.set(1.0, 0.004, HL + 1.0);
vest.add(vestFloor);
/* 左侧（逻辑 -x）不封墙：进门即见左手横向长廊，视野敞开 */
box(0.1, ROOM.h, 2.0, M.caseWall, 3.85, ROOM.h / 2, HL + 1.0);
AERIAL_HIDE.push(box(5.2, 0.1, 2.0, M.caseWall, 1.0, ROOM.h + 0.05, HL + 1.0));

/* 门厅后墙（逻辑 +z）：与前厅相接的一侧，保留围合感 */
box(5.2, ROOM.h, 0.1, M.caseWall, 1.0, ROOM.h / 2, HL + 2.0);

/* 地面 L 形铜线：从背后入口直走到门厅中心，再左拐指向长廊入口 */
box(2.6, 0.006, 0.018, guideMat, -0.3, 0.012, HL + 1.0);
box(0.018, 0.006, 1.0, guideMat, 0, 0.012, HL + 0.5);

/* 正前方端墙的电子屏：默认待机画面，?video=… 或 assets/corridor-screen.mp4 自动播放 */
(function turnScreen() {
  const SW = 1.92, SH = 1.08;                  // 16:9 显示区
  const SX = 3.55, SY = 1.95, SZ = HL + 1.0;  // 端墙内侧

  const standby = makeCanvas(1024, 576, (g, W, H) => {
    g.fillStyle = '#06090d'; g.fillRect(0, 0, W, H);
    const vg = g.createRadialGradient(W / 2, H / 2, W * .12, W / 2, H / 2, W * .72);
    vg.addColorStop(0, 'rgba(34,50,64,.60)');
    vg.addColorStop(1, 'rgba(0,0,0,.80)');
    g.fillStyle = vg; g.fillRect(0, 0, W, H);
    g.fillStyle = 'rgba(255,255,255,.022)';
    for (let y = 0; y < H; y += 4) g.fillRect(0, y, W, 1);
    g.strokeStyle = 'rgba(198,168,110,.42)'; g.lineWidth = 3;
    g.strokeRect(22, 22, W - 44, H - 44);
    g.textAlign = 'center';
    g.fillStyle = '#e9d8b0'; g.font = 'bold 92px "Microsoft YaHei", serif';
    g.fillText('左转入廊', W / 2, 232);
    g.fillStyle = '#9db2c2'; g.font = '34px "Microsoft YaHei", serif';
    g.fillText('五道工序 · 横向长廊', W / 2, 298);
    g.fillStyle = 'rgba(216,178,115,.78)';
    g.beginPath();
    g.moveTo(W / 2 - 17, 356); g.lineTo(W / 2 - 17, 414);
    g.lineTo(W / 2 + 29, 385); g.closePath(); g.fill();
    g.fillStyle = '#7f8d98'; g.font = '25px "Microsoft YaHei", serif';
    g.fillText('电子屏 · 封面加载中', W / 2, 474);
    g.fillStyle = '#5d6a74'; g.font = '20px monospace';
    g.fillText('永不消逝的银纹 · 云南非遗：乌铜走银', W / 2, 512);
  });

  const screenMat = new THREE.MeshBasicMaterial({ map: canvasTex(standby), toneMapped: false });
  const screen = new THREE.Mesh(new THREE.PlaneGeometry(SW, SH), screenMat);
  screen.position.set(SX, SY, SZ);
  screen.rotation.y = -Math.PI / 2;
  vest.add(screen);

  /* 乌铜背板 + 四边金属框 + 电源指示灯 */
  const frameMat = new THREE.MeshStandardMaterial({ color: 0x22201c, metalness: .72, roughness: .38 });
  const edgeMat = new THREE.MeshStandardMaterial({ color: 0x9c8256, metalness: .82, roughness: .3 });
  box(0.05, SH + 0.20, SW + 0.20, frameMat, SX + 0.045, SY, SZ, vest);
  const t = 0.055;
  box(t, t, SW + 0.22, edgeMat, SX - 0.012, SY + SH / 2 + 0.06, SZ, vest);
  box(t, t, SW + 0.22, edgeMat, SX - 0.012, SY - SH / 2 - 0.06, SZ, vest);
  box(t, SH + 0.14, t, edgeMat, SX - 0.012, SY, SZ - SW / 2 - 0.06, vest);
  box(t, SH + 0.14, t, edgeMat, SX - 0.012, SY, SZ + SW / 2 + 0.06, vest);
  const led = new THREE.Mesh(new THREE.SphereGeometry(0.022, 10, 8),
    new THREE.MeshBasicMaterial({ color: 0x8fe3b0 }));
  led.position.set(SX - 0.04, SY - SH / 2 - 0.13, SZ + SW / 2 - 0.08);
  vest.add(led);

  /* 视频接口：默认显示封面《永不消逝的银纹》；观众点击屏幕或走近 3m 内
     开始播放（有声、循环），离开触发区暂停并把进度复位到封面。
     浏览器的有声自动播放需要一次用户激活（按键 / 点击都算）——玩家既然
     能走过来，就必然已经有激活，play() 不会被拦；万一被拦就回落到封面 */
  const COVER_URL = 'data:image/jpeg;base64,';
  const videoURL = PARAMS.get('video') || 'assets/corridor-screen.mp4';
  /* 双击 file:// 打开时 Chromium 把本地视频视为跨源数据，禁止上传进 WebGL
     纹理（texImage2D 抛 SecurityError），所以不用 VideoTexture，改用 DOM
     叠加层：真 <video> 元素叠在 3D 画布上方，每帧按电子屏四角的相机投影
     用 CSS matrix 对齐位置与透视缩放。 */
  const overlay = document.createElement('video');
  overlay.muted = false; overlay.volume = 1.0; overlay.loop = true;
  overlay.playsInline = true; overlay.setAttribute('playsinline', '');
  overlay.preload = 'auto';
  overlay.style.cssText = 'position:fixed;left:0;top:0;width:100px;height:56.25px;' +
    'transform-origin:0 0;object-fit:fill;display:none;background:#000;' +
    'z-index:3;pointer-events:none;';
  document.body.appendChild(overlay);
  let videoReady = false, screenOn = false;

  function showCover() {
    screenMat.map = coverTex;
    screenMat.needsUpdate = true;
  }
  let manualOn = false;   /* 点击播放：不受 3m 触发区限制，走出长廊才停 */
  /* 有声播放被浏览器自动播放策略拦时，退回静音播放 + 提示点击开声音。
     点击电子屏是真实用户手势，unmute 一定被允许 */
  let mutedByPolicy = false, soundHint = null;
  function ensureHint() {
    if (soundHint) return soundHint;
    soundHint = document.createElement('div');
    soundHint.style.cssText = 'position:fixed;left:50%;bottom:64px;transform:translateX(-50%);' +
      'background:rgba(20,16,12,.86);color:#e8dcc8;font:14px/1.7 "Noto Serif SC",serif;' +
      'letter-spacing:.14em;padding:10px 24px;border-radius:4px;z-index:4;pointer-events:none;display:none;';
    soundHint.textContent = '浏览器限制了视频声音 · 点击电子屏即可开启';
    document.body.appendChild(soundHint);
    return soundHint;
  }
  function playScreen(manual) {
    if (!videoReady || screenOn) return;
    screenOn = true;
    manualOn = !!manual;
    if (mutedByPolicy) ensureHint().style.display = 'block';
    const p = overlay.play();
    if (p && p.catch) p.catch(function () {
      overlay.muted = true; mutedByPolicy = true;
      ensureHint().style.display = 'block';
      const p2 = overlay.play();
      if (p2 && p2.catch) p2.catch(function () { stopScreen(); });
    });
  }
  function unmuteScreen() {
    if (!screenOn || !mutedByPolicy) return false;
    overlay.muted = false; overlay.volume = 1.0;
    mutedByPolicy = false;
    if (soundHint) soundHint.style.display = 'none';
    const p = overlay.play();
    if (p && p.catch) p.catch(function () {});
    return true;
  }
  function stopScreen() {
    if (screenOn) {
      overlay.pause();
      try { overlay.currentTime = 0; } catch (e) {}
    }
    screenOn = false; manualOn = false;
    if (soundHint) soundHint.style.display = 'none';
    overlay.style.display = 'none';
    showCover();
  }
  /* tick 自动触发：走近自动播放进出 3m 触发区；点击播放只看是否还在长廊 */
  function autoTrigger(inCorr, near) {
    if (screenOn) {
      if (manualOn ? !inCorr : !(inCorr && near)) stopScreen();
    } else if (inCorr && near) {
      playScreen(false);
    }
  }

  overlay.addEventListener('loadeddata', function () { videoReady = true; });
  overlay.addEventListener('error', function () { videoReady = false; stopScreen(); });
  if (videoURL) { overlay.src = videoURL; overlay.load(); }

  /* 封面：构建时以 data URL 注入（单文件不依赖外部图片）；加载完成前先用待机底图 */
  const coverTex = new THREE.TextureLoader().load(COVER_URL, function () {
    if (!screenOn) showCover();
  });
  coverTex.encoding = THREE.sRGBEncoding;
  coverTex.minFilter = THREE.LinearFilter;
  coverTex.magFilter = THREE.LinearFilter;

  /* ---- 叠加层逐帧对齐：屏幕四角 → 世界 → 相机投影 → CSS matrix ---- */
  const L_LT = new THREE.Vector3(-SW / 2, SH / 2, 0);
  const L_RT = new THREE.Vector3(SW / 2, SH / 2, 0);
  const L_LB = new THREE.Vector3(-SW / 2, -SH / 2, 0);
  const W_LT = new THREE.Vector3(), W_RT = new THREE.Vector3(), W_LB = new THREE.Vector3();
  const P_LT = new THREE.Vector3(), P_RT = new THREE.Vector3(), P_LB = new THREE.Vector3();
  const TMP_A = new THREE.Vector3(), TMP_B = new THREE.Vector3(), TMP_N = new THREE.Vector3();
  const occRay = new THREE.Raycaster();
  const AERIAL_MODE = !!PARAMS.get('aerial');

  function layoutOverlay() {
    if (!screenOn || AERIAL_MODE) { overlay.style.display = 'none'; return; }
    const cam = window.__HALL && window.__HALL.camera;
    if (!cam) { overlay.style.display = 'none'; return; }
    /* 关键：tick 在 renderer.render 之前跑，相机矩阵还是上一帧的（本帧
       applyCamera 改了位姿但矩阵要到 render 才刷新）。不先更新，叠加层
       永远滞后一帧——移动鼠标看屏幕时视频会滑出画框。Camera 的
       updateMatrixWorld 会连带刷新 matrixWorldInverse。 */
    cam.updateMatrixWorld();
    screen.getWorldPosition(TMP_A);
    screen.getWorldDirection(TMP_N);               /* 平面法线（局部 +Z） */
    TMP_B.copy(cam.position).sub(TMP_A);
    if (TMP_B.dot(TMP_N) <= 0) { overlay.style.display = 'none'; return; }  /* 背面 */
    TMP_B.copy(TMP_A).applyMatrix4(cam.matrixWorldInverse);
    if (TMP_B.z > -0.05) { overlay.style.display = 'none'; return; }        /* 贴脸/身后 */
    /* 遮挡：相机 → 屏幕中心，路上有物体先命中就是被墙挡住了 */
    TMP_B.copy(cam.position).sub(TMP_A);
    const dist = TMP_B.length();
    TMP_B.normalize();
    occRay.set(cam.position, TMP_B);
    occRay.far = Math.max(dist - 0.15, 0.05);
    if (occRay.intersectObject(scene, true).length) { overlay.style.display = 'none'; return; }
    /* 四角投影成 CSS matrix（元素基准 100×56.25px） */
    W_LT.copy(L_LT).applyMatrix4(screen.matrixWorld);
    W_RT.copy(L_RT).applyMatrix4(screen.matrixWorld);
    W_LB.copy(L_LB).applyMatrix4(screen.matrixWorld);
    P_LT.copy(W_LT).project(cam);
    P_RT.copy(W_RT).project(cam);
    P_LB.copy(W_LB).project(cam);
    const vw = window.innerWidth, vh = window.innerHeight;
    const ax = (P_LT.x * 0.5 + 0.5) * vw, ay = (-P_LT.y * 0.5 + 0.5) * vh;
    const ux = ((P_RT.x - P_LT.x) * 0.5 * vw) / 100;
    const uy = (-(P_RT.y - P_LT.y) * 0.5 * vh) / 100;
    const vx = ((P_LB.x - P_LT.x) * 0.5 * vw) / 56.25;
    const vy = (-(P_LB.y - P_LT.y) * 0.5 * vh) / 56.25;
    overlay.style.display = 'block';
    overlay.style.transform = 'matrix(' + ux + ',' + uy + ',' + vx + ',' + vy + ',' + ax + ',' + ay + ')';
  }

  /* 屏幕网格交给胶水层：点击拾取与 3m 距离触发都在 tick 里做；tick 每帧对齐叠加层 */
  window.__SCREEN = { mesh: screen, play: playScreen, stop: stopScreen, auto: autoTrigger,
                      tick: layoutOverlay, unmute: unmuteScreen };
})();

/* 长廊南端 / 门厅一带没有展窗射灯，走过去像掉进黑洞：补两盏柔光 */
[[0.4, 11.0], [1.1, 14.6]].forEach(function (pz) {
  const fill = new THREE.PointLight(0xffe8cd, 3.4, 9, 2);
  fill.position.set(pz[0], 2.45, pz[1]);
  arch.add(fill);
});

const doorLight = new THREE.PointLight(0xffe6c2, 6, 9, 2);
doorLight.position.set(1.0, 2.2, HL + 1.0);
world.add(doorLight);

/* 由前厅进来时压低门厅灯，让左手长廊更亮；左侧已敞开，不再放「暗厅内景」贴片 */
if (FROM_HALL) {
  doorLight.intensity = 5.0;
}

/* 门槛与门洞阴影 */
box(DOOR.w + 0.1, 0.05, 0.26, M.border, 0, 0.025, HL + 0.16);
box(DOOR.w, 0.02, 0.05, M.trimShadow, 0, 0.052, HL + 0.03);
const doorShadow = new THREE.Mesh(
  new THREE.PlaneGeometry(DOOR.w, 1.1),
  new THREE.MeshBasicMaterial({ map: TEX.shadow, transparent: true, opacity: 0.3, depthWrite: false })
);
doorShadow.rotation.x = -Math.PI / 2;
doorShadow.position.set(0, 0.011, HL - 0.35);
arch.add(doorShadow);

/* 门额题字 */
const doorSign = new THREE.Mesh(
  new THREE.PlaneGeometry(2.2, 0.34),
  new THREE.MeshBasicMaterial({ map: doorSignTexture(), transparent: true })
);
doorSign.position.set(0, ROOM.h - LINTEL_H - 0.18, HL - 0.02);
doorSign.rotation.y = Math.PI;
arch.add(doorSign);

/* —— 长凳：已按需求移除 —— */

/* —— 端景：不置器物，尽头只留立轴一面 —— */

/* ---------- 7. 通用构件：人物 / 粒子 / 杆件 ---------- */
function makePerson(opt = {}) {
  const robe = new THREE.MeshStandardMaterial({ color: opt.robe || 0x6b6152, roughness: 0.96 });
  const robe2 = new THREE.MeshStandardMaterial({ color: opt.robe2 || 0x50483d, roughness: 0.96 });
  const skin = new THREE.MeshStandardMaterial({ color: opt.skin || 0xc09a78, roughness: 0.74 });
  const hair = new THREE.MeshStandardMaterial({ color: 0x1c1815, roughness: 1 });

  const g = new THREE.Group();

  [-0.115, 0.115].forEach(x => {
    const leg = new THREE.Mesh(new THREE.BoxGeometry(0.17, 0.6, 0.2), robe2);
    leg.position.set(x, 0.3, 0); g.add(leg);
    const shoe = new THREE.Mesh(new THREE.BoxGeometry(0.19, 0.075, 0.3), hair);
    shoe.position.set(x, 0.04, 0.04); g.add(shoe);
  });

  const body = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.26, 0.62, 12), robe);
  body.position.y = 0.91; g.add(body);

  const belt = new THREE.Mesh(new THREE.CylinderGeometry(0.262, 0.27, 0.075, 12), robe2);
  belt.position.y = 0.72; g.add(belt);

  const shoulders = new THREE.Mesh(new THREE.SphereGeometry(0.235, 14, 10), robe);
  shoulders.scale.set(1, 0.55, 0.85);
  shoulders.position.y = 1.185; g.add(shoulders);

  const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.085, 0.1, 8), skin);
  neck.position.y = 1.255; g.add(neck);

  const head = new THREE.Mesh(new THREE.SphereGeometry(0.14, 18, 14), skin);
  head.position.y = 1.38; head.scale.set(0.94, 1.06, 0.92); g.add(head);

  const cap = new THREE.Mesh(new THREE.SphereGeometry(0.145, 18, 14, 0, Math.PI * 2, 0, Math.PI * 0.6), hair);
  cap.position.y = 1.392; g.add(cap);
  const bun = new THREE.Mesh(new THREE.SphereGeometry(0.058, 10, 8), hair);
  bun.position.set(0, 1.475, -0.09); g.add(bun);

  const apron = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.52, 0.02), robe2);
  apron.position.set(0, 0.86, 0.203); g.add(apron);

  function arm(side) {
    const pivot = new THREE.Group();
    pivot.position.set(0.238 * side, 1.155, 0);
    const up = new THREE.Mesh(new THREE.CylinderGeometry(0.062, 0.05, 0.44, 8), robe);
    up.position.y = -0.22; pivot.add(up);
    const fore = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.045, 0.19, 8), robe);
    fore.position.y = -0.5; pivot.add(fore);
    const hand = new THREE.Mesh(new THREE.SphereGeometry(0.055, 10, 8), skin);
    hand.position.y = -0.605; pivot.add(hand);
    g.add(pivot);
    return pivot;
  }
  const armR = arm(1), armL = arm(-1);

  g.traverse(o => { if (o.isMesh) { o.castShadow = true; } });
  return { g, armR, armL, head };
}

function makeParticles(opt) {
  const count = opt.count || 40;
  const geo = new THREE.BufferGeometry();
  const pos = new Float32Array(count * 3);
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  const mat = new THREE.PointsMaterial({
    color: opt.color || 0xffa14a,
    size: opt.size || 0.055,
    map: dotTex,
    transparent: true,
    opacity: 0.95,
    depthWrite: false,
    blending: opt.normal ? THREE.NormalBlending : THREE.AdditiveBlending,
    sizeAttenuation: true
  });
  const points = new THREE.Points(geo, mat);
  points.frustumCulled = false;

  const state = [];
  const o = opt.origin;
  function reset(s) {
    s.p.set(
      o.x + (Math.random() - 0.5) * (opt.spread || 0.2),
      o.y + (Math.random() - 0.5) * (opt.spreadY || 0.08),
      o.z + (Math.random() - 0.5) * (opt.spread || 0.2)
    );
    s.v.set(
      (Math.random() - 0.5) * (opt.side || 0.3),
      (opt.up || 0.7) * (0.4 + Math.random() * 0.9),
      (Math.random() - 0.5) * (opt.side || 0.3)
    );
    s.life = 0;
    s.max = (opt.life || 1) * (0.55 + Math.random() * 0.9);
  }
  for (let i = 0; i < count; i++) {
    const s = { p: new THREE.Vector3(), v: new THREE.Vector3(), life: 0, max: 1 };
    reset(s);
    s.life = Math.random() * s.max;
    state.push(s);
  }

  function update(dt) {
    for (let i = 0; i < count; i++) {
      const s = state[i];
      s.life += dt;
      if (s.life > s.max) reset(s);
      s.v.y -= (opt.gravity || 0) * dt;
      s.p.addScaledVector(s.v, dt);
      pos[i * 3] = s.p.x; pos[i * 3 + 1] = s.p.y; pos[i * 3 + 2] = s.p.z;
    }
    geo.attributes.position.needsUpdate = true;
  }
  update(0.016);
  return { points, update };
}

function tubeBetween(a, b, r1, r2, mat) {
  const dir = new THREE.Vector3().subVectors(b, a);
  const len = dir.length();
  const mesh = new THREE.Mesh(new THREE.CylinderGeometry(r1, r2, len, 8, 1, true), mat);
  mesh.position.copy(a).addScaledVector(dir, 0.5);
  mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.clone().normalize());
  return mesh;
}

/* ---------- 8. 五道工序的微缩场景 ---------- */

/* 工序一 · 熔炼乌铜 */
function dSmelt() {
  const g = new THREE.Group();

  const stoveMat = new THREE.MeshStandardMaterial({ color: 0x6b5847, roughness: 0.96 });
  const stove = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.54, 0.7), stoveMat);
  stove.position.set(-0.72, 0.27, 0); g.add(stove);

  const topPlate = new THREE.Mesh(new THREE.BoxGeometry(0.98, 0.06, 0.78), MAT.stone);
  topPlate.position.set(-0.72, 0.57, 0); g.add(topPlate);

  /* 炉口 */
  const mouthBox = new THREE.Mesh(
    new THREE.BoxGeometry(0.46, 0.27, 0.1),
    new THREE.MeshStandardMaterial({ color: 0x241d18, roughness: 1 })
  );
  mouthBox.position.set(-0.72, 0.27, 0.335);
  g.add(mouthBox);

  const mouthTex = canvasTex(makeCanvas(128, 128, (c2, w, h) => {
    const gr = c2.createRadialGradient(w / 2, h * 0.66, 2, w / 2, h * 0.66, w * 0.66);
    gr.addColorStop(0, '#fff2b8');
    gr.addColorStop(0.32, '#ff8a1e');
    gr.addColorStop(0.68, '#a8310a');
    gr.addColorStop(1, '#2a0d04');
    c2.fillStyle = gr; c2.fillRect(0, 0, w, h);
  }));
  const mouthGlow = new THREE.Mesh(
    new THREE.PlaneGeometry(0.4, 0.21),
    new THREE.MeshBasicMaterial({ map: mouthTex })
  );
  mouthGlow.position.set(-0.72, 0.27, 0.387);
  g.add(mouthGlow);

  const ember = new THREE.PointLight(0xff7a24, 1.0, 1.7, 2);
  ember.position.set(-0.72, 0.3, 0.52);
  g.add(ember);

  const crucible = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.23, 0.4, 18), MAT.copper);
  crucible.position.set(-0.72, 0.79, 0); g.add(crucible);

  const meltMat = new THREE.MeshBasicMaterial({ color: 0xff7d2a });
  const melt = new THREE.Mesh(new THREE.CircleGeometry(0.275, 26), meltMat);
  melt.rotation.x = -Math.PI / 2;
  melt.position.set(-0.72, 0.992, 0); g.add(melt);

  const glow = new THREE.PointLight(0xff7a2c, 2.4, 3.0, 2);
  glow.position.set(-0.72, 1.14, 0); g.add(glow);

  const flames = [];
  for (let i = 0; i < 10; i++) {
    const fm = new THREE.MeshBasicMaterial({
      color: i % 3 === 0 ? 0xffc25e : 0xff8a2a,
      transparent: true, opacity: 0.4,
      blending: THREE.AdditiveBlending, depthWrite: false
    });
    const f = new THREE.Mesh(new THREE.ConeGeometry(0.06 + Math.random() * 0.05, 0.28 + Math.random() * 0.34, 6), fm);
    f.position.set(-0.72 + (Math.random() - 0.5) * 0.5, 0.9 + Math.random() * 0.12, (Math.random() - 0.5) * 0.4);
    f.userData = { ph: Math.random() * 6.28, y0: f.position.y };
    g.add(f); flames.push(f);
  }

  const sparks = makeParticles({
    count: 26, color: 0xffb060, size: 0.045, origin: new THREE.Vector3(-0.72, 1.0, 0),
    spread: 0.28, up: 1.0, side: 0.22, gravity: 1.5, life: 1.1
  });
  g.add(sparks.points);

  const p = makePerson({ robe: 0x6a5b49, robe2: 0x4b4035 });
  p.g.position.set(0.55, 0, -0.02);
  p.g.rotation.y = -Math.PI / 2;
  g.add(p.g);

  const rod = new THREE.Mesh(new THREE.CylinderGeometry(0.024, 0.024, 1.1, 8), MAT.woodDark);
  rod.position.set(0, -0.6, 0);
  rod.rotation.x = 3.28;
  p.armR.add(rod);

  p.armL.rotation.x = -1.18;
  p.armL.rotation.z = 0.2;

  /* 金料盘 */
  const tray = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.05, 0.3), MAT.wood);
  tray.position.set(1.35, 0.62, 0.2); g.add(tray);
  const goldMat = new THREE.MeshStandardMaterial({ color: 0xd0a94e, roughness: 0.3, metalness: 0.95 });
  for (let i = 0; i < 4; i++) {
    const ingot = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.05, 0.06), goldMat);
    ingot.position.set(1.2 + (i % 2) * 0.13, 0.67, 0.14 + Math.floor(i / 2) * 0.1);
    ingot.rotation.y = Math.random();
    g.add(ingot);
  }
  const trayLeg = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.07, 0.6, 8), MAT.woodDeep);
  trayLeg.position.set(1.35, 0.3, 0.2); g.add(trayLeg);

  contactShadow(g, -0.3, 0.004, 0, 2.6, 1.4, 0.3);

  return {
    group: g,
    update(t, dt) {
      flames.forEach(f => {
        const s = 0.85 + Math.sin(t * 6 + f.userData.ph) * 0.28;
        f.scale.set(1, s, 1);
        f.position.y = f.userData.y0 + Math.sin(t * 3.4 + f.userData.ph) * 0.045;
        f.material.opacity = 0.26 + 0.3 * (0.5 + 0.5 * Math.sin(t * 7 + f.userData.ph));
      });
      glow.intensity = 2.2 + Math.sin(t * 7.3) * 0.6 + Math.random() * 0.12;
      meltMat.color.setHSL(0.055, 1, 0.56 + Math.sin(t * 2.2) * 0.04);
      p.armR.rotation.x = -1.45 + Math.sin(t * 1.5) * 0.13;
      p.armR.rotation.z = Math.sin(t * 1.5) * 0.11;
      p.armL.rotation.x = -1.18 + Math.sin(t * 1.5 + 1.4) * 0.06;
      p.g.rotation.z = Math.sin(t * 1.5) * 0.012;
      sparks.update(dt);
    }
  };
}

/* 工序二 · 熔铸、锻打铜片成型 */
function dForge() {
  const g = new THREE.Group();

  const stump = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.34, 0.34, 12), MAT.woodDeep);
  stump.position.set(-0.35, 0.17, 0); g.add(stump);

  const anvilBase = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.14, 0.26), MAT.iron);
  anvilBase.position.set(-0.35, 0.41, 0); g.add(anvilBase);

  const anvil = new THREE.Mesh(new THREE.BoxGeometry(0.72, 0.14, 0.26), MAT.iron);
  anvil.position.set(-0.35, 0.53, 0); g.add(anvil);

  const horn = new THREE.Mesh(new THREE.ConeGeometry(0.1, 0.34, 10), MAT.iron);
  horn.rotation.z = Math.PI / 2;
  horn.position.set(-0.81, 0.55, 0); g.add(horn);

  const sheetMat = new THREE.MeshStandardMaterial({ color: 0x9a6540, roughness: 0.32, metalness: 0.9 });
  const sheet = new THREE.Mesh(new THREE.BoxGeometry(0.56, 0.035, 0.3), sheetMat);
  sheet.position.set(-0.35, 0.617, 0); g.add(sheet);

  const sparks = makeParticles({
    count: 30, color: 0xffc070, size: 0.04, origin: new THREE.Vector3(-0.35, 0.63, 0),
    spread: 0.09, up: 0.85, side: 1.5, gravity: 5.2, life: 0.55
  });
  g.add(sparks.points);

  const p = makePerson({ robe: 0x66594c, robe2: 0x493f34 });
  p.g.position.set(0.3, 0, 0.02);
  p.g.rotation.y = -Math.PI / 2;
  g.add(p.g);

  const hammer = new THREE.Group();
  const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.024, 0.024, 0.46, 8), MAT.woodDark);
  handle.position.y = -0.06; hammer.add(handle);
  const head = new THREE.Mesh(new THREE.BoxGeometry(0.085, 0.1, 0.24), MAT.iron);
  head.position.y = -0.26; hammer.add(head);
  hammer.position.set(0, -0.6, 0.02);
  p.armR.add(hammer);

  const tongs = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.34, 0.03), MAT.iron);
  tongs.position.set(0, -0.62, 0.03);
  tongs.rotation.x = 1.25;
  p.armL.add(tongs);

  const pile = [];
  for (let i = 0; i < 3; i++) {
    const s = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.03, 0.24), sheetMat.clone());
    s.position.set(1.45, 0.62 + i * 0.035, 0.06 + i * 0.02);
    s.rotation.y = (Math.random() - 0.5) * 0.4;
    g.add(s); pile.push(s);
  }
  const table = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.06, 0.6), MAT.wood);
  table.position.set(1.45, 0.58, 0.06); g.add(table);
  const tl1 = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.58, 0.06), MAT.woodDeep);
  tl1.position.set(1.1, 0.29, 0.06); g.add(tl1);
  const tl2 = tl1.clone(); tl2.position.x = 1.8; g.add(tl2);

  contactShadow(g, -0.1, 0.004, 0, 2.9, 1.4, 0.3);

  let phase = 0;
  return {
    group: g,
    update(t, dt) {
      const prev = phase;
      phase = t * 2.6;
      const swing = (Math.sin(phase) * 0.5 + 0.5);
      p.armR.rotation.x = -2.15 + swing * 1.30;
      p.armL.rotation.x = -0.82 + Math.sin(phase + 0.4) * 0.05;
      p.g.rotation.x = Math.sin(phase) * 0.012;

      const hit = Math.floor(phase / Math.PI);
      if (hit !== Math.floor(prev / Math.PI)) {
        sheet.scale.y = 0.55;
        for (let i = 0; i < 6; i++) sparks.update(0.016);
      }
      sheet.scale.y = lerp(sheet.scale.y, 1, 0.18);

      const thin = 1 - 0.22 * (0.5 + 0.5 * Math.sin(t * 0.5));
      sheet.scale.x = 1 + 0.04 * (0.5 + 0.5 * Math.sin(t * 0.5));
      sheet.scale.z = thin;

      sparks.update(dt);
      pile.forEach((s, i) => { s.position.y = 0.62 + i * 0.035 + Math.sin(t * 1.2 + i) * 0.002; });
    }
  };
}

/* 工序三 · 刻绘纹饰 */
function dEngrave() {
  const g = new THREE.Group();

  const benchTop = new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.07, 0.7), MAT.wood);
  benchTop.position.set(-0.45, 0.76, 0.05); g.add(benchTop);
  [[-1.05, -0.2], [-1.05, 0.3], [0.15, -0.2], [0.15, 0.3]].forEach(([x, z]) => {
    const leg = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.76, 0.07), MAT.woodDeep);
    leg.position.set(x, 0.38, z); g.add(leg);
  });

  const plateGroup = new THREE.Group();
  plateGroup.position.set(-0.32, 1.16, 0.06);
  plateGroup.rotation.x = -0.5;
  g.add(plateGroup);

  const plateMat = new THREE.MeshStandardMaterial({ color: 0x40372f, roughness: 0.56, metalness: 0.7 });
  const plate = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.72, 0.045), plateMat);
  plateGroup.add(plate);
  const plateEdge = new THREE.LineSegments(
    new THREE.EdgesGeometry(plate.geometry),
    new THREE.LineBasicMaterial({ color: 0x9fb0bd, transparent: true, opacity: 0.5 })
  );
  plateGroup.add(plateEdge);
  const frame = new THREE.Mesh(new THREE.BoxGeometry(1.06, 0.78, 0.02), MAT.woodDark);
  frame.position.z = -0.028; plateGroup.add(frame);

  const strut = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.42, 0.05), MAT.woodDeep);
  strut.position.set(-0.32, 0.99, -0.2);
  strut.rotation.x = 0.3;
  g.add(strut);
  const benchLip = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.05, 0.16), MAT.woodDark);
  benchLip.position.set(-0.32, 0.82, 0.22);
  g.add(benchLip);

  const lines = [];
  for (let i = 0; i < 18; i++) {
    const lm = new THREE.MeshStandardMaterial({
      color: 0xe6edf5, roughness: 0.35, metalness: 0.9,
      transparent: true, opacity: 0
    });
    const len = 0.09 + Math.random() * 0.16;
    const ln = new THREE.Mesh(new THREE.BoxGeometry(len, 0.014, 0.008), lm);
    const a = (i / 18) * Math.PI * 2.4;
    const r = 0.06 + (i / 18) * 0.26;
    ln.position.set(Math.cos(a) * r, Math.sin(a) * r, 0.028);
    ln.rotation.z = a + Math.PI / 2;
    plateGroup.add(ln); lines.push(ln);
  }

  const p = makePerson({ robe: 0x6d6152, robe2: 0x4f4639 });
  p.g.position.set(0.45, 0, 0.03);
  p.g.rotation.y = -Math.PI / 2;
  g.add(p.g);

  const chisel = new THREE.Mesh(new THREE.CylinderGeometry(0.016, 0.026, 0.3, 6), MAT.silverDim);
  chisel.position.set(0, -0.62, 0.03);
  chisel.rotation.x = 1.35;
  p.armR.add(chisel);

  const smallHammer = new THREE.Group();
  const hh = new THREE.Mesh(new THREE.CylinderGeometry(0.016, 0.016, 0.24, 6), MAT.woodDark);
  hh.position.y = 0.03; smallHammer.add(hh);
  const hhead = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.06, 0.13), MAT.iron);
  hhead.position.y = 0.15; smallHammer.add(hhead);
  smallHammer.position.set(0, -0.62, 0.02);
  smallHammer.rotation.x = 0.9;
  p.armL.add(smallHammer);

  const chips = makeParticles({
    count: 14, color: 0xc9a46a, size: 0.026, origin: new THREE.Vector3(-0.4, 0.94, 0.12),
    spread: 0.05, up: 0.5, side: 0.35, gravity: 3.0, life: 0.5
  });
  g.add(chips.points);

  /* 工作灯 */
  const post = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.026, 0.95, 8), MAT.iron);
  post.position.set(-1.28, 1.27, -0.22); g.add(post);
  const postBase = new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.12, 0.04, 12), MAT.iron);
  postBase.position.set(-1.28, 0.815, -0.22); g.add(postBase);
  const arm2 = new THREE.Mesh(new THREE.BoxGeometry(0.62, 0.028, 0.028), MAT.iron);
  arm2.position.set(-0.99, 1.73, -0.22); g.add(arm2);
  const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.02, 0.12, 6), MAT.iron);
  neck.position.set(-0.7, 1.67, -0.22); g.add(neck);
  const shade = new THREE.Mesh(new THREE.ConeGeometry(0.17, 0.19, 16, 1, true), MAT.iron);
  shade.position.set(-0.7, 1.52, -0.22);
  shade.rotation.x = Math.PI;
  g.add(shade);
  const bulbMesh = new THREE.Mesh(new THREE.SphereGeometry(0.05, 10, 8), new THREE.MeshBasicMaterial({ color: 0xffe6bd }));
  bulbMesh.position.set(-0.7, 1.46, -0.22); g.add(bulbMesh);
  const bulb = new THREE.PointLight(0xffd6a0, 1.2, 2.2, 2);
  bulb.position.set(-0.7, 1.42, -0.2); g.add(bulb);

  contactShadow(g, -0.2, 0.004, 0, 3.0, 1.4, 0.28);

  return {
    group: g,
    update(t, dt) {
      const tap = Math.sin(t * 9);
      p.armL.rotation.x = -1.02 + tap * 0.17;
      p.armR.rotation.x = -1.25 + tap * 0.035;
      p.head.rotation.x = 0.12 + Math.sin(t * 0.7) * 0.03;
      p.g.rotation.z = 0.02 + Math.sin(t * 0.8) * 0.008;

      lines.forEach((ln, i) => {
        const k = (t * 0.8 + i * 0.055) % 2.4;
        const show = k < 1.4 ? clamp(k / 0.35, 0, 1) : Math.max(0.15, 1 - (k - 1.4) / 0.8);
        ln.material.opacity = show * 0.9;
      });
      if (Math.random() < dt * 6) chips.update(dt * 2.2);
      chips.update(dt);
    }
  };
}

/* 工序四 · 走银 */
function dSilver() {
  const g = new THREE.Group();

  [-0.12, 0.12].forEach(dz => {
    const leg = new THREE.Mesh(new THREE.CylinderGeometry(0.032, 0.042, 0.86, 8), MAT.woodDeep);
    leg.position.set(-0.62, 0.43, dz * 1.6);
    leg.rotation.x = dz * 0.9;
    g.add(leg);
  });
  const cross = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.05, 0.5), MAT.woodDeep);
  cross.position.set(-0.62, 0.3, 0); g.add(cross);

  const plateGroup = new THREE.Group();
  plateGroup.position.set(-0.66, 1.02, 0.02);
  plateGroup.rotation.x = -0.55;
  g.add(plateGroup);

  const plate = new THREE.Mesh(new THREE.BoxGeometry(0.95, 0.62, 0.05), MAT.blackCopper);
  plateGroup.add(plate);
  const plateEdge = new THREE.LineSegments(
    new THREE.EdgesGeometry(plate.geometry),
    new THREE.LineBasicMaterial({ color: 0x9fb0bd, transparent: true, opacity: 0.55 })
  );
  plateGroup.add(plateEdge);

  const grooves = [];
  for (let i = 0; i < 14; i++) {
    const gm = new THREE.MeshBasicMaterial({
      color: 0xe8f4ff, transparent: true, opacity: 0,
      blending: THREE.AdditiveBlending, depthWrite: false
    });
    const a = (i / 14) * Math.PI * 2;
    const r = 0.05 + Math.sin(i * 0.9) * 0.16 + i * 0.012;
    const ln = new THREE.Mesh(new THREE.BoxGeometry(0.1 + i * 0.008, 0.016, 0.006), gm);
    ln.position.set(Math.cos(a) * r, Math.sin(a) * r, 0.03);
    ln.rotation.z = a + Math.PI / 2;
    plateGroup.add(ln); grooves.push(ln);
  }

  const streamMat = new THREE.MeshBasicMaterial({
    color: 0xf2f8ff, transparent: true, opacity: 0.85,
    blending: THREE.AdditiveBlending, depthWrite: false
  });
  const stream = tubeBetween(
    new THREE.Vector3(-0.48, 1.16, 0.02),
    new THREE.Vector3(-0.66, 0.9, 0.02),
    0.012, 0.026, streamMat
  );
  g.add(stream);

  const pourGlow = new THREE.PointLight(0xcfe6ff, 1.4, 1.9, 2);
  pourGlow.position.set(-0.6, 1.05, 0.05); g.add(pourGlow);

  const potGroup = new THREE.Group();
  potGroup.position.set(-0.4, 1.12, 0.02);
  potGroup.rotation.z = 0.55;
  g.add(potGroup);
  const pot = new THREE.Mesh(new THREE.CylinderGeometry(0.15, 0.12, 0.22, 14), MAT.copper);
  potGroup.add(pot);
  const potLiquid = new THREE.Mesh(new THREE.CircleGeometry(0.132, 16), new THREE.MeshBasicMaterial({ color: 0xeaf6ff }));
  potLiquid.rotation.x = -Math.PI / 2;
  potLiquid.position.y = 0.095;
  potGroup.add(potLiquid);

  const p = makePerson({ robe: 0x6a6052, robe2: 0x4c4438 });
  p.g.position.set(0.32, 0, 0.03);
  p.g.rotation.y = -Math.PI / 2;
  g.add(p.g);
  p.armR.rotation.x = -1.35; p.armR.rotation.z = -0.22;
  p.armL.rotation.x = -1.3; p.armL.rotation.z = 0.24;

  const heat = makeParticles({
    count: 18, color: 0xdff0ff, size: 0.045, origin: new THREE.Vector3(-0.62, 0.92, 0.04),
    spread: 0.22, up: 0.35, side: 0.12, gravity: -0.15, life: 1.8, normal: true
  });
  g.add(heat.points);

  const brazier = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.2, 0.24, 12), MAT.iron);
  brazier.position.set(1.5, 0.12, 0.1); g.add(brazier);
  const coals = new THREE.Mesh(new THREE.CircleGeometry(0.22, 14), new THREE.MeshBasicMaterial({ color: 0xff6a2a }));
  coals.rotation.x = -Math.PI / 2; coals.position.set(1.5, 0.245, 0.1); g.add(coals);
  const coalLight = new THREE.PointLight(0xff6a2a, 1.2, 1.4, 2);
  coalLight.position.set(1.5, 0.4, 0.1); g.add(coalLight);

  contactShadow(g, 0.1, 0.004, 0, 3.0, 1.4, 0.28);

  return {
    group: g,
    update(t, dt) {
      const wobble = Math.sin(t * 2.2) * 0.03;
      potGroup.rotation.z = 0.55 + wobble;
      potGroup.position.y = 1.12 + Math.sin(t * 2.2 + 0.6) * 0.008;
      p.armR.rotation.x = -1.35 + wobble * 0.5;
      p.armL.rotation.x = -1.3 + wobble * 0.5;
      p.g.rotation.z = Math.sin(t * 1.1) * 0.01;

      streamMat.opacity = 0.5 + Math.sin(t * 16) * 0.14 + Math.random() * 0.07;
      pourGlow.intensity = 1.3 + Math.sin(t * 9) * 0.4;
      potLiquid.material.color.setHSL(0.58, 0.5, 0.86 + Math.sin(t * 5) * 0.06);

      grooves.forEach((ln, i) => {
        const k = (t * 1.1 + i * 0.09) % 3.0;
        const v = k < 1.6 ? 1 : Math.max(0, 1 - (k - 1.6) / 0.7);
        ln.material.opacity = v * 0.95;
      });
      heat.update(dt);
      coalLight.intensity = 1.0 + Math.sin(t * 11) * 0.35;
    }
  };
}

/* 工序五 · 焊接组装、抛光处理 */
function dPolish() {
  const g = new THREE.Group();

  const post = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.92, 0.16), MAT.iron);
  post.position.set(-0.55, 0.46, -0.1); g.add(post);
  const foot = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.09, 0.56), MAT.iron);
  foot.position.set(-0.55, 0.045, -0.05); g.add(foot);
  const motor = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.2, 0.26), MAT.iron);
  motor.position.set(-0.55, 0.98, -0.13); g.add(motor);
  const axle = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.16, 10), MAT.silverDim);
  axle.rotation.x = Math.PI / 2;
  axle.position.set(-0.55, 0.98, -0.03); g.add(axle);

  const spin = new THREE.Group();
  spin.position.set(-0.55, 0.98, 0.02);
  g.add(spin);

  const wheelMat = new THREE.MeshStandardMaterial({ color: 0x8b8377, roughness: 0.96 });
  const wheel = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.3, 0.09, 28), wheelMat);
  wheel.rotation.x = Math.PI / 2;
  spin.add(wheel);

  const rimRing = new THREE.Mesh(new THREE.TorusGeometry(0.3, 0.016, 8, 40), new THREE.MeshStandardMaterial({ color: 0x59524a, roughness: 0.9 }));
  spin.add(rimRing);
  const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.055, 0.12, 14), MAT.iron);
  hub.rotation.x = Math.PI / 2;
  spin.add(hub);
  for (let i = 0; i < 3; i++) {
    const a = (i / 3) * Math.PI * 2;
    const spoke = new THREE.Mesh(new THREE.BoxGeometry(0.19, 0.028, 0.012), new THREE.MeshStandardMaterial({ color: 0x4b453d, roughness: 0.95 }));
    spoke.position.set(Math.cos(a) * 0.13, Math.sin(a) * 0.13, 0.048);
    spoke.rotation.z = a;
    spin.add(spoke);
  }

  const sparks = makeParticles({
    count: 34, color: 0xffcf8a, size: 0.036, origin: new THREE.Vector3(-0.25, 0.94, 0.06),
    spread: 0.05, up: 0.2, side: 1.0, gravity: 3.6, life: 0.6
  });
  g.add(sparks.points);

  const p = makePerson({ robe: 0x6d6456, robe2: 0x4e463a });
  p.g.position.set(0.3, 0, 0.02);
  p.g.rotation.y = -Math.PI / 2;
  g.add(p.g);
  p.armR.rotation.x = -1.25; p.armR.rotation.z = -0.16;
  p.armL.rotation.x = -1.2; p.armL.rotation.z = 0.18;

  const workProf = [
    [0, 0], [0.1, 0.01], [0.14, 0.06], [0.15, 0.13], [0.12, 0.2], [0.13, 0.24], [0.135, 0.26]
  ].map(q => new THREE.Vector2(q[0], q[1]));
  const work = new THREE.Mesh(new THREE.LatheGeometry(workProf, 28), MAT.blackCopper);
  work.position.set(-0.14, 0.9, 0.06);
  work.scale.setScalar(0.85);
  g.add(work);
  const workRing = new THREE.Mesh(new THREE.TorusGeometry(0.145, 0.008, 6, 40), MAT.silver);
  workRing.rotation.x = Math.PI / 2;
  workRing.position.set(-0.14, 1.02, 0.06);
  g.add(workRing);

  const shelf = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.06, 0.5), MAT.wood);
  shelf.position.set(1.45, 0.7, 0.05); g.add(shelf);
  [[1.2, 0.14], [1.78, 0.14]].forEach(([x, z]) => {
    const l = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.7, 0.06), MAT.woodDeep);
    l.position.set(x, 0.35, z); g.add(l);
  });
  [0, 1, 2].forEach(i => {
    const prof = [
      [0, 0], [0.09, 0.01], [0.12, 0.05], [0.13, 0.11], [0.1, 0.16], [0.11, 0.19]
    ].map(q => new THREE.Vector2(q[0], q[1]));
    const v = new THREE.Mesh(new THREE.LatheGeometry(prof, 24), i === 1 ? MAT.silver : MAT.blackCopper);
    v.position.set(1.18 + i * 0.27, 0.73, 0.05);
    g.add(v);
  });

  contactShadow(g, 0.15, 0.004, 0, 3.0, 1.4, 0.28);

  return {
    group: g,
    update(t, dt) {
      spin.rotation.z += dt * 9.0;
      p.armR.rotation.x = -1.25 + Math.sin(t * 1.6) * 0.04;
      p.armL.rotation.x = -1.2 + Math.sin(t * 1.6 + 0.5) * 0.04;
      p.g.rotation.z = Math.sin(t * 1.6) * 0.008;
      work.rotation.y += dt * 0.6;
      sparks.update(dt);
    }
  };
}

/* 工序五 · 捂黑：底铜氧化为乌黑发亮、银纹皎洁（签名工序）。
   画面 = 方形铜板做「捂黑」材质终态：近黑深色底（roughness 0.25 乌黑发亮，
   不是哑光黑），银纹高亮；交界处一抹极微弱暖光模拟手汗包浆的温润 */
function blackenPlateTex() {
  return canvasTex(makeCanvas(1024, 1024, (g, w, h) => {
    /* 乌黑发亮的底铜：中心一档微亮，边缘沉下去 */
    const bg = g.createRadialGradient(w * 0.5, h * 0.42, w * 0.08, w * 0.5, h * 0.5, w * 0.72);
    bg.addColorStop(0, '#171615');       /* ≈ RGB 0.02 深黑 */
    bg.addColorStop(0.55, '#0b0b0a');
    bg.addColorStop(1, '#030303');
    g.fillStyle = bg;
    g.fillRect(0, 0, w, h);

    /* 银纹：手绘线条复原照片的山水纹样（皎洁高亮，roughness 0.05 的银） */
    g.strokeStyle = '#e3e9ee';
    g.lineCap = 'round';
    g.lineJoin = 'round';

    /* 远山（两叠峰 + 山脊排线） */
    g.lineWidth = 7;
    g.beginPath();
    g.moveTo(w * 0.14, h * 0.37);
    g.quadraticCurveTo(w * 0.25, h * 0.20, w * 0.35, h * 0.31);
    g.quadraticCurveTo(w * 0.43, h * 0.37, w * 0.51, h * 0.26);
    g.quadraticCurveTo(w * 0.61, h * 0.16, w * 0.72, h * 0.31);
    g.stroke();
    g.lineWidth = 3;
    for (let i = 0; i < 6; i++) {
      const bx = w * (0.23 + i * 0.065), by = h * (0.31 + i * 0.014);
      g.beginPath();
      g.moveTo(bx, by);
      g.lineTo(bx + w * 0.05, by + h * 0.05);
      g.stroke();
    }

    /* 松 / 梅：主枝 + 两条分枝 + 梅花点 */
    g.lineWidth = 6;
    g.beginPath();
    g.moveTo(w * 0.30, h * 0.64);
    g.bezierCurveTo(w * 0.34, h * 0.53, w * 0.40, h * 0.48, w * 0.47, h * 0.44);
    g.stroke();
    g.lineWidth = 4;
    g.beginPath();
    g.moveTo(w * 0.38, h * 0.51);
    g.quadraticCurveTo(w * 0.44, h * 0.46, w * 0.51, h * 0.50);
    g.stroke();
    g.beginPath();
    g.moveTo(w * 0.34, h * 0.57);
    g.quadraticCurveTo(w * 0.28, h * 0.51, w * 0.23, h * 0.53);
    g.stroke();
    g.fillStyle = '#e3e9ee';
    [[0.47, 0.44], [0.51, 0.50], [0.23, 0.53], [0.40, 0.48]].forEach(([px, py]) => {
      for (let i = 0; i < 9; i++) {
        const a = Math.random() * Math.PI * 2, r = 7 + Math.random() * 28;
        g.beginPath();
        g.arc(w * px + Math.cos(a) * r, h * py + Math.sin(a) * r * 0.6, 2.5 + Math.random() * 3, 0, Math.PI * 2);
        g.fill();
      }
    });

    /* 水波 + 小舟 */
    g.lineWidth = 4;
    for (let i = 0; i < 5; i++) {
      const y = h * (0.72 + i * 0.045);
      g.beginPath();
      g.moveTo(w * 0.16, y);
      for (let x = 0; x <= w * 0.66; x += w * 0.045) {
        g.quadraticCurveTo(x + w * 0.022, y - 8, x + w * 0.045, y);
      }
      g.stroke();
    }
    g.lineWidth = 5;
    g.beginPath();
    g.moveTo(w * 0.55, h * 0.70);
    g.quadraticCurveTo(w * 0.60, h * 0.73, w * 0.65, h * 0.70);
    g.stroke();
    g.beginPath();
    g.moveTo(w * 0.60, h * 0.70); g.lineTo(w * 0.60, h * 0.635);
    g.stroke();
    g.beginPath();
    g.moveTo(w * 0.60, h * 0.645);
    g.quadraticCurveTo(w * 0.635, h * 0.665, w * 0.60, h * 0.688);
    g.stroke();

    /* 题字（竖排，右起）+ 朱红小印 */
    g.fillStyle = '#e6ebef';
    g.font = '54px "Noto Serif SC","STSong","SimSun",serif';
    g.textAlign = 'center';
    g.textBaseline = 'middle';
    [['溪', '静'], ['风', '不', '住'], ['树', '深']].forEach((col, ci) => {
      const x = w * (0.87 - ci * 0.095);
      col.forEach((ch, ri) => { g.fillText(ch, x, h * (0.115 + ri * 0.088)); });
    });
    g.fillStyle = 'rgba(163,52,38,.9)';
    g.fillRect(w * 0.775 - 24, h * 0.115 + 2 * 0.088 * h + 16, 48, 48);

    /* 银质包边（照片中的圆角方银边） */
    g.globalAlpha = 1;
    g.lineWidth = 26;
    g.strokeStyle = '#c9ced4';
    g.beginPath();
    g.roundRect(w * 0.022, h * 0.022, w * 0.956, h * 0.956, w * 0.075);
    g.stroke();
    g.lineWidth = 5;
    g.strokeStyle = '#3a3d40';
    g.beginPath();
    g.roundRect(w * 0.052, h * 0.052, w * 0.896, h * 0.896, w * 0.06);
    g.stroke();
  }));
}

function dBlacken() {
  const g = new THREE.Group();

  /* 案台 + 绒布 */
  const benchTop = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.07, 0.7), MAT.wood);
  benchTop.position.set(-0.35, 0.76, 0.05); g.add(benchTop);
  [[-0.95, -0.2], [-0.95, 0.3], [0.25, -0.2], [0.25, 0.3]].forEach(([x, z]) => {
    const leg = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.76, 0.07), MAT.woodDeep);
    leg.position.set(x, 0.38, z); g.add(leg);
  });
  const cloth = new THREE.Mesh(new THREE.BoxGeometry(1.12, 0.018, 0.6), MAT.woodDark);
  cloth.position.set(-0.35, 0.808, 0.05);
  cloth.rotation.y = 0.07;
  g.add(cloth);

  /* 铜板：斜立展示，乌黑底 + 银纹 */
  const plateGroup = new THREE.Group();
  plateGroup.position.set(-0.35, 1.02, 0.05);
  plateGroup.rotation.x = -0.62;
  g.add(plateGroup);
  const plateMat = new THREE.MeshStandardMaterial({
    map: blackenPlateTex(), color: 0xffffff,
    roughness: 0.25, metalness: 0.35, envMapIntensity: 0.9   /* 乌黑发亮，不是哑光黑 */
  });
  const plate = new THREE.Mesh(new THREE.BoxGeometry(0.86, 0.86, 0.035), plateMat);
  plateGroup.add(plate);

  /* 支撑托架 */
  const strut = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.34, 0.05), MAT.woodDeep);
  strut.position.set(-0.35, 0.93, -0.12);
  strut.rotation.x = 0.5;
  g.add(strut);
  const lip = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.05, 0.16), MAT.woodDark);
  lip.position.set(-0.35, 0.83, 0.2);
  g.add(lip);

  /* 流光泽：一道窄暖光带扫过板面，表现「乌黑发亮」的镜面感 */
  const sheenTex = canvasTex(makeCanvas(128, 128, (g2, w2, h2) => {
    const lg = g2.createLinearGradient(0, 0, w2, 0);
    lg.addColorStop(0, 'rgba(255,240,218,0)');
    lg.addColorStop(0.5, 'rgba(255,240,218,.5)');
    lg.addColorStop(1, 'rgba(255,240,218,0)');
    g2.fillStyle = lg;
    g2.fillRect(0, 0, w2, h2);
  }));
  const sheen = new THREE.Mesh(
    new THREE.PlaneGeometry(0.16, 0.82),
    new THREE.MeshBasicMaterial({
      map: sheenTex, transparent: true, opacity: 0,
      blending: THREE.AdditiveBlending, depthWrite: false
    })
  );
  sheen.position.z = 0.03;
  plateGroup.add(sheen);

  /* 交界处极微弱的暖色环境反射：模拟手汗包浆的温润感 */
  const patina = new THREE.PointLight(0xffd9b0, 0.5, 1.3, 2);
  patina.position.set(-0.1, 1.62, 0.18);
  g.add(patina);

  /* 匠人拭铜 */
  const p = makePerson({ robe: 0x6a5f50, robe2: 0x4c4438 });
  p.g.position.set(0.5, 0, 0.03);
  p.g.rotation.y = -Math.PI / 2;
  g.add(p.g);
  const clothWipe = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.05, 0.11),
    new THREE.MeshStandardMaterial({ color: 0x8b9096, roughness: 0.9, metalness: 0 }));
  clothWipe.position.set(0, -0.6, 0.02);
  p.armR.add(clothWipe);

  contactShadow(g, -0.1, 0.004, 0, 3.0, 1.4, 0.28);

  return {
    group: g,
    update(t, dt) {
      /* 拭铜：手臂轻缓往复 */
      p.armR.rotation.x = -1.12 + Math.sin(t * 2.1) * 0.10;
      p.armL.rotation.x = -1.18 + Math.sin(t * 2.1 + 0.6) * 0.05;
      p.g.rotation.z = Math.sin(t * 2.1) * 0.006;
      p.head.rotation.x = 0.14 + Math.sin(t * 0.6) * 0.02;
      /* 光泽扫过：包浆越养越亮 */
      const s = (t * 0.22) % 1;
      sheen.position.x = -0.55 + s * 1.1;
      sheen.material.opacity = Math.sin(s * Math.PI) * 0.30;
    }
  };
}

const DIORAMAS = [dSmelt, dEngrave, dSilver, dPolish, dBlacken];

/* ---------- 9. 器物 ---------- */
const VPROF = {
  jar: [[0, 0], [0.26, 0.015], [0.34, 0.06], [0.39, 0.18], [0.4, 0.32], [0.36, 0.43], [0.29, 0.51], [0.27, 0.55], [0.285, 0.575]],
  vase: [[0, 0], [0.2, 0.015], [0.27, 0.07], [0.3, 0.19], [0.28, 0.36], [0.22, 0.5], [0.15, 0.62], [0.12, 0.72], [0.13, 0.8], [0.165, 0.84]],
  bowl: [[0, 0], [0.16, 0.01], [0.27, 0.05], [0.35, 0.13], [0.4, 0.23], [0.415, 0.28]],
  box: [[0, 0], [0.3, 0.02], [0.33, 0.08], [0.34, 0.19], [0.325, 0.26], [0.24, 0.285]]
};

function radialAt(prof, y) {
  for (let i = 1; i < prof.length; i++) {
    if (prof[i].y >= y) {
      const a = prof[i - 1], b = prof[i];
      const t = (y - a.y) / Math.max(1e-5, b.y - a.y);
      return lerp(a.x, b.x, t);
    }
  }
  return prof[prof.length - 1].x;
}

function makeVessel(opt = {}) {
  const prof = VPROF[opt.kind || 'jar'].map(q => new THREE.Vector2(q[0], q[1]));
  const maxY = prof[prof.length - 1].y;
  const sc = (opt.h || 0.42) / maxY;
  const g = new THREE.Group();

  const body = new THREE.Mesh(
    new THREE.LatheGeometry(prof, 40),
    opt.silver ? MAT.silver : MAT.vessel
  );
  body.scale.setScalar(sc);
  body.castShadow = true;
  g.add(body);

  /* 口沿银线 */
  const rimR = prof[prof.length - 1].x * sc;
  const rim = new THREE.Mesh(new THREE.TorusGeometry(rimR + 0.002, 0.0058, 6, 36), MAT.silver);
  rim.rotation.x = Math.PI / 2;
  rim.position.y = maxY * sc;
  g.add(rim);

  /* 器身银环 */
  const sy = maxY * 0.6;
  const sr = radialAt(prof, sy) * sc + 0.003;
  const sh = new THREE.Mesh(new THREE.TorusGeometry(sr, 0.0045, 6, 36), MAT.silver);
  sh.rotation.x = Math.PI / 2;
  sh.position.y = sy * sc;
  g.add(sh);

  if ((opt.kind || 'jar') === 'jar' && opt.lid !== false) {
    const lid = new THREE.Mesh(new THREE.SphereGeometry(0.3 * sc, 26, 10, 0, Math.PI * 2, 0, Math.PI * 0.5), MAT.silver);
    lid.position.y = maxY * sc - 0.012 * sc;
    lid.scale.y = 0.26;
    g.add(lid);
    const knob = new THREE.Mesh(new THREE.SphereGeometry(0.036 * sc, 10, 8), MAT.silver);
    knob.position.y = maxY * sc + 0.062 * sc;
    g.add(knob);
  }

  return g;
}

/* @@PART_B_END@@ */

/* ---------- 10. 五道工序 ---------- */
const PROCESS = [
  {
    no: '壹', name: '熔炼乌铜',
    text: '在熔化的铜水中加入黄金及其他金属，熔炼为乌铜。这是一项关键性技术，原料配方最为重要。'
  },
  {
    no: '贰', name: '刻绘纹饰',
    text: '在成型的乌铜器皿上用錾子精细刻凿所需表现的图案纹理，刻绘深度依据乌铜片的壁厚而定。刻凿后还需在刻痕里涂上一种祖传的"焊药"。'
  },
  {
    no: '叁', name: '走银',
    text: '将已熔化的白银溶液浇于乌铜表面所刻绘纹饰的凹槽中。此步骤温度控制非常关键，因为铜与银的熔点极为接近，仅为130度的差异，一旦温度控制不好，走银时乌铜可能同时熔化。这一步也是乌铜走银最关键的技术。'
  },
  {
    no: '肆', name: '焊接组装、抛光处理',
    text: '将走银后的各个部件焊接组装成器，再经反复打磨、抛光。乌铜色黑如漆，银纹皎洁如月，黑白分明而历久不褪，一件器物至此方成。'
  },
  {
    no: '伍', name: '捂黑',
    text: '捂黑是乌铜走银的"签名工序"。通过手汗中的微量元素与乌铜表面反应，底铜氧化为乌黑发亮的状态，银纹则因不与汗液反应而保持皎洁，最终形成黑底银纹、黑白分明的视觉终点。'
  }
];

const vitrines = [];
const hitboxes = [];
const colliders = [];

/* 地面镜像光带 */
function windowReflection(x, z, w, len, op, dir) {
  const m = new THREE.Mesh(
    new THREE.PlaneGeometry(len, w),
    new THREE.MeshBasicMaterial({
      map: dir > 0 ? M.reflL : M.reflR,
      transparent: true, opacity: op, depthWrite: false,
      blending: THREE.AdditiveBlending
    })
  );
  m.rotation.x = -Math.PI / 2;
  m.position.set(x, 0.013, z);
  m.renderOrder = 3;
  arch.add(m);
  return m;
}

/* ---------- 11. 左侧工序展窗 ---------- */
function buildWindow(cfg, i, zi) {
  const z = (zi === undefined) ? WIN_Z[i] : zi;
  const g = new THREE.Group();
  g.position.set(-HW, 0, z);
  g.rotation.y = Math.PI / 2;
  world.add(g);

  const W = WIN.W, H = WIN.H, SILL = WIN.SILL, D = WIN.D;
  const yC = SILL + H / 2;

  /* 柜内四壁 */
  const back = new THREE.Mesh(new THREE.PlaneGeometry(W, H), M.warm);
  back.position.set(0, yC, -D + 0.02);
  g.add(back);

  const jamb = M.caseWall;
  box(0.06, H, D, jamb, -(W / 2 + 0.03), yC, -D / 2, g);
  box(0.06, H, D, jamb, W / 2 + 0.03, yC, -D / 2, g);
  box(W, 0.06, D, M.caseWall, 0, SILL + H, -D / 2, g);
  const innerFloor = box(W, 0.06, D, M.caseFloor, 0, SILL - 0.03, -D / 2, g);
  innerFloor.receiveShadow = true;

  /* 顶部灯槽 */
  const coveMat = new THREE.MeshBasicMaterial({ color: 0xffe4bb });
  const cove = new THREE.Mesh(new THREE.BoxGeometry(W - 0.42, 0.032, 0.09), coveMat);
  cove.position.set(0, SILL + H - 0.055, -0.32);
  g.add(cove);
  box(W - 0.42, 0.04, 0.16, M.trimShadow, 0, SILL + H - 0.015, -0.36, g);

  /* 石质阶梯边框 */
  const F = 0.2;
  box(F, H + 0.52, 0.17, M.trim, -(W / 2 + F / 2), yC, 0.02, g);
  box(F, H + 0.52, 0.17, M.trim, W / 2 + F / 2, yC, 0.02, g);
  box(W + F * 2, F, 0.17, M.trim, 0, SILL + H + F / 2, 0.02, g);
  box(W + F * 2, 0.14, 0.34, M.trim, 0, SILL - 0.07, 0.12, g);

  /* 内层细边与阴影缝 */
  box(0.07, H + 0.06, 0.06, M.trim, -(W / 2 + 0.035), yC, 0.12, g);
  box(0.07, H + 0.06, 0.06, M.trim, W / 2 + 0.035, yC, 0.12, g);
  box(W + 0.14, 0.07, 0.06, M.trim, 0, SILL + H + 0.035, 0.12, g);

  box(0.022, H, 0.05, M.trimShadow, -(W / 2 - 0.005), yC, 0.01, g);
  box(0.022, H, 0.05, M.trimShadow, W / 2 - 0.005, yC, 0.01, g);
  box(W, 0.022, 0.05, M.trimShadow, 0, SILL + H - 0.005, 0.01, g);

  /* 外缘阴影缝：让石框从墙面脱开 */
  box(0.035, H + 0.56, 0.035, M.trimShadow, -(W / 2 + F + 0.017), yC, 0.012, g);
  box(0.035, H + 0.56, 0.035, M.trimShadow, W / 2 + F + 0.017, yC, 0.012, g);
  box(W + F * 2 + 0.06, 0.035, 0.035, M.trimShadow, 0, SILL + H + F, 0.012, g);

  /* 外缘阴影缝：让石框从墙面脱开 */
  box(0.035, H + 0.56, 0.035, M.trimShadow, -(W / 2 + F + 0.017), yC, 0.012, g);
  box(0.035, H + 0.56, 0.035, M.trimShadow, W / 2 + F + 0.017, yC, 0.012, g);
  box(W + F * 2 + 0.06, 0.035, 0.035, M.trimShadow, 0, SILL + H + F, 0.012, g);

  /* 微缩场景 */
  const dia = DIORAMAS[i]();
  dia.group.position.set(-0.12, SILL, -D * 0.55);
  dia.group.scale.setScalar(1.26);
  dia.group.traverse(o => { if (o.isMesh) o.castShadow = true; });
  g.add(dia.group);

  /* 玻璃面：只留一道极淡的斜向反光 */
  if (!M.glassTex) {
    M.glassTex = canvasTex(makeCanvas(256, 256, (g2, w, h) => {
      g2.clearRect(0, 0, w, h);
      const lgr = g2.createLinearGradient(0, h, w, 0);
      lgr.addColorStop(0, 'rgba(255,255,255,0)');
      lgr.addColorStop(0.42, 'rgba(255,255,255,0.5)');
      lgr.addColorStop(0.5, 'rgba(255,255,255,0.9)');
      lgr.addColorStop(0.58, 'rgba(255,255,255,0.36)');
      lgr.addColorStop(1, 'rgba(255,255,255,0)');
      g2.fillStyle = lgr; g2.fillRect(0, 0, w, h);
    }));
  }
  const glass = new THREE.Mesh(
    new THREE.PlaneGeometry(W - 0.02, H - 0.02),
    new THREE.MeshBasicMaterial({
      map: M.glassTex, transparent: true, opacity: 0.1,
      blending: THREE.AdditiveBlending, depthWrite: false
    })
  );
  glass.position.set(0, yC, 0.085);
  g.add(glass);

  /* 内壁说明卡 */
  const card = new THREE.Mesh(
    new THREE.PlaneGeometry(0.42, 0.566),
    new THREE.MeshBasicMaterial({ map: windowCardTexture(cfg.no, cfg.name), transparent: true })
  );
  card.position.set(1.58, 2.24, -D + 0.05);
  g.add(card);

  /* 柜内射灯 */
  const spot = new THREE.SpotLight(0xffd7a8, 5.4, 7.5, 0.98, 0.92, 2);
  spot.position.set(0, SILL + H - 0.16, -0.32);
  spot.target.position.set(-0.1, SILL + 0.6, -D * 0.62);
  spot.castShadow = true;
  spot.shadow.mapSize.set(256, 256);
  spot.shadow.camera.near = 0.3;
  spot.shadow.camera.far = 6.5;
  spot.shadow.bias = -0.0018;
  spot.shadow.radius = 2;
  g.add(spot); g.add(spot.target);

  /* 点击热区 */
  const hit = new THREE.Mesh(
    new THREE.PlaneGeometry(W - 0.1, H - 0.1),
    new THREE.MeshBasicMaterial({ transparent: true, opacity: 0, depthWrite: false, side: THREE.DoubleSide })
  );
  hit.position.set(0, yC, 0.06);
  hit.userData.id = i;
  g.add(hit);
  hitboxes.push(hit);

  /* 外墙铭牌 */
  const plaque = new THREE.Mesh(
    new THREE.PlaneGeometry(0.62, 0.103),
    new THREE.MeshBasicMaterial({ map: labelTexture(cfg.no, cfg.name), transparent: true })
  );
  plaque.position.set(-HW + 0.015, 1.52, z + W / 2 + 0.42);
  plaque.rotation.y = Math.PI / 2;
  world.add(plaque);

  /* 地面反射光晕 */
  windowReflection(-HW + 1.6, z, 4.15, 3.2, 0.56, 1);

  vitrines.push({
    index: i, cfg, group: g, dia, cove: coveMat, spot,
    front: new THREE.Vector3(-HW + 0.4, 1.4, z),
    _d: 99, _k: 0
  });
}

/* 连通版：门厅在逻辑 z=+17 端，往长廊深处走逻辑 z 递减；
   把工序一放到 WIN_Z 最后一格（逻辑 z=+12），保证从展厅北门进长廊
   左拐后第一扇展窗就是工序一，沿走线依次一到五（用户 2026-11-15 指正） */
PROCESS.forEach(function (cfg, i) { buildWindow(cfg, i, WIN_Z[PROCESS.length - 1 - i]); });

/* ---------- 12. 右侧器物柜 ---------- */
const CAB_Z = [-12, -7.2, -2.4, 2.4, 7.2, 12];
const CAB_CONTENT = [
  { kind: 'jar', name: '乌铜走银罐' },
  { kind: 'vase', name: '走银花瓶' },
  { kind: 'bowl', name: '乌铜茶碗' },
  { kind: 'box', name: '银纹盖盒' },
  { kind: 'vase', name: '乌铜走银瓶' },
  { kind: 'jar', name: '银纹小罐' }
];

function cabLabelTexture(name) {
  const c = makeCanvas(512, 104, (g, W, H) => {
    g.fillStyle = '#241f1a'; g.fillRect(0, 0, W, H);
    g.strokeStyle = 'rgba(200,172,126,.35)'; g.lineWidth = 2;
    g.strokeRect(6, 6, W - 12, H - 12);
    g.fillStyle = '#dcc7a0';
    g.font = '400 38px "Songti SC","STSong","SimSun",serif';
    g.textAlign = 'center'; g.textBaseline = 'middle';
    g.fillText(name, W / 2, H / 2 + 1);
  });
  return canvasTex(c);
}

function buildCabinet(z, i) {
  const g = new THREE.Group();
  g.position.set(HW, 0, z);
  g.rotation.y = -Math.PI / 2;
  world.add(g);

  const CW = 2.08;

  /* 背板（暖光内壁） */
  const backMat = new THREE.MeshBasicMaterial({ map: TEX.warm, color: 0xcbb896 });
  const back = new THREE.Mesh(new THREE.PlaneGeometry(CW - 0.12, 1.82), backMat);
  back.position.set(0, 1.93, 0.04);
  g.add(back);

  /* 柜体 */
  box(0.09, 2.46, 0.42, M.walnutDark, -(CW / 2 + 0.045), 1.63, 0.21, g);
  box(0.09, 2.46, 0.42, M.walnutDark, CW / 2 + 0.045, 1.63, 0.21, g);
  box(CW + 0.18, 0.1, 0.44, M.walnut, 0, 2.86, 0.22, g);
  box(CW + 0.1, 0.07, 0.4, M.walnutDark, 0, 1.02, 0.2, g);

  /* 底柜 */
  box(CW + 0.14, 0.92, 0.46, M.walnut, 0, 0.46, 0.23, g);
  box(CW + 0.2, 0.06, 0.52, M.walnutDark, 0, 0.95, 0.26, g);
  /* 抽屉面 */
  for (let k = 0; k < 2; k++) {
    const dr = box(CW / 2 - 0.14, 0.3, 0.02, M.walnutDark, (k - 0.5) * (CW / 2), 0.66, 0.462, g);
    const pull = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.022, 0.022), M.brass);
    pull.position.set((k - 0.5) * (CW / 2), 0.66, 0.482);
    g.add(pull);
  }

  /* 层板 */
  [1.68, 2.28].forEach(y => {
    box(CW - 0.16, 0.042, 0.35, M.walnut, 0, y, 0.21, g);
  });

  /* 铜边 */
  box(0.014, 1.86, 0.014, M.brass, -(CW / 2 - 0.01), 1.93, 0.4, g);
  box(0.014, 1.86, 0.014, M.brass, CW / 2 - 0.01, 1.93, 0.4, g);

  /* 器物陈列 */
  const cf = CAB_CONTENT[i];
  /* 碗形套 0.4 高会算出 1.19m 底径（比柜子还宽），这一格不再摆大件 */
  if (cf.kind !== 'bowl') {
    const big = makeVessel({ kind: cf.kind, h: cf.kind === 'box' ? 0.24 : 0.4, rings: 2 });
    big.position.set(-0.42, 0.98, 0.24);
    g.add(big);
  }

  const small = makeVessel({ kind: i % 2 ? 'bowl' : 'jar', h: i % 2 ? 0.16 : 0.28, rings: 1, vertical: false, lid: false });
  small.position.set(0.42, 0.98, 0.24);
  g.add(small);

  const v1 = makeVessel({ kind: 'vase', h: 0.3, rings: 1 });
  v1.position.set(-0.32, 1.7, 0.22);
  g.add(v1);

  const v2 = makeVessel({ kind: 'jar', h: 0.22, rings: 1 });
  v2.position.set(0.44, 1.7, 0.22);
  g.add(v2);

  const v3 = makeVessel({ kind: 'box', h: 0.15, rings: 0, vertical: false, lid: false });
  v3.position.set(-0.5, 2.3, 0.22);
  g.add(v3);

  const v4 = makeVessel({ kind: 'vase', h: 0.24, rings: 1 });
  v4.position.set(0.36, 2.3, 0.22);
  g.add(v4);

  /* 说明小牌 */
  const label = new THREE.Mesh(
    new THREE.PlaneGeometry(0.44, 0.089),
    new THREE.MeshBasicMaterial({ map: cabLabelTexture(cf.name) })
  );
  label.position.set(0, 0.82, 0.475);
  g.add(label);

  /* 柜内灯 */
  const lamp = new THREE.PointLight(0xffd2a0, 6.6, 2.6, 2);
  lamp.position.set(0, 2.32, 0.72);
  g.add(lamp);

  /* 地面光晕 */
  windowReflection(HW - 1.05, z, 2.0, 2.1, 0.22, -1);
}

CAB_Z.forEach(buildCabinet);

/* ---------- 13. 轨道射灯 ---------- */
function buildTrack() {
  const railZ = [];
  for (let z = -13.2; z <= 13.3; z += 2.2) railZ.push(z);

  railZ.forEach((z, i) => {
    const fix = new THREE.Group();
    fix.position.set(0, ROOM.h - 0.02, z);
    world.add(fix);

    const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, 0.12, 8), M.trackHead);
    stem.position.y = -0.05;
    fix.add(stem);

    const body = new THREE.Mesh(new THREE.CylinderGeometry(0.048, 0.062, 0.19, 12), M.trackHead);
    body.rotation.x = Math.PI / 2;
    body.position.z = 0.1;
    fix.add(body);

    const lens = new THREE.Mesh(new THREE.CircleGeometry(0.042, 14), new THREE.MeshBasicMaterial({ color: 0xfff0d4 }));
    lens.position.z = 0.196;
    fix.add(lens);

    let target;
    if (i % 3 === 0) {
      const nz = WIN_Z.reduce((a, b) => Math.abs(b - z) < Math.abs(a - z) ? b : a, WIN_Z[0]);
      target = new THREE.Vector3(-HW + 1.4, 1.5, nz);
    } else if (i % 3 === 1) {
      const nz = CAB_Z.reduce((a, b) => Math.abs(b - z) < Math.abs(a - z) ? b : a, CAB_Z[0]);
      target = new THREE.Vector3(HW - 0.3, 1.6, nz);
    } else {
      target = new THREE.Vector3(0, 0, z + 0.9);
    }
    fix.lookAt(target);
  });

  /* 实际光源（数量受控） */
  [-10, -3.4, 3.4, 10].forEach((z, i) => {
    const sp = new THREE.SpotLight(0xffeedb, 44, 12, 0.5, 0.86, 2);
    sp.position.set(0, ROOM.h - 0.18, z);
    sp.target.position.set(i % 2 ? 1.0 : -1.0, 0, z + 0.4);
    world.add(sp); world.add(sp.target);

    const pool = floorGlow(i % 2 ? 0.9 : -0.9, z + 0.6, 3.2, 3.2, 0.09);
    pool.material.color.set(0xffe0b8);
  });
}
buildTrack();

/* ---------- 14. 端景主光（尽头只洗立轴，不置器物） ---------- */
const focalSpot = new THREE.SpotLight(0xffe2b6, 46, 9, 0.5, 0.86, 2);
focalSpot.position.set(0, ROOM.h - 0.85, -HL + 2.6);
focalSpot.target.position.set(0, 1.95, -HL - 0.3);
focalSpot.castShadow = true;
focalSpot.shadow.mapSize.set(1024, 1024);
focalSpot.shadow.camera.near = 0.6;
focalSpot.shadow.camera.far = 8;
focalSpot.shadow.bias = -0.0015;
world.add(focalSpot); world.add(focalSpot.target);

const focalFill = new THREE.PointLight(0xffd8a8, 9.0, 5.0, 2);
focalFill.position.set(0, 2.4, -HL + 1.5);
world.add(focalFill);

/* 端景地面光晕 */
floorGlow(0, -HL + 1.5, 3.0, 3.2, 0.16);

/* 入口光晕 */
floorGlow(0, HL - 0.6, 3.2, 3.0, 0.18);

/* ---------- 15. 碰撞体 ---------- */
/* 长凳已移除，碰撞体一并删除 */

/* ---------- 16. 交互 ---------- */
const panelEl = document.getElementById('panel');
const pnoEl = document.getElementById('pno');
const pmetaEl = document.getElementById('pmeta');
const ptitleEl = document.getElementById('ptitle');
const ptextEl = document.getElementById('ptext');
const hintEl = document.getElementById('hint');
const introEl = document.getElementById('intro');
const enterBtn = document.getElementById('enter');

let openIndex = -1;
let hintKey = '';
let msg = '';
let msgT = 0;

function openPanel(i) {
  if (i < 0 || i >= PROCESS.length) return;
  openIndex = i;
  const p = PROCESS[i];
  pnoEl.textContent = p.no;
  pmetaEl.textContent = `第 ${i + 1} 道工序 · 共 5 道`;
  ptitleEl.textContent = p.name;
  ptextEl.textContent = p.text;
  panelEl.classList.add('show');
  panelEl.setAttribute('aria-hidden', 'false');
}

function closePanel() {
  if (openIndex < 0) return;
  openIndex = -1;
  panelEl.classList.remove('show');
  panelEl.setAttribute('aria-hidden', 'true');
}

document.getElementById('close').addEventListener('click', (e) => {
  e.stopPropagation();
  closePanel();
});

/* ---------- 16.5 从门口穿回前厅 ---------- */
const veilEl = document.getElementById('veil');
let leaving = false;

function leaveToHall() { /* 连通版：原路往回走就是展厅，不换页 */ }

/* ---------- 20. 展窗状态 ---------- */
const COL_DIM = new THREE.Color(0xffeed0);
const COL_HOT = new THREE.Color(0xffffff);
const tmpCol = new THREE.Color();

function updateGallery(dt) {
  let nearId = -1;
  let nearDist = Infinity;

  for (const v of vitrines) {
    const dx = player.x - v.front.x;
    const dz = player.z - v.front.z;
    v._d = Math.hypot(dx, dz);
    if (v._d < nearDist) { nearDist = v._d; nearId = v.index; }
  }

  const active = nearDist < 4.5 ? nearId : -1;

  if (openIndex >= 0 && vitrines[openIndex]._d > 6.4) closePanel();

  for (const v of vitrines) {
    const on = (v.index === active || v.index === openIndex);
    v._k = lerp(v._k, on ? 1 : 0, 1 - Math.pow(0.004, dt));
    v.spot.intensity = 5.4 + v._k * 2.6;
    tmpCol.copy(COL_DIM).lerp(COL_HOT, v._k);
    v.cove.color.copy(tmpCol);
  }

  if (msgT > 0) {
    msgT -= dt;
    if (hintKey !== 'msg') { hintKey = 'msg'; hintEl.innerHTML = `<span class="k">提示</span><span class="sep"></span><span>${msg}</span>`; }
    hintEl.classList.add('show');
  } else if (FROM_HALL && player.z > HL && openIndex < 0) {
    if (hintKey !== 'door') {
      hintKey = 'door';
      hintEl.innerHTML = `<span class="k">门厅</span><span class="sep"></span><span>左转进入横向长廊 · 身后返回「一堂藏雅，十一器生辉」</span>`;
    }
    hintEl.classList.add('show');
  } else if (active >= 0 && openIndex < 0) {
    const key = 'near' + active;
    if (hintKey !== key) {
      hintKey = key;
      hintEl.innerHTML = `<span class="k">点击展窗</span><span class="sep"></span><span>查看「${PROCESS[active].name}」</span>`;
    }
    hintEl.classList.add('show');
  } else {
    if (hintKey !== 'none') { hintKey = 'none'; }
    hintEl.classList.remove('show');
  }
}


/* ============================================================
   21+. 连通版：由展厅主循环驱动，不再有自己的相机 / 事件 / 渲染循环
   ============================================================ */
const AERIAL = PARAMS.get('aerial') === '1';

/* 零碎地面补片：按实际尺寸取石板密度（1 张贴图 = 2×2 块石板 = 2.4m 见方）。
   函数声明会提升，门厅 / 连接廊 / 封口补片都能用；直接套主地面贴图
   会把 1.2m 石板压成密集条纹 */
function floorMatFor(w, h) {
  const t = TEX.floor.clone();
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.repeat.set(w / 2.4, h / 2.4);
  t.needsUpdate = true;
  const m = new THREE.MeshStandardMaterial({
    map: t, bumpMap: t, bumpScale: 0.006,
    color: 0xafa08a,              /* 与 M.floor 同一个基色，否则补片会比主地面白一档 */
    roughness: 0.50, metalness: 0.04, envMapIntensity: 0.40
  });
  m.userData.floor = true;   /* 标记：unifyFloors 不要再给它刷成平色 */
  return m;
}

/* 门厅 -> 展厅北门之间的一小段连接廊（世界坐标，不受 world 旋转影响） */
(function linkPassage() {
  const wall = M.wall;     /* 与展厅 / 长廊同一套墙面材质，连接廊不再是一块纯色板 */
  const CX = -4.95, Z0 = -6.80, Z1 = -10.10;
  const LEN = Z0 - Z1, CZ = (Z0 + Z1) / 2;
  const floor = floorMatFor(2.4, LEN);   /* 按实际尺寸取石板密度 */
  const f = new THREE.Mesh(new THREE.PlaneGeometry(2.4, LEN), floor);
  f.rotation.x = -Math.PI / 2; f.position.set(CX, 0.012, CZ); scene.add(f);
  /* 侧墙通高（原来 3.2m，顶着 4.35m 的廊顶会空出 1.15m 黑洞，
     从长廊看过来就是一块悬空的墙板）；内表面退到门口门套外沿，与 2.4m 门洞对齐 */
  [-1.26, 1.26].forEach(function (dx) {
    const w = new THREE.Mesh(new THREE.BoxGeometry(0.12, ROOM.h, LEN), wall);
    w.position.set(CX + dx, ROOM.h / 2, CZ); scene.add(w);
  });
  /* 通道东侧墙到门厅东墙之间差 0.3m，接缝处会漏一条竖的黑缝：补一块直角墙垛 */
  const jog = new THREE.Mesh(new THREE.BoxGeometry(0.30, ROOM.h, 0.50), wall);
  jog.position.set(-3.60, ROOM.h / 2, -9.85); scene.add(jog);
  /* 拆除旧门洞后，长廊 / 门厅的顶板在这一带留了几处没盖住的缺口（抬头能看穿）。
     用一块整顶板把整个交界区兜住：底面比原顶板高 1cm，压在它上面，不会共面闪烁 */
  const collarMat = M.ceiling.clone();
  collarMat.emissive = new THREE.Color(0x8b8780);   /* 这一段没有射灯，顶板自带一点亮度 */
  collarMat.needsUpdate = true;
  const collar = new THREE.Mesh(new THREE.BoxGeometry(3.3, 0.10, 3.9), collarMat);
  collar.position.set(-4.90, ROOM.h + 0.06, -8.55); scene.add(collar);
  AERIAL_HIDE.push(collar);   /* 俯视图要能看到地面，别让这块顶板把交界盖成白块 */
  /* 连接廊补光压得很低：离墙只有 1.2m，亮一点就会把这面墙刷成过曝的白，
     和两侧暖灰墙面形成明显色差（用户 2026-11-14 反馈） */
  const l = new THREE.PointLight(0xffe9cc, 1.60, 9, 2);
  l.position.set(CX, 2.55, CZ); scene.add(l);
  /* 通道上方没有射灯，再补一盏贴近顶板的弱光把顶面托起来，否则抬头是一片暗顶 */
  const up = new THREE.PointLight(0xffe9cc, 1.15, 6, 2);
  up.position.set(CX, 3.60, CZ); scene.add(up);
  /* 门口门套顶板（2.89m）是朝下的面，没有光就是一块压黑的门头：给它一盏小射灯 */
  const dl = new THREE.PointLight(0xffe9cc, 1.05, 5, 2);
  dl.position.set(CX, 2.05, -7.15); scene.add(dl);
})();

/* 长廊入口端墙墩拆除后的封口：展厅北墙外侧补一块墙板 + 地面补片，防止从入口斜望时看到空洞 */
(function entranceClose() {
  const wall = M.wall;     /* 同长廊墙面材质 */
  const floor = floorMatFor(1.45, 0.88);   /* 按实际尺寸取石板密度 */
  const panel = new THREE.Mesh(new THREE.BoxGeometry(1.45, 4.4, 0.10), wall);
  panel.position.set(-6.72, 2.2, -6.86); scene.add(panel);
  const patch = new THREE.Mesh(new THREE.BoxGeometry(1.45, 0.02, 0.88), floor);
  patch.position.set(-6.72, 0.01, -7.24); scene.add(patch);
})();

/* 连通区域的实体墙碰撞：连接廊 / 转折门厅 / 横向长廊都不允许穿墙
   （含尽端「乌铜走银」立轴墙、电子屏端墙、门厅东墙与长廊两侧墙） */
window.__CORR_COLLIDE = function (p) {
  var R = 0.42;
  /* 连接廊：两侧墙 x=-6.09 / -3.81 */
  if (p.z >= -10.10 && p.x >= -6.15 && p.x <= -3.75) {
    p.x = Math.max(-6.09 + R, Math.min(-3.81 - R, p.x));
    return;
  }
  /* 转折门厅：东墙 -3.45 / 电子屏端墙 -14.85 */
  if (p.x >= -5.40) {
    p.x = Math.max(-5.40, Math.min(-3.45 - R, p.x));
    p.z = Math.max(-14.80 + R, p.z);
    return;
  }
  /* 横向长廊：尽端立轴墙 -37.40 / 南墙 -7.60 / 北墙 -14.80 */
  p.x = Math.max(-37.40 + R, p.x);
  p.z = Math.max(-14.80 + R, Math.min(-7.60 - R, p.z));
};

/* r147 是 legacy 光照单位：把长廊灯光按同一系数收一收，保持原来的亮度层次 */
const LIGHT_SCALE = 0.45;
scene.traverse(function (o) { if (o.isLight) o.intensity *= LIGHT_SCALE; });

/* 地面统一：把零碎的地面补片刷成与展厅地面同一色系，
   主地面（M.floor）已经是展厅同款材质，跳过不动，避免把高光压死 */
(function unifyFloors() {
  const FLOOR_COLOR = 0x5f5346;
  const p = new THREE.Vector3();
  const bb = new THREE.Box3();
  scene.updateMatrixWorld(true);
  scene.traverse(function (o) {
    if (!o.isMesh || !o.geometry || !o.material || !o.material.color) return;
    if (o.material === M.floor || o.material === M.wall || o.material === M.caseWall) return;
    if (o.material.userData && o.material.userData.floor) return;   /* 已经是展厅同款地面 */
    o.getWorldPosition(p);
    if (p.y > 0.40) return;                       /* 只取地面附近 */
    bb.setFromObject(o);
    const sy = bb.max.y - bb.min.y;
    if (sy > 0.45) return;                        /* 高于 45cm 的是墙裙/家具，不是地面 */
    const sx = bb.max.x - bb.min.x, sz = bb.max.z - bb.min.z;
    if (sx < 1.2 && sz < 1.2) return;             /* 排除小道具 */
    const m = o.material;
    m.color.setHex(FLOOR_COLOR);
    if (m.roughness !== undefined) m.roughness = Math.max(m.roughness, 0.45);
    if (m.envMapIntensity !== undefined) m.envMapIntensity = Math.min(m.envMapIntensity, 0.55);
  });
})();

/* 门口那道门槛石（3.3 × 0.05 × 0.26）原本是暖白石材 M.border，正对门厅射灯，
   渲出来是一条刺眼的白板；改成与地面同一套石板材质。
   上面那道细刻线（3.2 × 0.02 × 0.05，M.trimShadow）同样被灯打成白线，压成地面暗缝色。 */
(function thresholdAsFloor() {
  scene.traverse(function (o) {
    if (!o.isMesh || !o.geometry || !o.geometry.parameters) return;
    const p = o.geometry.parameters;
    if (p.width === undefined || p.height === undefined || p.depth === undefined) return;
    if (o.position.z < 12) return;                 /* 只看长廊南端门口这一带 */
    if (Math.abs(p.width - 3.3) < 0.02 && Math.abs(p.depth - 0.26) < 0.02 && p.height < 0.1) {
      o.material = floorMatFor(3.3, 0.26);         /* 与地面同一套贴图，按实际尺寸取石板密度 */
      o.position.y = -0.011;                       /* 5cm 立边压到地面以下，顶面与地面齐平 */
      return;
    }
    if (Math.abs(p.width - 3.2) < 0.02 && Math.abs(p.depth - 0.05) < 0.02 && p.height < 0.03) {
      o.visible = false;                           /* 门洞刻缝：就在射灯正下方，怎么压都会被打亮，直接去掉 */
    }
  });
})();

/* 拾取：沿用长廊 hitboxes，但用统一相机 */
const raycaster = new THREE.Raycaster();
const ndc = new THREE.Vector2();
function pickCorridor(cx, cy) {
  const r = canvas.getBoundingClientRect();
  ndc.x = ((cx - r.left) / r.width) * 2 - 1;
  ndc.y = -((cy - r.top) / r.height) * 2 + 1;
  raycaster.setFromCamera(ndc, window.__HALL.camera);
  /* 电子屏：点中即播放（无论远近） */
  if (window.__SCREEN) {
    const sh = raycaster.intersectObject(window.__SCREEN.mesh, false);
    if (sh.length) {
      const S = window.__SCREEN;
      if (S.unmute && S.unmute()) return true;  /* 已在播但被策略静音：这次点击 = 开声音 */
      S.play(true); return true;
    }
  }
  const hits = raycaster.intersectObjects(hitboxes, false);
  if (!hits.length) { if (openIndex >= 0) closePanel(); return false; }
  const id = hits[0].object.userData.id;
  if (vitrines[id]._d < 4.6) {
    /* 工序一：Step1_Forge.glb 微距观看器（OrbitControls + Bloom） */
    if (id === 0 && window.__FORGE_VIEWER) { window.__FORGE_VIEWER.open(); return true; }
    openPanel(id);
  }
  else { msg = '走近展窗，即可查看工序详情'; msgT = 1.8; hintKey = ''; }
  return true;
}

/* 世界坐标 -> 长廊逻辑坐标：x_l = -(z_w - PZ), z_l = x_w - PX */
function syncPlayer() {
  const p = window.__HALL.state.pos;
  player.x = -(p.z - WORLD_PZ);
  player.z = (p.x - WORLD_PX);
}

window.__CORR = {
  scene: scene, world: world, THREE: THREE, vitrines: vitrines,
  M: M, TEX: TEX,
  hitboxes: hitboxes, AERIAL_HIDE: AERIAL_HIDE, player: player,
  pick: pickCorridor
};
window.__CORR_EXPOSURE = 0.95;
window.__CORR_PICK = function (cx, cy) {
  if (typeof window.__IN_CONNECTED !== 'function' ||
      !window.__IN_CONNECTED(window.__HALL.state.pos)) return false;
  return pickCorridor(cx, cy);
};
let lastZone = null;
window.__CORR_TICK = function (dt, elapsed) {
  syncPlayer();
  updateGallery(dt);
  for (let i = 0; i < vitrines.length; i++) vitrines[i].dia.update(elapsed + i * 1.7, dt);
  const inCorr = typeof window.__IN_CONNECTED === 'function' &&
    window.__IN_CONNECTED(window.__HALL.state.pos);
  /* 电子屏：走近 3m 内自动播放（有声、循环），离开触发区暂停并复位到封面 */
  if (window.__SCREEN) {
    const S = window.__SCREEN;
    if (!S.wp) S.wp = new THREE.Vector3();
    S.mesh.getWorldPosition(S.wp);
    const sd = Math.hypot(window.__HALL.state.pos.x - S.wp.x,
                          window.__HALL.state.pos.z - S.wp.z);
    if (S.auto) S.auto(inCorr, sd < 3.0);          /* 自动播放进出触发区；点击播放出长廊才停 */
    if (S.tick) S.tick();                          /* 电子屏视频叠加层逐帧对齐 */
  }
  const mm = document.getElementById('minimap');
  if (mm) mm.style.display = inCorr ? 'none' : '';
  const hint = document.getElementById('hint');
  if (hint) hint.style.display = inCorr ? '' : 'none';
  if (lastZone !== inCorr) {
    lastZone = inCorr;
    const h1 = document.querySelector('#hudTitle h1');
    const sub = document.querySelector('#hudTitle .ht-sub');
    if (h1 && sub) {
      h1.textContent = inCorr ? '漫步长廊，品五道匠心' : '一堂藏雅，十一器生辉';
      sub.textContent = inCorr
        ? '乌铜走银 · 非遗工艺长廊 · 原路返回即到单厅'
        : '十一座玻璃展柜 · 穿北门入长廊 · 五道工序';
    }
  }
};
window.__CORR_AERIAL = function () {
  scene.fog = null;
  AERIAL_HIDE.forEach(function (o) { o.visible = false; });
  window.__CORR_EXPOSURE = 0.78;   /* 俯视看到的是被射灯打亮的地面，压一档避免过曝 */
  const h = document.getElementById('hint'); if (h) h.style.display = 'none';
  const t = document.getElementById('tips'); if (t) t.style.display = 'none';
  const top = new THREE.DirectionalLight(0xfff6e8, 0.22);
  top.position.set(0.2, 1, 0.35);
  scene.add(top);
};

/* ============================================================
   22. 展厅入口立牌「乌铜走银」：展厅进门左拐、南墙 ⑪ 号柜旁的空地
   版面用 canvas 还原照片：米色布纹纸底 + 朱红「金大师」圆印 +
   行楷标题 + 宋体正文两段 + 右下角三足双耳鼎剪影
   注意：它在「展厅 Scene」里（__HALL.scene），不在长廊 Scene 里
   ============================================================ */
(function entranceSign() {
  const SW = 1400, SH = 1880;                 /* 版面画布（比例 ≈ 照片 700×940） */
  const cv = document.createElement('canvas');
  cv.width = SW; cv.height = SH;
  const g = cv.getContext('2d');

  /* ---- 纸底：暖米色 + 亚麻竖纹 + 上亮下暗的布面光 ---- */
  g.fillStyle = '#efe2c6';
  g.fillRect(0, 0, SW, SH);
  for (let i = 0; i < 190; i++) {
    const x = i * SW / 190;
    g.fillStyle = i % 2 ? 'rgba(255,252,240,.20)' : 'rgba(150,124,86,.05)';
    g.fillRect(x, 0, 2, SH);
  }
  const bg = g.createLinearGradient(0, 0, 0, SH);
  bg.addColorStop(0, 'rgba(255,251,236,.34)');
  bg.addColorStop(0.42, 'rgba(255,255,255,0)');
  bg.addColorStop(1, 'rgba(122,96,58,.13)');
  g.fillStyle = bg;
  g.fillRect(0, 0, SW, SH);

  /* ---- 左上：朱红圆印「金大师」+ 英文小字 ---- */
  (function seal() {
    const cx = 212, cy = 198, r = 84;
    g.fillStyle = '#a02a20';
    g.beginPath(); g.arc(cx, cy, r, 0, Math.PI * 2); g.fill();
    g.strokeStyle = 'rgba(255,246,232,.80)';
    g.lineWidth = 3;
    g.beginPath(); g.arc(cx, cy, r - 11, 0, Math.PI * 2); g.stroke();
    g.fillStyle = '#f8efe2';
    g.textAlign = 'center'; g.textBaseline = 'middle';
    g.font = '20px "STKaiti","KaiTi",serif';
    g.fillText('KING MASTER', cx, cy - 46);
    g.font = '56px "STKaiti","KaiTi",serif';
    g.fillText('金', cx, cy + 2);
    g.font = '38px "STKaiti","KaiTi",serif';
    g.fillText('大师', cx, cy + 44);
    g.textBaseline = 'alphabetic'; g.textAlign = 'left';

    /* 印章下方的品牌小字（照片里是 KING MASTER / 金大师 两行） */
    g.textAlign = 'center';
    g.fillStyle = '#4a5642';
    g.font = '19px "Georgia","Times New Roman",serif';
    g.fillText('K I N G   M A S T E R', cx, 320);
    g.font = '26px "STSong","SimSun",serif';
    g.fillText('金大师', cx, 356);
    g.textAlign = 'left';
  })();

  /* ---- 标题：乌铜走银（行楷，字距放大） ---- */
  (function title() {
    const txt = '乌铜走银', size = 170, ls = 26, cx = 820, by = 268;
    g.font = size + 'px "STXingkai","华文行楷","STKaiti","KaiTi",serif';
    g.fillStyle = '#251d13';
    let w = 0;
    for (let i = 0; i < txt.length; i++) w += g.measureText(txt[i]).width;
    w += ls * (txt.length - 1);
    let x = cx - w / 2;
    for (let i = 0; i < txt.length; i++) {
      g.fillText(txt[i], x, by);
      x += g.measureText(txt[i]).width + ls;
    }
  })();

  /* ---- 正文：宋体、两端对齐（与照片同一段文字，一字不差） ---- */
  const P1 = '乌铜走银是云南一种独特的铜制纯手工工艺，始创于清雍正年间的云南石屏县，' +
    '距今已近300年历史，它以乌铜为胎，在胎上雕刻各种花纹图案，然后将纯银（或金）' +
    '熔化后走入花纹图案的刻痕中，利用高温使银（或金）与乌铜融为一体，再经过冷却、' +
    '打磨、抛光、捂黑等技术处理后，底铜自然变为乌黑，透出银（或金）纹图案，呈现出' +
    '黑白（或黑黄）分明的技艺效果，其色彩古色古香、典雅别致。因一般多以走银为主，' +
    '故称“乌铜走银”。';
  const P2 = '乌铜走银，又称黑金，它是有脉搏的，会呼吸的，有生命力的，能带给人惊喜的，' +
    '活的金属。会随着四季更迭，人物变化，呈现出不同的颜色和不同的状态，' +
    '期待它能带给你更多的惊喜。';

  const BS = 45, LS = 2.2, LH = 71, X0 = 96, MW = 1208, COLOR = '#3b3226';
  const FONT = BS + 'px "STSong","SimSun","Noto Serif SC",serif';

  function flow(text) {
    g.font = FONT;
    const lines = [];
    let cur = '';
    for (let i = 0; i < text.length; i++) {
      const ch = text[i];
      const test = cur + ch;
      if (g.measureText(test).width + LS * (test.length - 1) > MW && cur.length > 1) {
        if ('，。、；：？！）》」』”’,.!?:;)'.indexOf(ch) >= 0) { cur = test; continue; }
        lines.push(cur); cur = ch;
      } else cur = test;
    }
    if (cur) lines.push(cur);
    return lines;
  }

  function drawFlow(lines, y) {
    g.font = FONT;
    g.fillStyle = COLOR;
    for (let i = 0; i < lines.length; i++) {
      const L = lines[i];
      const last = i === lines.length - 1;
      const nat = g.measureText(L).width + LS * (L.length - 1);
      const gap = (last || L.length < 2) ? LS : LS + (MW - nat) / (L.length - 1);
      let x = X0;
      for (let k = 0; k < L.length; k++) {
        g.fillText(L[k], x, y + i * LH);
        x += g.measureText(L[k]).width + gap;
      }
    }
    return y + lines.length * LH;
  }

  const yAfterP1 = drawFlow(flow(P1), 470);
  drawFlow(flow(P2), yAfterP1 + 62);

  /* ---- 右下：三足双耳鼎剪影 ---- */
  (function ding(cx, by, w) {
    const h = w * 1.06;
    const y0 = by - h;
    g.fillStyle = '#372f24';
    /* 双立耳 */
    g.fillRect(cx - 0.365 * w, y0 + 0.135 * h, 0.052 * w, 0.125 * h);
    g.fillRect(cx + 0.313 * w, y0 + 0.135 * h, 0.052 * w, 0.125 * h);
    /* 口沿 */
    g.fillRect(cx - 0.48 * w, y0 + 0.235 * h, 0.96 * w, 0.055 * h);
    /* 腹 */
    g.beginPath();
    g.moveTo(cx - 0.455 * w, y0 + 0.290 * h);
    g.bezierCurveTo(cx - 0.500 * w, y0 + 0.560 * h, cx - 0.300 * w, y0 + 0.735 * h,
                    cx, y0 + 0.735 * h);
    g.bezierCurveTo(cx + 0.300 * w, y0 + 0.735 * h, cx + 0.500 * w, y0 + 0.560 * h,
                    cx + 0.455 * w, y0 + 0.290 * h);
    g.closePath(); g.fill();
    /* 三足 */
    const leg = function (ax, bx, tx, ty) {
      g.beginPath();
      g.moveTo(cx + ax * w, y0 + 0.660 * h);
      g.lineTo(cx + bx * w, y0 + 0.660 * h);
      g.lineTo(cx + tx * w, y0 + ty * h);
      g.closePath(); g.fill();
    };
    leg(-0.300, -0.196, -0.232, 1.000);
    leg(0.196, 0.300, 0.232, 1.000);
    leg(-0.052, 0.052, 0.040, 0.968);
  })(1052, 1728, 268);

  /* 纸边一圈极淡的压痕 */
  g.strokeStyle = 'rgba(96,74,46,.10)';
  g.lineWidth = 8;
  g.strokeRect(4, 4, SW - 8, SH - 8);

  const tex = new THREE.CanvasTexture(cv);
  tex.encoding = THREE.sRGBEncoding;
  tex.anisotropy = 8;

  /* ---------- 立牌实体（世界坐标，与连接廊 / 门厅同一套） ---------- */
  const PW = 1.02, PH = 1.37;          /* 版面尺寸（米） */
  const BT = 0.030, BD = 0.052;        /* 黑框宽 / 厚 */
  /* 黑框 / 版面一律「按原色上屏」：
     r147 里 hex 色被当成线性值，再过 ACES（展厅曝光 1.28）会被抬亮一大截——
     0x111110 会变成中灰。所以颜色先 convertSRGBToLinear，并且关掉 toneMapped，
     画布上是多少，屏幕上就是多少 */
  const black = new THREE.MeshBasicMaterial({
    color: new THREE.Color(0x131211).convertSRGBToLinear(), toneMapped: false
  });
  const paper = new THREE.MeshBasicMaterial({ map: tex, toneMapped: false });

  const grp = new THREE.Group();
  const face = new THREE.Group();      /* 版面 + 黑框：一起后仰 4.5°，像真立牌 */
  face.position.set(0, 0.545, 0);
  face.rotation.x = -0.078;
  grp.add(face);

  /* 背板：与版面等大（比版面大一圈会在黑框内侧露一条浅灰的「卡纸边」） */
  const back = new THREE.Mesh(new THREE.BoxGeometry(PW - 0.004, PH - 0.004, 0.030), black);
  back.position.set(0, PH / 2 + 0.01, 0.004);
  face.add(back);

  /* 版面 */
  const panel = new THREE.Mesh(new THREE.PlaneGeometry(PW, PH), paper);
  panel.position.set(0, PH / 2 + 0.01, 0.023);
  face.add(panel);

  /* 黑框四边：内沿压住版面 4mm，画面上不会露出缝 */
  const OV = 0.004;
  const fw = PW + BT * 2 - OV * 2;
  const top = new THREE.Mesh(new THREE.BoxGeometry(fw, BT, BD), black);
  top.position.set(0, PH + 0.01 + BT / 2 - OV, 0.018);
  face.add(top);
  const bot = new THREE.Mesh(new THREE.BoxGeometry(fw, BT, BD), black);
  bot.position.set(0, 0.01 - BT / 2 + OV, 0.018);
  face.add(bot);
  [-1, 1].forEach(function (s) {
    const side = new THREE.Mesh(new THREE.BoxGeometry(BT, PH - OV * 2, BD), black);
    side.position.set(s * (PW / 2 + BT / 2 - OV), PH / 2 + 0.01, 0.018);
    face.add(side);
  });

  /* 两条腿 + 底脚 + 横向拉杆（落地，不随版面后仰） */
  [-0.33, 0.33].forEach(function (x) {
    const leg = new THREE.Mesh(new THREE.BoxGeometry(0.030, 0.615, 0.038), black);
    leg.position.set(x, 0.307, -0.030);
    grp.add(leg);
    const foot = new THREE.Mesh(new THREE.BoxGeometry(0.036, 0.024, 0.30), black);
    foot.position.set(x, 0.012, -0.088);
    grp.add(foot);
  });
  const rail = new THREE.Mesh(new THREE.BoxGeometry(0.70, 0.024, 0.032), black);
  rail.position.set(0, 0.012, -0.030);
  grp.add(rail);

  /* 接地软阴影：没有影子会像浮在地上 */
  (function () {
    const c2 = document.createElement('canvas');
    c2.width = c2.height = 128;
    const q = c2.getContext('2d');
    const rg = q.createRadialGradient(64, 64, 4, 64, 64, 62);
    rg.addColorStop(0, 'rgba(0,0,0,.46)');
    rg.addColorStop(0.55, 'rgba(0,0,0,.18)');
    rg.addColorStop(1, 'rgba(0,0,0,0)');
    q.fillStyle = rg; q.fillRect(0, 0, 128, 128);
    const st = new THREE.CanvasTexture(c2);
    const shadow = new THREE.Mesh(
      new THREE.PlaneGeometry(1.55, 1.05),
      new THREE.MeshBasicMaterial({ map: st, transparent: true, depthWrite: false, toneMapped: false })
    );
    shadow.rotation.x = -Math.PI / 2;
    shadow.position.set(0, 0.010, -0.07);
    grp.add(shadow);
  })();

  /* 位置：展厅进门左拐 —— 南墙 ⑪ 号柜（南墙西）与朱红门套柱之间的空地。
     朝向按用户原话「对着长廊入口方向」：长廊入口（展厅北门）在立牌的
     北偏西 11° 方位上，SYAW=190° 让版面法线正对北门；厅心 (0,0) 在其
     东偏北 26°，斜 36° 仍能看清版面；⑪ 号柜在版面正后方，互不遮挡 */
  const SX = -2.55, SZ = 5.15, SYAW = 190 * Math.PI / 180;
  const HS = window.__HALL.scene;      /* 展厅 Scene（长廊是另一个 Scene） */
  grp.position.set(SX, 0, SZ);
  grp.rotation.y = SYAW;
  HS.add(grp);

  /* 挡住玩家，别让人穿模走过去 */
  if (window.__HALL.BLOCK) window.__HALL.BLOCK.push({ x: SX, z: SZ, r: 0.60 });

  window.__SIGN = { grp: grp, tex: tex, pos: [SX, SZ], yaw: SYAW };
})();

/* ============================================================
   23. 工序一「熔炼乌铜」锻打场景 —— assets/step1-forge.glb
       · GLTFLoader + DRACOLoader（file:// 下解码器用 blob URL 喂）
       · 展窗内实体：替换程序化熔炼微缩，锤击动画 + 火花随走廊 tick 播放
       · 点击工序一展窗：微距观看器（HDR 环境 + 平行光 + OrbitControls
         + EffectComposer/UnrealBloom，Threshold 0.8 / Strength 1.2）
   ============================================================ */
(function forgeStep1() {
  const T = THREE;
  if (!window.__FORGE_GLB || !T.GLTFLoader) return;

  /* Draco 解码器：file:// 页面 fetch 本地文件会被 CORS 拦掉，
     把页内 base64 的 wasm / wrapper 转成 blob URL，
     再用 LoadingManager.setURLModifier 按文件名喂给 DRACOLoader */
  function b64u8(b64) {
    const str = atob(b64), u = new Uint8Array(str.length);
    for (let i = 0; i < str.length; i++) u[i] = str.charCodeAt(i);
    return u;
  }
  const blobs = {};
  [['draco_wasm_wrapper.js', 'text/javascript', window.__DRACO_WRAP_B64],
   ['draco_decoder.wasm', 'application/wasm', window.__DRACO_WASM_B64]].forEach(function (it) {
    blobs[it[0]] = URL.createObjectURL(new Blob([b64u8(it[2])], { type: it[1] }));
  });
  const mgr = new T.LoadingManager();
  mgr.setURLModifier(function (url) {
    for (const k in blobs) if (url.indexOf(k) !== -1) return blobs[k];
    return url;
  });
  const dracoLoader = new T.DRACOLoader(mgr);
  dracoLoader.setDecoderPath('inline:');   /* 路径不参与解析：上面按文件名拦截 */
  const loader = new T.GLTFLoader(mgr);
  loader.setDRACOLoader(dracoLoader);

  /* ---- 火花粒子：40 颗红色发光粒子，随机向上初速 + 重力，0.3s 淡出 ---- */
  const SPARK_TEX = (function () {
    const c = document.createElement('canvas'); c.width = c.height = 32;
    const g = c.getContext('2d');
    const r = g.createRadialGradient(16, 16, 0, 16, 16, 16);
    r.addColorStop(0, 'rgba(255,255,255,1)');
    r.addColorStop(0.35, 'rgba(255,255,255,.55)');
    r.addColorStop(1, 'rgba(255,255,255,0)');
    g.fillStyle = r; g.fillRect(0, 0, 32, 32);
    return new T.CanvasTexture(c);
  })();
  function Sparks() { this.list = []; }
  Sparks.prototype.burst = function (parent, pos, size, vs) {
    const N = 40, geo = new T.BufferGeometry(), arr = new Float32Array(N * 3), vel = [];
    for (let i = 0; i < N; i++) {
      arr[i * 3] = pos.x; arr[i * 3 + 1] = pos.y; arr[i * 3 + 2] = pos.z;
      vel.push(new T.Vector3((Math.random() - 0.5) * 1.1 * vs,
                             (0.9 + Math.random() * 1.7) * vs,
                             (Math.random() - 0.5) * 1.1 * vs));
    }
    geo.setAttribute('position', new T.BufferAttribute(arr, 3));
    const mat = new T.PointsMaterial({
      color: 0xff3d1a, size: size, map: SPARK_TEX, transparent: true, opacity: 1,
      blending: T.AdditiveBlending, depthWrite: false, toneMapped: false
    });
    const pts = new T.Points(geo, mat);
    pts.frustumCulled = false;
    parent.add(pts);
    this.list.push({ pts: pts, vel: vel, t: 0, vs: vs });
  };
  Sparks.prototype.update = function (dt) {
    for (let i = this.list.length - 1; i >= 0; i--) {
      const b = this.list[i]; b.t += dt;
      const a = b.pts.geometry.attributes.position.array;
      for (let j = 0; j < b.vel.length; j++) {
        const v = b.vel[j];
        v.y -= 6.5 * b.vs * dt;
        a[j * 3] += v.x * dt; a[j * 3 + 1] += v.y * dt; a[j * 3 + 2] += v.z * dt;
      }
      b.pts.geometry.attributes.position.needsUpdate = true;
      b.pts.material.opacity = Math.max(0, 1 - b.t / 0.3);
      if (b.t >= 0.3) {
        b.pts.parent.remove(b.pts);
        b.pts.geometry.dispose(); b.pts.material.dispose();
        this.list.splice(i, 1);
      }
    }
  };

  /* ---- 锤击动画：1.5s 一循环 = 0.72s 平滑抬起 → 0.18s 加速砸下 → 停在接触帧 ---- */
  const CYCLE = 1.5, T_RISE = 0.72, T_HIT = 0.90;
  function chiselTip(root) {
    const ch = root.getObjectByName('Chisel');
    if (!ch) return null;
    const bb = new T.Box3().setFromObject(ch);
    return new T.Vector3((bb.min.x + bb.max.x) / 2, bb.min.y, (bb.min.z + bb.max.z) / 2);
  }
  function makeActor(root, sparkParent, sparkSize, velScale, tipLocal, strikeDY, raiseH) {
    const hammer = root.getObjectByName('Hammer'), chisel = root.getObjectByName('Chisel');
    if (!hammer || !chisel || !tipLocal) return null;
    /* 基准位优先用 userData 里存的落点位——克隆可能发生在动画中途，
       此刻的 position 是被抬到半空的瞬时值，不能当基准。
       注意 Object3D.clone 会把 userData JSON 深拷贝成纯对象，只能按 x/y/z 读 */
    const bp = hammer.userData && hammer.userData.basePos;
    const base = bp ? new T.Vector3(bp.x, bp.y, bp.z) : hammer.position.clone();
    const sparks = new Sparks();
    /* k=1：抬起位（落点基准位上方 raiseH）；k=0：接触位（锤底贴錾顶，
       用户要求「砸下时停住」——接触帧停 0.6s，火花在砸下瞬间迸出） */
    return {
      root: root, hammer: hammer, tip: tipLocal, sparks: sparks, t: 0, prev: 0,
      update: function (dt) {
        this.prev = this.t; this.t += dt;
        if (this.t >= CYCLE) this.t -= CYCLE;
        let k = 0;
        if (this.t < T_RISE) { const u = this.t / T_RISE; k = u * u * (3 - 2 * u); }
        else if (this.t < T_HIT) { const u = (this.t - T_RISE) / (T_HIT - T_RISE); k = 1 - u * u; }
        /* k=1 抬到 raiseH 高处；k=0 压到接触帧（strikeDY 通常≈0：原位姿锤就贴着錾顶） */
        this.hammer.position.set(base.x, base.y + k * raiseH + (1 - k) * strikeDY, base.z);
        if (this.prev < T_HIT && this.t >= T_HIT) {
          this.sparks.burst(sparkParent, tipLocal, sparkSize, velScale);
        }
        this.sparks.update(dt);
      }
    };
  }

  const actors = [];
  loader.load(window.__FORGE_GLB, function (gltf) {
    const model = gltf.scene;
    model.traverse(function (o) { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });
    const tipLocal = chiselTip(model);

    /* ---- 材质校色（2026-11-15 用户要求）：铜片橙红、木桩棕、铁件锈暖；
       GLB 全部材质无贴图、白基色 + 高金属度，所以直接改材质色即可 ----
       注意 r147 legacy：hex 要 convertSRGBToLinear 才是直觉色 */
    model.traverse(function (o) {
      if (!o.isMesh || !o.material) return;
      const mn = o.material.name || '';
      const set = function (hex, met, rou, emHex) {
        o.material.color.setHex(hex).convertSRGBToLinear();
        o.material.metalness = met;
        o.material.roughness = rou;
        if (o.material.emissive) o.material.emissive.setHex(emHex || 0x000000).convertSRGBToLinear();
      };
      if (o.name === 'Copper_Sheet' || mn === 'M_Copper_Black') {
        set(0xd4521e, 0.2, 0.5, 0x661c06);          /* 锻打中的铜片：橙红发烫（低金属度防反射蓝天变品红） */
      } else if (o.name === 'Wood_Base' || mn === 'M_Wood_Dark') {
        set(0x4a2c15, 0.0, 0.9, 0);                 /* 木桩：深棕（ACES 去饱和提亮，色要压深） */
      } else if (mn === 'M_Wood_Handle') {
        set(0x9c6a38, 0.0, 0.72, 0);                /* 锤柄：木色 */
      } else if (mn === 'M_Iron_Rusty') {
        set(0x8f6a52, 0.85, 0.5, 0);                /* 锤头/錾子：锈铁暖色，不再发黑 */
      }
    });

    /* 刚加载完的节点 matrixWorld 还是脏的（Hammer 组的矩阵未下发到子网格，
       直接 setFromObject 会把锤头 bbox 算到原点附近），先强制全量更新 */
    model.updateMatrixWorld(true);
    const chBB = new T.Box3().setFromObject(model.getObjectByName('Chisel'));
    const head = model.getObjectByName('Hammer_Mesh') || model.getObjectByName('Hammer');
    const hBB = new T.Box3().setFromObject(head);

    /* 锤子落点搬到錾子顶端正上方。錾子是斜置的杆（底端在铜片上、顶端朝右上），
       顶端 = 包围盒 max-x/max-y 角；用「包围盒顶面中心」会悬在半空（已踩坑） */
    const sx = chBB.max.x, sy = chBB.max.y, sz = (chBB.min.z + chBB.max.z) / 2;
    const ham = model.getObjectByName('Hammer');
    if (ham) {
      ham.position.x += sx - (hBB.min.x + hBB.max.x) / 2;   /* 锤头底面中心 → 錾顶 */
      ham.position.y += sy + 0.008 - hBB.min.y;             /* 留 8mm 缝防穿模 */
      ham.position.z += sz - (hBB.min.z + hBB.max.z) / 2;
      ham.userData.basePos = { x: ham.position.x, y: ham.position.y, z: ham.position.z };
    }
    const strikeDY = 0;                            /* 锤已就位：k=0 即接触帧 */
    /* 火花迸溅点 = 锤的落点 = 錾杆顶端（用户原要求「錾顶迸火花」） */
    const strikeLocal = new T.Vector3(sx, sy, sz);
    const mBB = new T.Box3().setFromObject(model);
    const raiseH = Math.max(0.18, (mBB.max.y - mBB.min.y) * 0.45);

    /* ---- 展窗内实体：替换工序一窗口里的程序化熔炼微缩 ---- */
    (function putInVitrine() {
      let vit = null;
      for (let i = 0; i < vitrines.length; i++) if (vitrines[i].index === 0) { vit = vitrines[i]; break; }
      if (!vit) return;
      vit.dia.group.visible = false;   /* 加载失败时保持原微缩（上面 error 回调不动它） */
      const holder = new T.Group();
      holder.position.set(-0.12, WIN.SILL, -WIN.D * 0.55);
      vit.group.add(holder);
      holder.add(model);
      const bb = new T.Box3().setFromObject(model);
      const size = bb.getSize(new T.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z);
      let sc = 1.45 / maxDim;
      if (size.y * sc > 1.0) sc = 1.0 / size.y;
      holder.scale.setScalar(sc);
      const ctr = bb.getCenter(new T.Vector3());
      model.position.set(-ctr.x, -bb.min.y, -ctr.z);
      const act = makeActor(model, holder, 0.035 * sc, 1 / sc, strikeLocal, strikeDY, raiseH);
      if (act) { actors.push(act); }
      window.__FORGE = { model: model, holder: holder, act: act, scale: sc, tip: tipLocal };
    })();

    /* ---- 微距观看器：点击工序一展窗打开 ---- */
    window.__FORGE_VIEWER = buildViewer(model, tipLocal);
  }, undefined, function () { /* 加载失败：保持程序化微缩，观看器不可用 */ });

  window.__FORGE_TICK = function (dt) { for (let i = 0; i < actors.length; i++) actors[i].update(dt); };
  (function hookTick() {
    const prev = window.__CORR_TICK;
    if (!prev) return;
    window.__CORR_TICK = function (dt, elapsed) {
      prev(dt, elapsed);
      window.__FORGE_TICK(dt);
    };
  })();

  /* ================= 微距观看器 ================= */
  function buildViewer(srcModel, tipLocal) {
    let built = false, wrap = null, stage = null, cv = null;
    let renderer, scene, camera, controls, composer, act, bloomPass;
    let running = false, raf = 0, lastT = 0;

    function build() {
      wrap = document.createElement('div');
      wrap.style.cssText = 'position:fixed;inset:0;background:rgba(8,7,6,.88);z-index:900;display:none;';
      stage = document.createElement('div');
      stage.style.cssText = 'position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);'
        + 'width:min(1100px,92vw);height:min(680px,84vh);background:#12100d;'
        + 'border:1px solid #3a342c;box-shadow:0 30px 80px rgba(0,0,0,.6);';
      cv = document.createElement('canvas');
      cv.style.cssText = 'width:100%;height:100%;display:block;';
      stage.appendChild(cv);
      const bar = document.createElement('div');
      bar.style.cssText = 'position:absolute;left:0;right:52px;top:0;padding:14px 20px;'
        + 'font:13px \'Microsoft YaHei\',sans-serif;color:#cfc4b2;letter-spacing:.18em;pointer-events:none;';
      bar.innerHTML = '工序一 · 熔炼乌铜 —— 锻打微距&ensp;<span style=\"opacity:.55\">拖拽旋转 · 滚轮缩放 · 火花随锤击迸溅</span>';
      const close = document.createElement('button');
      close.textContent = '\u2715 关闭';
      close.style.cssText = 'position:absolute;right:14px;top:12px;background:#2a2620;color:#e8dcc8;'
        + 'border:1px solid #4a4237;padding:6px 14px;font:12px \'Microsoft YaHei\',sans-serif;'
        + 'cursor:pointer;letter-spacing:.1em;';
      const foot = document.createElement('div');
      foot.style.cssText = 'position:absolute;left:0;right:0;bottom:0;padding:12px 20px 14px;'
        + 'font:12px/1.9 "Microsoft YaHei",sans-serif;color:#8f8474;letter-spacing:.06em;'
        + 'text-align:justify;pointer-events:none;border-top:1px solid #2a2620;';
      foot.textContent = (typeof PROCESS !== 'undefined' && PROCESS[0])
        ? '第' + PROCESS[0].no.replace('壹', '一') + '道工序 · ' + PROCESS[0].name + '　' + PROCESS[0].text
        : '';
      stage.appendChild(bar); stage.appendChild(foot); stage.appendChild(close);
      wrap.appendChild(stage);
      document.body.appendChild(wrap);
      close.addEventListener('click', hide);
      wrap.addEventListener('click', function (e) { if (e.target === wrap) hide(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && running) hide();
      });

      renderer = new T.WebGLRenderer({ canvas: cv, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.outputEncoding = T.sRGBEncoding;
      renderer.toneMapping = T.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.18;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = T.PCFSoftShadowMap;

      scene = new T.Scene();
      scene.background = new T.Color(0x1a120c);    /* 暖黑背景（用户要求画面整体偏红） */

      /* HDR 环境光：royal_esplanade_1k.hdr（页内 base64，RGBELoader 解析） */
      new T.RGBELoader().load(window.__FORGE_HDR, function (tex) {
        tex.mapping = T.EquirectangularReflectionMapping;
        scene.environment = tex;
      });

      /* 右上方平行主光（带阴影）+ 半球补光：暖红炉火色调 */
      const sun = new T.DirectionalLight(0xffc49a, 2.6);
      sun.position.set(2.4, 3.2, 1.8);
      sun.castShadow = true;
      sun.shadow.mapSize.set(1024, 1024);
      sun.shadow.camera.near = 0.1; sun.shadow.camera.far = 8;
      sun.shadow.camera.left = -1.2; sun.shadow.camera.right = 1.2;
      sun.shadow.camera.top = 1.2; sun.shadow.camera.bottom = -1.2;
      sun.shadow.bias = -0.0008;
      scene.add(sun);
      scene.add(new T.HemisphereLight(0x8a5638, 0x2a1508, 0.8));

      /* 台面：接住影子（压 envMapIntensity，防 HDR 环境光把台面打成奶油色） */
      const ground = new T.Mesh(
        new T.PlaneGeometry(2.2, 2.2),
        new T.MeshStandardMaterial({ color: new T.Color(0x241509).convertSRGBToLinear(),
                                     roughness: 0.95, metalness: 0 })
      );
      ground.material.envMapIntensity = 0.3;
      ground.rotation.x = -Math.PI / 2;
      ground.receiveShadow = true;
      scene.add(ground);

      /* 模型实例：整体归一到 1m，台面接地、居中。
         克隆后先把锤子复位到落点基准位（克隆可能取到动画中途的瞬时位姿），
         再强制更新矩阵——否则包围盒还是脏的，归一化尺度全错 */
      const root = srcModel.clone(true);
      const rootHam = root.getObjectByName('Hammer');
      if (rootHam && rootHam.userData.basePos) rootHam.position.copy(rootHam.userData.basePos);
      root.updateMatrixWorld(true);
      const bb = new T.Box3().setFromObject(root);
      const size = bb.getSize(new T.Vector3()), ctr = bb.getCenter(new T.Vector3());
      const sc = 1.0 / Math.max(size.x, size.y, size.z);
      root.scale.setScalar(sc);
      root.position.set(-ctr.x * sc, -bb.min.y * sc, -ctr.z * sc);
      scene.add(root);
      root.traverse(function (o) {
        if (o.isMesh && o.material && 'envMapIntensity' in o.material) {
          /* 木质件少吸中性环境光，棕色更纯 */
          o.material.envMapIntensity = (o.material.name === 'M_Wood_Dark' ||
            o.material.name === 'M_Wood_Handle') ? 0.3 : 0.65;
        }
      });
      scene.updateMatrixWorld(true);
      /* 火花 / 相机目标 = 锤落点 = 錾子顶端（世界坐标；锤已在源模型里就位） */
      const chB = new T.Box3().setFromObject(root.getObjectByName('Chisel'));
      const strikeW = new T.Vector3(chB.max.x, chB.max.y,
                                    (chB.min.z + chB.max.z) / 2);
      const mB = new T.Box3().setFromObject(root);
      act = makeActor(root, scene, 0.04, 1 / sc, strikeW, 0,
                      Math.max(0.18, (mB.max.y - mB.min.y) * 0.45) );

      /* 相机：微距特写，对准锤落点（錾顶）——铜片/錾子/接触帧都入画；
         抬锤瞬间锤会暂时出画，这正是「微距」的合理取舍 */
      camera = new T.PerspectiveCamera(40, 16 / 9, 0.01, 50);
      camera.position.set(strikeW.x + 0.28, strikeW.y + 0.20, strikeW.z + 0.44);

      controls = new T.OrbitControls(camera, cv);
      controls.target.set(strikeW.x, strikeW.y - 0.01, strikeW.z);
      controls.enableDamping = true;
      controls.dampingFactor = 0.08;
      controls.minDistance = 0.04;
      controls.maxDistance = 2.5;
      controls.update();

      /* 泛光后期：UnrealBloomPass（Threshold 0.8 / Strength 1.2）+ 伽马输出 */
      composer = new T.EffectComposer(renderer);
      composer.addPass(new T.RenderPass(scene, camera));
      bloomPass = new T.UnrealBloomPass(new T.Vector2(16, 16), 1.2, 0.5, 0.8);
      composer.addPass(bloomPass);
      composer.addPass(new T.ShaderPass(T.GammaCorrectionShader));
      wrap.__ROOT = root; wrap.__ACT = act; wrap.__CAM = camera;   /* 调试出口 */
      window.__FORGE_VIEWER_WRAP = wrap;
      built = true;
      resize();
      window.addEventListener('resize', resize);
    }

    function resize() {
      if (!built) return;
      const w = stage.clientWidth, h = stage.clientHeight;
      renderer.setSize(w, h, false);
      composer.setSize(w, h);
      if (bloomPass) bloomPass.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }

    function loop(now) {
      if (!running) return;
      raf = requestAnimationFrame(loop);
      const dt = Math.min(0.05, (now - lastT) / 1000 || 0.016);
      lastT = now;
      if (act) act.update(dt);
      controls.update();
      composer.render();
    }

    function show() {
      if (!built) build();
      wrap.style.display = 'block';
      resize();
      running = true; lastT = performance.now();
      raf = requestAnimationFrame(loop);
    }
    function hide() {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      wrap.style.display = 'none';
    }
    return { open: show, close: hide };
  }
})();

</script>
<script>
/* 俯视总览：把长廊天花也收起来，两个空间一起看全 */
if (/[?&]aerial=/.test(location.search) && window.__CORR_AERIAL) window.__CORR_AERIAL();
document.documentElement.dataset.diag =
  'HALL=' + !!window.__HALL + ' CORR=' + !!window.__CORR + ' TICK=' + !!window.__CORR_TICK;

</script>
</body>
</html>
