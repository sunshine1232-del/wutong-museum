<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>乌铜走银 · 连通展厅（单厅 + 非遗工艺长廊）</title>
<style>
/* ============================================================
   乌铜走银 · 单厅 3D 展厅
   配色：黑铜 #0b0807 / 白银 #dfe6ef / 暗金 #b08a4f
   ============================================================ */
:root{
  --ink:#e8e2d9;
  --muted:#a2988b;
  --dim:#6c6259;
  --dim2:#605850;
  --silver:#dfe6ef;
  --gold:#b08a4f;
  --gold-lt:#d8b273;
  --copper:#c2805a;
  --line:rgba(223,230,239,.14);
  --serif:"Songti SC","Source Han Serif SC","Noto Serif SC","Noto Serif CJK SC",SimSun,serif;
  --sans:"PingFang SC","Microsoft YaHei","Hiragino Sans GB",system-ui,sans-serif;
  --mono:"SF Mono","JetBrains Mono",Consolas,monospace;
}

*,*::before,*::after{ box-sizing:border-box; }

html,body{
  margin:0; padding:0; width:100%; height:100%;
  overflow:hidden; background:#070606; color:var(--ink);
  font-family:var(--sans);
  -webkit-font-smoothing:antialiased;
  user-select:none;
}

#gl{ position:fixed; inset:0; display:block; width:100%; height:100%; }

#vignette{
  position:fixed; inset:0; pointer-events:none; z-index:2;
  background:
    radial-gradient(90% 70% at 50% 46%, rgba(0,0,0,0) 42%, rgba(0,0,0,.55) 100%),
    linear-gradient(180deg, rgba(0,0,0,.35), rgba(0,0,0,0) 22%, rgba(0,0,0,0) 78%, rgba(0,0,0,.42));
}

.mono{ font-family:var(--mono); letter-spacing:.14em; }

/* ---------- 载入 ---------- */
#loader{
  position:fixed; inset:0; z-index:60;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:18px; background:#070606;
  transition:opacity .9s ease, visibility .9s;
}
#loader.off{ opacity:0; visibility:hidden; }
.ld-ring{
  width:46px; height:46px; border-radius:50%;
  border:1px solid rgba(223,230,239,.18);
  border-top-color:var(--gold);
  animation:spin 1.1s linear infinite;
}
@keyframes spin{ to{ transform:rotate(360deg); } }
.ld-txt{ font-family:var(--serif); font-size:15px; letter-spacing:.42em; color:#cfc4b7; padding-left:.42em; }
.ld-sub{ font-size:9px; color:var(--dim2); }

/* ---------- 左上标题 ---------- */
#hudTitle{
  position:fixed; left:clamp(24px,4vw,58px); top:clamp(24px,4vh,52px); z-index:10;
  pointer-events:none;
}
.ht-kicker{ font-size:9.5px; color:var(--gold); letter-spacing:.28em; margin-bottom:12px; }
#hudTitle h1{
  font-family:var(--serif); font-weight:400;
  font-size:clamp(24px,3.2vw,38px); line-height:1.2;
  letter-spacing:.16em; margin:0; color:#efe8dd;
}
.ht-rule{ width:38px; height:1px; background:var(--gold); margin:16px 0 12px; opacity:.7; }
.ht-sub{ font-size:11px; letter-spacing:.22em; color:var(--muted); }

/* ---------- 左下提示 ---------- */
#tips{
  position:fixed; left:clamp(24px,4vw,58px); bottom:clamp(22px,4vh,46px); z-index:10;
  display:flex; flex-direction:column; gap:7px;
  font-size:10.5px; color:var(--dim2); letter-spacing:.1em;
  pointer-events:none;
}
#tips .tip b{ color:#9c948b; font-weight:500; letter-spacing:.14em; margin-right:8px; }

/* ---------- 右下平面图 ---------- */
#minimap{
  position:fixed; right:clamp(20px,3vw,44px); bottom:clamp(20px,3vh,40px); z-index:10;
  width:190px; padding:10px 10px 6px;
  background:rgba(10,8,7,.55);
  border:1px solid var(--line);
  backdrop-filter:blur(8px);
  pointer-events:none;
  transition:opacity .45s ease, transform .45s ease;
}
body:has(#card.on) #minimap{ opacity:.16; transform:translateY(8px); }
.mm-head{ font-size:8.5px; color:var(--gold); letter-spacing:.22em; margin-bottom:6px; }
#mmSvg{ display:block; width:100%; height:auto; }
.mm-room{ fill:none; stroke:rgba(223,230,239,.26); stroke-width:.9; }
.mm-ring{ fill:none; stroke:rgba(223,230,239,.20); stroke-width:1.2; stroke-dasharray:3 3; }
.mm-screen{ fill:rgba(201,164,92,.55); stroke:rgba(224,192,137,.85); stroke-width:.6; }
.mm-dot{ fill:var(--gold); opacity:.85; }
.mm-dot.on{ fill:#fff; opacity:1; r:3.2; }
.mm-dir{ stroke:#fff; stroke-width:1.2; }
.mm-foot{ font-size:8px; color:var(--dim2); text-align:center; margin-top:2px; letter-spacing:.18em; }

/* ---------- 展品卡 ---------- */
#card{
  position:fixed; right:clamp(20px,3vw,44px); top:50%;
  transform:translate(24px,-50%);
  width:min(396px,calc(100vw - 40px));
  z-index:20; padding:22px 24px 18px;
  background:linear-gradient(165deg, rgba(22,18,16,.94), rgba(11,9,8,.96));
  border:1px solid rgba(176,138,79,.28);
  box-shadow:0 30px 80px rgba(0,0,0,.6);
  opacity:0; visibility:hidden;
  transition:opacity .5s ease, transform .55s cubic-bezier(.22,1,.36,1), visibility .5s;
}
#card.on{ opacity:1; visibility:visible; transform:translate(0,-50%); }
.c-top{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
.c-idx{ font-size:11px; color:var(--gold); letter-spacing:.3em; }
.c-close{
  background:none; border:none; padding:0; cursor:pointer;
  font-size:9.5px; letter-spacing:.14em; color:var(--dim2);
  font-family:var(--sans); transition:color .3s;
}
.c-close:hover{ color:var(--gold-lt); }
#card h2{
  font-family:var(--serif); font-weight:400; font-size:25px;
  letter-spacing:.12em; margin:0 0 9px; color:#f4ede2;
}
.c-en{ font-family:var(--serif); font-style:italic; font-size:13px; letter-spacing:.04em; color:#a2988a; margin:-4px 0 12px; }
.c-meta{ font-size:11.5px; letter-spacing:.14em; color:#9a9082; }
.c-craft{ display:flex; align-items:center; gap:10px; margin-top:16px; padding-top:12px; border-top:1px solid rgba(176,138,79,.18); }
.c-craft span{ font-size:9.5px; letter-spacing:.22em; color:#8b7a5e; }
.c-craft b{ font-weight:400; font-size:12px; letter-spacing:.10em; color:#e3c88d; }
.c-tip{ margin-top:10px; font-size:9px; letter-spacing:.14em; color:#6b6259; }
.c-rule{ height:1px; background:linear-gradient(90deg, rgba(176,138,79,.55), rgba(176,138,79,0)); margin:16px 0 14px; }
#cardDesc{ font-size:15.5px; line-height:1.95; color:#cec5b8; margin:0; letter-spacing:.02em; }
.c-foot{ margin-top:18px; font-size:9px; color:#665d54; letter-spacing:.22em; }

/* ---------- 提示 ---------- */
#focusHint{
  position:fixed; left:50%; bottom:clamp(22px,4vh,44px); transform:translateX(-50%);
  z-index:10; font-size:10px; letter-spacing:.2em; color:var(--dim2);
  opacity:0; transition:opacity .6s; pointer-events:none;
}
#focusHint.on{ opacity:1; }

#enterHint{
  position:fixed; left:50%; top:50%; transform:translate(-50%,-50%);
  z-index:12; display:flex; align-items:center; gap:16px;
  font-family:var(--serif); font-size:13px; letter-spacing:.3em; color:#cfc4b7;
  opacity:0; pointer-events:none; transition:opacity 1.2s ease;
}
#enterHint.on{ opacity:1; }
#enterHint .eh-line{ width:clamp(30px,6vw,70px); height:1px; background:linear-gradient(90deg, transparent, var(--gold)); }
#enterHint .eh-line:last-child{ background:linear-gradient(90deg, var(--gold), transparent); }

/* ---------- 右上：原样模型查看器入口 ---------- */
#rawEntry, #cmpEntry{
  position:fixed; right:clamp(20px,3vw,44px); z-index:12;
  font-size:10px; letter-spacing:.14em; color:var(--dim2); text-decoration:none;
  padding:8px 12px; background:rgba(10,8,7,.45); border:1px solid var(--line);
  backdrop-filter:blur(8px); transition:color .2s, border-color .2s;
}
#rawEntry{ top:clamp(18px,3vh,36px); }
#cmpEntry{ top:calc(clamp(18px,3vh,36px) + 38px); color:#a08a68; }
#rawEntry:hover, #cmpEntry:hover{ color:var(--gold-lt); border-color:rgba(216,178,115,.6); }

/* ---------- 窄屏 ---------- */
@media(max-width:820px){
  #rawEntry, #cmpEntry{ font-size:9px; padding:6px 9px; }
  #cmpEntry{ top:calc(clamp(18px,3vh,36px) + 32px); }
  #minimap{ width:140px; }
  #tips{ font-size:9.5px; gap:5px; }
  #card{ top:auto; bottom:16px; right:16px; left:16px; width:auto; transform:translateY(20px); }
  #card.on{ transform:translateY(0); }
  .ht-sub{ display:none; }
}
@media(max-width:560px){
  #minimap{ display:none; }
}

@media(prefers-reduced-motion:reduce){
  *{ animation-duration:.01ms !important; transition-duration:.01ms !important; }
}

/* ---------- 穿门过场 ---------- */
#veil{
  position:fixed; inset:0; z-index:50;
  display:flex; align-items:center; justify-content:center;
  background:radial-gradient(ellipse at 50% 50%, #2a221a 0%, #0b0907 100%);
  opacity:0; pointer-events:none; transition:opacity .85s ease;
}
#veil.on{ opacity:1; }
#veil span{
  font-family:var(--serif); font-size:11px; letter-spacing:.62em; text-indent:.62em;
  color:rgba(214,198,174,.52);
}


/* ---- 长廊工序面板 / 门厅提示（与展厅 HUD 并存，不冲突） ---- */
#hint{position:fixed;left:50%;bottom:44px;transform:translate(-50%,14px);
  display:flex;align-items:center;gap:10px;padding:10px 20px;
  border:1px solid rgba(120,98,70,.26);background:rgba(250,246,238,.86);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  font-size:12px;letter-spacing:.18em;color:rgba(48,41,33,.78);
  opacity:0;pointer-events:none;transition:opacity .45s ease,transform .45s ease;z-index:7}
#hint.show{opacity:1;transform:translate(-50%,0)}
#hint .k{color:#9a7743}
#hint .sep{width:1px;height:11px;background:rgba(120,98,70,.3)}
#panel{position:fixed;right:40px;top:50%;width:min(376px,calc(100vw - 48px));
  transform:translate(24px,-50%);opacity:0;pointer-events:none;
  padding:38px 36px 26px;
  background:linear-gradient(156deg,rgba(251,247,239,.975),rgba(240,233,221,.99));
  border:1px solid rgba(120,98,70,.24);
  box-shadow:0 30px 80px rgba(62,48,32,.26),inset 0 1px 0 rgba(255,255,255,.85);
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  transition:opacity .4s ease,transform .55s cubic-bezier(.16,.84,.34,1);z-index:8}
#panel::before{content:'';position:absolute;left:0;top:38px;bottom:38px;width:1px;
  background:linear-gradient(180deg,transparent,rgba(154,119,67,.62),transparent)}
#panel.show{opacity:1;transform:translate(0,-50%);pointer-events:auto}
#panel .pno{font-size:58px;line-height:.9;color:rgba(154,119,67,.26);letter-spacing:.04em;
  margin-bottom:14px;font-weight:500}
#panel .pmeta{font-size:10px;letter-spacing:.4em;color:rgba(140,108,62,.9);margin-bottom:12px;
  font-family:"PingFang SC","Microsoft YaHei",sans-serif}
#panel h2{margin:0;font-size:27px;font-weight:500;letter-spacing:.08em;color:#241e18;line-height:1.45}
#panel .rule{height:1px;margin:20px 0 19px;
  background:linear-gradient(90deg,rgba(154,119,67,.6),rgba(154,119,67,.04))}
#panel p{margin:0;font-size:14.5px;line-height:2.0;color:#4c453d;letter-spacing:.04em;text-align:justify}
#panel .pfoot{margin-top:24px;padding-top:13px;border-top:1px solid rgba(90,74,54,.12);
  font-size:10px;letter-spacing:.18em;color:rgba(56,48,38,.34);
  font-family:"PingFang SC","Microsoft YaHei",sans-serif}
#close{position:absolute;right:14px;top:14px;width:30px;height:30px;border:0;background:transparent;
  color:rgba(56,48,38,.4);font-size:20px;line-height:1;cursor:pointer;
  font-family:Arial,sans-serif;transition:color .3s,transform .3s}
#close:hover{color:#9a7743;transform:rotate(90deg)}
#err{display:none}
@media(max-width:640px){
  #panel{right:10px;left:10px;width:auto;top:auto;bottom:10px;transform:translateY(26px);padding:28px 24px 20px}
  #panel.show{transform:translateY(0)}
  #panel .pno{font-size:40px}
  #panel h2{font-size:22px}
}

</style>
</head>
<body>

<canvas id="gl"></canvas>
<div id="vignette"></div>

<!-- 载入 -->
<div id="loader">
  <div class="ld-ring"></div>
  <div class="ld-txt">正在布置展厅</div>
  <div class="ld-sub mono">WUTONG ZOUYIN · SINGLE HALL</div>
</div>

<!-- 左上：标题 -->
<header id="hudTitle">
  <div class="ht-kicker mono">乌铜走银 · 虚拟展厅</div>
  <h1>一堂藏雅，十一器生辉</h1>
  <div class="ht-rule"></div>
  <div class="ht-sub">十一座玻璃展柜 · 穿北门入长廊 · 五道工序</div>
</header>

<!-- 左下：操作提示 -->
<div id="tips">
  <div class="tip"><b>W</b> 穿门入厅</div>
  <div class="tip"><b>A</b> 左移 · <b>D</b> 右移</div>
  <div class="tip"><b>拖拽</b> 环视</div>
  <div class="tip"><b>点击展品</b> 悬浮旋转细看</div>
  <div class="tip"><b>Esc</b> 返回动线</div>
  <div class="tip"><b>北侧门洞</b> 直通长廊 · 左转入廊</div>
</div>

<!-- 右下：平面导览 -->
<div id="minimap">
  <div class="mm-head mono">展厅平面</div>
  <svg viewBox="0 0 168 168" id="mmSvg">
    <rect x="8" y="8" width="152" height="152" class="mm-room"/>
    <rect x="54" y="81" width="60" height="6" rx="1.4" class="mm-screen"/>
    <g id="mmDots"></g>
    <g id="mmMe">
      <circle r="3.4" class="mm-dot"/>
      <line id="mmDir" x1="0" y1="0" x2="0" y2="-9" class="mm-dir"/>
    </g>
  </svg>
  <div class="mm-foot mono">入口 ↓ · 长廊 ↖（出门即到）</div>
</div>

<!-- 唯一主网页：不设外部入口 -->

<!-- 展品卡 -->
<aside id="card">
  <div class="c-top">
    <span class="c-idx mono" id="cardIdx">01 / 11</span>
    <button class="c-close" id="cardBack" type="button" aria-label="返回">返回动线 Esc</button>
  </div>
  <h2 id="cardName">—</h2>
  <div class="c-en" id="cardEn">—</div>
  <div class="c-meta" id="cardMeta">—</div>
  <div class="c-rule"></div>
  <p id="cardDesc">—</p>
  <div class="c-craft"><span class="mono">工艺</span><b id="cardCraft">—</b></div>
  <div class="c-foot mono" id="cardFoot">WUTONG ZOUYIN · 乌铜走银</div>
  <div class="c-tip mono">正在缓慢旋转 · 拖拽可绕看</div>
</aside>

<!-- 聚焦提示 -->
<div id="focusHint">点击展品查看说明 · 拖动仍可环视</div>

<!-- 边缘提示：首次进入 -->
<div id="enterHint">
  <span class="eh-line"></span>
  推门而入 · 沿柜环行一周
  <span class="eh-line"></span>
</div>

<!-- 穿门过场 -->
<div id="veil"><span>长 廊</span></div>


<!-- 长廊：工序说明面板与门厅提示（展厅 HUD 之外，两个空间共用同一页面） -->
<div id="hint"><span class="k">门厅</span><span class="sep"></span><span>左转进入横向长廊 · 身后返回「一堂藏雅，十一器生辉」</span></div>
<aside id="panel" aria-hidden="true">
  <button id="close" aria-label="关闭">×</button>
  <div class="pno" id="pno">壹</div>
  <div class="pmeta" id="pmeta">第 1 道工序</div>
  <h2 id="ptitle">熔炼乌铜</h2>
  <div class="rule"></div>
  <p id="ptext"></p>
  <div class="pfoot">离开展窗自动收起 · ESC 关闭</div>
</aside>
<div id="err"></div>
<div id="intro" style="display:none"><button id="enter"></button></div>

<!-- 优先本地 Three.js，断网也能进；CDN 仅作兜底 -->
<script>
/**
 * @license
 * Copyright 2010-2022 Three.js Authors
 * SPDX-License-Identifier: MIT
